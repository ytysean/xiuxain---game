# ===== S54 P1：委托竞价系统 =====
# 设置委托竞价（离线自动出价）
func 设置委托竞价(拍品ID: String, 委托价: int) -> Dictionary:
	var lot: Dictionary = _查找拍品(拍品ID)
	if lot.is_empty():
		return {"成功": false, "原因": "拍品不存在"}
	if lot.get("状态", "") != "竞拍中":
		return {"成功": false, "原因": "该拍品已结束竞拍"}
	var 当前价: int = int(lot.get("当前价", 0))
	if 委托价 <= 当前价:
		return {"成功": false, "原因": "委托价须高于当前价"}
	if Game.灵石 < 委托价:
		return {"成功": false, "原因": "灵石不足，无法冻结委托金额"}
	# 取消已有委托
	_取消委托竞价(拍品ID)
	# 冻结灵石
	Game.灵石 -= 委托价
	# 添加委托
	var 委托: Dictionary = {
		"拍品ID": 拍品ID,
		"委托价": 委托价,
		"冻结灵石": 委托价,
		"设置日": Game.累计游戏日,
		"状态": "活跃",
	}
	(全服拍卖["委托列表"] as Array).append(委托)
	Game.添加纪事("全服拍卖", "委托竞价", "宗主设置委托竞价：「%s」最高%d灵石。" % [lot.get("名称", ""), 委托价], 1)
	return {"成功": true, "原因": "委托竞价设置成功"}

# 取消委托竞价
func _取消委托竞价(拍品ID: String) -> void:
	var 委托列表: Array = 全服拍卖.get("委托列表", [])
	for w in 委托列表:
		if str(w.get("拍品ID", "")) == 拍品ID and str(w.get("状态", "")) == "活跃":
			Game.灵石 += int(w.get("冻结灵石", 0))
			w["状态"] = "已取消"

# 处理委托竞价（模拟玩家出价）
func _处理委托竞价(lot: Dictionary) -> void:
	var 拍品ID: String = str(lot.get("id", ""))
	var 当前价: int = int(lot.get("当前价", 0))
	var 步进: int = max(10, int(float(当前价) * 0.05))
	for w in 全服拍卖.get("委托列表", []):
		if str(w.get("拍品ID", "")) != 拍品ID or str(w.get("状态", "")) != "活跃":
			continue
		var 委托价: int = int(w.get("委托价", 0))
		if 委托价 > 当前价 + 步进:
			# 委托出价
			var 出价: int = min(委托价, 当前价 + 步进)
			lot["当前价"] = 出价
			lot["最高出价者"] = "玩家(宗主·委托)"
			(lot["竞价记录"] as Array).append({"出价者": "玩家(宗主·委托)", "出价": 出价, "日": Game.累计游戏日})
			# 延时机制
			var 结束日: int = int(lot.get("延时结束日", int(全服拍卖.get("结束日", 0))))
			if 结束日 - int(Game.累计游戏日) <= 3:
				lot["延时结束日"] = int(Game.累计游戏日) + 1
			break

