# 随机触发奇遇（根据路线奇遇概率）
func 随机触发奇遇(路线: String) -> Dictionary:
	var 路线配置: Dictionary = 历练路线配置.get(路线, {})
	var 奇遇概率: float = float(路线配置.get("奇遇概率", 0.1))
	if randf() > 奇遇概率:
		return {}
	# 从奇遇池中随机选择
	if 历练奇遇池.is_empty():
		return {}
	return 历练奇遇池[randi() % 历练奇遇池.size()].duplicate()

# 处理奇遇选项（玩家选择后调用）
func 处理奇遇选项(奇遇: Dictionary, 选项索引: int, 弟子ID列表: Array) -> Dictionary:
	if 奇遇.is_empty() or 选项索引 < 0:
		return {"成功": false, "原因": "参数无效"}
	var 选项列表: Array = 奇遇.get("选项", [])
	if 选项索引 >= 选项列表.size():
		return {"成功": false, "原因": "选项索引越界"}
	var 选项: Dictionary = 选项列表[选项索引]
	var 成功率: float = float(选项.get("成功率", 0.5))
	var 成功: bool = randf() < 成功率
	var 效果: Dictionary = 选项.get("成功效果", {}) if 成功 else 选项.get("失败效果", {})
	var 纪事文本: String = str(选项.get("纪事", ""))
	# 应用效果
	_应用奇遇效果(效果, 弟子ID列表)
	return {
		"成功": 成功,
		"奇遇名称": str(奇遇.get("名称", "")),
		"选项名称": str(选项.get("名称", "")),
		"效果": 效果,
		"纪事": 纪事文本
	}

# 应用奇遇效果
func _应用奇遇效果(效果: Dictionary, 弟子ID列表: Array) -> void:
	if 效果.is_empty():
		return
	# 资源类效果
	if 效果.has("灵石") and Game != null:
		Game.灵石 += int(效果.get("灵石", 0))
	if 效果.has("声望") and Game != null and "声望" in Game:
		Game.声望 += int(效果.get("声望", 0))
	if 效果.has("贡献点") and Game != null and "贡献点" in Game:
		Game.贡献点 += int(效果.get("贡献点", 0))
	if 效果.has("悟道点") and Game != null and "悟道点" in Game:
		Game.悟道点 += int(效果.get("悟道点", 0))
	# 弟子属性类效果
	for did in 弟子ID列表:
		var d = _获取弟子(did)
		if d == null:
			continue
		if 效果.has("道心") and d.has_method("增加道心"):
			d.增加道心(int(效果.get("道心", 0)))
		if 效果.has("心境") and d.has_method("增加心境"):
			d.增加心境(int(效果.get("心境", 0)))
		if 效果.has("心魔") and d.has_method("增加心魔"):
			d.增加心魔(int(效果.get("心魔", 0)))
		if 效果.has("修为") and "修为" in d:
			d.修为 = int(d.修为) + int(效果.get("修为", 0))
		if 效果.has("修为损耗") and "修为" in d:
			d.修为 = max(0, int(d.修为) - int(效果.get("修为损耗", 0)))
		if 效果.has("状态"):
			d.状态 = str(效果.get("状态", ""))
		# 修真味·因果：奇遇选项可直接增减 业力/功德（取舍型奇遇的落点）
		if 效果.has("业力") and d.has_method("增加业力"):
			d.增加业力(int(效果.get("业力", 0)))
		if 效果.has("功德") and d.has_method("增加功德"):
			d.增加功德(int(效果.get("功德", 0)))

# ===== 历练风险决策系统 =====
# 历练过程中玩家可以选择"见好就收"或"继续深入"
func 历练风险决策(实例ID: String, 决策: String) -> Dictionary:
	var 实例: Dictionary = 进行中历练.get(实例ID, {})
	if 实例.is_empty():
		return {"成功": false, "原因": "历练实例不存在"}
	var 当前游戏日: int = 0
	if Game != null:
		var v = Game.get("累计游戏日")
		当前游戏日 = int(v) if v != null else 0
	var 已历练天数: int = 当前游戏日 - int(实例.get("开始游戏日", 0))
	var 总天数: int = int(实例.get("预计结束游戏日", 0)) - int(实例.get("开始游戏日", 0))
	var 进度: float = float(已历练天数) / float(max(1, 总天数))
	if 决策 == "见好就收":
		# 提前结束，获得部分奖励（按进度比例）
		var 部分奖励倍率: float = clamp(进度 * 0.8, 0.2, 0.9)
		实例["提前结束"] = true
		实例["提前结束倍率"] = 部分奖励倍率
		进行中历练[实例ID] = 实例
		return {"成功": true, "决策": "见好就收", "进度": 进度, "奖励倍率": 部分奖励倍率, "说明": "已选择见好就收，将按%.0f%%进度获得奖励" % (部分奖励倍率 * 100)}
	elif 决策 == "继续深入":
		# 继续深入，有机会获得更多奖励，但风险增加
		var 风险增加: float = clamp(进度 * 0.1, 0.0, 0.3)
		实例["继续深入"] = true
		实例["风险增加"] = 风险增加
		进行中历练[实例ID] = 实例
		return {"成功": true, "决策": "继续深入", "进度": 进度, "风险增加": 风险增加, "说明": "已选择继续深入，奖励可能增加%.0f%%，但风险也随之增加" % (风险增加 * 100)}
	return {"成功": false, "原因": "无效决策"}

# ===== 历练多结局系统 =====
# 根据玩家选择和历练结果，生成不同结局
func 获取历练结局(实例ID: String, 成功: bool, 评级: String) -> Dictionary:
	var 实例: Dictionary = 进行中历练.get(实例ID, {})
	var 路线: String = str(实例.get("路线", "稳妥"))
	var 奇遇记录: Array = 实例.get("奇遇记录", [])
	var 提前结束: bool = 实例.get("提前结束", false)
	var 继续深入: bool = 实例.get("继续深入", false)
	var 结局类型: String = "普通"
	var 结局描述: String = ""
	var 额外奖励: Dictionary = {}
	# 判断结局类型
	if 成功 and 评级 == "S" and 奇遇记录.size() >= 2:
		结局类型 = "完美"
		结局描述 = "此行圆满，不仅平安归来，更屡逢奇遇，收获颇丰，实乃大吉之兆！"
		额外奖励 = {"声望": 20, "贡献点": 10, "道心": 3}
	elif 成功 and 评级 == "S":
		结局类型 = "大捷"
		结局描述 = "此行大捷，弟子们奋勇争先，凯旋而归，宗门上下皆欢。"
		额外奖励 = {"声望": 10, "贡献点": 5}
	elif 成功 and 继续深入:
		结局类型 = "深入"
		结局描述 = "弟子们不畏艰险，深入险境，虽有波折，但终获大机缘。"
		额外奖励 = {"道心": 2, "修为": 100}
	elif 成功 and 提前结束:
		结局类型 = "稳妥"
		结局描述 = "弟子们见好就收，虽未获全功，但平安归来，亦是明智之举。"
		额外奖励 = {"道心": 1}
	elif 成功:
		结局类型 = "普通"
		结局描述 = "此行顺利完成，弟子们各有收获，平安归来。"
	elif not 成功 and 奇遇记录.size() >= 1:
		结局类型 = "险归"
		结局描述 = "此行虽遇波折，甚至遭遇险境，但弟子们凭借机缘化险为夷，虽败犹荣。"
		额外奖励 = {"道心": 2, "心境": 3}
	else:
		结局类型 = "失败"
		结局描述 = "此行不顺，弟子们未能完成历练，铩羽而归，需好生休整。"
	# 应用额外奖励
	if not 额外奖励.is_empty() and Game != null:
		if 额外奖励.has("声望") and "声望" in Game:
			Game.声望 += int(额外奖励.get("声望", 0))
		if 额外奖励.has("贡献点") and "贡献点" in Game:
			Game.贡献点 += int(额外奖励.get("贡献点", 0))
	return {
		"结局类型": 结局类型,
		"结局描述": 结局描述,
		"额外奖励": 额外奖励,
		"路线": 路线,
		"奇遇次数": 奇遇记录.size(),
		"评级": 评级
	}

# ===== 增强版开始历练（带路线选择）=====
func 开始历练增强(关卡ID: String, 弟子ID列表: Array, 路线: String = "稳妥") -> Dictionary:
	# 先调用原有开始历练
	var 结果: Dictionary = 开始历练(关卡ID, 弟子ID列表)
	if not 结果.get("成功", false):
		return 结果
	# 添加路线信息
	var 实例ID: String = str(结果.get("实例ID", ""))
	if 实例ID != "" and 进行中历练.has(实例ID):
		进行中历练[实例ID]["路线"] = 路线
		进行中历练[实例ID]["奇遇记录"] = []
		进行中历练[实例ID]["提前结束"] = false
		进行中历练[实例ID]["继续深入"] = false
		# 根据路线调整预计时长
		var 路线配置: Dictionary = 历练路线配置.get(路线, {})
		var 风险等级: int = int(路线配置.get("风险等级", 1))
		if 风险等级 >= 3:
			进行中历练[实例ID]["预计结束游戏日"] = int(进行中历练[实例ID]["预计结束游戏日"]) + 2
	return 结果

# ===== 获取历练进度（UI用）=====
func 获取历练进度(实例ID: String) -> Dictionary:
	var 实例: Dictionary = 进行中历练.get(实例ID, {})
	if 实例.is_empty():
		return {}
	var 当前游戏日: int = 0
	if Game != null:
		var v = Game.get("累计游戏日")
		当前游戏日 = int(v) if v != null else 0
	var 已历练天数: int = 当前游戏日 - int(实例.get("开始游戏日", 0))
	var 总天数: int = int(实例.get("预计结束游戏日", 0)) - int(实例.get("开始游戏日", 0))
	var 进度: float = clamp(float(已历练天数) / float(max(1, 总天数)), 0.0, 1.0)
	var 路线: String = str(实例.get("路线", "稳妥"))
	var 路线配置: Dictionary = 历练路线配置.get(路线, {})
	return {
		"实例ID": 实例ID,
		"关卡ID": 实例.get("关卡ID", ""),
		"路线": 路线,
		"路线名称": 路线配置.get("名称", 路线),
		"进度": 进度,
		"已历练天数": 已历练天数,
		"总天数": 总天数,
		"剩余天数": max(0, 总天数 - 已历练天数),
		"奇遇记录": 实例.get("奇遇记录", []),
		"提前结束": 实例.get("提前结束", false),
		"继续深入": 实例.get("继续深入", false),
		"可决策": 进度 >= 0.3 and 进度 < 1.0
	}

# ===== 历练叙事生成（UI用，增加代入感）=====
func 生成历练叙事(实例ID: String) -> Array:
	var 实例: Dictionary = 进行中历练.get(实例ID, {})
	if 实例.is_empty():
		return []
	var 关卡: Dictionary = 获取关卡(str(实例.get("关卡ID", "")))
	var 路线: String = str(实例.get("路线", "稳妥"))
	var 路线配置: Dictionary = 历练路线配置.get(路线, {})
	var 叙事: Array = []
	# 开始叙事
	叙事.append("【启程】弟子们辞别宗门，前往「%s」，选择了「%s」的路线。" % [str(关卡.get("名称", "")), str(路线配置.get("名称", 路线))])
	叙事.append("【路线】%s" % str(路线配置.get("描述", "")))
	# 奇遇叙事
	var 奇遇记录: Array = 实例.get("奇遇记录", [])
	for 奇遇 in 奇遇记录:
		叙事.append("【奇遇】%s" % str(奇遇.get("纪事", "")))
	# 决策叙事
	if 实例.get("提前结束", false):
		叙事.append("【决策】弟子们见好就收，选择提前返回宗门。")
	elif 实例.get("继续深入", false):
		叙事.append("【决策】弟子们不畏艰险，选择继续深入险境。")
	return 叙事
# ============ 奇遇事件系统（待处理奇遇 + 玩家选择）============
# 设计：历练途中每日按路线概率触发奇遇，添加到"待处理奇遇"列表；
#       玩家打开历练页面时看到待处理奇遇，弹出弹窗做选择；
#       选择结果记录到奇遇记录中，并应用效果。

# 触发待处理奇遇（每日推演时调用）
func 触发待处理奇遇(实例ID: String) -> void:
	var 实例: Dictionary = 进行中历练.get(实例ID, {})
	if 实例.is_empty():
		return
	var 路线: String = str(实例.get("路线", "稳妥"))
	var 待处理列表: Array = 实例.get("待处理奇遇", [])
	# 最多同时存在1个待处理奇遇
	if 待处理列表.size() >= 1:
		return
	# 按路线奇遇概率触发
	var 奇遇: Dictionary = 随机触发奇遇(路线)
	if 奇遇.is_empty():
		return
	# 添加到待处理列表
	待处理列表.append({
		"奇遇ID": str(奇遇.get("ID", "")),
		"奇遇": 奇遇,
		"触发日": (int(Game.get("累计游戏日")) if Game != null else 0),
		"已处理": false
	})
	实例["待处理奇遇"] = 待处理列表
	进行中历练[实例ID] = 实例

# 获取待处理奇遇列表（UI用）
func 获取待处理奇遇(实例ID: String) -> Array:
	var 实例: Dictionary = 进行中历练.get(实例ID, {})
	if 实例.is_empty():
		return []
	var 待处理列表: Array = 实例.get("待处理奇遇", [])
	var 结果: Array = []
	for item in 待处理列表:
		if not bool(item.get("已处理", false)):
			结果.append(item)
	return 结果

# 处理待处理奇遇（玩家选择后调用）
func 处理待处理奇遇(实例ID: String, 奇遇索引: int, 选项索引: int) -> Dictionary:
	var 实例: Dictionary = 进行中历练.get(实例ID, {})
	if 实例.is_empty():
		return {"成功": false, "原因": "历练实例不存在"}
	var 待处理列表: Array = 实例.get("待处理奇遇", [])
	if 奇遇索引 < 0 or 奇遇索引 >= 待处理列表.size():
		return {"成功": false, "原因": "奇遇索引越界"}
	var item: Dictionary = 待处理列表[奇遇索引]
	if bool(item.get("已处理", false)):
		return {"成功": false, "原因": "该奇遇已处理"}
	var 奇遇: Dictionary = item.get("奇遇", {})
	var 弟子ID列表: Array = 实例.get("弟子ID列表", [])
	# 调用处理奇遇选项
	var 结果: Dictionary = 处理奇遇选项(奇遇, 选项索引, 弟子ID列表)
	# 标记为已处理
	item["已处理"] = true
	item["选择选项"] = 选项索引
	item["处理结果"] = 结果
	待处理列表[奇遇索引] = item
	实例["待处理奇遇"] = 待处理列表
	# 添加到奇遇记录
	var 奇遇记录: Array = 实例.get("奇遇记录", [])
	奇遇记录.append({
		"奇遇名称": str(奇遇.get("名称", "")),
		"选项名称": str(结果.get("选项名称", "")),
		"成功": bool(结果.get("成功", false)),
		"纪事": str(结果.get("纪事", "")),
		"处理日": (int(Game.get("累计游戏日")) if Game != null else 0)
	})
	实例["奇遇记录"] = 奇遇记录
	进行中历练[实例ID] = 实例
	return {
		"成功": true,
		"奇遇名称": str(奇遇.get("名称", "")),
		"选项名称": str(结果.get("选项名称", "")),
		"选择成功": bool(结果.get("成功", false)),
		"效果": 结果.get("效果", {}),
		"纪事": str(结果.get("纪事", ""))
	}

# 每日推演时触发所有进行中历练的奇遇
func 每日触发奇遇() -> void:
	for 实例ID in 进行中历练.keys():
		触发待处理奇遇(实例ID)

# ============ P0-1历练优化：历史记录系统 ============
# 添加历练记录（历练完成时调用）
# 回放保留条数：可回放（含 battle_log + 双方快照）的历练记录上限
const 回放保留条数: int = 20

func 添加历练记录(结果: Dictionary) -> void:
	var 记录: Dictionary = {
		"历练ID": str(结果.get("历练ID", "")),
		"关卡名称": str(结果.get("关卡名称", "")),
		"路线": str(结果.get("路线", "稳妥")),
		"开始日": int(结果.get("开始日", 0)),
		"结束日": (int(Game.get("累计游戏日")) if Game != null else 0),
		"成功": bool(结果.get("成功", false)),
		"评级": str(结果.get("评级", "")),
		"结局类型": str(结果.get("结局类型", "普通")),
		"奇遇次数": int(结果.get("奇遇次数", 0)),
		"奖励": 结果.get("奖励", {}),
		"弟子ID列表": 结果.get("弟子ID列表", []),
		# P0-3 战斗快播：回放数据（仅最近 回放保留条数 条保留，见下方裁剪）
		"攻方快照": 结果.get("攻方快照", []),
		"守方快照": 结果.get("守方快照", []),
		"原始战报": 结果.get("原始战报", {}),
	}
	历练历史记录.insert(0, 记录)
	# 最多保留100条
	if 历练历史记录.size() > 100:
		历练历史记录.resize(100)
	# 存档体积闸门：battle_log + 双方快照体积不小，仅最近 回放保留条数 条可回放。
	#   rationale：玩家「刚打完想复盘」的行为集中在最近几场，20 条足够覆盖；
	#   超出部分仍保留文字战绩（关卡/评级/奖励），只剥离回放数据，
	#   避免 100 条全量战报进存档拖慢移动端存读。
	for i in range(回放保留条数, 历练历史记录.size()):
		var 旧记录: Dictionary = 历练历史记录[i]
		旧记录.erase("原始战报")
		旧记录.erase("攻方快照")
		旧记录.erase("守方快照")

# 获取历练历史（UI用，支持分页）
func 获取历练历史(页码: int = 0, 每页: int = 20) -> Array:
	var 开始: int = 页码 * 每页
	var 结束: int = min(开始 + 每页, 历练历史记录.size())
	if 开始 >= 历练历史记录.size():
		return []
	var 结果: Array = []
	for i in range(开始, 结束):
		结果.append(历练历史记录[i])
	return 结果

# 获取历练统计
func 获取历练统计() -> Dictionary:
	var 总次数: int = 历练历史记录.size()
	var 成功次数: int = 0
	var 失败次数: int = 0
	var 完美次数: int = 0
	var 大捷次数: int = 0
	var 奇遇总次数: int = 0
	var 评级统计: Dictionary = {}
	var 路线统计: Dictionary = {}
	for 记录 in 历练历史记录:
		if bool(记录.get("成功", false)):
			成功次数 += 1
		else:
			失败次数 += 1
		var 结局: String = str(记录.get("结局类型", ""))
		if 结局 == "完美":
			完美次数 += 1
		elif 结局 == "大捷":
			大捷次数 += 1
		奇遇总次数 += int(记录.get("奇遇次数", 0))
		var 评级: String = str(记录.get("评级", ""))
		评级统计[评级] = int(评级统计.get(评级, 0)) + 1
		var 路线: String = str(记录.get("路线", "稳妥"))
		路线统计[路线] = int(路线统计.get(路线, 0)) + 1
	return {
		"总次数": 总次数,
		"成功次数": 成功次数,
		"失败次数": 失败次数,
		"成功率": float(成功次数) / float(max(1, 总次数)),
		"完美次数": 完美次数,
		"大捷次数": 大捷次数,
		"奇遇总次数": 奇遇总次数,
		"平均奇遇次数": float(奇遇总次数) / float(max(1, 总次数)),
		"评级统计": 评级统计,
		"路线统计": 路线统计,
	}

# 清除历练历史（玩家手动操作）
func 清除历练历史() -> void:
	历练历史记录.clear()
