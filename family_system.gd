## 设置家族策略
func 设置家族策略(家族ID: String, 策略类型: String, 策略值: String, 操作者: Disciple) -> Dictionary:
	if 家族ID == "" or 策略类型 == "" or 策略值 == "":
		return {"成功": false, "因": "参数无效"}
	if not _家族策略配置.has(策略类型):
		return {"成功": false, "因": "策略类型不存在"}
	if not _家族策略配置[策略类型].has(策略值):
		return {"成功": false, "因": "策略值不存在"}
	var 家族: Dictionary = 获取家族(家族ID)
	if 家族.is_empty():
		return {"成功": false, "因": "家族不存在"}
	var 职位权限: Dictionary = {"老祖": 10, "长老": 8, "核心": 6, "内门": 4, "外门": 2, "附庸": 1}
	if 操作者 == null or 操作者.家族ID != 家族ID or 职位权限.get(操作者.家族职位, 0) < 8:
		return {"成功": false, "因": "权限不足，只有老祖/长老才能设置家族策略"}
	if not 家族.has("家族策略"):
		家族["家族策略"] = {}
	家族["家族策略"][策略类型] = 策略值
	家族列表[家族ID] = 家族
	Game.添加纪事("家族策略", "策略变更", "「%s」%s变更为「%s」" % [str(家族.get("名", "")), 策略类型, 策略值], 1)
	return {"成功": true, "策略类型": 策略类型, "策略值": 策略值}

## 获取家族策略
func 获取家族策略(家族ID: String) -> Dictionary:
	if 家族ID == "" or not 家族列表.has(家族ID):
		return {"发展策略": "平衡", "外交策略": "友好", "资源策略": "平衡", "人才策略": "平衡", "战争策略": "自卫"}
	var 家族: Dictionary = 家族列表[家族ID]
	var 策略: Dictionary = 家族.get("家族策略", {})
	var 默认策略: Dictionary = {"发展策略": "平衡", "外交策略": "友好", "资源策略": "平衡", "人才策略": "平衡", "战争策略": "自卫"}
	for 策略类型 in 默认策略.keys():
		if not 策略.has(策略类型):
			策略[策略类型] = 默认策略[策略类型]
	return 策略

## 家族AI托管执行（根据策略自动管理家族）
func 家族AI托管执行(家族ID: String) -> Dictionary:
	if 家族ID == "" or not 家族列表.has(家族ID):
		return {"成功": false, "因": "家族不存在"}
	var 家族: Dictionary = 家族列表[家族ID]
	var 策略: Dictionary = 获取家族策略(家族ID)
	var 执行记录: Array = []
	# 1. 自动升级家族（根据发展策略）
	var 发展策略: String = str(策略.get("发展策略", "平衡"))
	var 升级权重: float = float(_家族策略配置["发展策略"][发展策略].get("升级权重", 0.5))
	if randf() < 升级权重 and int(家族.get("等级", 1)) < 5:
		var 贡献池: int = int(家族.get("贡献池", 0))
		var 升级消耗: int = int(家族.get("等级", 1)) * 100
		if 贡献池 >= 升级消耗:
			家族["贡献池"] = 贡献池 - 升级消耗
			家族["等级"] = int(家族.get("等级", 1)) + 1
			执行记录.append("自动升级家族到%d级" % 家族["等级"])
	# 2. 自动争夺资源点（根据战争策略）
	var 战争策略: String = str(策略.get("战争策略", "自卫"))
	var 争夺权重: float = float(_家族策略配置["战争策略"][战争策略].get("争夺权重", 0.3))
	if randf() < 争夺权重:
		var 资源点列表: Array = Game.获取资源点占领状态()
		for 资源点 in 资源点列表:
			if str(资源点.get("占领家族ID", "")) == "" and randf() < 0.3:
				var 核心弟子: Object = null
				for 成员ID in 家族.get("成员列表", []):
					var d: Object = Game._取弟子(成员ID)
					if d != null and d is Disciple and d.状态 == "在宗" and (d.家族职位 == "核心" or d.家族职位 == "长老" or d.家族职位 == "老祖"):
						核心弟子 = d
						break
				if 核心弟子 != null:
					var 结果: Dictionary = Game.争夺资源点(家族ID, str(资源点.get("资源点ID", "")), 核心弟子)
					if 结果.get("成功", false) and 结果.get("结果", "") == "争夺成功":
						执行记录.append("自动争夺资源点「%s」成功" % str(资源点.get("名", "")))
				break
	# 3. 自动装备家族秘宝给最强弟子
	var 秘宝列表: Array = 家族.get("家族秘宝", [])
	if not 秘宝列表.is_empty():
		var 最强弟子: Object = null
		var 最高战力: int = 0
		for 成员ID in 家族.get("成员列表", []):
			var d: Object = Game._取弟子(成员ID)
			if d != null and d is Disciple and d.状态 == "在宗":
				var 战力: int = d.计算战力()
				if 战力 > 最高战力:
					最高战力 = 战力
					最强弟子 = d
		if 最强弟子 != null and 最强弟子.家族秘宝 == "":
			最强弟子.家族秘宝 = 秘宝列表[0]
			执行记录.append("自动装备秘宝给%s" % 最强弟子.姓名)
	# 4. 自动学习血脉功法给有潜力弟子
	var 血脉功法: String = str(家族.get("血脉功法", ""))
	if 血脉功法 != "":
		for 成员ID in 家族.get("成员列表", []):
			var d: Object = Game._取弟子(成员ID)
			if d != null and d is Disciple and d.状态 == "在宗" and not 血脉功法 in d.血脉功法列表:
				if d.资质 >= 3 and randf() < 0.5:
					d.血脉功法列表.append(血脉功法)
					执行记录.append("自动学习血脉功法给%s" % d.姓名)
					break
	家族列表[家族ID] = 家族
	return {"成功": true, "执行记录": 执行记录, "策略": 策略}

## 月度家族结算（资源点产出+声望变化+事件随机触发+AI托管）
func 月度家族结算() -> Dictionary:
	var 结算记录: Array = []
	var 总产出: Dictionary = {"灵石": 0, "灵草": 0, "矿石": 0}
	# 1. 资源点产出结算
	for 家族ID in 家族列表.keys():
		var 家族: Dictionary = 家族列表[家族ID]
		var 家族产出: Dictionary = {"灵石": 0, "灵草": 0, "矿石": 0}
		for 资源点ID in Game._资源点配置.keys():
			if str(Game._资源点占领.get(资源点ID, "")) == 家族ID:
				var 资源点: Dictionary = Game._资源点配置[资源点ID]
				var 类型: String = str(资源点.get("类型", ""))
				var 产出: int = int(资源点.get("产出", 0))
				if 类型 == "灵石":
					家族产出["灵石"] += 产出
				elif 类型 == "灵草":
					家族产出["灵草"] += 产出
				elif 类型 == "矿石":
					家族产出["矿石"] += 产出
		if not 家族.has("家族宝库"):
			家族["家族宝库"] = {}
		for 资源类型 in 家族产出.keys():
			if 家族产出[资源类型] > 0:
				家族["家族宝库"][资源类型] = int(家族["家族宝库"].get(资源类型, 0)) + 家族产出[资源类型]
				总产出[资源类型] += 家族产出[资源类型]
		家族列表[家族ID] = 家族
	# 2. 家族声望自然变化
	for 家族ID in 家族列表.keys():
		var 家族: Dictionary = 家族列表[家族ID]
		var 评分: int = 计算家族实力评分(家族ID).get("评分", 0)
		var 声望变化: int = 0
		if 评分 > 200:
			声望变化 = 5
		elif 评分 > 100:
			声望变化 = 2
		elif 评分 < 50:
			声望变化 = -1
		if 声望变化 != 0:
			家族["家族声望"] = max(0, int(家族.get("家族声望", 0)) + 声望变化)
			家族列表[家族ID] = 家族
	# 3. 家族事件随机触发（每月10%概率）
	if randf() < 0.1 and not 家族列表.is_empty():
		var 随机家族ID: String = 家族列表.keys()[randi() % 家族列表.size()]
		var 随机事件类型: Array = ["family_genius", "family_crisis", "family_treasure", "family_breakthrough"]
		var 事件类型: String = 随机事件类型[randi() % 随机事件类型.size()]
		触发家族事件(随机家族ID, 事件类型)
		结算记录.append("随机触发家族事件：%s" % 事件类型)
	# 4. AI托管执行（所有家族每月自动执行一次）
	for 家族ID in 家族列表.keys():
		var AI结果: Dictionary = 家族AI托管执行(家族ID)
		if AI结果.get("成功", false) and not AI结果.get("执行记录", []).is_empty():
			结算记录.append("家族「%s」AI托管：%s" % [str(家族列表[家族ID].get("名", "")), "；".join(AI结果.get("执行记录", []))])
	# 5. AI外交自动执行
	for 家族ID in 家族列表.keys():
		var 外交结果: Dictionary = AI外交自动执行(家族ID)

	return {"成功": true, "总产出": 总产出, "结算记录": 结算记录}
func 家族战争自动结算() -> Dictionary:
	var 战争记录: Array = []
	for 家族ID in 家族列表.keys():
		var 家族: Dictionary = 家族列表[家族ID]
		var 敌对列表: Array = 家族.get("敌对家族", [])
		for 敌对 in 敌对列表:
			var 敌对ID: String = str(敌对.get("家族ID", ""))
			if 敌对ID > 家族ID and 家族列表.has(敌对ID):
				var 敌对家族: Dictionary = 家族列表[敌对ID]
				var 家族评分: int = 计算家族实力评分(家族ID).get("评分", 0)
				var 敌对评分: int = 计算家族实力评分(敌对ID).get("评分", 0)
				if randf() < 0.1:
					var 胜率: float = 0.5 + clamp((家族评分 - 敌对评分) / 200.0, -0.3, 0.3)
					if randf() < 胜率:
						var 掠夺灵石: int = min(100, int(敌对家族.get("家族宝库", {}).get("灵石", 0)))
						if 掠夺灵石 > 0:
							敌对家族["家族宝库"]["灵石"] = int(敌对家族["家族宝库"].get("灵石", 0)) - 掠夺灵石
							家族["家族宝库"]["灵石"] = int(家族.get("家族宝库", {}).get("灵石", 0)) + 掠夺灵石
						战争记录.append("「%s」击败「%s」，掠夺灵石%d" % [str(家族.get("名", "")), str(敌对家族.get("名", "")), 掠夺灵石])
					else:
						var 掠夺灵石: int = min(100, int(家族.get("家族宝库", {}).get("灵石", 0)))
						if 掠夺灵石 > 0:
							家族["家族宝库"]["灵石"] = int(家族.get("家族宝库", {}).get("灵石", 0)) - 掠夺灵石
							敌对家族["家族宝库"]["灵石"] = int(敌对家族.get("家族宝库", {}).get("灵石", 0)) + 掠夺灵石
						战争记录.append("「%s」击败「%s」，掠夺灵石%d" % [str(敌对家族.get("名", "")), str(家族.get("名", "")), 掠夺灵石])
					家族列表[家族ID] = 家族
					家族列表[敌对ID] = 敌对家族
	return {"成功": true, "战争记录": 战争记录}

