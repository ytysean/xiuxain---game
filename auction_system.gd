func _检查特殊事件_S34() -> void:
	if 拍卖会.get("当前事件", "") != "":
		return  # 已有事件进行中
	for evt in _特殊事件库:
		if randf() < float(evt.get("概率", 0.01)):
			拍卖会["当前事件"] = str(evt.get("id", ""))
			拍卖会["事件名称"] = str(evt.get("名称", ""))
			拍卖会["事件描述"] = str(evt.get("描述", ""))
			拍卖会["事件剩余日"] = 7
			# 生成事件拍品
			var 拍品数: int = int(evt.get("拍品数", 3))
			for i in range(拍品数):
				var lot: Dictionary = _生成单个拍品_S34("常驻")
				lot["事件"] = str(evt.get("id", ""))
				var _常驻: Array = 拍卖会.get("常驻拍品", [])
				_常驻.append(lot)
				拍卖会["常驻拍品"] = _常驻
			# Game.添加纪事
			Game.添加纪事("拍卖行", "【特殊事件】%s" % str(evt.get("名称", "")), str(evt.get("描述", "")))
			return

## 特殊事件月度推进（减少剩余天数，结束时清除）
func _推进特殊事件_S34() -> void:
	var 剩余: int = int(拍卖会.get("事件剩余日", 0))
	if 剩余 > 0:
		剩余 -= 1
		拍卖会["事件剩余日"] = 剩余
