## 获取灵田地块数量（按等级）
static func 获取地块数(灵田等级: int) -> int:
	return 3 + max(0, 灵田等级 - 1)  # 1级3块，每升1级+1块

## 初始化灵田数据（如果不存在）
static func 初始化(灵田等级: int) -> Array:
	var 地块数 = 获取地块数(灵田等级)
	var 地块: Array = []
	for i in range(地块数):
		地块.append({"索引": i, "状态": "空闲", "种植ID": "", "种植时间": 0, "成熟时间": 0})
	return 地块

## 检查地块是否成熟
static func 是否成熟(地块: Dictionary, 当前天: int) -> bool:
	if str(地块.get("状态", "")) != "种植中":
		return false
	return 当前天 >= int(地块.get("成熟时间", 0))

## 种植灵材
## 返回：{成功, 原因}
static func 种植(地块列表: Array, 地块索引: int, 灵材ID: String, 当前天: int, 灵田等级: int) -> Dictionary:
	if 地块索引 < 0 or 地块索引 >= 地块列表.size():
		return {"成功": false, "原因": "地块不存在"}
	var 地块 = 地块列表[地块索引]
	if str(地块.get("状态", "")) != "空闲":
		return {"成功": false, "原因": "该地块已在种植中"}
	var 灵材 = 灵材库.get(灵材ID, {})
	if 灵材.is_empty():
		return {"成功": false, "原因": "未知灵材"}
	var 成熟天数 = int(灵材.get("成熟天数", 1))
	地块["状态"] = "种植中"
	地块["种植ID"] = 灵材ID
	地块["种植时间"] = 当前天
	地块["成熟时间"] = 当前天 + 成熟天数
	return {"成功": true, "原因": "已种植%s，%d天后成熟" % [str(灵材.get("名称","")), 成熟天数]}

## 收获灵材
## 返回：{成功, 产出物品(Item/null), 数量, 原因}
static func 收获(地块列表: Array, 地块索引: int, 当前天: int, 灵田等级: int) -> Dictionary:
	if 地块索引 < 0 or 地块索引 >= 地块列表.size():
		return {"成功": false, "产出": null, "数量": 0, "原因": "地块不存在"}
	var 地块 = 地块列表[地块索引]
	if str(地块.get("状态", "")) != "种植中":
		return {"成功": false, "产出": null, "数量": 0, "原因": "该地块未在种植"}
	if not 是否成熟(地块, 当前天):
		var 剩余 = int(地块.get("成熟时间", 0)) - 当前天
		return {"成功": false, "产出": null, "数量": 0, "原因": "尚未成熟，还需%d天" % 剩余}
	var 灵材ID = str(地块.get("种植ID", ""))
	var 灵材 = 灵材库.get(灵材ID, {})
	if 灵材.is_empty():
		return {"成功": false, "产出": null, "数量": 0, "原因": "未知灵材"}
	# 计算产量：基础产量 + 灵田等级加成（每级+10%）
	var 基础产量 = int(灵材.get("基础产量", 1))
	var 产量加成 = 1.0 + float(max(0, 灵田等级 - 1)) * 0.1
	var 实际产量 = max(1, int(round(float(基础产量) * 产量加成)))
	# 创建物品
	var 新品 = Item.new()
	新品.类别 = "ling_cai"
	新品.品阶 = str(灵材.get("品阶", "凡阶"))
	新品.名称 = str(灵材.get("名称", ""))
	新品.功效 = "灵田产出的%s" % 新品.名称
	新品.描述 = str(灵材.get("名称", ""))
	新品.战力加成 = 0
	新品.算战力()
	# 重置地块
	地块["状态"] = "空闲"
	地块["种植ID"] = ""
	地块["种植时间"] = 0
	地块["成熟时间"] = 0
	return {"成功": true, "产出": 新品, "数量": 实际产量, "原因": "收获%s×%d" % [新品.名称, 实际产量]}
