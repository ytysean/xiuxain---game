## 获取弟子功绩等级
static func 获取功绩等级(总功绩: int) -> Dictionary:
	for i in range(功绩等级.size() - 1, -1, -1):
		if 总功绩 >= int(功绩等级[i].get("下限", 0)):
			return 功绩等级[i]
	return 功绩等级[0]

## 获取弟子可用权限
static func 获取权限(总功绩: int) -> Array:
	var 等级 = 获取功绩等级(总功绩)
	return 等级.get("权限", ["基础兑换"])

## 检查弟子是否有权限兑换商品
static func 检查权限(总功绩: int, 商品权限: String) -> bool:
	var 权限列表 = 获取权限(总功绩)
	if "全部权限" in 权限列表 or "全部兑换" in 权限列表:
		return true
	return 商品权限 in 权限列表

## 兑换商品
static func 兑换(商品ID: String, 弟子总功绩: int = 0) -> Dictionary:
	var 商品 = {}
	for g in 兑换商品:
		if str(g.get("ID", "")) == 商品ID:
			商品 = g
			break
	if 商品.is_empty():
		return {"成功": false, "原因": "商品不存在"}
	# 检查权限
	var 商品权限 = str(商品.get("权限", "基础兑换"))
	if 弟子总功绩 > 0 and not 检查权限(弟子总功绩, 商品权限):
		return {"成功": false, "原因": "权限不足"}
	var 消耗 = int(商品.get("消耗贡献", 0))
	if Game == null or Game.贡献点 < 消耗:
		return {"成功": false, "原因": "贡献点不足（需%d）" % 消耗}
	Game.贡献点 -= 消耗
	# 发放奖励
	var 类型 = str(商品.get("类型", ""))
	var 数量 = int(商品.get("数量", 1))
	if 类型 == "灵石":
		Game.灵石 += 数量
	elif 类型 == "悟道点":
		Game.悟道点 += 数量
	elif 类型 == "灵材":
		if Game.宗门库房 != null:
			# S25：库房统一装 Item（原塞裸 Dictionary，存档 to_dict() 会崩）；Item 无数量字段 → 按数量逐件入库
			for n in range(数量):
				var 新品: Item = Item.new()
				新品.名称 = str(商品.get("名称", "灵材"))
				新品.类别 = "灵材"
				新品.品阶 = str(商品.get("品阶", "凡阶"))
				Game.宗门库房.append(新品)
	elif 类型 == "丹药":
		if Game.宗门库房 != null:
			for n in range(数量):
				var 新品: Item = Item.new()
				新品.名称 = str(商品.get("名称", "丹药"))
				新品.类别 = "丹药"
				新品.品阶 = str(商品.get("品阶", "凡阶"))
				Game.宗门库房.append(新品)
	return {"成功": true, "原因": "兑换成功：%s" % str(商品.get("名称", ""))}

## 记录功绩
static func 记录功绩(弟子, 类型名: String, 功绩值: int) -> int:
	if 弟子 == null:
		return 0
	# 获取功绩类型加成
	var 类型信息 = 功绩类型.get(类型名, {"基础值": 10, "加成系数": 1.0})
	var 基础值 = int(类型信息.get("基础值", 10))
	var 加成系数 = float(类型信息.get("加成系数", 1.0))
	# 计算实际功绩值
	var 实际值 = int(max(1, 功绩值) * 加成系数)
	if Game != null:
		Game.贡献点 += 实际值
		# 记录到弟子履历
		if "履历" in 弟子 and 弟子.履历 != null:
			弟子.履历.append({"日": Game.累计游戏日 if Game != null else 0, "事件": "功绩：%s" % 类型名, "详情": "获得贡献点%d" % 实际值})
		# 记录弟子总功绩
		if not "总功绩" in 弟子:
			弟子["总功绩"] = 0
		弟子.总功绩 = int(弟子.get("总功绩", 0)) + 实际值
	return 实际值

## 获取功绩排行榜
static func 获取排行榜(弟子列表: Array, 数量: int = 10) -> Array:
	var 排行: Array = []
	for 弟子 in 弟子列表:
		if 弟子 == null:
			continue
		var 总功绩 = int(弟子.get("总功绩", 0))
		排行.append({"弟子": 弟子, "总功绩": 总功绩, "姓名": str(弟子.get("姓名", "未知")), "等级": 获取功绩等级(总功绩).get("名", "")})
	# 按总功绩降序排序
	排行.sort_custom(func(x, y): return x["总功绩"] > y["总功绩"])
	return 排行.slice(0, min(数量, 排行.size()))
