# 阵法组合效果配置
const 阵法组合效果配置: Dictionary = {
	"攻防一体": {"阵法": ["攻击阵", "防御阵"], "效果": "攻击+10%，防御+10%", "攻击加成": 0.1, "防御加成": 0.1},
