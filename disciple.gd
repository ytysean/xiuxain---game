## 获取对某对象的记忆
func 获取对象记忆(对象ID: String) -> Array:
	var 结果: Array = []
	for 记忆 in 记忆列表:
		if str(记忆.get("对象ID", "")) == 对象ID:
			结果.append(记忆)
	return 结果

## 获取对某对象的总体印象
func 获取对象印象(对象ID: String) -> String:
	var 正面: int = 0
	var 负面: int = 0
	for 记忆 in 记忆列表:
		if str(记忆.get("对象ID", "")) == 对象ID:
			match str(记忆.get("类型", "")):
				"正面": 正面 += 1
				"负面": 负面 += 1
	if 正面 > 负面 * 2: return "非常好"
	elif 正面 > 负面: return "较好"
	elif 负面 > 正面 * 2: return "非常差"
	elif 负面 > 正面: return "较差"
	else: return "一般"
func 总战力() -> int:
	# 对齐 ADR-001 §4.2：仅计已穿戴装备，走乘性公式
	return 计算战力()

# ============ 战力结算（ADR-001 D3，§4.2 乘性公式）============
func 计算战力() -> int:
	var base: float = float(境界表[境界]["战力"])
	# 已穿戴装备的 flat 基础（§4.7：基础战力表[品阶] + 极品 flat，并入 base 前；仅已穿戴）
	for it in 装备.values():
		base += float(it.装备基础战力())
	# S45-5 符词条·战力：佩戴护身符的「战力」类词条（加法增量，不进 ADR-001 §4.2 乘性主体）
	if Game != null and Game.has_method("护身符战力加成"):
		base += float(Game.护身符战力加成(self))
	var 资质系数: float = _取资质系数()
	var 灵根系数: float = _取灵根系数()
	var 道途系数: float = _取道途综合系数()
	var 通用增益: float = 聚合通用增益()        # 已穿戴词缀%（装备单源子帽≤8%，全局软25/硬30）
	var 道心增益: float = 0.0
	# 道心系统接入战力：每100点道心+1%战力，上限10%
	if 道心 > 0:
		道心增益 = min(0.10, float(道心) / 10000.0)
	# §6.16 血脉共鸣战力加成：有血缘关系的弟子同时在宗时，单源子帽≤1.5%（全局等效）
	var 血脉共鸣增益: float = 0.0
	if Game != null and Game.has_method("血脉共鸣战力加成"):
		血脉共鸣增益 = Game.血脉共鸣战力加成(self)
	# §6.16 血脉加成：血脉觉醒后提供修炼/战力/突破加成，单源子帽≤1.5%
	var 血脉增益: float = 0.0
	if Game != null and Game.has_method("计算血脉加成"):
		var 血脉加: Dictionary = Game.计算血脉加成(self)
		血脉增益 = float(血脉加.get("战力加成", 0.0))
	# §6.16 家族功法叠加：同一家族功法同时修炼有叠加效果，单源子帽≤1%
	var 家族功法增益: float = 0.0
	if Game != null and Game.has_method("计算家族功法叠加"):
		var 家族加: Dictionary = Game.计算家族功法叠加(self)
		家族功法增益 = float(家族加.get("战力加成", 0.0))
	# §6.16 家族秘宝：祖传仙器/镇族之宝，单源子帽≤1%
	var 家族秘宝增益: float = 0.0
	if Game != null and Game.has_method("计算家族秘宝加成"):
		var 秘宝加: Dictionary = Game.计算家族秘宝加成(self)
		家族秘宝增益 = float(秘宝加.get("战力加成", 0.0))
	# §6.16 血脉功法：只有特定血脉能修炼，单源子帽≤1.5%
	var 血脉功法增益: float = 0.0
	if Game != null and Game.has_method("计算血脉功法加成"):
		var 血脉功法加: Dictionary = Game.计算血脉功法加成(self)
		血脉功法增益 = float(血脉功法加.get("战力加成", 0.0))
	# §6.16 家族阵法：家族护山大阵，单源子帽≤1%
	var 家族阵法增益: float = 0.0
	if Game != null and Game.has_method("计算家族阵法加成"):
		var 阵法加: Dictionary = Game.计算家族阵法加成(self)
		家族阵法增益 = float(阵法加.get("战力加成", 0.0))
	# §6.16 家族社交：联盟+联姻加成，单源子帽≤1%
	var 家族社交增益: float = 0.0
	if Game != null and Game.has_method("计算家族社交加成"):
		var 社交加: Dictionary = Game.计算家族社交加成(self)
		家族社交增益 = float(社交加.get("战力加成", 0.0))
	# 宗主称号全宗战力加成
	var 宗主战力增益: float = 0.0
	if Game != null and Game.has_method("获取宗主称号加成"):
		宗主战力增益 = Game.获取宗主称号加成("全宗战力")
	# 弟子个人称号战力加成
	var 个人称号战力增益: float = 0.0
	if Game != null and Game.has_method("获取称号加成"):
		个人称号战力增益 = Game.获取称号加成(self, "战力")
	# 特殊体质战力加成
	var 体质战力增益: float = 体质战力加成()
	# 高阶修士战力加成（神魂+法相+领域）
	var 高阶战力增益: float = 高阶战力加成()
	var 主体: int = int(base * 资质系数 * 灵根系数 * 道途系数 * (1.0 + 通用增益) * (1.0 + 道心增益) * (1.0 + 血脉共鸣增益) * (1.0 + 血脉增益) * (1.0 + 家族功法增益) * (1.0 + 家族秘宝增益) * (1.0 + 血脉功法增益) * (1.0 + 家族阵法增益) * (1.0 + 家族社交增益) * (1.0 + 宗主战力增益) * (1.0 + 个人称号战力增益) * (1.0 + 体质战力增益) * (1.0 + 高阶战力增益) * (1.0 + 套装增益()))
	var 灵兽加成: int = 灵兽契约战力()
	return max(0, 主体 + 灵兽加成)       # UX 边缘情况⑤：下限夹 0

# 套装增益计算：统计已穿戴装备中各套装数量，激活对应效果
# P0-3：使用equip_set.csv配置，支持2件套/4件套效果
func 套装增益() -> float:
	# P0-3：优先使用equip_set.csv配置
	if ForgeSystem != null and ForgeSystem.has_method("计算套装战力加成"):
		var 套装结果: Dictionary = ForgeSystem.计算套装战力加成(装备)
		var 战力加成: int = int(套装结果.get("战力加成", 0))
		if 战力加成 > 0:
			# 转换为百分比增益（战力加成 / 境界基础战力）
			var 基础战力: float = float(境界表[境界]["战力"])
			if 基础战力 > 0:
				return float(战力加成) / 基础战力
	# 回退：使用硬编码的Item.套装库（旧版兼容）
	var 套装计数: Dictionary = {}
	for it in 装备.values():
		if it == null or not it.has_method("get"):
			continue
		var sid = str(it.套装ID)
		if sid == "":
			continue
		套装计数[sid] = 套装计数.get(sid, 0) + 1
	var 总增益: float = 0.0
	for sid in 套装计数.keys():
		var 数量 = 套装计数[sid]
		var 套装配置 = Item.套装库.get(sid, {})
		if 套装配置.is_empty():
			continue
		# 简化：套装效果按百分比增益，2件+3%，3件+5%，5件+10%
		if 数量 >= 5:
			总增益 += 0.10
		elif 数量 >= 3:
			总增益 += 0.05
		elif 数量 >= 2:
			总增益 += 0.03
	return 总增益

# S2 build轴·套装实战加成：读取 Item.套装库 真实 2/3/5件效果，按各套装已达最高档位取该档加成，跨套装累加。
# 战斗维度（% 小数）：攻/防/血/速/暴击/反伤/穿透/减伤/吸血/闪避；修炼速度/寿命/突破率等非战斗维度忽略。
# 支持单条多维度（如「攻击+14% 吸血+10%」按空格拆分逐段解析）。
func 套装战斗加成() -> Dictionary:
	var 合计: Dictionary = {"攻": 0.0, "防": 0.0, "血": 0.0, "速": 0.0, "暴击": 0.0, "反伤": 0.0, "穿透": 0.0, "减伤": 0.0, "吸血": 0.0, "闪避": 0.0}
	var 套装计数: Dictionary = {}
	for it in 装备.values():
		if it == null or not it.has_method("get"):
			continue
		var sid = str(it.套装ID)
		if sid == "":
			continue
		套装计数[sid] = 套装计数.get(sid, 0) + 1
	var 触发共鸣: bool = false
	for sid in 套装计数.keys():
		var 数量 = 套装计数[sid]
		var 配置 = Item.套装库.get(sid, {})
		if 配置.is_empty():
			continue
		var 档位键: String = ""
		if 数量 >= 5:
			档位键 = "5件"
			触发共鸣 = true
		elif 数量 >= 3:
			档位键 = "3件"
		elif 数量 >= 2:
			档位键 = "2件"
		if 档位键 == "":
			continue
		_解析套装效果(配置.get(档位键, ""), 合计)
	# S2 增强·五件同套共鸣：达成任一整套(5件) → 全属性(攻防血速)+10%，独立于单套5件效果叠加
	if 触发共鸣:
		for _st in ["攻", "防", "血", "速"]:
			合计[_st] += 0.10
	return 合计

# 解析单条套装效果文案 → 累加进 合计。支持多维度（按空格/、/， 拆分逐段独立解析）。
func _解析套装效果(文案: String, 合计: Dictionary) -> void:
	if 文案 == "":
		return
	var 段列表: Array = 文案.replace("，", " ").replace("、", " ").split(" ", false)
	for 段 in 段列表:
		_解析单段(段, 合计)

func _解析单段(段: String, 合计: Dictionary) -> void:
	var 数文: String = 段.replace("+", "").replace("%", "")
	for 词 in ["攻击", "防御", "全属性", "暴击", "反伤", "穿透", "减伤", "吸血", "闪避", "速度", "气血", "血"]:
		数文 = 数文.replace(词, "")
	var 数: float = 数文.strip_edges().to_float() / 100.0
	if 数 <= 0.0:
		return
	if "全属性" in 段:
		for _st in ["攻", "防", "血", "速"]:
			合计[_st] += 数
	elif "攻击" in 段:
		合计["攻"] += 数
	elif "防御" in 段:
		合计["防"] += 数
	elif "暴击" in 段:
		合计["暴击"] += 数
	elif "反伤" in 段:
		合计["反伤"] += 数
	elif "穿透" in 段:
		合计["穿透"] += 数
	elif "减伤" in 段:
		合计["减伤"] += 数
	elif "吸血" in 段:
		合计["吸血"] += 数
	elif "闪避" in 段:
		合计["闪避"] += 数
	elif "速度" in 段:
		合计["速"] += 数
	elif "气血" in 段 or "血" in 段:
		合计["血"] += 数
	# 其余（修炼速度/寿命/突破成功率）→ 非战斗维度，忽略

# S2 build轴·套装特效：读取 Item.套装库 的 "X技能" 键（X=已达档位 2/3/5），
# 将对应 set_xxx 技能注入战斗快照「技能」数组 → 激活 BattleCalculator 增强引擎（控制/灼烧/护盾/回春/破甲/增益/疾行）。
# 无特效套装返回空数组 → 战斗走原版路径（零风险）。
func 套装技能() -> Array:
	var 技能列表: Array = []
	var 套装计数: Dictionary = {}
	for it in 装备.values():
		if it == null or not it.has_method("get"):
			continue
		var sid = str(it.套装ID)
		if sid == "":
			continue
		套装计数[sid] = 套装计数.get(sid, 0) + 1
	for sid in 套装计数.keys():
		var 数量 = 套装计数[sid]
		var 配置 = Item.套装库.get(sid, {})
		if 配置.is_empty():
			continue
		var 技能键列表: Array = []
		if 数量 >= 5:
			for _k in ["5技能", "5技能2", "5技能3"]:
				if 配置.has(_k):
					技能键列表.append(_k)
		elif 数量 >= 3:
			for _k in ["3技能", "3技能2"]:
				if 配置.has(_k):
					技能键列表.append(_k)
		elif 数量 >= 2:
			for _k in ["2技能", "2技能2"]:
				if 配置.has(_k):
					技能键列表.append(_k)
		if 技能键列表.is_empty():
			continue
		for _sk in 技能键列表:
			技能列表.append(_构造套装技能(str(配置[_sk])))
	return 技能列表

# S2 毕业·全品类毕业技能汇总：聚合 套装 + 功法(无上) + 神器/奇物 + 灵宠(专属契约技) 四源
func 战斗技能汇总() -> Array:
	var 列表: Array = []
	列表.append_array(套装技能())
	列表.append_array(功法毕业技能())
	列表.append_array(已修功法技能())  # S1 批3：skill_cultivation 已修功法主动技能
	列表.append_array(神器奇物技能())
	列表.append_array(灵宠毕业技能())
	return 列表

# 已修功法主动技能（skill_cultivation.csv）
# 将已修功法转换为战斗引擎可识别的技能字典
# 同时读取 弟子.已修功法 和 Game.弟子技能字典（藏经阁兑换的技能存在这里）
func 已修功法技能() -> Array:
	var 列表: Array = []
	# 1. 弟子.已修功法（skill_id字符串列表）
	for gid in 已修功法:
		var g: Dictionary = SkillCultivationLoader.get_skill(gid)
		if g.is_empty():
			continue
		列表.append(_构造功法技能字典(gid, g))
	# 2. Game.弟子技能字典（藏经阁兑换的技能，完整字典列表）
	if Game != null and Game.弟子技能字典 != null:
		var 弟子技能: Array = Game.弟子技能字典.get(弟子ID, [])
		for sk in 弟子技能:
			if typeof(sk) != TYPE_DICTIONARY:
				continue
			var skill_id: String = str(sk.get("skill_id", ""))
			# 避免重复
			var 已存在: bool = false
			for existing in 列表:
				if str(existing.get("skill_id", "")) == skill_id:
					已存在 = true
					break
			if 已存在:
				continue
			列表.append(_构造功法技能字典(skill_id, sk))
	return 列表

# 合并已修功法列表（弟子.已修功法 + Game.弟子技能字典中的skill_id）
func _合并已修功法列表() -> Array:
	var 合并: Array = []
	for gid in 已修功法:
		if not 合并.has(gid):
			合并.append(gid)
	if Game != null and Game.弟子技能字典 != null:
		var 弟子技能: Array = Game.弟子技能字典.get(弟子ID, [])
		for sk in 弟子技能:
			if typeof(sk) == TYPE_DICTIONARY:
				var sid: String = str(sk.get("skill_id", ""))
				if sid != "" and not 合并.has(sid):
					合并.append(sid)
	return 合并

# 构造功法技能字典（统一转换逻辑）
func _构造功法技能字典(skill_id: String, g: Dictionary) -> Dictionary:
	var skill_type: String = str(g.get("skill_type", "通用"))
	var effect_value: String = str(g.get("effect_value", "2%")).replace("%", "")
	var dmg_rate: float = 1.0
	var effect_type: String = "伤害"
	var cd: int = 3
	match skill_type:
		"攻击":
			effect_type = "伤害"
			dmg_rate = 1.0 + effect_value.to_float() / 100.0
			cd = 2
		"控制":
			effect_type = "控制"
			dmg_rate = 1.0
			cd = 4
		"辅助防御":
			effect_type = "护盾"
			dmg_rate = 0.5
			cd = 3
		_:
			effect_type = "增益"
			dmg_rate = 1.0
			cd = 3
	return {
		"skill_id": skill_id,
		"skill_name": str(g.get("skill_name", skill_id)),
		"skill_type": skill_type,
		"effect_type": effect_type,
		"damage_rate": dmg_rate,
		"mp_cost": 0,
		"cooldown": cd
	}

# 无上功法特殊技能（GongFaSystem.功法库 中带 特殊技能 的条目，经 已学功法 注入）
func 功法毕业技能() -> Array:
	var 列表: Array = []
	for gid in 已学功法:
		var g: Dictionary = GongFaSystem.功法库.get(gid, {})
		if g.is_empty() or not g.has("特殊技能"):
			continue
		列表.append(_构造套装技能(str(g["特殊技能"])))
	return 列表

# 神器(独一无二) / 奇物(变异小极品) 附带技能
func 神器奇物技能() -> Array:
	var 列表: Array = []
	for it in 装备.values():
		if it == null:
			continue
		if it.独一无二 and it.神器技能 != "":
			列表.append(_构造套装技能(it.神器技能))
			if it.神器技能2 != "":
				列表.append(_构造套装技能(it.神器技能2))
		elif it.奇物 and it.奇物技能 != "":
			列表.append(_构造套装技能(it.奇物技能))
	return 列表

# 灵宠专属契约技（始祖完美血脉 / 超道阶源初神兽，经 主宠/副宠 注入）
func 灵宠毕业技能() -> Array:
	var 列表: Array = []
	for b in [主宠灵兽, 副宠灵兽]:
		if b == null:
			continue
		for k in b.专属契约技():
			列表.append(_构造套装技能(k))
	return 列表

# set_xxx → 增强引擎技能字典（damage_rate=1.0 → 既造成伤害又施加特效，避免「只放技能不普攻」导致零输出）。
# mp_cost=0 / cooldown 适中 → 每隔数回合触发一次，与普攻交替。
func _构造套装技能(sk_id: String) -> Dictionary:
	match sk_id:
		"set_freeze": return {"skill_id": "set_freeze", "skill_name": "玄冰封", "skill_type": "控制", "effect_type": "控制", "damage_rate": 1.0, "mp_cost": 0, "cooldown": 3}
		"set_stun": return {"skill_id": "set_stun", "skill_name": "震魂击", "skill_type": "控制", "effect_type": "控制", "damage_rate": 1.0, "mp_cost": 0, "cooldown": 4}
		"set_burn": return {"skill_id": "set_burn", "skill_name": "业火焚", "skill_type": "灼烧", "effect_type": "灼烧", "damage_rate": 1.0, "mp_cost": 0, "cooldown": 3}
		"set_defdown": return {"skill_id": "set_defdown", "skill_name": "破甲击", "skill_type": "破甲", "effect_type": "破甲", "damage_rate": 1.0, "mp_cost": 0, "cooldown": 3}
		"set_shield": return {"skill_id": "set_shield", "skill_name": "太虚护", "skill_type": "护盾", "effect_type": "护盾", "damage_rate": 1.0, "mp_cost": 0, "cooldown": 4}
		"set_regen": return {"skill_id": "set_regen", "skill_name": "青木回春", "skill_type": "回春", "effect_type": "回春", "damage_rate": 1.0, "mp_cost": 0, "cooldown": 3}
		"set_atkup": return {"skill_id": "set_atkup", "skill_name": "战意勃发", "skill_type": "增益", "effect_type": "增伤", "damage_rate": 1.0, "mp_cost": 0, "cooldown": 3}
		"set_defup": return {"skill_id": "set_defup", "skill_name": "金钟罩", "skill_type": "增益", "effect_type": "减伤", "damage_rate": 1.0, "mp_cost": 0, "cooldown": 3}
		"set_spdup": return {"skill_id": "set_spdup", "skill_name": "疾风步", "skill_type": "增益", "effect_type": "疾行", "damage_rate": 1.0, "mp_cost": 0, "cooldown": 3}
		"set_true_dmg": return {"skill_id": "set_true_dmg", "skill_name": "真伤蚀", "skill_type": "真伤", "effect_type": "真伤", "damage_rate": 1.0, "mp_cost": 0, "cooldown": 4}
		"set_revive": return {"skill_id": "set_revive", "skill_name": "浴血生", "skill_type": "复活", "effect_type": "复活", "damage_rate": 1.0, "mp_cost": 0, "cooldown": 6}
		"set_aura": return {"skill_id": "set_aura", "skill_name": "灵光佑", "skill_type": "增益", "effect_type": "增伤", "damage_rate": 1.0, "mp_cost": 0, "cooldown": 4}
	return {}

# 获取套装进度信息（用于UI显示）
func 获取套装进度() -> Array:
	var 套装计数: Dictionary = {}
	for it in 装备.values():
		if it == null:
			continue
		var sid = ""
		if typeof(it) == TYPE_OBJECT:
			sid = str(it.套装ID) if "套装ID" in it else ""
		elif typeof(it) == TYPE_DICTIONARY:
			sid = str(it.get("套装ID", ""))
		if sid == "":
			continue
		套装计数[sid] = 套装计数.get(sid, 0) + 1
	var 结果: Array = []
	for sid in 套装计数.keys():
		var 数量 = 套装计数[sid]
		var 套装配置 = Item.套装库.get(sid, {})
		结果.append({
			"套装ID": sid,
			"名称": 套装配置.get("名称", sid),
			"数量": 数量,
			"2件效果": 套装配置.get("2件", ""),
			"3件效果": 套装配置.get("3件", ""),
			"5件效果": 套装配置.get("5件", ""),
		})
	return 结果

# 通用增益聚合（ADR-001 §4.6）：当前仅装备单一来源，后续功法/大阵/羁绊并入同池
func 聚合通用增益() -> float:
	var 装备词缀池: float = 0.0
	for it in 装备.values():
		for a in it.词缀:
			装备词缀池 += float(a.get("数值", 0)) / 100.0
	var 装备子帽: float = clamp(装备词缀池, 0.0, 0.08)   # 单源子帽 ≤8%（裁决②基线）
	var 通用增益总和: float = 装备子帽
	if Game != null:
		通用增益总和 += Game.付费增益值   # S1-4 付费buff并入同池，共享25/30封顶
	return _clamp_soft(通用增益总和, 0.25, 0.30, 0.2)  # 软25%/硬30%，溢出按20%衰减

# 软上限：≤hard 全计；>hard 仅溢出部分按 decay 计入（硬上限附近衰减，对应 E4）
func _clamp_soft(v: float, soft: float, hard: float, decay: float) -> float:
	if v <= hard:
		return v
	return hard + (v - hard) * decay

func _取资质系数() -> float:
	return 资质系数表.get(资质, 1.0)

func _取灵根系数() -> float:
	if 灵根 in 灵根变异:
		return 1.1     # 变异灵根（§4.2）
	return 灵根系数表.get(灵根, 1.0)   # 天灵根1.08 / 普通五行1.0

func _取道途综合系数() -> float:
	# 当前仅单道途（主修）；多道途（主辅/三修）H8 未落地，落地后按 §4.3 取 1.7/2.1
	return 1.0

# ============ 心境/道心/心魔系统 ============
## 心魔阈值影响：修炼效率
func 心魔修炼效率系数() -> float:
	if 心魔值 >= 90:
		return 0.5  # 重度：-50%
	elif 心魔值 >= 60:
		return 0.7  # 中度：-30%
	elif 心魔值 >= 30:
		return 0.9  # 轻度：-10%
	return 1.0

## 心魔阈值影响：突破成功率（百分比，如-5表示-5%）
func 心魔突破成功率惩罚() -> float:
	if 心魔值 >= 90:
		return -30.0  # 重度：-30%
	elif 心魔值 >= 60:
		return -15.0  # 中度：-15%
	elif 心魔值 >= 30:
		return -5.0   # 轻度：-5%
	return 0.0

## 心境加成：突破成功率（心境×0.2%）
func 心境突破加成() -> float:
	return float(心境) * 0.2

## 道心加成：突破成功率（道心×0.3%）
func 道心突破加成() -> float:
