	"wu_dao_cha": {"名称": "悟道茶", "品阶": "圣阶", "成熟天数": 12, "基础产量": 1, "种子": "悟道茶籽"},
	"chang_sheng_guo": {"名称": "长生果", "品阶": "圣阶", "成熟天数": 15, "基础产量": 1, "种子": "长生果核"},
