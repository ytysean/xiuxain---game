# ===== L2 望气：把数字翻译成相术文本 =====

## 业力侧气象；无业力返回空串
static func 业力气象(业力: int) -> String:
	var 文本: String = ""
	for 档 in 业力档:
		if 业力 >= int(档[0]):
			文本 = str(档[1])
	return 文本


## 功德侧气象；无功德返回空串
static func 功德气象(功德: int) -> String:
	var 文本: String = ""
	for 档 in 功德档:
		if 功德 >= int(档[0]):
			文本 = str(档[1])
	return 文本


## 业力短词（德业驳杂时组合使用）
static func 业力短词(业力: int) -> String:
	var 文本: String = ""
	for 档 in 业力短档:
		if 业力 >= int(档[0]):
			文本 = str(档[1])
	return 文本


## 功德短词（德业驳杂时组合使用）
static func 功德短词(功德: int) -> String:
	var 文本: String = ""
	for 档 in 功德短档:
		if 功德 >= int(档[0]):
			文本 = str(档[1])
	return 文本


## 望气结论：综合德业。德业皆重时呈现驳杂气象（修真味核心：善恶不是加减法）
## 驳杂时用短词组合，避免详情页 key-value 行被长句挤爆
static func 望气(d) -> String:
	var 业力: int = int(d.业力)
	var 功德: int = int(d.功德)
	if 业力 <= 0 and 功德 <= 0:
		return "气色清朗，无滞无碍"
	var 业文本: String = 业力气象(业力)
	var 功文本: String = 功德气象(功德)
	# 因果已生而未成气象（>0 但均低于最低档）。此处绝不可返回空串：
	# 空串会被 UI 当作「未施望气术」，玩家白花灵石且可无限重复点击（望气已过期 以空串判未望气）。
	if 业文本 == "" and 功文本 == "":
		return "气色尚平，未成气象"
	if 业文本 != "" and 功文本 != "":
		return "%s，然%s" % [功德短词(功德), 业力短词(业力)]
	if 业文本 != "":
		return 业文本
	return 功文本


## 望气是否过期（按游戏日）
static func 望气已过期(d, 当前游戏日: int) -> bool:
	if str(d.望气快照) == "":
		return true
	return (当前游戏日 - int(d.望气日)) >= 望气有效期


# ===== L3 征兆：让世界替玩家说话 =====

## 单个弟子的异象传闻；无因果则返回空串
## 主导判定：业力/功德谁大谁主导；主导侧够不到最低档时回落到另一侧。
## 回落是必须的——否则「业力30·功德25」这类德业驳杂者会卡在业力分支
## （业力档最低 40，30 够不到）而把善的一面整个吞掉，善永远不被看见。
static func 征兆(d) -> String:
	var 业力: int = int(d.业力)
	var 功德: int = int(d.功德)
	var 名: String = str(d.姓名)
	var 文本: String = ""
	if 业力 >= 功德:
		文本 = _取征兆(业征兆池, 业力, 名)
		if 文本 == "":
			文本 = _取征兆(功征兆池, 功德, 名)
	else:
		文本 = _取征兆(功征兆池, 功德, 名)
		if 文本 == "":
			文本 = _取征兆(业征兆池, 业力, 名)
	return 文本


## 按值取最高满足档的一条；值不够最低档则返回空串（池须按阈值降序）
static func _取征兆(池: Array, 值: int, 名: String) -> String:
	for 档 in 池:
		if 值 >= int(档[0]):
			var 文本们: Array = 档[1]
			return str(文本们[randi() % 文本们.size()]) % 名
	return ""


## 宗门异闻：全宗最多取一业一善两条，避免刷屏成噪音
## 返回 [{"文本": String, "弟子": Object}]；"弟子" 供 UI 点击直达本人（发现→确认链路）
static func 宗门异闻(弟子列表: Array) -> Array:
	var 业最高 = null
	var 功最高 = null
	for d in 弟子列表:
		if 业最高 == null or int(d.业力) > int(业最高.业力):
			业最高 = d
		if 功最高 == null or int(d.功德) > int(功最高.功德):
			功最高 = d
	var 闻: Array = []
	if 业最高 != null:
		var 业闻: String = 征兆(业最高)
		if 业闻 != "":
			闻.append({"文本": 业闻, "弟子": 业最高})
	if 功最高 != null and 功最高 != 业最高:
		var 功闻: String = 征兆(功最高)
		if 功闻 != "":
			闻.append({"文本": 功闻, "弟子": 功最高})
	return 闻


## 宗门异闻·按境界分区（决策#3）：每个境界取该境内业/功最显著弟子各一（同人去重）
## 返回 [{"文本":String,"弟子":Object,"境界":String,"类":String}]。
## 仅用于「宗门大了」后的分区播报；小宗门仍走 宗门异闻。
## 总量上限由调用方（game_state._记录异闻_S45）按月截断，本函数不做上限控制。
static func 宗门异闻分区(弟子列表: Array) -> Array:
	var 按境: Dictionary = {}
	for d in 弟子列表:
		var 境: String = str(d.境界)
		if 境 == "":
			continue
		if not 按境.has(境):
			按境[境] = []
		按境[境].append(d)
	var 闻: Array = []
	for 境 in 按境.keys():
		var 组内: Array = 按境[境]
		var 业最高 = null
		var 功最高 = null
		for d in 组内:
			if 业最高 == null or int(d.业力) > int(业最高.业力):
				业最高 = d
			if 功最高 == null or int(d.功德) > int(功最高.功德):
				功最高 = d
		if 业最高 != null:
			var 业闻: String = 征兆(业最高)
			if 业闻 != "":
				闻.append({"文本": 业闻, "弟子": 业最高, "境界": 境, "类": "业"})
		if 功最高 != null and 功最高 != 业最高:
			var 功闻: String = 征兆(功最高)
			if 功闻 != "":
				闻.append({"文本": 功闻, "弟子": 功最高, "境界": 境, "类": "功"})
	return 闻


## 望宗门气运：一次看清全宗整体气象——点出「有没有问题」却不点名。
## 设计意图：个人望气 50 灵石，玩家不可能挨个望 100 人；宗门望气给粗信号（谁最脏由异闻负责指认），
## 三层漏斗为：宗门气运(粗) → 异闻点名(中) → 个人望气(细)。
## 口径：以「最恶者」而非均值定档——一颗老鼠屎坏一锅汤才符合直觉，均值会把极端恶人稀释掉。
static func 宗门气象(弟子列表: Array) -> String:
	if 弟子列表 == null or 弟子列表.is_empty():
		return "山门空寂，无从观望"
	var 最恶业: int = 0
	var 最善功: int = 0
	var 总业: int = 0
	var 总功: int = 0
	for d in 弟子列表:
		var 业: int = int(d.业力)
		var 功: int = int(d.功德)
		总业 += 业
		总功 += 功
		if 业 > 最恶业:
			最恶业 = 业
		if 功 > 最善功:
			最善功 = 功
	if 总业 <= 0 and 总功 <= 0:
		return "山门清明，气象冲和，并无异样"
	var 恶档: int = 0
	if 最恶业 >= 200:
		恶档 = 3
	elif 最恶业 >= 100:
		恶档 = 2
	elif 最恶业 >= 40:
		恶档 = 1
	var 善档: int = 0
	if 最善功 >= 200:
		善档 = 3
	elif 最善功 >= 100:
		善档 = 2
	elif 最善功 >= 20:
		善档 = 1
	# 驳杂优先于最高恶档：巨恶与大德并存是最有味道的一档，不可被「黑云压顶」吞掉
	if 恶档 >= 2 and 善档 >= 2:
		return "山门气象驳杂，紫气与黑云相争，门中贤愚并存"
	if 恶档 >= 3:
		return "山门黑云压顶，怨气冲霄，门中藏有巨恶"
	if 恶档 >= 2:
		return "山门上空黑云凝聚，门中恐有大奸大恶之徒"
	if 恶档 == 1:
		return "山门气色微晦，似有一二心术不正之人"
	if 善档 >= 2:
		return "山门紫气氤氲，气象兴隆，门中多有大德之士"
	if 善档 == 1:
		return "山门气色尚平，偶有德光闪动"
	# 有因果但未成气候（业力 < 40 且功德 < 20）：不可谎报德光
	return "山门气色尚平，些微因果未成气候"


# ===== L4 结算：后果以天象与幻境呈现，不给倍率 =====

## 天劫天象（入参为 Tribulation.因果天劫倍率 的返回值）
static func 天象描述(倍率: float) -> String:
	for 档 in 天象表:
		if 倍率 >= float(档[0]):
			return str(档[1])
	return "劫云如常，天道无喜无怒"


## 旧业翻账：历史业力不清零，渡劫/心魔劫时会被翻出
static func 翻旧账(d) -> String:
	var 历史: int = int(d.历史业力)
	if 历史 < 旧业门槛:
		return ""
	var 名: String = str(d.姓名)
	if 历史 >= 400:
		return "旧业翻涌：%s一身杀孽，天心早已记下，今日一并清算。" % 名
	if 历史 >= 200:
		return "旧业翻涌：%s昔年血洗之地的怨气，循着劫云找上门来。" % 名
	return "旧业微动：%s昔年所造杀业虽已搁置，终究未曾消散。" % 名


## 入魔幻境：杀过的人会在最虚弱时回来
static func 入魔幻境(d) -> String:
	var 业力: int = int(d.业力)
	var 历史: int = int(d.历史业力)
	var 名: String = str(d.姓名)
	if 历史 >= 200:
		return "%s识海之中，无数面孔逐一浮现——皆为昔日死于其手之人，此刻正静静看着他。" % 名
	if 历史 >= 旧业门槛 or 业力 >= 100:
		return "%s恍惚间见一熟悉的身影立于雾中，欲上前辨认，那人却缓缓回头，面目全非。" % 名
	if 业力 >= 20:
		return "%s心魔丛生，隐约听见有人在其耳边低语，说的尽是旧事。" % 名
	return "%s只觉心神不宁，识海中似有什么在轻轻叩门。" % 名
