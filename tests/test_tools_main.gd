# tests/test_tools_main.gd —— 测试工具主入口
# 功能：运行数值统计、战斗模拟、经济模拟，生成综合测试报告
# 运行：godot --headless --script tests/test_tools_main.gd
extends SceneTree

var 数值统计: NumericalStats
var 战斗模拟器: BattleSimulator
var 经济模拟器: EconomySimulator

func _init():
	print("=".repeat(60))
	print("《太玄宗门录》测试工具启动")
	print("=".repeat(60))

	# 初始化工具
	数值统计 = NumericalStats.new()
	战斗模拟器 = BattleSimulator.new()
	经济模拟器 = EconomySimulator.new()

	# 运行测试
	_运行数值统计测试()
	_运行战斗模拟测试()
	_运行经济模拟测试()

	# 生成综合报告
	_生成综合报告()

	print("\n🎉 所有测试完成！")
	quit()

func _运行数值统计测试():
	print("\n" + "=".repeat(60))
	print("一、数值统计工具测试")
	print("=".repeat(60))

	# 模拟记录一些数据
	数值统计.记录资源收入("灵石", 1000)
	数值统计.记录资源收入("灵气", 500)
	数值统计.记录资源支出("灵石", 300)
	数值统计.记录资源支出("灵气", 200)
	数值统计.记录突破("筑基", true)
	数值统计.记录突破("金丹", false)
	数值统计.记录修炼天数(100)
	数值统计.记录战斗("筑基", "练气", true, 5)
	数值统计.记录战斗("筑基", "筑基", false, 12)
	数值统计.更新游戏时间(365)
	数值统计.记录系统使用("灵田种植次数")
	数值统计.记录系统使用("炼丹次数")

	print("✅ 数值统计测试数据已记录")

	# 导出报告
	var 报告 = 数值统计.导出报告()
	print(报告)

	# 保存报告
	数值统计.保存报告到文件("user://数值统计报告.txt")

func _运行战斗模拟测试():
	print("\n" + "=".repeat(60))
	print("二、战斗模拟器测试")
	print("=".repeat(60))

	# 单场战斗模拟
	print("\n1. 单场战斗模拟（筑基vs练气，100次）")
	var 单场结果 = 战斗模拟器.模拟境界对比("筑基", "练气", 100)
	print("   胜率: %.1f%%" % 单场结果["胜率"])
	print("   平均回合数: %.1f" % 单场结果["平均回合数"])

	# 跨境界碾压测试
	print("\n2. 跨境界碾压测试（以金丹为基准）")
	var 碾压结果 = 战斗模拟器.模拟跨境界碾压("金丹", 50)
	for 对比境界 in 碾压结果.keys():
		var 数据 = 碾压结果[对比境界]
		print("   金丹vs%s: 胜率%.1f%%, 平均%.1f回合" % [对比境界, 数据["胜率"], 数据["平均回合数"]])

	# 导出境界对比报告
	print("\n3. 生成境界对比报告（10次模拟，快速测试）")
	var 战斗报告 = 战斗模拟器.导出境界对比报告(10)
	print(战斗报告)

	# 保存报告
	战斗模拟器.保存报告到文件("user://战斗模拟报告.txt", 战斗报告)

func _运行经济模拟测试():
	print("\n" + "=".repeat(60))
	print("三、经济模拟器测试")
	print("=".repeat(60))

	# 单日经济模拟
	print("\n1. 基准玩家单日经济")
	var 单日经济 = 经济模拟器.模拟单日经济(经济模拟器.基准玩家)
	for 资源类型 in 单日经济.keys():
		var 数据 = 单日经济[资源类型]
		print("   %s: 产出%d, 消耗%d, 净收入%d" % [资源类型, 数据["产出"], 数据["消耗"], 数据["净收入"]])

	# 长期经济模拟
	print("\n2. 基准玩家长期经济（365天）")
	var 长期经济 = 经济模拟器.模拟长期经济(经济模拟器.基准玩家, 365)
	var 累计收支 = 长期经济["累计收支"]
	for 资源类型 in 累计收支.keys():
		var 数据 = 累计收支[资源类型]
		print("   %s: 总产出%d, 总消耗%d, 总净收入%d, 日均净收入%.1f" % [资源类型, 数据["总产出"], 数据["总消耗"], 数据["总净收入"], 数据["日均净收入"]])

	# 不同玩家类型对比
	print("\n3. 不同玩家类型对比（30天）")
	var 玩家对比 = 经济模拟器.模拟不同玩家类型(30)
	for 类型名 in 玩家对比.keys():
		var 数据 = 玩家对比[类型名]
		var 收支 = 数据["累计收支"]
		var 灵石净收入 = 收支.get("灵石", {}).get("总净收入", 0)
		print("   %s: 灵石净收入%d (弟子%d, 灵田%d级, 每日%d分钟)" % [类型名, 灵石净收入, 数据["配置"]["弟子数量"], 数据["配置"]["灵田等级"], 数据["配置"]["每日游戏时长"]])

	# 导出经济报告
	print("\n4. 生成经济报告")
	var 经济报告 = 经济模拟器.导出经济报告(365)
	print(经济报告)

	# 保存报告
	经济模拟器.保存报告到文件("user://经济模拟报告.txt", 经济报告)

func _生成综合报告():
	print("\n" + "=".repeat(60))
	print("四、生成综合测试报告")
	print("=".repeat(60))

	var 综合报告 = ""
	综合报告 += "=".repeat(60) + "\n"
	综合报告 += "《太玄宗门录》综合测试报告\n"
	综合报告 += "=".repeat(60) + "\n\n"
	综合报告 += "生成时间: %s\n" % Time.get_datetime_string_from_system()
	综合报告 += "测试工具版本: v1.0\n\n"

	综合报告 += "一、测试工具清单\n"
	综合报告 += "-".repeat(40) + "\n"
	综合报告 += "1. 数值统计工具 (NumericalStats)\n"
	综合报告 += "   - 功能：记录资源收支、弟子成长、战斗数据、系统使用\n"
	综合报告 += "   - 用途：收集实际游戏数据，用于数值平衡分析\n\n"
	综合报告 += "2. 战斗模拟器 (BattleSimulator)\n"
	综合报告 += "   - 功能：模拟不同配置下的战斗结果\n"
	综合报告 += "   - 用途：测试境界平衡、道途平衡、属性敏感度\n\n"
	综合报告 += "3. 经济模拟器 (EconomySimulator)\n"
	综合报告 += "   - 功能：模拟长期的经济运行情况\n"
	综合报告 += "   - 用途：测试经济平衡、通货膨胀、不同玩家类型对比\n\n"

	综合报告 += "二、使用方法\n"
	综合报告 += "-".repeat(40) + "\n"
	综合报告 += "1. 在游戏中使用：\n"
	综合报告 += "   - 数值统计：在关键操作处调用 NumericalStats.record_xxx()\n"
	综合报告 += "   - 战斗模拟：调用 BattleSimulator.simulate_xxx() 测试战斗\n"
	综合报告 += "   - 经济模拟：调用 EconomySimulator.simulate_xxx() 测试经济\n\n"
	综合报告 += "2. 命令行运行测试：\n"
	综合报告 += "   godot --headless --script tests/test_tools_main.gd\n\n"
	综合报告 += "3. 导出报告：\n"
	综合报告 += "   - 数值统计报告：user://数值统计报告.txt\n"
	综合报告 += "   - 战斗模拟报告：user://战斗模拟报告.txt\n"
	综合报告 += "   - 经济模拟报告：user://经济模拟报告.txt\n\n"

	综合报告 += "三、下一步工作\n"
	综合报告 += "-".repeat(40) + "\n"
	综合报告 += "1. 在游戏中接入数值统计工具，收集实际数据\n"
	综合报告 += "2. 使用战斗模拟器测试各境界、各道途的平衡性\n"
	综合报告 += "3. 使用经济模拟器测试长期经济运行情况\n"
	综合报告 += "4. 根据测试数据调整数值配置\n"
	综合报告 += "5. 迭代优化，直到数值平衡达到设计目标\n\n"

	综合报告 += "=".repeat(60) + "\n"
	综合报告 += "报告结束\n"
	综合报告 += "=".repeat(60) + "\n"

	# 保存综合报告
	var f = FileAccess.open("user://综合测试报告.txt", FileAccess.WRITE)
	if f != null:
		f.store_string(综合报告)
		f.close()
		print("✅ 综合测试报告已保存: user://综合测试报告.txt")

	print(综合报告)
