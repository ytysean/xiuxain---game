	"力士傀儡": {"描述": "近战强攻，力大无穷，适合正面作战", "修炼加成": 0.0, "产出加成": 0.0, "战力加成": 20},
	"剑傀儡": {"描述": "远程道修，剑气纵横，适合输出", "修炼加成": 0.0, "产出加成": 0.0, "战力加成": 25},
	"盾傀儡": {"描述": "防御为主，坚不可摧，适合护宗", "修炼加成": 0.0, "产出加成": 0.03, "战力加成": 15},
	"采药傀儡": {"描述": "自动采集灵草，不知疲倦", "修炼加成": 0.0, "产出加成": 0.10, "战力加成": 0},
	"炼丹傀儡": {"描述": "辅助炼丹，控火精准", "修炼加成": 0.05, "产出加成": 0.05, "战力加成": 0},
	"侍童傀儡": {"描述": "侍奉左右，辅助修炼，心境平和", "修炼加成": 0.08, "产出加成": 0.02, "战力加成": 5},
	"替死傀儡": {"描述": "危急时刻替主而死，保命神物", "修炼加成": 0.0, "产出加成": 0.0, "战力加成": 0},
	"侦查傀儡": {"描述": "小巧灵动，擅长探路侦查", "修炼加成": 0.02, "产出加成": 0.02, "战力加成": 3},
	"毒傀儡": {"描述": "淬毒傀儡，攻击附带毒素，令人闻风丧胆", "修炼加成": 0.0, "产出加成": 0.0, "战力加成": 18},
}

# 制作傀儡（消耗材料+灵石，生成傀儡；修真世界观：傀儡需要矿石+妖兽材料+核心）
func 制作傀儡(傀儡名称: String, 傀儡品阶: String, 傀儡类型: String, 消耗灵石: int = 0, 是否替死: bool = false) -> Dictionary:
	# 材料消耗（按品阶递增）
	var 品阶材料: Dictionary = {
		"凡品": {"矿石": 10, "妖兽材料": 5, "核心": 1},
		"灵品": {"矿石": 30, "妖兽材料": 15, "核心": 1},
		"宝品": {"矿石": 80, "妖兽材料": 40, "核心": 2},
		"王品": {"矿石": 200, "妖兽材料": 100, "核心": 3},
		"道品": {"矿石": 500, "妖兽材料": 250, "核心": 5},
		"圣品": {"矿石": 1000, "妖兽材料": 500, "核心": 8},
		"仙品": {"矿石": 2000, "妖兽材料": 1000, "核心": 15},
	}
	var 材料: Dictionary = 品阶材料.get(傀儡品阶, 品阶材料["凡品"])
	# 检查材料
	if Game.矿石 < int(材料["矿石"]):
		return {"成功": false, "原因": "矿石不足（需%d，当前%d）" % [int(材料["矿石"]), Game.矿石]}
	# 毒傀儡需要额外毒药材料
	if 傀儡类型 == "毒傀儡":
		var 找到毒药: bool = false
		for i in range(Game.宗门库房.size()):
			var it = Game.宗门库房[i]
			if it != null and it.类别 == "du_yao":
				Game.宗门库房.remove_at(i)
				找到毒药 = true
				break
		if not 找到毒药:
			return {"成功": false, "原因": "毒傀儡炼制需消耗一枚毒药，库房无毒药"}
	if 消耗灵石 > 0 and Game.灵石 < 消耗灵石:
		return {"成功": false, "原因": "灵石不足"}
	# 消耗材料
	Game.矿石 -= int(材料["矿石"])
	if 消耗灵石 > 0:
		Game.灵石 -= 消耗灵石
	var 新傀儡 = {
		"ID": 傀儡ID计数器,
		"名称": 傀儡名称,
		"品阶": 傀儡品阶,
		"类型": 傀儡类型,
		"等级": 1,
		"效果": "待实现",
		"替死": 是否替死,
	}
	傀儡ID计数器 += 1
	傀儡列表.append(新傀儡)
	# 成就统计：累计制作傀儡数自增
	累计制作傀儡数 += 1
	Game._复检成就()
	Game.添加纪事("庶务", "炼制傀儡", "以%d矿石炼制%s（%s）成功，傀儡初具灵智。" % [int(材料["矿石"]), 傀儡名称, 傀儡品阶], 1)
	return {"成功": true, "傀儡": 新傀儡, "消息": "炼制%s成功" % 傀儡名称}

# P3 保命环节：取一具可用替死傀儡（宗门替死傀儡池，供弟子致命时替死）
func 取可用替死傀儡() -> Dictionary:
	for 傀儡 in 傀儡列表:
		if 傀儡.get("替死", false):
			return 傀儡
	return {"成功": false, "原因": "无可用替死傀儡"}

# P3 保命环节：消耗一具替死傀儡（从宗门替死傀儡池移除）
func 消耗替死傀儡(傀儡: Dictionary) -> void:
	var tid = 傀儡.get("ID", -1)
	for i in range(傀儡列表.size()):
		if 傀儡列表[i].get("ID", -1) == tid:
			傀儡列表.remove_at(i)
			break

# 获取傀儡列表
func 获取傀儡列表() -> Array:
	return 傀儡列表

# 升级傀儡（消耗灵石，提升傀儡等级和效果）
func 升级傀儡(傀儡ID: int, 消耗灵石: int = 0) -> Dictionary:
	var 目标傀儡 = null
	for 傀儡 in 傀儡列表:
		if 傀儡.get("ID", -1) == 傀儡ID:
			目标傀儡 = 傀儡
			break
	if 目标傀儡 == null:
		return {"成功": false, "原因": "傀儡不存在"}
	# 等级上限检查
	var 当前等级 = int(目标傀儡.get("等级", 1))
	var 最大等级 = 100
	if 当前等级 >= 最大等级:
		return {"成功": false, "原因": "已达最高品级（%d品）" % 最大等级}
	# 根据等级计算升级消耗
	var 升级消耗 = 100 * 当前等级
	if 消耗灵石 > 0:
		升级消耗 = 消耗灵石
	if Game.灵石 < 升级消耗:
		return {"成功": false, "原因": "灵石不足（需要%d）" % 升级消耗}
	Game.灵石 -= 升级消耗
	目标傀儡["等级"] = 当前等级 + 1
	# 根据傀儡类型计算效果（修真化描述）
	var 等级 = int(目标傀儡.get("等级", 1))
	var 类型 = 目标傀儡.get("类型", "")
	match 类型:
		"力士傀儡":
			目标傀儡["效果"] = "筋骨淬炼，道行+%d" % (等级 * 15)
		"剑傀儡":
			目标傀儡["效果"] = "剑气纵横，道行+%d" % (等级 * 20)
		"盾傀儡":
			目标傀儡["效果"] = "坚不可摧，道行+%d、产出+%d%%" % [等级 * 12, int(等级 * 2)]
		"采药傀儡":
			目标傀儡["效果"] = "不知疲倦，产出+%d%%" % int(等级 * 8)
		"炼丹傀儡":
			目标傀儡["效果"] = "控火精准，产出+%d%%" % int(等级 * 4)
		"侍童傀儡":
			目标傀儡["效果"] = "侍奉左右，修炼速度+%d%%、道行+%d" % [int(等级 * 6), 等级 * 3]
		"替死傀儡":
			目标傀儡["效果"] = "替主而死，保命神物"
		"侦查傀儡":
			目标傀儡["效果"] = "小巧灵动，修炼速度+%d%%、产出+%d%%" % [int(等级 * 2), int(等级 * 2)]
		"毒傀儡":
			目标傀儡["效果"] = "淬毒攻击，道行+%d" % (等级 * 15)
		_:
			目标傀儡["效果"] = "周身诸力俱增，根基日固"
	Game.添加纪事("庶务", "淬炼傀儡", "%s淬炼至%d级，灵智渐开，消耗%d灵石" % [目标傀儡.get("名称", ""), 等级, 升级消耗], 1)
	return {"成功": true, "傀儡": 目标傀儡, "消耗": 升级消耗, "消息": "%s升级成功" % 目标傀儡.get("名称", "")}

# 获取所有傀儡类型
func 获取所有傀儡类型() -> Array:
	var 类型列表 = []
	for 类型 in 傀儡类型配置.keys():
		var 配置 = 傀儡类型配置[类型]
		类型列表.append({
			"类型": 类型,
			"描述": 配置.get("描述", ""),
			"修炼加成": 配置.get("修炼加成", 0.0),
			"产出加成": 配置.get("产出加成", 0.0),
			"战力加成": 配置.get("战力加成", 0),
		})
	return 类型列表

# 获取傀儡总加成（供其他系统调用）
func 获取傀儡总加成() -> Dictionary:
	var 加成 = {"修炼速度": 0.0, "产出": 0.0, "战力": 0}
	for 傀儡 in 傀儡列表:
		var 等级 = int(傀儡.get("等级", 1))
		var 类型 = 傀儡.get("类型", "")
		match 类型:
			"力士傀儡":
				加成["战力"] += 等级 * 15
			"剑傀儡":
				加成["战力"] += 等级 * 20
			"盾傀儡":
				加成["战力"] += 等级 * 12
				加成["产出"] += 等级 * 0.02
			"采药傀儡":
				加成["产出"] += 等级 * 0.08
			"炼丹傀儡":
				加成["修炼速度"] += 等级 * 0.04
				加成["产出"] += 等级 * 0.04
			"侍童傀儡":
				加成["修炼速度"] += 等级 * 0.06
				加成["战力"] += 等级 * 3
			"侦查傀儡":
				加成["修炼速度"] += 等级 * 0.02
				加成["产出"] += 等级 * 0.02
			"毒傀儡":
				加成["战力"] += 等级 * 15
			_:
				加成["修炼速度"] += 等级 * 0.03
				加成["产出"] += 等级 * 0.03
		# 傀儡装备加成
		var 装备 = 傀儡.get("装备", {})
		if not 装备.is_empty():
			加成["修炼速度"] += float(装备.get("修炼加成", 0))
			加成["产出"] += float(装备.get("产出加成", 0))
			加成["战力"] += int(装备.get("战力加成", 0))
	return 加成

# 从宗门库房获取可装备给傀儡的物品列表
func 获取傀儡可装备物品() -> Array:
	var 可装备列表 = []
	for i in Game.宗门库房.size():
		var 物品 = Game.宗门库房[i]
		if 物品.类别 == "装备":
			可装备列表.append({
				"名称": 物品.名称,
				"品阶": 物品.品阶,
				"描述": 物品.描述,
				"索引": i,
			})
	return 可装备列表

# 内部：根据品阶计算装备加成
func _品阶装备加成(装备品阶: String) -> Dictionary:
	var 修炼加成 = 0.0
	var 产出加成 = 0.0
	var 战力加成 = 0
	if 装备品阶 == "凡品" or 装备品阶 == "凡阶":
		修炼加成 = 0.02; 产出加成 = 0.02; 战力加成 = 5
	elif 装备品阶 == "灵品" or 装备品阶 == "灵阶":
		修炼加成 = 0.05; 产出加成 = 0.05; 战力加成 = 15
	elif 装备品阶 == "宝品" or 装备品阶 == "宝阶":
		修炼加成 = 0.08; 产出加成 = 0.08; 战力加成 = 30
	elif 装备品阶 == "王品" or 装备品阶 == "王阶":
		修炼加成 = 0.12; 产出加成 = 0.12; 战力加成 = 50
	elif 装备品阶 == "圣品" or 装备品阶 == "圣阶":
		修炼加成 = 0.18; 产出加成 = 0.18; 战力加成 = 80
	elif 装备品阶 == "仙品" or 装备品阶 == "仙阶":
		修炼加成 = 0.25; 产出加成 = 0.25; 战力加成 = 120
	else:
		修炼加成 = 0.03; 产出加成 = 0.03; 战力加成 = 10
	return {"修炼加成": 修炼加成, "产出加成": 产出加成, "战力加成": 战力加成}

# 从宗门库房选择装备给傀儡（消耗宗门库房中的装备）
func 傀儡从宗门库房装备(傀儡ID: int, 物品索引: int) -> Dictionary:
	# 检查傀儡是否存在
	var 目标傀儡 = null
	for 傀儡 in 傀儡列表:
		if 傀儡.get("ID", -1) == 傀儡ID:
			目标傀儡 = 傀儡
			break
	if 目标傀儡 == null:
		return {"成功": false, "原因": "傀儡不存在"}
	# 检查物品索引是否有效
	if 物品索引 < 0 or 物品索引 >= Game.宗门库房.size():
		return {"成功": false, "原因": "物品索引无效"}
	var 物品 = Game.宗门库房[物品索引]
	if 物品.类别 != "装备":
		return {"成功": false, "原因": "该物品不是装备"}
	# 如果傀儡已有装备，先卸下
	if not 目标傀儡.get("装备", {}).is_empty():
		var 旧装备 = 目标傀儡.get("装备", {})
		# 将旧装备放回宗门库房
		var 旧装备物品 = Item.new()
		旧装备物品.名称 = 旧装备.get("名称", "")
		旧装备物品.品阶 = 旧装备.get("品阶", "")
		旧装备物品.类别 = "装备"
		旧装备物品.描述 = "傀儡卸下的装备"
		Game.宗门库房.append(旧装备物品)
	# 根据品阶计算装备加成
	var 加成 = _品阶装备加成(物品.品阶)
	目标傀儡["装备"] = {
		"名称": 物品.名称,
		"品阶": 物品.品阶,
		"修炼加成": 加成["修炼加成"],
		"产出加成": 加成["产出加成"],
		"战力加成": 加成["战力加成"],
	}
	# 从宗门库房移除装备
	Game.宗门库房.remove_at(物品索引)
	Game.添加纪事("庶务", "傀儡装备", "%s从宗门库房装备了%s（%s）" % [目标傀儡.get("名称", ""), 物品.名称, 物品.品阶], 1)
	return {"成功": true, "傀儡": 目标傀儡, "消息": "%s装备%s成功" % [目标傀儡.get("名称", ""), 物品.名称]}

# 为傀儡装备物品
func 傀儡装备(傀儡ID: int, 装备名称: String, 装备品阶: String = "灵品") -> Dictionary:
	var 目标傀儡 = null
	for 傀儡 in 傀儡列表:
		if 傀儡.get("ID", -1) == 傀儡ID:
			目标傀儡 = 傀儡
			break
	if 目标傀儡 == null:
		return {"成功": false, "原因": "傀儡不存在"}
	var 加成 = _品阶装备加成(装备品阶)
	目标傀儡["装备"] = {
		"名称": 装备名称,
		"品阶": 装备品阶,
		"修炼加成": 加成["修炼加成"],
		"产出加成": 加成["产出加成"],
		"战力加成": 加成["战力加成"],
	}
	Game.添加纪事("庶务", "傀儡装备", "%s装备了%s（%s）" % [目标傀儡.get("名称", ""), 装备名称, 装备品阶], 1)
	return {"成功": true, "傀儡": 目标傀儡, "消息": "%s装备%s成功" % [目标傀儡.get("名称", ""), 装备名称]}

# 卸下傀儡装备
func 傀儡卸下装备(傀儡ID: int) -> Dictionary:
	var 目标傀儡 = null
	for 傀儡 in 傀儡列表:
		if 傀儡.get("ID", -1) == 傀儡ID:
			目标傀儡 = 傀儡
			break
	if 目标傀儡 == null:
		return {"成功": false, "原因": "傀儡不存在"}
	if 目标傀儡.get("装备", {}).is_empty():
		return {"成功": false, "原因": "傀儡未装备物品"}
	var 卸下装备 = 目标傀儡.get("装备", {})
	目标傀儡["装备"] = {}
	Game.添加纪事("庶务", "傀儡卸下装备", "%s卸下了%s" % [目标傀儡.get("名称", ""), 卸下装备.get("名称", "")], 1)
	return {"成功": true, "卸下装备": 卸下装备, "消息": "%s卸下装备成功" % 目标傀儡.get("名称", "")}

# 序列化（供save_game使用）
func to_dict() -> Dictionary:
	return {
		"傀儡列表": 傀儡列表,
		"傀儡ID计数器": 傀儡ID计数器,
		"累计制作傀儡数": 累计制作傀儡数,
	}

# 反序列化（供load_game使用）
func from_dict(data: Dictionary) -> void:
	傀儡列表 = data.get("傀儡列表", [])
	傀儡ID计数器 = data.get("傀儡ID计数器", 0)
	累计制作傀儡数 = data.get("累计制作傀儡数", 0)
