; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="太玄宗门录"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Game="*res://game_state.gd"
UITheme="*res://ui_theme.gd"
UIThemeConfig="*res://ui_theme_config.gd"
UITween="*res://ui_tween.gd"
ToastManager="*res://components/ToastManager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=854
window/handheld/orientation="portrait"

[gui]

theme="res://theme/main_theme.tres"
