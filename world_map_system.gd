# ---------- 1.1 灵钓系统联动 ----------
# 区域 → 灵渊档位（真源：fishing_system.灵渊表 0浅滩灵池/1灵渊中层/2灵渊深处/3虚空灵渊）
# 修真味依据：北域苦寒、南疆瘴毒，人迹罕至故灵渊更深；中州繁华，多浅滩灵池。
const 区域灵渊档: Dictionary = {
	区域_中州: 0, 区域_东域: 1, 区域_西域: 1, 区域_南疆: 2, 区域_北域: 2,
}

# 获取某区域的钓点（灵渊）—— 纯转发 Game.灵钓系统，零自造鱼类名录
func 获取区域钓点(区域: String) -> Array:
	var 列表: Array = []
	if Game.灵钓系统 == null:
		return 列表
	var 档: int = int(区域灵渊档.get(区域, 0))
	# 灵渊必依灵脉而生：北域/南疆灵气更盛，鱼获品质加成
	var 灵气加成: float = 1.2 if (区域 == 区域_北域 or 区域 == 区域_南疆) else 1.0
	# 直取灵渊真源（含未解锁档，软门控以 需境界/已解锁 呈现，不吃掉 UI 展示）
	var 渊: Dictionary = Game.灵钓系统.获取灵渊(档)
	var 需境界: int = int(渊.get("需境界", 0))
	列表.append({
		"ID": "钓点_%d" % 档,
		"区域": 区域,
		"名称": "%s·%s" % [区域, str(渊.get("名", "灵渊"))],
		"灵渊id": 档,
		"难度": float(渊.get("难度", 1.0)),
		"需境界": 需境界,
		"已解锁": 需境界 <= int(Game.灵钓系统.钓道境界),
		"灵气加成": 灵气加成,
	})
	return 列表

# 获取钓点鱼获（转发灵钓系统真实可钓鱼类；灵气加成由调用侧决定表现，不篡改鱼表）
func 获取钓点鱼获(钓点ID: String) -> Array:
	if not 钓点ID.begins_with("钓点_"):
		return []
	var 档: int = int(钓点ID.substr(3))
	if 档 < 0 or Game.灵钓系统 == null:
		return []
	return Game.灵钓系统.获取可钓鱼类(档)

# ---------- 1.2 灵兽系统联动 ----------
# 区域 → 妖兽品阶档（真源：beast.gd.灵兽种类 39 种名录，零自造）
# 依据区域特性.危险度：中州 0.1 → 凡/灵阶；东域 0.2、西域 0.25 → 灵/宝阶；南疆 0.35、北域 0.4 → 宝/王阶
const 区域妖兽品阶: Dictionary = {
	区域_中州: ["fan_jie", "ling_jie"],
	区域_东域: ["ling_jie", "bao_jie"],
	区域_西域: ["ling_jie", "bao_jie"],
	区域_南疆: ["bao_jie", "wang_jie"],
	区域_北域: ["bao_jie", "wang_jie"],
}
const 妖兽品阶基准战力: Dictionary = {
	"fan_jie": 800, "ling_jie": 3000, "bao_jie": 10000,
	"wang_jie": 30000, "sheng_jie": 90000, "xian_jie": 300000,
}

# 获取某区域出没的妖兽（从 Beast.灵兽种类 按品阶档筛选，不自造名录）
func 获取区域妖兽(区域: String) -> Array:
	var 列表: Array = []
	var 档集: Array = 区域妖兽品阶.get(区域, ["fan_jie"])
	for i in range(Beast.灵兽种类.size()):
		var 种: Dictionary = Beast.灵兽种类[i]
		if not 档集.has(str(种.get("品阶", ""))):
			continue
		var 品阶: String = str(种.get("品阶", "fan_jie"))
		var 通名: String = str(Beast.品阶显示.get(品阶, 品阶))
		列表.append({
			"ID": "妖兽_%s_%d" % [区域, i],
			"区域": 区域,
			"名": str(种.get("名", "无名妖兽")),
			"品阶": 品阶,
			"品阶名": 通名,
			"战力": int(妖兽品阶基准战力.get(品阶, 3000)),
		})
	return 列表

# 尝试降服灵兽（妖兽ID 由 获取区域妖兽 产出；弟子战力决定成败）
func 尝试降服灵兽(妖兽ID: String, 弟子战力: int) -> Dictionary:
	if not 妖兽ID.begins_with("妖兽_"):
		return {"成功": false, "原因": "未识得此兽来历"}
	var 段: PackedStringArray = 妖兽ID.split("_")
	if 段.size() < 3:
		return {"成功": false, "原因": "妖兽ID格式有误"}
	var 区域: String = str(段[1])
	var 序: int = int(段[2])
	if 区域 not in 所有区域 or 序 < 0 or 序 >= Beast.灵兽种类.size():
		return {"成功": false, "原因": "此兽不在此方地界"}
	var 种: Dictionary = Beast.灵兽种类[序]
	var 品阶: String = str(种.get("品阶", "fan_jie"))
	if not 区域妖兽品阶.get(区域, []).has(品阶):
		return {"成功": false, "原因": "此兽不在此方地界"}
	var 目标战力: int = int(妖兽品阶基准战力.get(品阶, 3000))
	var 胜率: float = clampf(float(弟子战力) / float(弟子战力 + 目标战力), 0.05, 0.92)
	if randf() > 胜率:
		Game.添加纪事("神异", "降服失利", "欲降服%s，奈何此兽凶悍，弟子负伤而退。" % str(种.get("名", "妖兽")), 1)
		return {"成功": false, "原因": "此兽凶悍，降服未成", "胜率": 胜率, "目标": str(种.get("名", ""))}
	# 成功：以真源名录成兽（品阶=key，孵化后入灵兽库存）
	# 注：Beast.品阶 存的是品阶 key（fan_jie…），显示中文须走 Beast.品阶显示，不可覆盖字段
	var 兽: Beast = Beast.new(品阶)
	兽.孵化()
	# 对齐玩家所见species：同品阶内覆盖为遭遇名录中的那一头（种类名仅展示字段，beast_type 随之重取）
	兽.种类名 = str(种.get("名", 兽.种类名))
	兽.beast_type = str(Beast.种类类型.get(兽.种类名, 兽.beast_type))
	if Game.灵兽库存 != null:
		Game.灵兽库存.append(兽)
	var 兽名: String = str(兽.种类名)
	Game.添加纪事("神异", "降服灵兽", "于%s降服%s一头，收入宗门灵兽库。" % [区域, 兽名], 2)
	Game._加推演条目("【降服】%s 降服%s，宗门灵兽库再添一员" % [区域, 兽名], "神异", "中")
	return {"成功": true, "灵兽": 兽名, "品阶": str(Beast.品阶显示.get(品阶, 品阶)), "胜率": 胜率, "区域": 区域}

# ---------- 1.3 生产系统联动（资源产出直通库房）----------
# 资源点类型 → 入库去向（真源：Game.灵气 / Game.矿石 / Game.灵草 / Game.增加妖兽材料）
const 资源入库去向: Dictionary = {
	"灵脉": "灵气", "灵泉": "灵气", "矿脉": "矿石", "灵草丛": "灵草", "妖兽领": "妖兽材料",
}

# 采集资源入库存：把采集所得真正入账（灵气/矿石/灵草直加，妖兽材料走 Game.增加妖兽材料）
# 数量 < 0 时按资源点自身等级与距离独立计算（供 UI 直接调用）；否则用调用侧已算好的产量
func 采集资源入库存(资源点ID: String, 数量: int = -1) -> Dictionary:
	var 目标: Dictionary = {}
	for 资源点 in 资源点列表:
		if str(资源点["ID"]) == 资源点ID:
			目标 = 资源点
			break
	if 目标.is_empty():
		return {"成功": false, "原因": "资源点不存在"}
	var 类型: String = str(目标.get("类型", ""))
	var 去向: String = str(资源入库去向.get(类型, ""))
	if 去向 == "":
		return {"成功": false, "原因": "此物不入宗门库藏"}
	var 实收: int = 数量
	if 实收 < 0:
		var 配置: Dictionary = 资源点配置.get(类型, {})
		var 基础产量: int = int(配置.get("基础产量", 50))
		var 等级: int = int(目标.get("等级", 1))
		var 距离: float = float(目标.get("距离", 100))
		var 距离衰减: float = clampf(1.0 - 距离 / 1000.0, 0.5, 1.0)
		实收 = int(float(基础产量) * float(等级) * 距离衰减)
	if 实收 <= 0:
		return {"成功": false, "原因": "此次一无所获"}
	match 去向:
		"灵气":
			Game.灵气 += 实收
		"矿石":
			Game.矿石 += 实收
		"灵草":
			Game.灵草 += 实收
		"妖兽材料":
			var 境界序: Array = ["练气", "筑基", "金丹", "元婴", "化神"]
			var 境界名: String = str(境界序[clampi(int(目标.get("等级", 1)) - 1, 0, 境界序.size() - 1)])
			if Game.has_method("增加妖兽材料"):
				Game.增加妖兽材料(境界名, maxi(1, 实收 / 10), 0)
			else:
				Game.灵石 += 实收
	累计采集次数 += 1
	return {"成功": true, "去向": 去向, "数量": 实收, "资源点": str(目标.get("名称", ""))}

# ---------- 1.4 凡人王朝联动（适配 DynastySystem.郡县状态 —— 唯一真源，不自建好感度表）----------
func _郡县(城镇ID: String) -> Dictionary:
	if Game.王朝系统 == null:
		return {}
	return Game.王朝系统.郡县状态.get(城镇ID, {})

# 城池隶属：凡俗郡归当朝，修仙界城池（紫府仙都/妖族领等）不入王朝版图
func 获取城镇势力(城镇ID: String) -> String:
	var 郡: Dictionary = _郡县(城镇ID)
	if 郡.is_empty():
		return "修仙界"
	if not bool(郡.get("凡俗", false)):
		return "修仙界"
	var 王朝: Dictionary = Game.王朝系统.王朝
	return str(王朝.get("国号", "凡俗王朝"))

# 城镇好感（真源：郡县状态.感恩 —— 与 city_config.gratitude 同源）
func 获取城镇好感度(城镇ID: String) -> int:
	return int(_郡县(城镇ID).get("感恩", 0))

# 改变城镇好感（写穿到 郡县状态，0~100 封顶）
func 改变城镇好感度(城镇ID: String, 变化值: int) -> Dictionary:
	var 郡: Dictionary = _郡县(城镇ID)
	if 郡.is_empty():
		return {"成功": false, "原因": "此城不在王朝版图之内"}
	var 旧: int = int(郡.get("感恩", 0))
	var 新: int = clampi(旧 + 变化值, 0, 100)
	郡["感恩"] = 新
	return {"成功": true, "旧": 旧, "新": 新, "变化": 新 - 旧}

# 城镇通商（商路收益随好感与距离浮动；每城 7 日一次，需先有往来）
func 城镇通商(城镇ID: String) -> Dictionary:
	if 城镇ID not in 城镇坐标表:
		return {"成功": false, "原因": "未知城镇"}
	var 键: String = "通商_%s" % 城镇ID
	var 冷却止: int = int(城镇通商记录.get(键, 0))
	if Game.累计游戏日 < 冷却止:
		return {"成功": false, "原因": "商路尚在整备，还需%d日" % (冷却止 - Game.累计游戏日)}
	var 好感: int = 获取城镇好感度(城镇ID)
	if 好感 <= 0:
		return {"成功": false, "原因": "该城与宗门素无往来，需先朝贡通好"}
	var 城镇: Dictionary = 城镇坐标表[城镇ID]
	var 距离: float = 计算到城镇距离(城镇ID)
	var 收益: int = maxi(20, int(200.0 + float(好感) * 12.0 - 距离 * 0.5))
	Game.灵石 += 收益
	城镇通商记录[键] = Game.累计游戏日 + 7
	改变城镇好感度(城镇ID, 1)
	Game.添加纪事("商贸", "城镇通商", "与%s通商，得灵石%d，两地情谊更笃。" % [str(城镇.get("名称", "")), 收益], 0)
	return {"成功": true, "城镇": str(城镇.get("名称", "")), "收益": 收益, "好感": 好感, "下次可通商": Game.累计游戏日 + 7}

# 城镇朝贡（以灵石结好：感恩 +3、声望 +2；灵石不足则不成）
func 城镇朝贡(城镇ID: String) -> Dictionary:
	if 城镇ID not in 城镇坐标表:
		return {"成功": false, "原因": "未知城镇"}
	# 朝贡乃王朝之礼：只在王朝直辖（凡俗）郡县可行
	var 郡: Dictionary = _郡县(城镇ID)
	if 郡.is_empty():
		return {"成功": false, "原因": "此城不在王朝版图之内"}
	if not bool(郡.get("凡俗", false)):
		return {"成功": false, "原因": "此城非王朝之土，无从朝贡"}
	var 消耗: int = 300
	if Game.灵石 < 消耗:
		return {"成功": false, "原因": "灵石不足，需%d灵石" % 消耗}
	Game.灵石 -= 消耗
	var 变化: Dictionary = 改变城镇好感度(城镇ID, 3)
	Game.声望 += 2
	Game.添加纪事("商贸", "城镇朝贡", "遣使往%s朝贡，灵石%d，两地情谊渐厚。" % [str(城镇坐标表[城镇ID].get("名称", "")), 消耗], 0)
	return {"成功": true, "城镇": str(城镇坐标表[城镇ID].get("名称", "")), "消耗": 消耗, "好感变化": 变化, "声望": 2}

