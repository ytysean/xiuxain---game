## 参战正魔大战
func 参战正魔大战(弟子: Disciple, 战场: String = "中场") -> Dictionary:
	if 弟子 == null or 弟子.正魔阵营 == "":
		return {"成功": false, "因": "弟子未加入阵营"}
	var 今日参战: int = 0
	for 记录 in 正魔大战状态.get("参战记录", []):
		if int(记录.get("弟子ID", -1)) == 弟子.弟子ID and int(记录.get("时间", 0)) == Game.累计游戏日:
			今日参战 += 1
	if 今日参战 >= int(_正魔大战配置["每日参战上限"]):
		return {"成功": false, "因": "今日参战次数已用完"}
	var 危险度: float = float(_正魔大战配置["战场"].get(战场, {}).get("危险度", 0.7))
	var 基础战功: int = int(50 * 危险度 * (1.0 + 弟子.计算战力() / 10000.0))
	var 伤亡概率: float = 0.1 * 危险度
	var 获得战功: int = 基础战功
	var 伤亡: bool = false
	if randf() < 伤亡概率:
		伤亡 = true
		获得战功 = int(获得战功 * 0.5)
		弟子.状态 = "养伤"
	if 弟子.正魔阵营 == "正道":
		正魔大战状态["正道战功"] = int(正魔大战状态.get("正道战功", 0)) + 获得战功
	else:
		正魔大战状态["魔道战功"] = int(正魔大战状态.get("魔道战功", 0)) + 获得战功
	弟子.正魔战功 = int(弟子.正魔战功) + 获得战功
	正魔大战状态["参战记录"].append({"弟子ID": 弟子.弟子ID, "阵营": 弟子.正魔阵营, "战场": 战场, "战功": 获得战功, "伤亡": 伤亡, "时间": Game.累计游戏日})
	return {"成功": true, "获得战功": 获得战功, "伤亡": 伤亡, "当前战功": 弟子.正魔战功}

