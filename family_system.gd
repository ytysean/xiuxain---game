## 发起拍卖
func 发起拍卖(物品ID: String, 物品名: String, 品阶: String, 起拍价: int, 卖家ID: String, 卖家类型: String) -> Dictionary:
	if 物品ID == "" or 起拍价 <= 0:
		return {"成功": false, "因": "参数无效"}
	var 拍卖时长: int = int(_拍卖行配置["拍卖时长"].get(品阶, 24))
	var 佣金: float = float(_拍卖行配置["佣金比例"].get(品阶, 0.05))
	var 拍卖ID: String = "auction_%d" % randi()
	var 拍卖品: Dictionary = {
		"ID": 拍卖ID, "物品ID": 物品ID, "物品名": 物品名, "品阶": 品阶,
		"起拍价": 起拍价, "当前价": 起拍价, "卖家ID": 卖家ID, "卖家类型": 卖家类型,
		"开始时间": Game.累计游戏日, "结束时间": Game.累计游戏日 + 拍卖时长,
		"竞价列表": [], "佣金比例": 佣金, "状态": "进行中"
	}
	拍卖行列表.append(拍卖品)
	Game.添加纪事("拍卖行", "发起拍卖", "%s 发起拍卖「%s」，起拍价%d灵石" % [卖家ID, 物品名, 起拍价], 1)
	return {"成功": true, "拍卖ID": 拍卖ID, "结束时间": Game.累计游戏日 + 拍卖时长}

## 参与竞价
func 参与竞价(拍卖ID: String, 买家ID: String, 买家类型: String, 出价: int) -> Dictionary:
	var 拍卖品: Dictionary = {}
	var 索引: int = -1
	for i in range(拍卖行列表.size()):
		if str(拍卖行列表[i].get("ID", "")) == 拍卖ID:
			拍卖品 = 拍卖行列表[i]
			索引 = i
			break
	if 拍卖品.is_empty() or str(拍卖品.get("状态", "")) != "进行中":
		return {"成功": false, "因": "拍卖不存在或已结束"}
	var 品阶: String = str(拍卖品.get("品阶", "普通"))
	var 最低加价: int = int(_拍卖行配置["最低加价"].get(品阶, 10))
	var 当前价: int = int(拍卖品.get("当前价", 0))
	if 出价 < 当前价 + 最低加价:
		return {"成功": false, "因": "出价过低，最低加价%d" % 最低加价}
	拍卖品["当前价"] = 出价
	拍卖品["竞价列表"].append({"买家ID": 买家ID, "买家类型": 买家类型, "出价": 出价, "时间": Game.累计游戏日})
	拍卖行列表[索引] = 拍卖品
	return {"成功": true, "当前价": 出价}

## 结算拍卖（每月自动调用）
func 结算拍卖行() -> Dictionary:
	var 结算记录: Array = []
	var 已结束: Array = []
	for i in range(拍卖行列表.size()):
		var 拍卖品: Dictionary = 拍卖行列表[i]
		if Game.累计游戏日 >= int(拍卖品.get("结束时间", 0)) and str(拍卖品.get("状态", "")) == "进行中":
			拍卖品["状态"] = "已结束"
			var 竞价列表: Array = 拍卖品.get("竞价列表", [])
			if not 竞价列表.is_empty():
				var 最高竞价: Dictionary = 竞价列表[竞价列表.size() - 1]
				var 成交价: int = int(最高竞价.get("出价", 0))
				var 佣金: int = int(成交价 * float(拍卖品.get("佣金比例", 0.05)))
				var 卖家所得: int = 成交价 - 佣金
				结算记录.append("「%s」以%d灵石成交，卖家得%d，佣金%d" % [str(拍卖品.get("物品名", "")), 成交价, 卖家所得, 佣金])
				拍卖行历史.append(拍卖品)
			else:
				结算记录.append("「%s」流拍" % str(拍卖品.get("物品名", "")))
			已结束.append(i)
	# 移除已结束的拍卖
	for i in range(已结束.size() - 1, -1, -1):
		拍卖行列表.remove_at(已结束[i])
	# NPC自动参与竞价
	if randf() < float(_拍卖行配置.get("NPC参与概率", 0.6)) and not 拍卖行列表.is_empty():
		var 随机拍卖: Dictionary = 拍卖行列表[randi() % 拍卖行列表.size()]
		var 品阶: String = str(随机拍卖.get("品阶", "普通"))
		var 最低加价: int = int(_拍卖行配置["最低加价"].get(品阶, 10))
		var NPC出价: int = int(随机拍卖.get("当前价", 0)) + 最低加价 * (1 + randi() % 3)
		参与竞价(str(随机拍卖.get("ID", "")), "NPC_商人_%d" % randi(), "NPC", NPC出价)
		结算记录.append("NPC商人参与竞价「%s」，出价%d" % [str(随机拍卖.get("物品名", "")), NPC出价])
	return {"成功": true, "结算记录": 结算记录, "进行中数量": 拍卖行列表.size()}

## 获取拍卖行列表（UI用）
func 获取拍卖行列表(品阶过滤: String = "", 状态过滤: String = "进行中") -> Array:
	var 结果: Array = []
	for 拍卖品 in 拍卖行列表:
		if 品阶过滤 != "" and str(拍卖品.get("品阶", "")) != 品阶过滤:
			continue
		if 状态过滤 != "" and str(拍卖品.get("状态", "")) != 状态过滤:
			continue
		结果.append(拍卖品)
	结果.sort_custom(func(a, b): return a["当前价"] > b["当前价"])
	return 结果
