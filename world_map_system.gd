# 与商道系统联动：计算商队运输详情
func 计算商队运输详情(目标城镇ID: String, 运输方式: String = "普通商队") -> Dictionary:
	if 目标城镇ID not in 城镇坐标表:
		return {"成功": false, "原因": "目标城镇不存在"}
	var 距离: float = 计算到城镇距离(目标城镇ID)
	var 运输时间: int = 计算运输时间(距离, 运输方式)
	var 被劫风险: float = 计算被劫风险(距离, 运输方式)
	var 城镇: Dictionary = 城镇坐标表[目标城镇ID]
	# 运输费用
	var 基础费用: int = int(距离 * 2)
	match 运输方式:
		"普通商队":
			基础费用 = int(距离 * 2)
		"精锐商队":
			基础费用 = int(距离 * 5)
		"传送阵":
			基础费用 = 500  # 固定灵晶费用
	return {
		"成功": true,
		"目标城镇": 城镇["名称"],
		"距离": 距离,
		"运输方式": 运输方式,
		"运输时间": 运输时间,
		"被劫风险": 被劫风险,
		"运输费用": 基础费用,
		"区域": 城镇["区域"],
	}

# 与宗门战联动：计算出征详情
func 计算宗门战出征详情(目标宗门: Dictionary) -> Dictionary:
	var 目标区域: String = str(目标宗门.get("区域", 区域_中州))
	var 目标x: float = float(目标宗门.get("x", 0.0))
	var 目标y: float = float(目标宗门.get("y", 0.0))
	var 行军时间: int = 计算行军时间(目标区域, 目标x, 目标y)
	var 行军消耗: int = 计算行军消耗(目标区域, 目标x, 目标y)
	var 距离: float = 计算宗门间距离(宗门区域, 宗门坐标X, 宗门坐标Y, 目标区域, 目标x, 目标y)
	# 战力对比
	var 我方战力: int = int(Game.计算宗门总战力()) if Game.has_method("获取宗门总战力") else 5000
	var 敌方战力: int = int(目标宗门.get("战力", 1000))
	var 胜率: float = clamp(float(我方战力) / float(我方战力 + 敌方战力), 0.1, 0.9)
	return {
		"成功": true,
		"目标宗门": 目标宗门.get("名称", "未知宗门"),
		"距离": 距离,
		"行军时间": 行军时间,
		"行军消耗": 行军消耗,
		"我方战力": 我方战力,
		"敌方战力": 敌方战力,
		"预估胜率": 胜率,
		"跨区域": 目标区域 != 宗门区域,
	}

# ===== 死链收口 + 弟子派遣探索（2026-09-12 workbuddy · 任务#004）=====
# 原实现调用 Game.获取弟子信息 / Game.设置弟子状态 —— 二者在 game_state.gd 中并不存在，
# 经 has_method 兜底后恒走 early-return ⇒ 「能编译但永不生效」的假联动（本次实测确认）。
# 现改用真实 API：Game.弟子列表(Array[Disciple]) + Disciple.弟子ID/姓名/状态/境界。
# 外出状态判定沿用项目正统取值（"外派"/"失踪"/"陨落"/"叛出"），不自造 "探索中" 状态位，
# 避免污染 Disciple.状态 字段（弟子外出由本系统 探索中弟子 字典独立记账）。
func _找弟子(弟子ID: Variant) -> Disciple:
	var 目标: int = int(弟子ID)
	for d in Game.弟子列表:
		if d is Disciple and int(d.弟子ID) == 目标:
			return d
	return null

# 弟子是否在探索中
func _探索中(弟子ID: int) -> bool:
	return 探索中弟子.has(str(弟子ID))

# 与弟子系统联动：派遣弟子探索大地图（真实版）
func 派遣弟子探索(弟子ID: String, 探索天数: int = 3) -> Dictionary:
	var 弟子: Disciple = _找弟子(弟子ID)
	if 弟子 == null:
		return {"成功": false, "原因": "宗门中并无此弟子"}
	if _探索中(int(弟子.弟子ID)):
		return {"成功": false, "原因": "%s 尚在外游历，未及归宗" % str(弟子.姓名)}
	if str(弟子.状态) == "失踪" or str(弟子.状态) == "陨落" or str(弟子.状态) == "叛出" or str(弟子.状态) == "外派":
		return {"成功": false, "原因": "%s 正值%s，无法派遣" % [str(弟子.姓名), str(弟子.状态)]}
	var 灵石消耗: int = 探索天数 * 100
	if Game.灵石 < 灵石消耗:
		return {"成功": false, "原因": "灵石不足，需%d灵石" % 灵石消耗}
	Game.灵石 -= 灵石消耗
	探索中弟子[str(弟子.弟子ID)] = {
		"弟子ID": int(弟子.弟子ID),
		"姓名": str(弟子.姓名),
		"出发日": Game.累计游戏日,
		"返回日": Game.累计游戏日 + 探索天数,
		"区域": 宗门区域,
		"剩余天数": 探索天数,
	}
	Game.添加纪事("探索", "派遣探索", "%s领了宗门差事，携灵石%d往%s而去，约%d日方归。" % [str(弟子.姓名), 灵石消耗, 宗门区域, 探索天数], 1)
	return {"成功": true, "弟子": str(弟子.姓名), "探索天数": 探索天数, "消耗": 灵石消耗, "返回日": Game.累计游戏日 + 探索天数}

# 获取探索中的弟子（UI 列表消费）
func 获取探索中弟子() -> Array:
	var 列表: Array = []
	for k in 探索中弟子.keys():
		var 记: Dictionary = 探索中弟子[k]
		记["剩余天数"] = maxi(0, int(记.get("返回日", 0)) - Game.累计游戏日)
		列表.append(记)
	return 列表

# 检查并结算已归来的弟子（UI 刷新时调用）
func 检查探索归来() -> Array:
	var 归来: Array = []
	for k in 探索中弟子.keys().duplicate():
		var 记: Dictionary = 探索中弟子[k]
		if Game.累计游戏日 >= int(记.get("返回日", 0)):
			归来.append(弟子探索返回结算(str(k)))
	return 归来

# 弟子探索返回结算（真实版）
func 弟子探索返回结算(弟子ID: String) -> Dictionary:
	var 弟子: Disciple = _找弟子(弟子ID)
	if 弟子 == null:
		return {"成功": false, "原因": "宗门中并无此弟子"}
	if not _探索中(int(弟子.弟子ID)):
		return {"成功": false, "原因": "%s 并不在外游历" % str(弟子.姓名)}
	# 结算：境界越高见识越广，收获越丰（与弟子境界真源挂钩，非拍脑袋）
	var 境界序: Array = ["练气", "筑基", "金丹", "元婴", "化神", "炼虚", "合体", "大乘", "渡劫"]
	var 境位: int = maxi(0, 境界序.find(str(弟子.境界)))
	var 倍: float = 1.0 + 0.25 * float(境位)
	# P2-3.1：同盟协防 → 同域盟宗越多，行路越安、收获随之增益（「组队探索」的机制落点）
	var 协防: Dictionary = 获取同盟协防(宗门区域)
	var 协防倍: float = 1.0 + float(协防.get("危险削减", 0.0)) * 0.5
	var 灵石收获: int = int(randi_range(100, 500) * 倍 * 协防倍)
	var 声望收获: int = int(randi_range(5, 30) * 倍 * 协防倍)
	Game.灵石 += 灵石收获
	Game.声望 += 声望收获
	# 归来途中 30% 概率撞见大地图事件
	var 触发事件: bool = randf() < 0.3
	var 事件结果: Dictionary = {}
	if 触发事件:
		事件结果 = 触发大地图事件()
	# 顺路探明周边未发现的资源点（探索与资源系统咬合）
	var 发现: Array = []
	for 资源点 in 资源点列表:
		if not bool(资源点.get("已发现", false)) and randf() < 0.35:
			发现资源点(str(资源点["ID"]))
			发现.append(str(资源点["名称"]))
	var 附言: String = ""
	if not 发现.is_empty():
		附言 = "，并探明了%s" % "、".join(发现)
	探索中弟子.erase(str(弟子.弟子ID))
	Game.添加纪事("探索", "探索归来", "%s游历归来，得灵石%d、声望%d%s。" % [str(弟子.姓名), 灵石收获, 声望收获, 附言], 1)
	return {"成功": true, "弟子": str(弟子.姓名), "收获": {"灵石": 灵石收获, "声望": 声望收获}, "发现资源点": 发现, "触发事件": 触发事件, "事件结果": 事件结果, "同盟协防": 协防}

## 收口（2026-09-12）：原为 Python 生成器表达式 sum(1 for ... if ...)，GDScript 不支持
## → 门1 PARSE ERROR + 连带门3 全文件函数误报为「新增死函数」。
func _计数已发现资源点() -> int:
	var 计数: int = 0
	for r in 资源点列表:
