## 触发王朝事件
func 触发王朝事件(事件类型: String, 郡: String = "") -> Dictionary:
	if not _王朝事件配置.has(事件类型):
		return {"成功": false, "因": "事件类型不存在"}
	var 事件: Dictionary = _王朝事件配置[事件类型]
	var 事件记录: Dictionary = {"时间": Game.累计游戏日, "类型": 事件类型, "名": str(事件.get("名", "")), "描述": str(事件.get("描述", "")), "郡": 郡}
	if not Game.王朝系统.王朝.has("事件列表"):
		Game.王朝系统.王朝["事件列表"] = []
	(Game.王朝系统.王朝["事件列表"] as Array).append(事件记录)
	Game.添加纪事("凡人王朝", "王朝事件", "%s：%s" % [str(事件.get("名", "")), str(事件.get("描述", ""))], 2)
	return {"成功": true, "事件名": str(事件.get("名", ""))}

## 王朝办差优化（P2）
func 王朝办差优化(弟子: Disciple, 差事类型: String, 郡: String) -> Dictionary:
	if 弟子 == null or 差事类型 == "":
		return {"成功": false, "因": "参数无效"}
	var 基础奖励: Dictionary = {"灵石": 50, "Game.声望": 10, "贡献": 5}
	var 差事难度: float = 1.0
	var 成功率: float = 0.7 + float(弟子.资质) * 0.03
	var 奇遇概率: float = 0.15
	var 获得奇遇: bool = false
	var 奇遇类型: String = ""
	if randf() > 成功率:
		return {"成功": false, "因": "办差失败", "成功率": 成功率}
	if randf() < 奇遇概率:
		获得奇遇 = true
		var 奇遇列表: Array = ["偶遇贵人", "发现遗迹", "收服人才", "获得宝物", "化解危机"]
		奇遇类型 = 奇遇列表[randi() % 奇遇列表.size()]
		基础奖励["灵石"] = int(基础奖励["灵石"] * 2)
		基础奖励["Game.声望"] = int(基础奖励["Game.声望"] * 2)
	var 实际奖励: Dictionary = {"灵石": int(基础奖励["灵石"] * 差事难度), "Game.声望": int(基础奖励["Game.声望"] * 差事难度), "贡献": int(基础奖励["贡献"] * 差事难度)}
	Game.添加纪事("凡人王朝", "办差完成", "%s 在%s完成%s差事%s" % [弟子.姓名, 郡, 差事类型, "，触发奇遇：" + 奇遇类型 if 获得奇遇 else ""], 1)
	return {"成功": true, "奖励": 实际奖励, "获得奇遇": 获得奇遇, "奇遇类型": 奇遇类型}

## 获取王朝状态（UI用）
func 获取王朝状态() -> Dictionary:
	var 事件表: Array = Game.王朝系统.王朝.get("事件列表", []) as Array
	return {
		"当前事件": 事件表.back() if not 事件表.is_empty() else {},
		"历史事件": 事件表.slice(max(0, 事件表.size() - 10), 事件表.size()),
		"办差统计": Game.王朝系统.王朝.get("办差统计", {})
	}

## 三元运算辅助函数
func 三元运算(条件: bool, 真值, 假值):
	if 条件:
		return 真值
	else:
		return 假值

