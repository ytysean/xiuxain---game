# 添加待交割物品
func _添加待交割(lot: Dictionary, 成交价: int) -> void:
	var 交割: Dictionary = {
		"id": "deliver_%d_%d" % [Game.累计游戏日, randi() % 100000],
		"物品": lot.get("物品", {}),
		"物品名": lot.get("名称", ""),
		"品阶": lot.get("品阶", ""),
		"成交价": 成交价,
		"交割方式": "待选择",  # 当场交割/委托护送/自行带回
		"状态": "待交割",
		"成交日": Game.累计游戏日,
		"被盯上": false,  # 是否被魔道修士盯上
		"打劫风险": 0,   # 打劫风险0-100
	}
	# 根据物品价值判断是否被盯上
	var 品阶序: Array = ["凡阶", "灵阶", "宝阶", "王阶", "圣阶", "仙阶", "道阶", "神阶"]
	var 品阶索引: int = 品阶序.find(str(lot.get("品阶", "凡阶")))
	if 品阶索引 >= 3:  # 王阶以上被盯上
		交割["被盯上"] = true
		交割["打劫风险"] = min(90, 30 + 品阶索引 * 10)
	(全服拍卖["待交割列表"] as Array).append(交割)
	Game.添加纪事("全服拍卖", "待交割", "「%s」已成交，请选择交割方式。" % str(lot.get("名称", "")), 2)

# 选择交割方式
func 选择交割方式(交割ID: String, 方式: String, 护送境界: String = "金丹期") -> Dictionary:
	for d in 全服拍卖.get("待交割列表", []):
		if str(d.get("id", "")) == 交割ID and str(d.get("状态", "")) == "待交割":
			d["交割方式"] = 方式
			match 方式:
				"当场交割":
					return _当场交割(d)
				"委托护送":
					return _委托护送(d, 护送境界)
				"自行带回":
					return _自行带回(d)
	return {"成功": false, "原因": "交割单不存在或已处理。"}

# 计算护送费用（按境界）
func 计算护送费(成交价: int, 境界: String) -> int:
	var 比例: float = 0.03
	var 最低: int = 100
	match 境界:
		"金丹期":
			比例 = 0.03
			最低 = 100
		"元婴期":
			比例 = 0.05
			最低 = 200
		"化神期":
			比例 = 0.08
			最低 = 500
		"炼虚期":
			比例 = 0.10
			最低 = 1000
	return max(最低, int(float(成交价) * 比例))

# 获取护送境界列表
func 获取护送境界列表() -> Array:
	return [
		{"境界": "金丹期", "高手": "聚宝阁·金护法", "比例": "3%", "最低": 100, "安全度": "一般", "风险系数": 0.5},
		{"境界": "元婴期", "高手": "聚宝阁·银长老", "比例": "5%", "最低": 200, "安全度": "较高", "风险系数": 0.3},
		{"境界": "化神期", "高手": "聚宝阁·铜供奉", "比例": "8%", "最低": 500, "安全度": "高", "风险系数": 0.15},
		{"境界": "炼虚期", "高手": "聚宝阁·铁判官", "比例": "10%", "最低": 1000, "安全度": "极高", "风险系数": 0.05},
	]

# 当场交割（直接入库房，安全但可能被盯上）
func _当场交割(d: Dictionary) -> Dictionary:
	var it_dict: Dictionary = d.get("物品", {})
	var it: Item = Item.new()
	it.from_dict(it_dict)
	Game.宗门库房.append(it)
	d["状态"] = "已交割"
	Game.添加纪事("全服拍卖", "当场交割", "「%s」当场交割完毕，已入宗门库房。" % str(d.get("物品名", "")), 1)
	# 如果被盯上，离开拍卖行后可能被打劫
	if bool(d.get("被盯上", false)):
		_触发打劫(d, "当场交割")
	return {"成功": true, "原因": "当场交割完毕，物品已入库房。"}

# 委托护送（交费，拍卖行高手护送，安全）
func _委托护送(d: Dictionary, 境界: String = "金丹期") -> Dictionary:
	var 成交价: int = int(d.get("成交价", 0))
	var 护送费: int = 计算护送费(成交价, 境界)
	if Game.灵石 < 护送费:
		return {"成功": false, "原因": "灵石不足，%s护送费需%d灵石。" % [境界, 护送费]}
	Game.灵石 -= 护送费
	# 获取护送高手
	var 高手名: String = "聚宝阁·金护法（金丹期）"
	var 风险系数: float = 0.5
	for g in 获取护送境界列表():
		if str(g.get("境界", "")) == 境界:
			高手名 = "%s（%s）" % [str(g.get("高手", "")), 境界]
			风险系数 = float(g.get("风险系数", 0.5))
			break
	# 创建护送任务
	var 任务: Dictionary = {
		"id": "escort_%d_%d" % [Game.累计游戏日, randi() % 100000],
		"交割ID": d.get("id", ""),
		"物品": d.get("物品", {}),
		"物品名": d.get("物品名", ""),
		"护送费": 护送费,
		"护送境界": 境界,
		"风险系数": 风险系数,
		"状态": "护送中",
		"开始日": Game.累计游戏日,
		"到达日": Game.累计游戏日 + randi_range(3, 7),  # 3-7游戏日送达
		"护送高手": 高手名,
	}
	(全服拍卖["护送任务列表"] as Array).append(任务)
	d["状态"] = "护送中"
	d["护送境界"] = 境界
	d["风险系数"] = 风险系数
	全服拍卖["累计护送次数"] = int(全服拍卖.get("累计护送次数", 0)) + 1
	Game.添加纪事("全服拍卖", "委托护送", "「%s」委托%s护送，护送费%d灵石，预计%d日送达。" % [str(d.get("物品名", "")), 高手名, 护送费, int(任务.get("到达日", 0)) - int(任务.get("开始日", 0))], 2)
	return {"成功": true, "原因": "委托%s护送成功，%d日后送达。" % [境界, int(任务.get("到达日", 0)) - int(任务.get("开始日", 0))]}

# 自行带回（不交费，有被打劫风险）
func _自行带回(d: Dictionary) -> Dictionary:
	d["状态"] = "自行带回中"
	Game.添加纪事("全服拍卖", "自行带回", "「%s」由宗主自行带回宗门，路上需小心魔道修士。" % str(d.get("物品名", "")), 1)
	# 触发打劫判定
	if bool(d.get("被盯上", false)):
		_触发打劫(d, "自行带回")
	else:
		# 没被盯上，安全带回
		var it_dict: Dictionary = d.get("物品", {})
		var it: Item = Item.new()
		it.from_dict(it_dict)
		Game.宗门库房.append(it)
		d["状态"] = "已交割"
		Game.添加纪事("全服拍卖", "安全带回", "「%s」安全带回宗门，已入库房。" % str(d.get("物品名", "")), 1)
	return {"成功": true, "原因": "自行带回，%s" % ("遭遇打劫！" if bool(d.get("被盯上", false)) else "安全到达。")}

# 触发打劫
func _触发打劫(d: Dictionary, 场景: String) -> void:
	全服拍卖["累计被打劫次数"] = int(全服拍卖.get("累计被打劫次数", 0)) + 1
	var 风险: int = int(d.get("打劫风险", 30))
	if 场景 == "委托护送":
		# 根据护送境界调整风险系数
		var 风险系数: float = float(d.get("风险系数", 0.5))
		风险 = int(float(风险) * 风险系数)
	# 打劫判定
	if randf() * 100 < 风险:
		# 被打劫了！
		_打劫结算(d, 场景, true)
	else:
		# 躲过打劫
		_打劫结算(d, 场景, false)

# 打劫结算
func _打劫结算(d: Dictionary, 场景: String, 被打劫: bool) -> void:
	var 记录: Dictionary = {
		"物品": d.get("物品名", ""),
		"场景": 场景,
		"被打劫": 被打劫,
		"日": Game.累计游戏日,
		"打劫者": "",
		"结果": "",
	}
	if 被打劫:
		# 玩家可以选择战斗或交出物品
		var 打劫者: String = _随机打劫者()
		记录["打劫者"] = 打劫者
		# 简化：玩家宗门战力 vs 打劫者战力
		var 玩家战力: int = Game.宗门总战力 if "宗门总战力" in Game else 1000
		var 打劫者战力: int = randi_range(500, 5000)
		if 玩家战力 >= 打劫者战力:
			# 玩家胜利，击退打劫者
			记录["结果"] = "击退"
			var it_dict: Dictionary = d.get("物品", {})
			var it: Item = Item.new()
			it.from_dict(it_dict)
			Game.宗门库房.append(it)
			d["状态"] = "已交割"
			Game.添加纪事("全服拍卖", "击退打劫", "遭遇%s打劫！宗主率众击退，「%s」安全带回。" % [打劫者, str(d.get("物品名", ""))], 2)
			# 获得战利品
			var 战利品: int = randi_range(100, 1000)
			Game.灵石 += 战利品
			Game.添加纪事("全服拍卖", "战利品", "击退%s，缴获%d灵石。" % [打劫者, 战利品], 1)
		else:
			# 玩家失败，物品被抢
			记录["结果"] = "被抢"
			d["状态"] = "被抢"
			Game.添加纪事("全服拍卖", "被打劫", "遭遇%s打劫！不敌对方，「%s」被抢走！" % [打劫者, str(d.get("物品名", ""))], 3)
			# 损失声望
			if "宗门声望" in Game:
				Game.宗门声望 = max(0, int(Game.宗门声望) - 10)
	else:
		# 躲过打劫
		记录["结果"] = "躲过"
		var it_dict: Dictionary = d.get("物品", {})
		var it: Item = Item.new()
		it.from_dict(it_dict)
		Game.宗门库房.append(it)
		d["状态"] = "已交割"
		Game.添加纪事("全服拍卖", "躲过打劫", "虽有魔道修士窥伺，但「%s」侥幸躲过，安全带回宗门。" % str(d.get("物品名", "")), 1)
	(全服拍卖["打劫记录"] as Array).append(记录)

# 随机打劫者
func _随机打劫者() -> String:
	var 打劫者: Array = [
		"魔道·血手判官",
		"魔道·噬魂老祖",
		"散修·黑风寨寨主",
		"妖族·赤焰狼王",
		"邪修·百鬼道人",
		"马贼·铁鹞子",
	]
	return 打劫者[randi() % 打劫者.size()]

# 推进护送任务
func _推进护送任务() -> void:
	for t in 全服拍卖.get("护送任务列表", []):
		if str(t.get("状态", "")) != "护送中":
			continue
		if int(Game.累计游戏日) >= int(t.get("到达日", 0)):
			# 护送到达
			t["状态"] = "已送达"
			var it_dict: Dictionary = t.get("物品", {})
			var it: Item = Item.new()
			it.from_dict(it_dict)
			Game.宗门库房.append(it)
			Game.添加纪事("全服拍卖", "护送达", "聚宝阁高手%s将「%s」安全送达宗门，已入库房。" % [str(t.get("护送高手", "")), str(t.get("物品名", ""))], 2)
			# 更新交割状态
			for d in 全服拍卖.get("待交割列表", []):
				if str(d.get("id", "")) == str(t.get("交割ID", "")):
					d["状态"] = "已交割"

# 玩家打劫NPC（可选玩法）
func 玩家打劫NPC(NPC名: String) -> Dictionary:
	# 检查是否有可打劫的目标
	var 可打劫: Array = _获取可打劫目标()
	if 可打劫.is_empty():
		return {"成功": false, "原因": "当前无可打劫目标。"}
	# 打劫判定
	var 目标: Dictionary = 可打劫[randi() % 可打劫.size()]
	var 玩家战力: int = Game.宗门总战力 if "宗门总战力" in Game else 1000
	var 目标战力: int = int(目标.get("战力", 1000))
	if 玩家战力 >= 目标战力 * 1.2:
		# 打劫成功
		全服拍卖["累计打劫成功次数"] = int(全服拍卖.get("累计打劫成功次数", 0)) + 1
		var 战利品: int = randi_range(500, 5000)
		Game.灵石 += 战利品
		Game.添加纪事("全服拍卖", "打劫成功", "宗主率众打劫%s成功，缴获%d灵石！但此举有损正道声望。" % [str(目标.get("名", "")), 战利品], 2)
		# 损失正道声望
		if "正道声望" in Game:
			Game.正道声望 = max(0, int(Game.正道声望) - 20)
		return {"成功": true, "原因": "打劫成功！缴获%d灵石。" % 战利品}
	else:
		# 打劫失败
		Game.添加纪事("全服拍卖", "打劫失败", "宗主打劫%s失败，对方实力更强，悻悻而归。" % str(目标.get("名", "")), 1)
		return {"成功": false, "原因": "打劫失败，对方实力更强。"}

# 获取可打劫目标
func _获取可打劫目标() -> Array:
	var 目标: Array = []
	# 模拟其他竞拍者
	for 买家 in _模拟买家池:
		if randf() < 0.3:  # 30%概率有可打劫目标
			目标.append({
				"名": str(买家.get("名", "")),
				"战力": randi_range(500, 3000),
				"携带物品": "随机宝物",
			})
	return 目标

# 获取待交割列表
func 获取待交割列表() -> Array:
	return 全服拍卖.get("待交割列表", [])

# 获取护送任务列表
func 获取护送任务列表() -> Array:
	return 全服拍卖.get("护送任务列表", [])

# 获取打劫记录
func 获取打劫记录() -> Array:
	return 全服拍卖.get("打劫记录", [])

# ===== 序列化 =====
func to_dict() -> Dictionary:
	return {"全服拍卖": 全服拍卖}

func from_dict(data: Dictionary) -> void:
	if "全服拍卖" in data:
		全服拍卖 = data["全服拍卖"]
	_全服拍卖补缺()
