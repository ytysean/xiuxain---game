## ========== 对外关系扩展功能 ==========
func 获取所有宗门信息() -> Dictionary:
	return 其他宗门配置.duplicate()

func 获取宗门信息(宗门ID: String) -> Dictionary:
	return 其他宗门配置.get(宗门ID, {})

func 改善关系(宗门ID: String, 幅度: float = 0.1) -> void:
	var 当前关系 = 获取对外关系(宗门ID)
	match 当前关系:
		"敌对":
			if randf() < 幅度:
				设置对外关系(宗门ID, "中立")
		"中立":
			if randf() < 幅度:
				设置对外关系(宗门ID, "友好")
		"友好":
			pass  # 已经是友好
		_:
			设置对外关系(宗门ID, "中立")

func 恶化关系(宗门ID: String, 幅度: float = 0.1) -> void:
	var 当前关系 = 获取对外关系(宗门ID)
	match 当前关系:
		"友好":
			if randf() < 幅度:
				设置对外关系(宗门ID, "中立")
		"中立":
			if randf() < 幅度:
				设置对外关系(宗门ID, "敌对")
		"敌对":
			pass  # 已经是敌对
		_:
			设置对外关系(宗门ID, "中立")

func 派遣使者(宗门ID: String) -> Dictionary:
	if not 其他宗门配置.has(宗门ID):
		return {"成功": false, "消息": "未知宗门"}
	var 关系 = 获取对外关系(宗门ID)
	var 成功率 = 0.3
	match 关系:
		"友好":
			成功率 = 0.8
		"中立":
			成功率 = 0.5
		"敌对":
			成功率 = 0.2
	if randf() < 成功率:
		改善关系(宗门ID, 0.2)
		return {"成功": true, "消息": "使者出访成功，关系改善"}
	else:
		return {"成功": false, "消息": "使者出访失败，对方态度冷淡"}

func 发起贸易(宗门ID: String) -> Dictionary:
	if not 其他宗门配置.has(宗门ID):
		return {"成功": false, "消息": "未知宗门"}
	var 关系 = 获取对外关系(宗门ID)
	if 关系 == "敌对":
		return {"成功": false, "消息": "敌对宗门拒绝贸易"}
	var 收益 = randi_range(100, 500)
	return {"成功": true, "消息": "贸易成功，获得%d灵石" % 收益, "收益": 收益}

## ========== 议事会扩展功能 ==========
func 获取可用议题() -> Array:
	return 议事会议题配置.duplicate()

func 随机召开议事会() -> Dictionary:
	if 议事会议题配置.is_empty():
		return {"成功": false, "消息": "暂无可用议题"}
	var 随机议题 = 议事会议题配置[randi() % 议事会议题配置.size()]
	召开议事会(随机议题["议题"], 随机议题["提议"])
	return {"成功": true, "议题": 随机议题["议题"], "提议": 随机议题["提议"]}

func 对议题投票(议事会索引: int, 决定: String) -> Dictionary:
	if 议事会索引 < 0 or 议事会索引 >= _议事会记录.size():
		return {"成功": false, "消息": "无效的议事会索引"}
	记录议事会决议(议事会索引, 决定)
	return {"成功": true, "消息": "已记录决议：" + 决定}
