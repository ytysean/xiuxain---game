# ===== 好感度与关系系统 =====
## 获取与某弟子的好感度
func 获取好感度(目标弟子ID: String) -> int:
	if 好感度缓存.has(目标弟子ID):
		return int(好感度缓存[目标弟子ID])
	return 0

## 设置与某弟子的好感度
func 设置好感度(目标弟子ID: String, 值: int) -> void:
	好感度缓存[目标弟子ID] = clamp(值, 0, 100)

## 增加与某弟子的好感度
func 增加好感度(目标弟子ID: String, 增量: int) -> void:
	var 当前: int = 获取好感度(目标弟子ID)
	设置好感度(目标弟子ID, 当前 + 增量)

## 获取关系等级
func 获取关系等级(目标弟子ID: String) -> String:
	var 好感度: int = 获取好感度(目标弟子ID)
	if 好感度 >= 95:
		return "道侣"
	elif 好感度 >= 80:
		return "道友"
	elif 好感度 >= 60:
		return "好友"
	elif 好感度 >= 40:
		return "朋友"
	elif 好感度 >= 20:
		return "相识"
	else:
		return "陌生"

## 检查是否是道友
func 是道友(目标弟子ID: String) -> bool:
	for 道友 in 道友列表:
		if str(道友.get("弟子ID", "")) == 目标弟子ID:
			return true
	return false

## 检查是否可以结成道友
func 可以结成道友(目标弟子: Disciple) -> bool:
	if 目标弟子 == null:
		return false
	if 弟子ID == 目标弟子.弟子ID:
		return false
	if 是道友(str(目标弟子.弟子ID)):
		return false
	if 道侣 != "":
		return false
	# 好感度>=80才能结成道友
	if 获取好感度(str(目标弟子.弟子ID)) < 80:
		return false
	if 目标弟子.获取好感度(str(弟子ID)) < 80:
		return false
	return true

## 结成道友
func 结成道友(目标弟子: Disciple) -> Dictionary:
	if not 可以结成道友(目标弟子):
		return {"成功": false, "因": "不满足结成道友条件（需好感度>=80）"}
	
	# 互相添加为道友
	var 道友记录1: Dictionary = {"弟子ID": 目标弟子.弟子ID, "好感度": 获取好感度(str(目标弟子.弟子ID)), "时间": 0}
	道友列表.append(道友记录1)
	var 道友记录2: Dictionary = {"弟子ID": 弟子ID, "好感度": 目标弟子.获取好感度(str(弟子ID)), "时间": 0}
	目标弟子.道友列表.append(道友记录2)
	
	# 结成道友后好感度+5
	增加好感度(str(目标弟子.弟子ID), 5)
	目标弟子.增加好感度(str(弟子ID), 5)
	
	return {"成功": true, "消息": "%s与%s结为道友！" % [姓名, 目标弟子.姓名]}

## 检查是否可以结成道侣（通婚）
func 可以结成道侣(目标弟子: Disciple) -> bool:
	if 目标弟子 == null:
		return false
	if 弟子ID == 目标弟子.弟子ID:
		return false
	if 道侣 != "" or 目标弟子.道侣 != "":
		return false
	if 境界 not in ["金丹", "元婴", "化神", "炼虚", "合体", "大乘"]:
		return false
	if 目标弟子.境界 not in ["金丹", "元婴", "化神", "炼虚", "合体", "大乘"]:
		return false
	# 好感度>=90才能结成道侣
	if 获取好感度(str(目标弟子.弟子ID)) < 90:
		return false
	if 目标弟子.获取好感度(str(弟子ID)) < 90:
		return false
	# 必须先是道友
	if not 是道友(str(目标弟子.弟子ID)):
		return false
	return true

## 获取好感度增长速率（基于种族/关系/共同活动）
func 获取好感度增长速率(目标弟子: Disciple) -> float:
	var 速率: float = 1.0
	# 同种族+2
	if 种族 == 目标弟子.种族:
		速率 += 2.0
	# 关系好的种族+1
	if Game != null and Game.has_method("获取种族关系"):
		var 关系: int = int(Game.获取种族关系(种族, 目标弟子.种族))
		if 关系 > 50:
			速率 += 1.0
		elif 关系 < -30:
			速率 -= 1.0
	# 同司职+1
	if 司职 == 目标弟子.司职 and 司职 != "":
		速率 += 1.0
	# 心境高+0.5
	速率 += 心境 * 0.005
	return max(0.5, 速率)

