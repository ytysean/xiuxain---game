## 随机生成修真风格功法名字
func 随机生成功法名字(家族名: String = "") -> String:
	var 格式: int = randi() % 4
	var 核心词: String = str(_功法核心词库[randi() % _功法核心词库.size()])
	var 类型词: String = str(_功法类型词库[randi() % _功法类型词库.size()])
	var 前缀: String = str(_功法前缀词库[randi() % _功法前缀词库.size()])
	
	match 格式:
		# 格式1：{家族名}{核心词}{类型词}
		0:
			if 家族名 != "":
				return "%s%s%s" % [家族名, 核心词, 类型词]
			else:
				return "%s%s" % [核心词, 类型词]
		# 格式2：{数字/前缀}{核心词}{类型词}
		1:
			if 前缀 != "":
				return "%s%s%s" % [前缀, 核心词, 类型词]
			else:
				return "%s%s" % [核心词, 类型词]
		# 格式3：{核心词}{核心词}{类型词}（双核心词）
		2:
			var 核心词2: String = str(_功法核心词库[randi() % _功法核心词库.size()])
			return "%s%s%s" % [核心词, 核心词2, 类型词]
		# 格式4：{家族名}{前缀}{核心词}{类型词}
		3:
			if 家族名 != "" and 前缀 != "":
				return "%s%s%s%s" % [家族名, 前缀, 核心词, 类型词]
			else:
				return "%s%s" % [核心词, 类型词]
	return "%s%s" % [核心词, 类型词]

