		"品阶": str(物品.品阶),
		"起拍价": 起拍价,
		"当前价": 起拍价,
		"结束日": Game.累计游戏日 + 时长日,
		"状态": "暗拍中",
		"密封出价列表": [],  # [{出价者, 出价, 时间}]
		"最高出价": 0,
		"最高出价者": "",
		"拍卖师": _获取当前拍卖师_S34(false),
	}
	return 拍品

## 暗拍出价：密封出价，其他人看不到
func 暗拍出价_S34(拍品ID: String, 出价: int) -> Dictionary:
	for lot in 拍卖会.get("常驻拍品", []):
		if str(lot.get("id", "")) == 拍品ID and str(lot.get("品类", "")) == "暗拍":
			if lot.get("状态", "") != "暗拍中":
				return {"成功": false, "原因": "暗拍已结束"}
			if 出价 < int(lot.get("起拍价", 0)):
				return {"成功": false, "原因": "出价不能低于起拍价"}
			if Game.灵石 < 出价:
				return {"成功": false, "原因": "灵石不足"}
			# 记录密封出价
			var 出价记录: Dictionary = {
				"出价者": "玩家",
				"出价": 出价,
				"时间": Game.累计游戏日,
			}
			(lot["密封出价列表"] as Array).append(出价记录)
			# 冻结灵石
			Game.灵石 -= 出价
			lot["玩家冻结灵石"] = int(lot.get("玩家冻结灵石", 0)) + 出价
			return {"成功": true, "原因": "已密封出价 %d Game.灵石，其他人看不到你的出价" % 出价}
	return {"成功": false, "原因": "未找到暗拍拍品"}

## 暗拍结算：最高价得，其他人解冻
func _暗拍结算_S34(lot: Dictionary) -> void:
	var 出价列表: Array = lot.get("密封出价列表", [])
	if 出价列表.is_empty():
		lot["状态"] = "流拍"
		return
	# 找出最高价
	var 最高: int = 0
	var 最高者: String = ""
	for b in 出价列表:
		if int(b.get("出价", 0)) > 最高:
			最高 = int(b.get("出价", 0))
			最高者 = str(b.get("出价者", ""))
	lot["最高出价"] = 最高
	lot["最高出价者"] = 最高者
	lot["当前价"] = 最高
	lot["状态"] = "已结束"
	# 解冻其他人的灵石，扣除最高价
	for b in 出价列表:
		if str(b.get("出价者", "")) == "玩家":
			if str(b.get("出价者", "")) == 最高者:
				# 玩家竞得，扣除最高价，其他已冻结的退还
				var 已冻结: int = int(lot.get("玩家冻结灵石", 0))
				Game.灵石 += (已冻结 - 最高)
			else:
				# 玩家未竞得，全额解冻
				Game.灵石 += int(b.get("出价", 0))

## P2-3：鉴宝玩法
## 未知拍品：需要鉴定才能知道真实价值，鉴定可能增值或贬值
func 创建未知拍品_S34(基础品阶: String, 鉴定费: int) -> Dictionary:
	var 拍品: Dictionary = {
		"id": "未知_" + str(Time.get_unix_time_from_system()),
		"名称": "未知宝物",
		"品类": "鉴宝",
		"显示品阶": "???",
		"真实品阶": 基础品阶,
		"起拍价": 鉴定费,
		"当前价": 鉴定费,
		"结束日": Game.累计游戏日 + 7,
		"状态": "待鉴定",
		"已鉴定": false,
		"鉴定结果": "",
		"增值倍率": 1.0,
	}
	return 拍品

## 鉴定未知拍品：消耗灵石/声望，可能增值或贬值
func 鉴定拍品_S34(拍品ID: String) -> Dictionary:
	for lot in 拍卖会.get("常驻拍品", []):
		if str(lot.get("id", "")) == 拍品ID and str(lot.get("品类", "")) == "鉴宝":
			if bool(lot.get("已鉴定", false)):
				return {"成功": false, "原因": "该拍品已鉴定"}
			var 鉴定费: int = int(lot.get("起拍价", 100))
			if Game.灵石 < 鉴定费:
				return {"成功": false, "原因": "鉴定需要 %d 灵石" % 鉴定费}
			Game.灵石 -= 鉴定费
			var 倍率: float = 1.0
			var 结果: String = ""
			var r: float = randf()
			if r < 0.7:
				倍率 = 1.0
				结果 = "此物确为 %s 品阶，灵气如常，价值无差" % str(lot.get("真实品阶", ""))
			elif r < 0.9:
				倍率 = 1.5 + randf() * 1.5
				结果 = "惊喜！此物暗藏玄机，灵气内敛，实为 %s 上品，价值暴涨 %.1f 倍！" % [str(lot.get("真实品阶", "")), 倍率]
			else:
				倍率 = 0.3 + randf() * 0.4
				结果 = "遗憾...此物华而不实，灵气涣散，实际价值仅为 %.1f 倍" % 倍率
			lot["已鉴定"] = true
			lot["鉴定结果"] = 结果
			lot["增值倍率"] = 倍率
			lot["显示品阶"] = str(lot.get("真实品阶", ""))
			lot["当前价"] = int(float(lot.get("起拍价", 100)) * 倍率)
			return {"成功": true, "原因": 结果, "倍率": 倍率}
	return {"成功": false, "原因": "未找到鉴宝拍品"}

