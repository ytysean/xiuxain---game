## 神识基础值（随境界增长，练气10→渡劫100）
const 神识境界基准: Dictionary = {
	"练气": 10, "筑基": 20, "金丹": 35, "元婴": 50,
	"化神": 65, "炼虚": 75, "合体": 85, "大乘": 95, "渡劫": 100,
}

## 获取神识值（基础值+装备+丹药加成）
func 获取神识() -> float:
	var 基础: float = 神识境界基准.get(境界, 10.0)
	# 装备加成
	for it in 装备.values():
		if it != null and it.效果 != null:
			if "神识" in str(it.效果):
				基础 += 10.0
	# 丹毒影响（丹毒高神识下降）
	基础 -= 丹毒 * 0.1
	return max(1.0, 基础)

## 神识加成（炼丹/炼器成功率，神识每10点+2%成功率，上限+20%）
func 神识生产加成() -> float:
