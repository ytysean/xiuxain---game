[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/top_bar.gd" id="1_tb"]

; 01 屏画布 1:1（Ardot 2:181 顶部资源栏，逻辑 480×64，渲染 1080×144，UI_SCALE=2.25）。
; 子节点全部由 top_bar.gd 在 _ready 内按画布绝对像素坐标构建，
; 本文件只声明根节点 + 顶部锚定，不持有任何色值/坐标字面量。
; offset_bottom 由 top_bar.gd::_ready() 动态设为 BAR_H*UI_SCALE（64×2.25=144），本处仅保留初始兜底值。

[node name="TopBar" type="Control"]
layout_mode = 3
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 92.0
grow_horizontal = 2
mouse_filter = 1
script = ExtResource("1_tb")
