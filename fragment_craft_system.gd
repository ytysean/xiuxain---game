# 检查是否可以合成
static func 可合成(碎片ID: String, 碎片数量: int, 灵石: int) -> Dictionary:
	var 配方 = 合成配方库.get(碎片ID, {})
	if 配方.is_empty():
		return {"可合成": false, "原因": "碎片ID不存在"}
	var 所需数量: int = int(配方.get("所需数量", 999))
	var 额外灵石: int = int(配方.get("额外灵石消耗", 0))
	if 碎片数量 < 所需数量:
		return {"可合成": false, "原因": "碎片不足（需%d，当前%d）" % [所需数量, 碎片数量]}
	if 灵石 < 额外灵石:
		return {"可合成": false, "原因": "灵石不足（需%d，当前%d）" % [额外灵石, 灵石]}
	return {"可合成": true, "原因": "可以合成"}

# 执行合成（简化版本：100%成功率）
# 返回：{成功, 产出ID, 产出类型, 消耗碎片数, 消耗灵石, 原因}
static func 执行合成(碎片ID: String, 碎片数量: int, 灵石: int) -> Dictionary:
	var 检查 = 可合成(碎片ID, 碎片数量, 灵石)
	if not 检查["可合成"]:
		return {"成功": false, "产出ID": "", "产出类型": "", "消耗碎片数": 0, "消耗灵石": 0, "原因": 检查["原因"]}
	var 配方 = 合成配方库.get(碎片ID, {})
	var 所需数量: int = int(配方.get("所需数量", 0))
	var 额外灵石: int = int(配方.get("额外灵石消耗", 0))
	var 产出ID: String = str(配方.get("合成产出ID", ""))
	var 产出类型: String = str(配方.get("合成产出类型", ""))
	return {
		"成功": true,
		"产出ID": 产出ID,
		"产出类型": 产出类型,
		"消耗碎片数": 所需数量,
		"消耗灵石": 额外灵石,
		"原因": "合成成功！获得%s" % str(配方.get("名称", ""))
	}

# 获取所有合成配方列表
static func 获取所有配方() -> Array:
	var 列表: Array = []
	for 碎片ID in 合成配方库.keys():
		var 配方 = 合成配方库[碎片ID]
		列表.append({
			"碎片ID": 碎片ID,
			"名称": 配方.get("名称", ""),
			"类型": 配方.get("类型", ""),
			"所需数量": 配方.get("所需数量", 0),
			"合成产出ID": 配方.get("合成产出ID", ""),
			"合成产出类型": 配方.get("合成产出类型", ""),
			"额外灵石消耗": 配方.get("额外灵石消耗", 0),
			"描述": 配方.get("描述", "")
		})
	return 列表
