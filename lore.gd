	"【测灵根·过场·天品】\n测灵坛石光冲天，引得传功长老亲自出关核验。本届测灵竟检出{top_name}，身具天品灵根，乃百年难遇的先天道体。掌门当即拍板，直接收入内门，列为核心弟子重点培养。其余{total_num}名弟子亦录入外门，本届测灵可谓硕果颇丰。",
	"【测灵根·过场·天品】\n灵根石光华盛放，映得整座测灵坛五色流转。{top_name}上前之时，石身竟生出道韵共鸣，乃是天品灵根。传功长老亲收其为亲传弟子，无需入外门磨砺，直接修习宗门核心功法。余下弟子悉数归入外门，本届大典堪称盛况。",
	"【测灵根·过场·天品】\n钟鼓齐鸣，测灵大典忽生异象——灵根石中迸出一道冲天霞光。值守执事连忙封锁测灵坛，急报掌门亲验。待霞光散去，方知是{top_name}身负天品灵根，根骨清奇、道体天成。掌门大喜，赐下核心弟子令牌，自此与宗门气运相连。其余{total_num}名新晋弟子，尽数编入外门。",
]

# 取测灵根过场（N=人数，新徒=新招弟子数组，天品=true 走天品专属池）
# 变量：{total_num}人数 | {top_name}最佳弟子名 | {top_grade}品阶 | {top_element}属性(天灵根→万法)
# 逻辑：天品→专属池；否则随机1条 → 填{total_num} → 上品及以上填亮点句 / 否则删去
static func 取测灵根过场(N: int, 新徒: Array = [], 天品: bool = false) -> String:
	if 天品:
		var 模板: String = 天品测灵根过场.pick_random()
		var s: String = 模板.replace("{total_num}", str(N))
		for d in 新徒:
			if d is Disciple and d.灵根品阶 == "天品":
				s = s.replace("{top_name}", d.姓名)
				break
		return s
	var 模板: String = 测灵根过场.pick_random()
	var s: String = 模板.replace("{total_num}", str(N))
	# 尝试找最高品质弟子填充亮点
	if 新徒.size() > 0:
		var 最佳: Variant = null
		var 最佳品阶 := -1
		for d in 新徒:
			if d is Disciple:
				var 阶: int = _灵根品阶值(d.灵根品阶)
				if 阶 > 最佳品阶:
					最佳品阶 = 阶
					最佳 = d
		if 最佳 != null and 最佳品阶 >= 2:   # 上品及以上才填亮点（2=上品,3=极品,4=天品）
			var 品阶文本: String = ["", "良品", "上品", "极品", "天品"][最佳品阶]
			var 属性文本: String = "万法" if 最佳.灵根 == "天灵根" else 最佳.灵根
			s = s.replace("{top_name}", 最佳.姓名).replace("{top_grade}", 品阶文本).replace("{top_element}", 属性文本)
		else:
			# 无高品质弟子→删除亮点分句（含{top_name}的那整句或整段）
			s = _删除亮点句(s)
	else:
		# 无新徒数据（如旧调用兼容）→ 删除占位符相关句
		s = _删除亮点句(s)
	# ── 兜底清理：正则可能漏掉的特殊模式（如"尤以{top_name}..."前接 。\n 而非逗号）──
	s = s.replace("{top_name}", "").replace("{top_grade}", "").replace("{top_element}", "")
	# 安全换行：防止源码 \\n 或编码问题导致 \n 显示为字面文本
	s = s.replace("\\n", "\n")
	# 去掉开发分类标签前缀：【测灵根·过场三】【测灵根·过场·天品】等，玩家不应看到
	var 标签正则 := RegEx.new()
	标签正则.compile(r"^【[^】]+】\s*")
	s = 标签正则.sub(s, "")
	return s

# 删除亮点句：去除包含 {top_name} 的整段描述（到下一个句号/换行+非空行截止）
static func _删除亮点句(s: String) -> String:
	var 正则 := RegEx.new()
	# 匹配两种亮点句模式：
	# 1) "...其中{top_name}...。" （逗号后接亮点句，以句号结尾）
	# 2) 独立亮点句 "尤以{top_name}..." 或 "{top_name}..."
	正则.compile(r"[，,]\s*[^。]*\{top_name\}[^。]*。|^[^。]*\{top_name\}[^。]*。")
	s = 正则.sub(s, "")
	return s

# 灵根品阶数值化（用于排序取最佳，统一 0-4 轴）：天品=4 极品=3 上品=2 良品/凡品=1 其他=0
# 取最佳亮点句的阈值在 取测灵根过场 用「品阶值 >= 2」即 上品及以上（含上品/极品/天品）
# 入参为 灵根品阶 字符串（天品/极品/上品/良品/凡品），非灵根类型
static func _灵根品阶值(品阶名: String) -> int:
	match 品阶名:
		"天品": return 4
		"极品": return 3
		"上品": return 2
		"良品", "凡品": return 1
		_: return 0

static func 取堂口(key: String) -> Dictionary:
	return 堂口定义.get(key, {})

