	"pan_tao_small": {"名称": "五百年灵桃", "品阶": "王阶", "成熟天数": 10, "基础产量": 1, "种子": "蟠桃核", "基础年份": 500},
	# 圣阶
	"wu_dao_cha": {"名称": "八百年悟道茶", "品阶": "圣阶", "成熟天数": 12, "基础产量": 1, "种子": "悟道茶籽", "基础年份": 800},
