# 事件状态
var 当前事件: Dictionary = {}
var 事件冷却日: int = 0
var 今日已触发事件数: int = 0
var 事件历史: Array = []

# 触发大地图事件（探索时调用）
func 触发大地图事件(探索区域: String = "") -> Dictionary:
	# 冷却检查
	if Game.累计游戏日 < 事件冷却日:
		return {"成功": false, "原因": "方圆百里已被探查过，暂无异动"}
	# 每日最多触发3次
	if 今日已触发事件数 >= 3:
		return {"成功": false, "原因": "今日已多次探查，弟子们需要休整"}
	# 基础触发概率30%
	if randf() > 0.3:
		事件冷却日 = Game.累计游戏日 + 1
		return {"成功": false, "原因": "一路平静，未发现异常"}
	# 按稀有度权重抽取事件
	var 总权重: float = 0.0
	for 事件 in 大地图事件库:
		var 稀有度配置: Dictionary = 事件稀有度.get(事件["稀有度"], {})
		总权重 += float(稀有度配置.get("概率权重", 10))
	var 随机值: float = randf() * 总权重
	var 累计: float = 0.0
	var 选中事件: Dictionary = {}
	for 事件 in 大地图事件库:
		var 稀有度配置: Dictionary = 事件稀有度.get(事件["稀有度"], {})
		累计 += float(稀有度配置.get("概率权重", 10))
		if 随机值 <= 累计:
			选中事件 = 事件
			break
	if 选中事件.is_empty():
		选中事件 = 大地图事件库[0]
	# 记录
	当前事件 = 选中事件.duplicate()
	当前事件["触发时间"] = Game.累计游戏日
	当前事件["状态"] = "待处理"
	今日已触发事件数 += 1
	事件冷却日 = Game.累计游戏日 + 1
	事件历史.append({"事件": 选中事件["名"], "时间": Game.累计游戏日, "结果": "待处理"})
	# 添加纪事
	Game.添加纪事("探索", "大地图事件", "%s：%s" % [选中事件["名"], 选中事件["描述"]], 1)
	return {"成功": true, "事件": 当前事件}

# 处理事件选择
func 处理事件选择(选择ID: String) -> Dictionary:
	if 当前事件.is_empty() or 当前事件.get("状态", "") != "待处理":
		return {"成功": false, "原因": "当前没有待处理的事件"}
	var 事件名: String = str(当前事件.get("名", ""))
	var 稀有度: String = str(当前事件.get("稀有度", "普通"))
	var 奖励倍率: float = float(事件稀有度.get(稀有度, {}).get("奖励倍率", 1.0))
	var 结果: Dictionary = {"成功": true, "事件": 事件名, "选择": 选择ID}
	# 根据事件类型和选择处理
	match 选择ID:
		"战斗":
			var 战力需求: int = int(1000 * 奖励倍率)
			var 宗门战力: int = int(Game.计算宗门总战力()) if Game.has_method("获取宗门总战力") else 5000
			if 宗门战力 >= 战力需求:
				var 灵石奖励: int = int(randi_range(100, 500) * 奖励倍率)
				Game.灵石 += 灵石奖励
				结果["奖励"] = {"灵石": 灵石奖励, "材料": "妖兽材料x1"}
				结果["描述"] = "一战功成，斩获颇丰"
			else:
				var 损失: int = int(宗门战力 * 0.1)
				结果["奖励"] = {"损失": 损失}
				结果["描述"] = "实力不足，弟子负伤而退"
		"帮助":
			var 声望奖励: int = int(randi_range(10, 30) * 奖励倍率)
			var 灵石奖励: int = int(randi_range(200, 800) * 奖励倍率)
			Game.灵石 += 灵石奖励
			结果["奖励"] = {"声望": 声望奖励, "灵石": 灵石奖励}
			结果["描述"] = "出手相助，商队感激不尽"
		"忽略":
			结果["奖励"] = {}
			结果["描述"] = "事不关己，绕道而行"
		"采集":
			var 灵气奖励: int = int(randi_range(50, 200) * 奖励倍率)
			结果["奖励"] = {"灵气": 灵气奖励}
			结果["描述"] = "汲取灵泉，灵气大涨"
		"探索":
			var 灵石奖励: int = int(randi_range(500, 2000) * 奖励倍率)
			Game.灵石 += 灵石奖励
			结果["奖励"] = {"灵石": 灵石奖励, "物品": "随机"}
			结果["描述"] = "深入探索，有所收获"
		"社交":
			var 声望奖励: int = int(randi_range(5, 20) * 奖励倍率)
			结果["奖励"] = {"声望": 声望奖励}
			结果["描述"] = "结交同道，声望提升"
		_:
			结果["奖励"] = {}
			结果["描述"] = "选择了未知选项"
	# 更新事件状态
	当前事件["状态"] = "已处理"
	当前事件["结果"] = 结果
	# 更新历史
	if not 事件历史.is_empty():
		事件历史[-1]["结果"] = 结果.get("描述", "已处理")
	# 添加纪事
	Game.添加纪事("探索", "事件结果", "%s：%s" % [事件名, 结果.get("描述", "")], 0)
	return 结果

# 获取事件选项
func 获取当前事件选项() -> Array:
	if 当前事件.is_empty():
		return []
	var 类型: String = str(当前事件.get("类型", ""))
	match 类型:
		"战斗":
			return [{"ID": "战斗", "名": "迎战", "描述": "与敌人战斗，胜则有赏，败则有损"}, {"ID": "忽略", "名": "绕道", "描述": "不惹是非，安全离开"}]
		"选择":
			return [{"ID": "帮助", "名": "出手相助", "描述": "消耗少量资源，获得声望和灵石"}, {"ID": "忽略", "名": "袖手旁观", "描述": "不参与，无奖励无损失"}]
		"探索":
			return [{"ID": "探索", "名": "深入探索", "描述": "可能获得珍贵物品，也可能触发危险"}, {"ID": "忽略", "名": "标记离开", "描述": "记录位置，以后再来"}]
		"采集":
			return [{"ID": "采集", "名": "采集", "描述": "获取资源"}]
		"社交":
			return [{"ID": "社交", "名": "结交", "描述": "与同道交流，获得声望"}]
		_:
			return [{"ID": "忽略", "名": "离开", "描述": "不做处理"}]

