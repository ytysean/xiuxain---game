# ===== 拍卖时间控制 =====
# 检查是否应该开启拍卖（每天一次，游戏内时间对应）
func _检查开启拍卖() -> void:
	if 全服拍卖.get("激活", false):
		return
	var 当前日: int = int(Game.累计游戏日)
	# 每30游戏日开启一次（约2现实小时）
	if 当前日 - int(全服拍卖.get("上次拍卖日", -999)) >= 30:
		# 判断拍卖类型
		var 拍卖次数: int = int(当前日 / 30)
		var 类型: String = "日常"
		# S54 P2：节日特拍（每360游戏日=现实1天一次，对应特殊节日）
		var 节日: String = _检查节日(当前日)
		if 节日 != "":
			类型 = "节日特拍"
			全服拍卖["当前节日"] = 节日
		# 周末大拍（每7次日常拍卖后一次）
		elif 拍卖次数 % 7 == 0 and 当前日 > 0:
			类型 = "周末大拍"
		# VIP专属拍卖（每14次日常拍卖后一次，即每420游戏日）
		elif 拍卖次数 % 14 == 0 and 当前日 > 0 and _检查VIP权限():
			类型 = "VIP专属"
		_开启拍卖大典(类型)

# S54 P2：检查当前节日
func _检查节日(当前日: int) -> String:
	# 游戏内节日：每360游戏日（现实1天）对应一个节日循环
	var 节日循环: Array = ["春节", "元宵", "清明", "端午", "七夕", "中秋", "重阳", "冬至"]
	var 节日日: int = int(当前日 / 360) % 节日循环.size()
	# 节日当天开启节日特拍
	if 当前日 % 360 == 0 and 当前日 > 0:
		return 节日循环[节日日]
	return ""

# S54 P2：检查VIP权限（简化：门派等级>=8或月卡）
func _检查VIP权限() -> bool:
	return Game.门派等级 >= 8 or (Game.月卡到期日 >= 0 and Game.月卡到期日 >= Game.累计游戏日)

# 开启拍卖大典
func _开启拍卖大典(类型: String = "日常") -> void:
	全服拍卖["激活"] = true
	全服拍卖["开始日"] = Game.累计游戏日
	全服拍卖["拍卖类型"] = 类型
	# 持续时间：日常15游戏日，大拍/节日/VIP 30游戏日
	var 持续: int = 15 if 类型 == "日常" else 30
	全服拍卖["结束日"] = Game.累计游戏日 + 持续
	全服拍卖["当前拍品索引"] = 0
	全服拍卖["上次拍卖日"] = Game.累计游戏日
	全服拍卖["预告已发布"] = false
	全服拍卖["拍卖师话术"] = []
	# 生成拍品列表（玩家寄拍+系统生成）
	_生成拍品列表(类型)
	# 全服公告
	if 类型 == "周末大拍":
		Game.添加纪事("全服拍卖", "周末大拍开幕", "★ 聚宝阁周末大拍隆重开启！本次大典宝物翻倍，压轴之物更是稀世罕见，诸位道友莫要错过！", 2)
	elif 类型 == "节日特拍":
		var 节日: String = str(全服拍卖.get("当前节日", ""))
		Game.添加纪事("全服拍卖", "%s特拍开幕" % 节日, "◆ 聚宝阁%s特拍隆重开启！佳节之际，稀世之宝齐聚，诸位道友共襄盛举！" % 节日, 2)
	elif 类型 == "VIP专属":
		Game.添加纪事("全服拍卖", "仙阶专属拍卖开幕", "◇ 聚宝阁仙阶专属拍卖隆重开启！仅限尊贵道友参与，绝世珍宝唯君可得！", 2)
	else:
		Game.添加纪事("全服拍卖", "大典开幕", "聚宝阁全服拍卖大典隆重开启！诸位道友云集，稀世之宝逐一登场，价高者得！", 2)
	# 拍卖师开场话术
	_拍卖师话术("开场", 类型)

# 结束拍卖大典
func _结束拍卖大典() -> void:
	全服拍卖["激活"] = false
	# 结算所有未成交拍品
	for lot in 全服拍卖.get("拍品列表", []):
		if lot.get("状态", "") == "竞拍中":
			_流拍处理(lot)
	Game.添加纪事("全服拍卖", "大典结束", "聚宝阁全服拍卖大典圆满结束，共计成交%d件宝物。" % _成交数(), 2)

# 推进拍卖（每游戏日调用）
func 推进全服拍卖(天: int) -> void:
	_全服拍卖补缺()
	_检查开启拍卖()
	# S54 P5：推进护送任务
	_推进护送任务()
	if not 全服拍卖.get("激活", false):
		return
	# 检查是否结束
	if int(Game.累计游戏日) >= int(全服拍卖.get("结束日", 0)):
		_结束拍卖大典()
		return
	# 模拟其他玩家出价（每3游戏日一次）
	if int(Game.累计游戏日) % 3 == 0:
		_模拟玩家出价()
	# 推进到下一件拍品（当前拍品成交或流拍后）
	_推进拍品()

# ===== 拍品生成 =====
func _生成拍品列表(类型: String = "日常") -> void:
	var 拍品列表: Array = []
	# 1. 玩家寄拍物品（从寄拍列表中选取）
	var 寄拍: Array = 全服拍卖.get("寄拍列表", [])
	var 玩家拍品数: int = 0
	if 类型 == "周末大拍":
		玩家拍品数 = min(25, 寄拍.size())  # 大拍更多玩家寄拍
	else:
		玩家拍品数 = min(15, 寄拍.size())
	for i in range(玩家拍品数):
		var lot: Dictionary = 寄拍[i]
		lot["状态"] = "竞拍中"
		lot["开始日"] = Game.累计游戏日
		拍品列表.append(lot)
	# 从寄拍列表移除
	全服拍卖["寄拍列表"] = 寄拍.slice(玩家拍品数)
	# 2. 系统生成物品
	var 系统拍品数: int = 0
	if 类型 == "周末大拍":
		系统拍品数 = randi_range(15, 25)  # 大拍更多系统物品
	else:
		系统拍品数 = randi_range(5, 10)
	for i in range(系统拍品数):
		var lot: Dictionary = _生成系统拍品(类型)
		拍品列表.append(lot)
	# 随机打乱顺序
	拍品列表.shuffle()
	全服拍卖["拍品列表"] = 拍品列表

# 生成系统拍品
func _生成系统拍品(类型: String = "日常") -> Dictionary:
	var 品阶池: Array = []
	if 类型 == "VIP专属":
		品阶池 = ["王阶", "圣阶", "仙阶", "神阶"]  # VIP专属最高品阶
	elif 类型 == "节日特拍":
		品阶池 = ["宝阶", "王阶", "圣阶", "仙阶"]  # 节日特拍高品阶
	elif 类型 == "周末大拍":
		品阶池 = ["宝阶", "王阶", "圣阶", "仙阶"]  # 大拍更高品阶
	else:
		品阶池 = ["灵阶", "宝阶", "王阶", "圣阶"]
	var 品阶: String = 品阶池[randi() % 品阶池.size()]
	var 类别池: Array = ["丹药", "灵材", "装备", "符箓"]
	var 类别: String = 类别池[randi() % 类别池.size()]
	var it: Item = Item.new()
	it.品阶 = 品阶
	it.类别 = 类别
	it.名称 = _随机物品名(类别, 品阶)
	it.战力加成 = randi_range(100, 1000)
	# S54 P4：15%概率生成神秘物品（未鉴定）
	if randf() < 0.15:
		it = _生成神秘物品(类别, 品阶)
	var 基准价: int = _系统估价(it)
	# S55：应用价格供需指数
	var 价格指数: float = 获取价格指数(类别, 品阶)
	基准价 = int(float(基准价) * 价格指数)
	var 底价: int = max(100, int(float(基准价) * randf_range(0.6, 0.9)))
	var 一口价: int = int(float(底价) * randf_range(1.5, 2.5))
	return {
		"id": "sys_%d_%d" % [Game.累计游戏日, randi() % 100000],
		"物品": it.to_dict(),
		"名称": it.获取显示名称(),
		"类别": 类别,
		"品阶": it.获取显示品阶(),
		"底价": 底价,
		"当前价": 底价,
		"一口价": 一口价,
		"寄拍者": "聚宝阁",
		"寄拍者类型": "系统",
		"状态": "竞拍中",
		"开始日": Game.累计游戏日,
		"竞价记录": [],
		"最高出价者": "",
		"延时结束日": 0,
		"拍卖类型": 类型,
		"神秘物品": it.神秘物品,
	}

# S54 P4：生成神秘物品
func _生成神秘物品(类别: String, 表面品阶: String) -> Item:
	var it: Item = Item.new()
	it.类别 = 类别
	it.神秘物品 = true
	it.鉴定状态 = "未鉴定"
	# 表面品阶（显示给玩家看的）
	it.品阶 = 表面品阶
	it.名称 = _随机神秘物品名(类别)
	it.描述 = "此物古朴无奇，似有玄机暗藏，非慧眼不能识。"
	it.战力加成 = randi_range(50, 200)  # 表面战力低
	# 30%概率为赝品
	if randf() < 0.3:
		it.是赝品 = true
		it.赝品仿真度 = randi_range(30, 90)
		it.真实品阶 = "凡阶"
		it.真实名称 = "赝品·%s" % it.名称
		it.真实描述 = "此乃后人仿制之物，虽外观逼真，实则灵气涣散，价值有限。"
		it.真实战力 = randi_range(10, 50)
	else:
		# 真品：真实品阶可能比表面高1-3阶
		var 品阶序: Array = ["凡阶", "灵阶", "宝阶", "王阶", "圣阶", "仙阶", "道阶", "神阶"]
		var 表面索引: int = 品阶序.find(表面品阶)
		var 真实索引: int = min(品阶序.size() - 1, 表面索引 + randi_range(1, 3))
		it.真实品阶 = 品阶序[真实索引]
		it.真实名称 = _随机真实物品名(类别, it.真实品阶)
		it.真实描述 = _随机真实物品描述(类别, it.真实品阶)
		it.真实战力 = randi_range(500, 5000)
		# 20%概率有特殊激活条件
		if randf() < 0.2:
			it.激活条件 = _随机激活条件()
	return it

# 随机神秘物品名
func _随机神秘物品名(类别: String) -> String:
	var 名池: Dictionary = {
		"丹药": ["古朴丹瓶", "无名丹药", "尘封丹丸", "异香丹粒"],
		"灵材": ["奇异矿石", "未知灵草", "神秘骨骸", "古朴玉片"],
		"装备": ["锈迹铁剑", "残破护甲", "无名指环", "古朴玉佩"],
		"符箓": ["泛黄符纸", "神秘符篆", "残缺符卷", "无名符牌"],
	}
	var 池: Array = 名池.get(类别, ["神秘物品"])
	return 池[randi() % 池.size()]

# 随机真实物品名
func _随机真实物品名(类别: String, 品阶: String) -> String:
	var 名池: Dictionary = {
		"丹药": ["九转金丹", "太上忘情丹", "不死神药", "鸿蒙紫气丹"],
		"灵材": ["混沌石", "先天灵根", "凤凰精血", "龙族逆鳞"],
		"装备": ["轩辕剑", "东皇钟", "诛仙剑", "乾坤鼎"],
		"符箓": ["天罡符", "地煞符", "封神符", "辟火符"],
	}
	var 池: Array = 名池.get(类别, ["上古遗物"])
	return 池[randi() % 池.size()]

