      "normal": "常态平面受光，",
      "hover": "悬浮态整体微提亮、顶部高光增强，",
      "press": "点击态下沉、暗部加深、内阴影，",
      "selected": "选中态暗金描边发光增强、外晕暖金光，"
    },
    "state_desc_en": {
      "normal": "neutral flat lighting, ",
      "hover": "hover state slightly brighter with enhanced top highlight, ",
      "press": "pressed state recessed with deepened shadows and inner shadow, ",
      "selected": "selected state enhanced glowing dark-gold border with warm outer halo, "
    },
    "negative_prompt": "文字, 字母, 数字, 水印, logo, 签名, 白色粗边框, 扁平矢量, 卡通Q版, 简化, 低质量, 低分辨率, 纯白背景, 杂乱背景, 现代元素, 赛博朋克, 霓虹, 过曝, 模糊, 畸变, 多余手指",
    "gen_size": {
      "square": [1024, 1024],
      "bar": [1024, 256]
    },
    "deliver_size": {
      "square": [256, 256],
      "bar": [512, 128]
    },
    "watermark_clean_default": false,
    "comfyui_ckpt": "请替换为你的本地 checkpoint 文件名（如 juggernautXL_v8.safetensors / 麦橘超然V8.safetensors），或在命令行用 --ckpt 覆盖",
