# ---------- 2.2 城镇商情 ↔ 坊市 / 跑商（适配 city_config + goods_config 真源）----------
var 城镇商情表: Dictionary = {}   # 懒加载 city_config.csv：city_id → {名称,等级,基准价率,特产,缺货}
var 货品基价表: Dictionary = {}   # 懒加载 goods_config.csv：goods_id → {名,类型,基价,品阶}

func _载商情配置() -> void:
	if not 城镇商情表.is_empty():
		return
	var f: FileAccess = FileAccess.open("res://config/city_config.csv", FileAccess.READ)
	if f != null:
		f.get_csv_line()
		while not f.eof_reached():
			var p: PackedStringArray = f.get_csv_line()
			if p.size() < 7:
				continue
			var id: String = p[0].strip_edges()
			if id.is_empty():
				continue
			城镇商情表[id] = {
				"名称": p[1].strip_edges(),
				"等级": int(p[2]),
				"基准价率": float(p[4]),
				"特产": p[5].strip_edges(),
				"缺货": p[6].strip_edges(),
			}
		f.close()
	var g: FileAccess = FileAccess.open("res://config/goods_config.csv", FileAccess.READ)
	if g != null:
		g.get_csv_line()
		while not g.eof_reached():
			var q: PackedStringArray = g.get_csv_line()
			if q.size() < 7:
				continue
			var gid: String = q[0].strip_edges()
			if gid.is_empty():
				continue
			货品基价表[gid] = {
				"名": q[1].strip_edges(),
				"类型": q[2].strip_edges(),
				"基价": int(q[3]),
				"品阶": int(q[6]),
			}
		g.close()

func _拆货单(串: String) -> Array:
	var 出: Array = []
	for s in 串.split("|"):
		var t: String = s.strip_edges()
		if t != "":
			出.append(t)
	return 出

# 城镇商情：基准价率 + 好感折让 + 特产 / 缺货清单
func 获取城镇商情(城镇ID: String) -> Dictionary:
	_载商情配置()
	var 城: Dictionary = 城镇商情表.get(城镇ID, {})
	if 城.is_empty():
		return {"成功": false, "原因": "未知城镇"}
	var 率: float = float(城.get("基准价率", 1.0))
	var 好感: int = 获取城镇好感度(城镇ID)
	var 折让: float = clampf(float(好感) / 500.0, 0.0, 0.06)   # 好感每百点让利 1.2%，上限 6%
	return {
		"成功": true, "城镇ID": 城镇ID, "名称": str(城.get("名称", "")),
		"等级": int(城.get("等级", 1)), "基准价率": 率,
		"买入价率": 率 * (1.0 - 折让), "卖出价率": 率 * (1.0 + 折让),
		"好感": 好感, "折让": 折让,
		"特产清单": _拆货单(str(城.get("特产", ""))),
		"缺货清单": _拆货单(str(城.get("缺货", ""))),
	}

# 某货品在城中的买卖价（真源：goods_config.base_price × 城市价率 × 特产 / 缺货修正）
func 获取货品城价(城镇ID: String, 货品ID: String) -> Dictionary:
	_载商情配置()
	var 情: Dictionary = 获取城镇商情(城镇ID)
	if not bool(情.get("成功", false)):
		return 情
	if not 货品基价表.has(货品ID):
		return {"成功": false, "原因": "未知货品"}
	var 基价: int = int(货品基价表[货品ID].get("基价", 1))
	var 买价: int = int(float(基价) * float(情.get("买入价率", 1.0)))
	var 卖价: int = int(float(基价) * float(情.get("卖出价率", 1.0)))
	if 货品ID in 情.get("特产清单", []):
		买价 = int(float(买价) * 0.8)
	if 货品ID in 情.get("缺货清单", []):
		卖价 = int(float(卖价) * 1.25)
	return {"成功": true, "城镇ID": 城镇ID, "货品": str(货品基价表[货品ID].get("名", 货品ID)),
		"买入价": maxi(1, 买价), "卖出价": maxi(1, 卖价)}

# 跑商利润（低价买高价卖）：甲城买入 → 乙城卖出，扣商队运费
func 计算跑商利润(买入城ID: String, 卖出城ID: String, 货品ID: String, 数量: int = 1) -> Dictionary:
	var 甲: Dictionary = 获取货品城价(买入城ID, 货品ID)
	var 乙: Dictionary = 获取货品城价(卖出城ID, 货品ID)
	if not bool(甲.get("成功", false)) or not bool(乙.get("成功", false)):
		return {"成功": false, "原因": "城镇或货品不存在"}
	数量 = maxi(1, 数量)
	var 买价: int = int(甲.get("买入价", 0))
	var 卖价: int = int(乙.get("卖出价", 0))
	var 运输: Dictionary = 计算商队运输详情(卖出城ID)
	var 运费: int = int(运输.get("运输费用", 0)) if bool(运输.get("成功", false)) else 0
	var 毛利: int = (卖价 - 买价) * 数量
	var 净利: int = 毛利 - 运费
	return {"成功": true, "货品": str(甲.get("货品", "")), "数量": 数量,
		"买入价": 买价, "卖出价": 卖价, "毛利": 毛利, "运费": 运费, "净利": 净利,
		"利润率": float(净利) / float(maxi(1, 买价 * 数量))}

# 城镇珍品（特产中品阶 ≥3 者）—— 拍卖行珍品只在这些城镇现世
func 获取城镇珍品(城镇ID: String) -> Array:
	_载商情配置()
	var 情: Dictionary = 获取城镇商情(城镇ID)
	if not bool(情.get("成功", false)):
		return []
	var 出: Array = []
	for gid in 情.get("特产清单", []):
		var 货: Dictionary = 货品基价表.get(str(gid), {})
		if 货.is_empty():
			continue
		if int(货.get("品阶", 1)) >= 3:
			出.append({
				"货品ID": str(gid), "名称": str(货.get("名", "")),
				"品阶": int(货.get("品阶", 1)), "基价": int(货.get("基价", 0)),
			})
	return 出

# 跑商路线推荐：城际差价 Top N（明细由 计算跑商利润 给出，含运费与净利）
func 获取跑商路线推荐(数量上限: int = 3) -> Array:
	_载商情配置()
	var 价表: Dictionary = {}
	for cid in 城镇商情表.keys():
		var 情: Dictionary = 获取城镇商情(str(cid))
		if not bool(情.get("成功", false)):
			continue
		var 价项: Dictionary = {}
		for gid in 货品基价表.keys():
			var 基价: int = int(货品基价表[gid].get("基价", 1))
			var 买: int = int(float(基价) * float(情.get("买入价率", 1.0)))
			var 卖: int = int(float(基价) * float(情.get("卖出价率", 1.0)))
			if gid in 情.get("特产清单", []):
				买 = int(float(买) * 0.8)
			if gid in 情.get("缺货清单", []):
				卖 = int(float(卖) * 1.25)
			价项[str(gid)] = {"买入": maxi(1, 买), "卖出": maxi(1, 卖)}
		价表[str(cid)] = 价项
	var 城内: Array = 价表.keys()
	var 候选: Array = []
	for i in range(城内.size()):
		for j in range(i + 1, 城内.size()):
			var 甲: Dictionary = 价表[str(城内[i])]
			var 乙: Dictionary = 价表[str(城内[j])]
			for gid in 甲.keys():
				if not 乙.has(gid):
					continue
				var 正: int = int(乙[gid]["卖出"]) - int(甲[gid]["买入"])
				var 反: int = int(甲[gid]["卖出"]) - int(乙[gid]["买入"])
				if 正 > 0:
					候选.append({"买入城": str(城内[i]), "卖出城": str(城内[j]), "货品ID": str(gid), "差价": 正})
				if 反 > 0:
					候选.append({"买入城": str(城内[j]), "卖出城": str(城内[i]), "货品ID": str(gid), "差价": 反})
	候选.sort_custom(func(a, b): return int(a["差价"]) > int(b["差价"]))
	var 出: Array = []
	for k in range(mini(maxi(0, 数量上限), 候选.size())):
		var rt: Dictionary = 候选[k]
		var 明细: Dictionary = 计算跑商利润(str(rt["买入城"]), str(rt["卖出城"]), str(rt["货品ID"]), 1)
		if not bool(明细.get("成功", false)):
			continue
		明细["买入城"] = str(rt["买入城"])
		明细["卖出城"] = str(rt["卖出城"])
		明细["差价"] = int(rt["差价"])
		明细["保本量"] = ceili(float(明细.get("运费", 0)) / float(maxi(1, int(rt["差价"]))))
		出.append(明细)
	return 出

