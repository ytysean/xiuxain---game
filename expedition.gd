func _境界达标(弟子境界: String, 要求境界: String) -> bool:
	# 原为局部 10 阶序（末位"道阶"，无"仙阶"）：弟子到仙阶时 find=-1 → 所有关卡恒判不达标（2026-09-02 修）
	return Disciple.境界达标(弟子境界, 要求境界)

# ============ 派遣逻辑 ============
func 开始历练(关卡ID: String, 弟子ID列表: Array) -> Dictionary:
	var 关卡 = 获取关卡(关卡ID)
	if 关卡.is_empty():
		return {"成功": false, "原因": "关卡不存在"}
	if 弟子ID列表.is_empty() or 弟子ID列表.size() > 3:
		return {"成功": false, "原因": "需派遣1-3名弟子"}
	# 检查弟子是否空闲
	for did in 弟子ID列表:
		if _弟子是否在历练中(did):
			return {"成功": false, "原因": "有弟子正在历练中"}
		var _d = _获取弟子(did)
		if _d != null and (_d.状态 == "失踪" or _d.状态 == "陨落" or _d.状态 == "叛出"):
			return {"成功": false, "原因": "%s 已失踪/陨落，无法派遣" % _d.姓名}
		if Game != null and Game.誓约禁历练(did):   # S36 苦修誓：期间禁出战（真拦截）
			return {"成功": false, "原因": "%s 身负苦修之誓，闭关期间不可出战" % (str(_d.姓名) if _d != null else "该弟子")}
	# 日常/秘境次数检查（付费额外次数可突破今日/本周限制）
	if (关卡["类型"] == "daily" and 已完成日常.has(关卡ID)) or (关卡["类型"] == "secret" and 已完成秘境.has(关卡ID)):
		if Game != null and Game.历练额外次数 > 0:
			Game.历练额外次数 -= 1
		else:
			return {"成功": false, "原因": "今日已完成该日常" if 关卡["类型"] == "daily" else "本周已完成该秘境"}
	# 创建历练实例
	历练实例计数器 += 1
	var 实例ID = "exp_" + str(历练实例计数器)
	var 当前游戏日 = 0
	if Game != null:
		var v = Game.get("累计游戏日")
		当前游戏日 = int(v) if v != null else 0
	var 预计结束 = 当前游戏日 + int(关卡["预计时长"])
	进行中历练[实例ID] = {
		"关卡ID": 关卡ID,
		"弟子ID列表": 弟子ID列表.duplicate(),
		"开始游戏日": 当前游戏日,
		"预计结束游戏日": 预计结束,
	}
	# 修真味纪事：启程
	var 弟子名列表: Array = []
	for did in 弟子ID列表:
		var _d = _获取弟子(did)
		if _d != null:
			弟子名列表.append(str(_d.姓名))
	var 弟子名串: String = "、".join(弟子名列表)
	var 关卡名: String = str(关卡.get("名称", ""))
	var 启程文案: String = ""
	match str(关卡.get("类型", "")):
		"daily":
			启程文案 = "%s领了宗门差事，动身前往%s走一遭。" % [弟子名串, 关卡名]
		"realm":
			启程文案 = "%s整束行装，往%s历练去了，盼能突破境界。" % [弟子名串, 关卡名]
		"secret":
			启程文案 = "%s身负宗门嘱托，深入%s秘境探幽，此去吉凶难料。" % [弟子名串, 关卡名]
		_:
			启程文案 = "%s动身往%s去了。" % [弟子名串, 关卡名]
	if Game != null and Game.has_method("添加纪事"):
		Game.添加纪事("历练", "启程", 启程文案, 1)
	return {"成功": true, "实例ID": 实例ID, "预计结束游戏日": 预计结束}

func _弟子是否在历练中(弟子ID: int) -> bool:
	for 实例ID in 进行中历练.keys():
		var 实例 = 进行中历练[实例ID]
		if 实例["弟子ID列表"].has(弟子ID):
			return true
	return false

func 获取进行中历练() -> Dictionary:
	return 进行中历练.duplicate()

# ============ 结算逻辑 ============

# ============ S1-1：真实战斗接入（替代掷骰绕过真实战斗）============
# 历练结算改用 BattleManager.发起1v1 真实引擎定胜负，不再 randf() 掷骰。
# 红线：仅调用 BattleManager（不改 BattleCalculator/BattleManager 内部）；
#       敌方 技能=[] → 走 _结算_1v1_原版（72 断言基线逐字节一致）。

# S1-1 真实战斗接入：敌方 = 关卡「怪物」字段指向的真实怪物（monster_main.csv 经 StageDataLoader，
# 含 怪物境界倍率 对称缩放），与 副本/秘境 完全同口径、零臆造。
# 多怪物时聚合为单个敌方快照（属性累加、战力合计），与 _聚合队伍快照 对称。
func _构造敌方快照(关卡ID: String) -> Dictionary:
	var 关卡 = 获取关卡(关卡ID)
	var 怪物ids: Array = 关卡怪物映射.get(关卡ID, [])
	var 单位列表: Array = []
	if 怪物ids.size() > 0:
		单位列表 = StageDataLoader.build_monster_units_by_ids(怪物ids)
	# 兜底：关卡未配置怪物（数据缺口）时，退化为最弱练气野怪，保证不崩、不造臆造属性
	if 单位列表.is_empty():
		单位列表 = StageDataLoader.build_monster_units_by_ids(["M101"])
	if 单位列表.size() == 1:
		var u = 单位列表[0]
		return {
			"战力": BattleCalculator.战力度量(u),
			"属性": u.get("属性", {}),
			"道途": u.get("道途", ""),
			"职业": u.get("道途", ""),
			"灵根": u.get("灵根", {"主": "金", "纯度": "单"}),
			"灵兽战力": 0,
			"灵兽": [],
			"极品特效": [],
			"通用增益": 0.0,
			"道心增益": 0.0,
			"暴击率": u.get("暴击率", 0.0),
			"闪避率": u.get("闪避率", 0.0),
			"名称": u.get("名称", "妖兽"),
			"敌方种族": [u.get("种族", "")],
			"技能": [],
			"功法被动": [],
		}
	# 多怪物聚合
	var 聚合属性 := {"攻": 0, "防": 0, "血": 0, "速": 0}
	var 总战力 = 0
	var 暴击累加 = 0.0
	var 闪避累加 = 0.0
	var 反伤累加 = 0.0
	var 穿透累加 = 0.0
	var 名称列表 := []
	var 种族列表 := []
	for u in 单位列表:
		var a = u.get("属性", {})
		种族列表.append(u.get("种族", ""))
		聚合属性["攻"] += int(a.get("攻", 0))
		聚合属性["防"] += int(a.get("防", 0))
		聚合属性["血"] += int(a.get("血", 0))
		聚合属性["速"] += int(a.get("速", 0))
		总战力 += BattleCalculator.战力度量(u)
		暴击累加 += float(u.get("暴击率", 0.0))
		闪避累加 += float(u.get("闪避率", 0.0))
		反伤累加 += float(u.get("反伤率", 0.0))
		穿透累加 += float(u.get("穿透率", 0.0))
		名称列表.append(u.get("名称", "妖兽"))
	var 人数 = 单位列表.size()
	return {
		"战力": 总战力,
		"属性": 聚合属性,
		"道途": "",
		"职业": "",
		"灵根": 单位列表[0].get("灵根", {"主": "金", "纯度": "单"}),
		"灵兽战力": 0,
		"灵兽": [],
		"极品特效": [],
		"通用增益": 0.0,
		"道心增益": 0.0,
		"暴击率": 暴击累加 / float(人数),
		"闪避率": 闪避累加 / float(人数),
		"反伤率": 反伤累加 / float(人数),
		"穿透率": 穿透累加 / float(人数),
		"名称": "妖兽群·" + "、".join(名称列表),
		"敌方种族": 种族列表,
		"技能": [],
		"功法被动": [],
	}

# 聚合 1-3 名弟子的战斗快照为一个「队伍代表」（属性累加、战力合计）
func _聚合队伍快照(弟子ID列表: Array) -> Dictionary:
	var 队员快照 := []
	for did in 弟子ID列表:
		var d = _获取弟子(did)
		if d != null and d.has_method("get_final_combat_attr"):
			队员快照.append(d.get_final_combat_attr())
	if 队员快照.is_empty():
		return {}
	var 队长 = 队员快照[0]
	var 聚合属性 := {"攻": 0, "防": 0, "血": 0, "速": 0}
	var 总战力 = 0
	var 暴击累加 = 0.0
	var 闪避累加 = 0.0
	var 反伤累加 = 0.0
	var 穿透累加 = 0.0
	for s in 队员快照:
		var a = s.get("属性", {})
		聚合属性["攻"] += int(a.get("攻", 0))
		聚合属性["防"] += int(a.get("防", 0))
		聚合属性["血"] += int(a.get("血", 0))
		聚合属性["速"] += int(a.get("速", 0))
		总战力 += int(s.get("战力", 0))
		暴击累加 += float(s.get("暴击率", 0.0))
		闪避累加 += float(s.get("闪避率", 0.0))
		反伤累加 += float(s.get("反伤率", 0.0))
		穿透累加 += float(s.get("穿透率", 0.0))
	var 人数 = 队员快照.size()
	return {
		"战力": 总战力,
		"属性": 聚合属性,
		"道途": 队长.get("道途", "道修"),
		"职业": 队长.get("职业", "道修"),
		"灵根": 队长.get("灵根", {"主": "金", "纯度": "单"}),
		"灵兽战力": 队长.get("灵兽战力", 0),
		"灵兽": 队长.get("灵兽", []),
		"极品特效": 队长.get("极品特效", []),
		"通用增益": 队长.get("通用增益", 0.0),
		"道心增益": 队长.get("道心增益", 0.0),
		"暴击率": 暴击累加 / float(人数),
		"闪避率": 闪避累加 / float(人数),
		"反伤率": 反伤累加 / float(人数),
		"穿透率": 穿透累加 / float(人数),
		"名称": "队伍·" + str(队长.get("名称", "弟子")) + "等" + str(人数) + "人小队",
		"技能": [],
		"功法被动": 队长.get("功法被动", []),
	}

# 把 BattleManager 战报 log 转为可读文本（供历练结果/纪事展示）
func _格式化战报(战报: Dictionary) -> Array:
	var 文本 := []
	for e in 战报.get("battle_log", []):
		if e.get("pet_action", false):
			continue
		var 回合 = int(e.get("round", 0))
		var 行动 = str(e.get("actor", ""))
		var 目标 = str(e.get("target", ""))
		var 伤害 = int(e.get("damage", 0))
		var 标记 = ""
		if e.get("is_crit", false):
			标记 = "暴击"
		if e.get("is_restrain", false):
			标记 += ("克制" if 标记 == "" else "·克制")
		var 后缀 = ""
		if 标记 != "":
			后缀 = "（" + 标记 + "）"
		文本.append("第" + str(回合) + "回合 " + 行动 + " → " + 目标 + " 造成" + str(伤害) + "伤害" + 后缀)
	return 文本

func 检查并结算历练() -> Array:
	## 每日推演时调用，检查所有进行中历练是否到期，到期则结算
	var 结算结果列表: Array = []
	var 当前游戏日 = 0
	if Game != null:
		var v2 = Game.get("累计游戏日")
		当前游戏日 = int(v2) if v2 != null else 0
	var 到期实例: Array = []
	for 实例ID in 进行中历练.keys():
		var 实例 = 进行中历练[实例ID]
		if 当前游戏日 >= int(实例["预计结束游戏日"]):
			到期实例.append(实例ID)
	for 实例ID in 到期实例:
		var 结果 = _结算单个历练(实例ID)
		结算结果列表.append(结果)
	# 调查任务到期结算（P3 扩展）
	var 调查到期: Array = []
	for iid in 调查进行中.keys():
		if 当前游戏日 >= int(调查进行中[iid].get("预计结束游戏日", 0)):
			调查到期.append(iid)
	for iid in 调查到期:
		var 调查结果 = _结算调查(iid)
		结算结果列表.append({"类型": "investigate", "调查成功": 调查结果.get("成功", false), "文本": 调查结果.get("文本", "")})
	return 结算结果列表

func _结算单个历练(实例ID: String) -> Dictionary:
	var 实例 = 进行中历练.get(实例ID, {})
	if 实例.is_empty():
		return {}
	var 关卡ID = 实例["关卡ID"]
	var 关卡 = 获取关卡(关卡ID)
	var 弟子ID列表 = 实例["弟子ID列表"]
	# 计算总战力（境界表口径，供界面/回传展示）
	var 总战力 = 0
	for did in 弟子ID列表:
		var d = _获取弟子(did)
		if d != null:
			总战力 += int(d.战力)
	# S1-1：先构造双方真实战斗快照（玩家队 + 关卡真实怪物）
	var 攻方快照 = _聚合队伍快照(弟子ID列表)
	var 守方快照 = _构造敌方快照(关卡ID)
	# 真实战力度量比（贴合真实战斗引擎，替代原 总战力/推荐战力 口径）
	var 我方度量 = BattleCalculator.战力度量(攻方快照) if not 攻方快照.is_empty() else 0
	var 敌方度量 = BattleCalculator.战力度量(守方快照)
	var 战力比 = float(我方度量) / float(敌方度量) if 敌方度量 > 0 else 1.0
	# 计算成功率（以真实战力度量比为基准的预估，供界面展示）
	var 推荐战力 = int(关卡["推荐战力"])
	var 成功率 = clamp(战力比, 0.1, 0.95)
	# 心境/道心加成（取队伍平均值）作为真实胜率的修正预估
	var 平均心境 = 0
	var 平均道心 = 0
	var 平均心魔 = 0
	for did in 弟子ID列表:
		var d = _获取弟子(did)
		if d != null:
			平均心境 += int(d.心境)
			平均道心 += int(d.道心)
			平均心魔 += int(d.心魔值)
	if 弟子ID列表.size() > 0:
		平均心境 /= 弟子ID列表.size()
		平均道心 /= 弟子ID列表.size()
		平均心魔 /= 弟子ID列表.size()
	成功率 += (float(平均心境) * 0.05 + float(平均道心) * 0.08 - float(平均心魔) * 0.1) / 100.0
	成功率 = clamp(成功率, 0.05, 0.95)
	# 毒道：历练前自动使用低阶毒药（凡品/灵品），降低敌方战力
	# 修真规则：宗门大比/同门切磋禁用毒（伤同门和气），仅对外历练/秘境可用
	# 弟子AI：按性格/道途判定用毒类型，正道弟子拒绝用毒
	var 关卡名: String = str(关卡.get("名称", ""))
	var 禁用毒: bool = 关卡名.find("大比") >= 0 or 关卡名.find("切磋") >= 0 or 关卡名.find("比试") >= 0
	if 禁用毒 and Game != null and Game.has_method("添加纪事"):
		Game.添加纪事("毒道", "未施毒", "%s乃同门比试，众目睽睽之下岂可施用毒物？有违门规，有伤和气。" % 关卡名, 1)
	if Game != null and not 禁用毒:
		# 取队伍中第一个弟子做AI判定（队长决定用毒策略）
		var 队长 = null
		for did in 弟子ID列表:
			队长 = _获取弟子(did)
			if 队长 != null:
				break
		var 用毒判定: Dictionary = {"可用毒": true, "偏好类型": "任意"}
		if 队长 != null and Game.has_method("弟子AI用毒判定"):
			用毒判定 = Game.弟子AI用毒判定(队长)
		if not bool(用毒判定.get("可用毒", true)):
			# 正道弟子拒绝用毒
			if Game.has_method("添加纪事"):
				Game.添加纪事("毒道", "未施毒", "%s乃正道弟子，不屑于用毒，有违道心。" % str(队长.姓名 if 队长 != null else "弟子"), 1)
		else:
			var 偏好类型: String = str(用毒判定.get("偏好类型", "任意"))
			var 毒药列表: Array = Game.获取毒药列表()
			for 毒药 in 毒药列表:
				if str(毒药["品阶"]) in ["凡品", "灵品"] and str(毒药["类型"]) != "解毒药":
					# 按弟子偏好筛选毒药类型
					var 毒类型: String = str(毒药["类型"])
					if 偏好类型 == "麻痹毒" and 毒类型 != "麻痹毒":
						continue
					if 偏好类型 == "杀伤性毒" and 毒类型 == "麻痹毒":
						continue
					# 从库房消耗一枚该毒药
					var 找到: bool = false
					for i in range(Game.宗门库房.size()):
						var it = Game.宗门库房[i]
						if it != null and it.名称 == 毒药["名称"]:
							Game.宗门库房.remove_at(i)
							找到 = true
							break
					if 找到:
						var 毒伤: int = int(毒药["伤害"])
						守方快照["战力"] = max(1, int(守方快照.get("战力", 0)) - 毒伤)
						# 毒道：实际毒伤结算（减少敌方血量，符合修真世界观）
						var 实际毒伤: int = 0
						var 敌方属性: Dictionary = 守方快照.get("属性", {})
						if not 敌方属性.is_empty():
							var 最大血量: int = int(敌方属性.get("血", 100))
							实际毒伤 = min(int(最大血量 * 0.2), 毒伤)  # 最多扣20%最大血量
							敌方属性["血"] = max(1, 最大血量 - 实际毒伤)
							守方快照["属性"] = 敌方属性
							# 重新计算战力（血量减少后战力下降）
							守方快照["战力"] = max(1, int(守方快照.get("战力", 0)) - int(实际毒伤 * 0.5))
						# 按毒药类型区分历练用毒代价
						if 毒类型 == "麻痹毒":
							# 麻痹毒：控制性，正道声望小幅下降
							if Game.has_method("增加阵营声望"):
								Game.增加阵营声望("正道宗门", -1)
								Game.增加阵营声望("魔道邪宗", 1)
						else:
							# 杀伤性毒：正道声望下降
							if Game.has_method("增加阵营声望"):
								Game.增加阵营声望("正道宗门", -2)
								Game.增加阵营声望("魔道邪宗", 1)
						if Game.has_method("添加纪事"):
							Game.添加纪事("毒道", "历练施毒", "%s历练前暗中施放%s（%s），敌方道行削弱%d，受到%d点毒素伤害。%s" % [str(队长.姓名 if 队长 != null else "弟子"), 毒药["名称"], 毒类型, 毒伤, 实际毒伤, str(用毒判定.get("原因", ""))], 1)
						break
	# 判定成功/失败（S1-1：真实战斗引擎替代掷骰绕过）
	var 战报 = {"is_win": false, "battle_log": []}
	if not 攻方快照.is_empty():
		战报 = BattleManager.发起1v1(攻方快照, 守方快照, "quick", false)
	var 成功 = 战报.get("is_win", false)
	var 战斗战报 = _格式化战报(战报)
	# 失败→按难度 + 阶差 概率标记弟子「失踪」，并下发调查任务（P3 逻辑链）
	# 阶差 = 关卡要求阶 - 弟子修为阶：低阶弟子做高级任务时阶差大→失踪率显著升高（贴合真实修真：弱者闯险地易失联）
	if not 成功:
		var 关卡要求阶 = _关卡要求阶(关卡)
		for did in 弟子ID列表:
			var _d = _获取弟子(did)
			if _d == null:
				continue
			var 阶差 = max(0, 关卡要求阶 - _修为阶(_d))
			var 失踪概率 = clamp(float(关卡["难度"]) * 0.15 + 阶差 * 0.05, 0.0, 0.80)
			if randf() < 失踪概率:
				_标记失踪(did, 关卡)
	# 评级
	var 评级 = "C"
	if 成功:
		if 战力比 >= 1.5:
			评级 = "S"
		elif 战力比 >= 1.0:
			评级 = "A"
		else:
			评级 = "B"
	else:
		评级 = "C"
	# 掉落
	var 掉落 = _计算掉落(关卡["掉落池"], 评级, 成功)
	# 随机事件
	var 事件 = _触发事件(关卡["事件池"], 弟子ID列表)
	# 修真味历练事件（基于弟子性格自动决策）
	if 成功 and randf() < 0.15:
		_历练修真事件(弟子ID列表, 关卡)
	# 记录已完成
	if 关卡["类型"] == "daily":
		已完成日常.append(关卡ID)
	elif 关卡["类型"] == "secret":
		已完成秘境.append(关卡ID)
	# 移除进行中
	进行中历练.erase(实例ID)
	# 应用事件效果
	_应用事件效果(事件, 弟子ID列表)
	# 杀敌拾遗：历练得手（尤其秘境激战），有几率从敌身搜出保命之物（P3 保命来源：杀敌）
	if 成功 and randf() < (0.10 + float(关卡["难度"]) * 0.03):
		var _幸存 := []
		for did in 弟子ID列表:
			var _d = _获取弟子(did)
			if _d != null and _d.状态 != "陨落":
				_幸存.append(did)
		# P3 保命环节：杀敌所得以「实物保命道具」入背包，非直接计数
		if not _幸存.is_empty() and Game != null and Game.has_method("构造保命道具"):
			var _中 = _幸存.pick_random()
			var _徒 = _获取弟子(int(_中))
			if _徒 != null:
				var 战利品 = Game.构造保命道具("血战护符", "宝阶", "fabao",
					"斩敌所得护身法宝，致命劫数下替弟子挡劫", "血战余生所得的护身之宝，再逢死劫时自发护主。")
				_徒.获得物品(战利品)
				if Game.has_method("添加纪事"):
					Game.添加纪事("保命", "杀敌", "%s 历练斩敌立功，获战利【血战护符】（法宝·保命），纳入背包" % _徒.姓名, 1)
	# 修真味纪事：收获/返程
	var 弟子名列表2: Array = []
	for did in 弟子ID列表:
		var _d2 = _获取弟子(did)
		if _d2 != null:
			弟子名列表2.append(str(_d2.姓名))
	var 弟子名串2: String = "、".join(弟子名列表2)
	var 关卡名2: String = str(关卡.get("名称", ""))
	if 成功:
		var 收获文案: String = ""
		match 评级:
			"S":
				收获文案 = "%s于%s大获全胜，满载而归，宗门上下为之侧目。" % [弟子名串2, 关卡名2]
			"A":
				收获文案 = "%s于%s有所斩获，收获颇丰，安然归宗。" % [弟子名串2, 关卡名2]
			"B":
				收获文案 = "%s于%s险中求胜，虽折损些须，终究有所得。" % [弟子名串2, 关卡名2]
			_:
				收获文案 = "%s自%s归来，所获寥寥。" % [弟子名串2, 关卡名2]
		if Game != null and Game.has_method("添加纪事"):
			Game.添加纪事("历练", "归来", 收获文案, 2 if 评级 == "S" else 1)
	else:
		var 失败文案: String = "%s于%s受挫，铩羽而归。" % [弟子名串2, 关卡名2]
		if Game != null and Game.has_method("添加纪事"):
			Game.添加纪事("历练", "失利", 失败文案, 2)
	# 发放奖励到宗门
	_结算因果(守方快照, 弟子ID列表, 成功, 关卡)
	# S28 悬赏：弟子历练归来，有概率获得悬赏目标物并上交
	if 成功 and Game != null:
		for did in 弟子ID列表:
			var _d = _获取弟子(did)
			if _d != null:
				# 检查该弟子是否接取了悬赏
				for bid in Game.宗门悬赏榜:
					var 悬赏 = Game.宗门悬赏榜[bid]
					if int(悬赏.get("接取弟子ID", -1)) != int(did):
						continue
					# 30%概率获得目标物（难度越高概率越低）
					var 获取概率: float = 0.30 - float(关卡.get("难度", 1)) * 0.03
					if randf() < 获取概率:
						var 目标物: String = str(悬赏.get("目标物名称", ""))
						var 获取数: int = randi_range(1, max(1, int(悬赏.get("需求数量", 1)) / 3))
						Game.上交悬赏物品(int(did), 目标物, 获取数)
					break
	_发放奖励(掉落)
	# P0-1历练优化：添加历史记录
	var 奇遇记录列表: Array = 实例.get("奇遇记录", [])
	var 历史结局: String = "普通"
	if 成功 and 评级 == "S" and 奇遇记录列表.size() >= 2:
		历史结局 = "完美"
	elif 成功 and 评级 == "S":
		历史结局 = "大捷"
	elif 成功 and bool(实例.get("继续深入", false)):
		历史结局 = "深入"
	elif 成功 and bool(实例.get("提前结束", false)):
		历史结局 = "稳妥"
	elif not 成功 and 奇遇记录列表.size() >= 1:
		历史结局 = "险归"
	添加历练记录({
		"历练ID": 实例ID,
		"关卡名称": 关卡["名称"],
		"路线": str(实例.get("路线", "稳妥")),
		"开始日": int(实例.get("开始游戏日", 0)),
		"成功": 成功,
		"评级": 评级,
		"结局类型": 历史结局,
		"奇遇次数": 奇遇记录列表.size(),
		"奖励": 掉落,
		"弟子ID列表": 弟子ID列表,
		# P0-3 战斗快播：存双方快照与原始战报，供历练史册「观战」回放
		"攻方快照": 攻方快照,
		"守方快照": 守方快照,
		"原始战报": 战报,
	})
	return {
		"实例ID": 实例ID,
		"关卡ID": 关卡ID,
		"关卡名称": 关卡["名称"],
		# S1-2：补出关卡类型（daily/realm/secret），供 game_state 侧按类型埋任务进度。
		#   纯新增字段，不改变任何既有字段语义，调用方取不到的场景走 .get 默认值。
		"类型": 关卡["类型"],
		"成功": 成功,
		"评级": 评级,
		"总战力": 总战力,
		"推荐战力": 推荐战力,
		"成功率": 成功率,
		"战斗战报": 战斗战报,
		# P0-3 战斗快播：保留原始战报（含 battle_log），供历练史册「观战」回放
		"原始战报": 战报,
		"掉落": 掉落,
		"事件": 事件,
		"弟子ID列表": 弟子ID列表,
		# P2接入：保存双方快照，供战斗场景回放使用（点击回放时用full模式重新计算）
		"攻方快照": 攻方快照,
		"守方快照": 守方快照,
	}

# ============ 因果结算（修真味·业力/功德事件入口）============
# 设计：斩妖诛邪 = 功德（除害护道）；杀同类修士 = 业力（杀业缠身）。
# 数值 rationale：
#   · 功德 = 2 + 关卡难度（难度1~5 → 3~7点/次），约 15~30 次历练攒满 100 功德
#     → 天劫 -10%（tribulation.因果天劫倍率 帽 -20%），属长期养成，非速成。
#   · 业力 = 20/次（斩人族修士），5 次即达 100 → 天劫 +10%，惩罚可感但可逆（积德抵消）。
#   · 陨落弟子不结算（已不在世，因果随其身灭）。
const 因果_功德种族: Array = ["妖族", "异兽", "魔族", "鬼族", "龙族"]
const 因果_杀业种族: Array = ["人族"]
## 历练修真事件（15%概率触发，基于弟子性格自动决策）
func _历练修真事件(弟子ID列表: Array, 关卡: Dictionary) -> void:
	if 弟子ID列表.is_empty():
		return
	var 主弟子: Object = _获取弟子(弟子ID列表[0])
	if 主弟子 == null:
		return
	var 性格: String = str(主弟子.性格) if "性格" in 主弟子 else "沉稳守道"
	var 关卡名: String = str(关卡.get("名称", ""))
	var roll: float = randf()
	if roll < 0.25:
		# 遇到妖兽
		if 性格 in ["桀骜不羁", "狂傲绝世", "杀伐果断"]:
			# 好战性格：正面硬刚
			var 额外灵石: int = randi_range(20, 100)
			if Game != null:
				Game.灵石 += 额外灵石
			if Game != null and Game.has_method("添加纪事"):
				Game.添加纪事("历练", "斩杀妖兽", "%s于%s撞见妖兽，不由分说拔剑便斩，得妖兽材料及%d灵石。" % [主弟子.姓名, 关卡名, 额外灵石], 2)
		else:
			# 谨慎性格：绕道而行
			if Game != null and Game.has_method("添加纪事"):
				Game.添加纪事("历练", "避其锋芒", "%s于%s撞见妖兽，审时度势绕道而行，虽无斩获却保全性命。" % [主弟子.姓名, 关卡名], 1)
	elif roll < 0.45:
		# 遇到散修
		if 性格 in ["豪迈仗义", "仁心济世", "守礼尊师"]:
			# 善良性格：结交
			var 声望加: int = randi_range(1, 5)
			if Game != null:
				Game.声望 += 声望加
			if Game != null and Game.has_method("添加纪事"):
				Game.添加纪事("历练", "结交散修", "%s在%s偶遇云游散修，相谈甚欢，结下善缘，宗门声望+%d。" % [主弟子.姓名, 关卡名, 声望加], 2)
		elif 性格 in ["桀骜不羁", "杀伐果断"]:
			# 好战性格：黑吃黑
			if randf() < 0.5:
				var 额外灵石: int = randi_range(50, 200)
				if Game != null:
					Game.灵石 += 额外灵石
				if Game != null and Game.has_method("添加纪事"):
					Game.添加纪事("历练", "黑吃黑", "%s于%s偶遇落单散修，见财起意痛下杀手，夺其储物袋得%d灵石。" % [主弟子.姓名, 关卡名, 额外灵石], 3)
			else:
				主弟子.受伤剩余 = max(int(主弟子.受伤剩余), 5)
				if Game != null and Game.has_method("添加纪事"):
					Game.添加纪事("历练", "黑吃黑失败", "%s于%s意图黑吃黑，岂料对方深藏不露，反被其击伤，需养伤5日。" % [主弟子.姓名, 关卡名], 3)
		else:
			if Game != null and Game.has_method("添加纪事"):
				Game.添加纪事("历练", "擦肩而过", "%s在%s偶遇散修，双方点头致意，各奔东西。" % [主弟子.姓名, 关卡名], 1)
	elif roll < 0.65:
		# 发现洞府
		if 性格 in ["锐意争先", "贪心逐缘", "狂傲绝世"]:
			# 冒险性格：立刻探索
			if randf() < 0.6:
				var 悟道: int = randi_range(10, 50)
				if Game != null:
					Game.悟道点 += 悟道
				if Game != null and Game.has_method("添加纪事"):
					Game.添加纪事("历练", "洞府奇遇", "%s于%s寻得一处隐蔽洞府，入内探得前人遗留手札，研读后大有感悟！" % [主弟子.姓名, 关卡名], 3)
			else:
				主弟子.受伤剩余 = max(int(主弟子.受伤剩余), 10)
				if Game != null and Game.has_method("添加纪事"):
					Game.添加纪事("历练", "洞府陷阱", "%s于%s寻得洞府，贸然闯入触动禁制，身受重伤需养伤10日。" % [主弟子.姓名, 关卡名], 3)
		else:
			# 谨慎性格：标记位置回报宗门
			if Game != null and Game.has_method("添加纪事"):
				Game.添加纪事("历练", "标记洞府", "%s于%s寻得一处隐蔽洞府，恐有禁制未敢擅入，暗记方位回宗禀报。" % [主弟子.姓名, 关卡名], 2)
	elif roll < 0.80:
		# 灵泉/灵草发现
		var 灵草数: int = randi_range(2, 10)
		if Game != null:
			Game.灵草 += 灵草数
		if Game != null and Game.has_method("添加纪事"):
			Game.添加纪事("历练", "灵草收获", "%s于%s寻得一丛天生灵草，采得%d株。" % [主弟子.姓名, 关卡名, 灵草数], 2)
	else:
		# 修炼突破契机
		var 心境加: int = randi_range(1, 3)
		if "增加心境" in 主弟子:
			主弟子.增加心境(心境加)
		if Game != null and Game.has_method("添加纪事"):
			Game.添加纪事("历练", "心境突破", "%s在%s历练中有所感悟，心境+%d。" % [主弟子.姓名, 关卡名, 心境加], 2)

func _结算因果(守方快照: Dictionary, 弟子ID列表: Array, 成功: bool, 关卡: Dictionary) -> void:
	if not 成功:
		return
	var 种族列表: Array = 守方快照.get("敌方种族", [])
	if 种族列表.is_empty():
		return
	var 难度: float = float(关卡.get("难度", 1))
	var 功德量: int = 0
	var 业力量: int = 0
	for rc in 种族列表:
		var s: String = str(rc)
		if s in 因果_功德种族:
			功德量 += int(2 + 难度)
		elif s in 因果_杀业种族:
			业力量 += 20
	if 功德量 <= 0 and 业力量 <= 0:
		return
	var 记账: Array = []
	for did in 弟子ID列表:
		var d = _获取弟子(did)
		if d == null or d.状态 == "陨落":
			continue
		if 功德量 > 0 and d.has_method("增加功德"):
			d.增加功德(功德量)
		if 业力量 > 0 and d.has_method("增加业力"):
			d.增加业力(业力量)
		记账.append(d.姓名)
	if 记账.is_empty():
		return
	if Game != null and Game.has_method("添加纪事"):
		if 功德量 > 0:
			Game.添加纪事("历练", "斩妖积德",
				"%s 于%s斩妖除害，功德+%d" % ["、".join(记账), str(关卡.get("名称", "历练")), 功德量], 1)
		if 业力量 > 0:
			Game.添加纪事("历练", "杀业缠身",
				"%s 于%s手染同族之血，业力+%d" % ["、".join(记账), str(关卡.get("名称", "历练")), 业力量], 2)

# ============ 调查任务逻辑（P3 扩展）============
func _标记失踪(弟子ID: int, 关卡: Dictionary) -> void:
	var d = _获取弟子(弟子ID)
	if d == null:
		return
	if d.状态 == "陨落" or d.状态 == "失踪" or d.状态 == "叛出":
		return
	# 保命环节（P3）：致命伤害时按优先级替死，弟子不失踪、不陨落
	# 优先级：灵兽护主 → 傀儡替死 → 假死丹 → 保命护身道具
	if _灵兽护主替死(d):
		return
	if _傀儡替死(d):
		return
	if _保命道具替死(d):
		return
	if d.保命护身 > 0:
		d.保命护身 -= 1
		if Game != null and Game.has_method("添加纪事"):
			Game.添加纪事("历练", "保命护身", "%s 遇致命劫数，随身保命护身碎裂，护其生还归来" % d.姓名, 1)
		return
	d.状态 = "失踪"
	var 阶 = _修为阶(d)
	调查实例计数器 += 1
	var tid = "inv_" + str(调查实例计数器)
	调查任务列表[tid] = {
		"任务ID": tid,
		"失踪弟子ID": 弟子ID,
		"失踪弟子名": d.姓名,
		"失踪弟子境界": d.境界,
		"失踪关卡名": 关卡.get("名称", ""),
		"要求修为阶": 阶,
		"难度": int(关卡.get("难度", 1)),
		"发布日": (int(Game.get("累计游戏日")) if Game != null else 0),
		"奖励灵石": 200 * int(关卡.get("难度", 1)),
		"奖励贡献点": 20 * int(关卡.get("难度", 1)),
		"链": "失踪", "链序": 1, "前驱任务ID": "",   # P3 任务联动：本任务为链首（A）
	}
	if Game != null and Game.has_method("添加纪事"):
		Game.添加纪事("历练", "弟子失踪", "%s 于【%s】历练失败，不知所踪，宗门已下发调查差事" % [d.姓名, 关卡.get("名称", "")], 2)

# P3 保命环节：灵兽护主替死（绑定灵兽中有护主技能则代弟子挡劫，消耗该兽）
func _灵兽护主替死(d: Object) -> bool:
	if d == null:
		return false
	for 兽 in [d.主宠灵兽, d.副宠灵兽]:
		if 兽 != null and 兽.护主:
			var 兽名 = 兽.种类名
			if 兽 == d.主宠灵兽:
				d.主宠灵兽 = null
			else:
				d.副宠灵兽 = null
			if Game != null and Game.has_method("添加纪事"):
				Game.添加纪事("历练", "灵兽护主", "%s 的灵兽%s舍身护主，替其挡下致命一劫" % [d.姓名, 兽名], 1)
			return true
	return false

# P3 保命环节：傀儡替死（宗门替死傀儡池中有替死傀儡则耗一具代弟子挡劫）
func _傀儡替死(d: Object) -> bool:
	if Game == null or not Game.has_method("取可用替死傀儡"):
		return false
	var 傀儡 = Game.取可用替死傀儡()
	if 傀儡 != null:
		var 名 = str(傀儡.get("名称", ""))
		Game.消耗替死傀儡(傀儡)
		if Game.has_method("添加纪事"):
			Game.添加纪事("历练", "傀儡替死", "宗门替死傀儡%s替%s挡下致命一劫，自身崩碎" % [名, d.姓名], 1)
		return true
	return false

# P3 保命环节：保命道具替死（背包中有保命道具——假死丹或任意 保命 标记法宝——则消耗其一避劫）
func _保命道具替死(d: Object) -> bool:
	if d == null or d.背包 == null:
		return false
	for i in range(d.背包.size()):
		var it = d.背包[i]
		if it == null or not (it is Item):
			continue
		var 名 = str(it.名称)
		var 是保命道具: bool = (it.保命 == true) or ("假死丹" in 名)
		if 是保命道具:
			d.背包.remove_at(i)
			if Game != null and Game.has_method("添加纪事"):
				Game.添加纪事("历练", "保命道具", "%s 的%s自行护主，替其挡下致命一劫，化险为夷" % [d.姓名, 名], 1)
			return true
	return false

func _派生后继任务(前驱: Dictionary, 分支: String) -> String:
	# 基于前驱调查任务派生后继任务（因果链 A→B→C）：前驱.失踪弟子 同一人，难度/要求/赏格递进
	var 徒ID = int(前驱.get("失踪弟子ID", -1))
	var 徒名 = 前驱.get("失踪弟子名", "")
	var 徒境 = 前驱.get("失踪弟子境界", "")
	var 关名 = 前驱.get("失踪关卡名", "")
	var 前难度 = int(前驱.get("难度", 1))
	var 前要求 = int(前驱.get("要求修为阶", 0))
	var 前奖励 = int(前驱.get("奖励灵石", 200))
	调查实例计数器 += 1
	var tid = "inv_" + str(调查实例计数器)
	var 新难度 = 前难度 + 1
	var 新要求 = 前要求 + 10
	var 新奖励 = int(前奖励 * 1.5)
	var 链名 = "追凶"
	var 链序 = 2
	if 分支 == "通缉":
		新奖励 = int(前奖励 * 2.0)
		新要求 = 前要求 + 10
		链名 = "通缉"
		链序 = 2
	elif 分支 == "肃清":
		新难度 = 前难度 + 1
		新要求 = 前要求 + 20
		新奖励 = int(前奖励 * 2.0)
		链名 = "肃清"
		链序 = 3
	调查任务列表[tid] = {
		"任务ID": tid, "失踪弟子ID": 徒ID, "失踪弟子名": 徒名, "失踪弟子境界": 徒境,
		"失踪关卡名": 关名, "要求修为阶": 新要求, "难度": 新难度,
		"发布日": (int(Game.get("累计游戏日")) if Game != null else 0),
		"奖励灵石": 新奖励, "奖励贡献点": int(新奖励 / 10),
		"链": 链名, "链序": 链序, "前驱任务ID": str(前驱.get("任务ID", "")),
	}
	return tid

func 开始调查(任务ID: String, 接取弟子ID列表: Array) -> Dictionary:
	if not 调查任务列表.has(任务ID):
		return {"成功": false, "原因": "调查差事不存在"}
	if 接取弟子ID列表.is_empty() or 接取弟子ID列表.size() > 3:
		return {"成功": false, "原因": "需派遣1-3名高阶弟子"}
	var 任务 = 调查任务列表[任务ID]
	var 要求 = int(任务.get("要求修为阶", 0))
	for did in 接取弟子ID列表:
		var d = _获取弟子(did)
		if d == null:
			return {"成功": false, "原因": "弟子不存在"}
		if d.状态 == "失踪" or d.状态 == "陨落" or d.状态 == "叛出":
			return {"成功": false, "原因": "%s 已失踪/陨落，无法接取" % d.姓名}
		if _修为阶(d) <= 要求:
			return {"成功": false, "原因": "%s 修为不足，须高于失踪弟子" % d.姓名}
		if _弟子是否在历练中(did):
			return {"成功": false, "原因": "%s 正在历练中" % d.姓名}
	调查实例计数器 += 1
	var iid = "invrun_" + str(调查实例计数器)
	var 当前游戏日 = int(Game.get("累计游戏日")) if Game != null else 0
	var 时长 = int(任务.get("难度", 1)) * 2 + 2
	调查进行中[iid] = {
		"实例ID": iid, "任务ID": 任务ID, "失踪弟子ID": int(任务.get("失踪弟子ID", -1)),
		"接取弟子ID列表": 接取弟子ID列表.duplicate(), "开始游戏日": 当前游戏日,
		"预计结束游戏日": 当前游戏日 + 时长, "任务": 任务,
	}
	调查任务列表.erase(任务ID)
	if Game != null and Game.has_method("添加纪事"):
		Game.添加纪事("历练", "派出调查", "宗门遣高阶弟子前往调查 %s 失踪一事" % 任务.get("失踪弟子名", ""), 1)
	return {"成功": true, "实例ID": iid}

func _结算调查(实例ID: String) -> Dictionary:
	var 实例 = 调查进行中.get(实例ID, {})
	if 实例.is_empty():
		return {}
	var 任务 = 实例.get("任务", {})
	var 难度 = int(任务.get("难度", 1)) if not 任务.is_empty() else 2
	var 失踪弟子ID = int(实例.get("失踪弟子ID", -1))
	var 接取列表 = 实例.get("接取弟子ID列表", [])
	var 总战力 = 0
	for did in 接取列表:
		var d = _获取弟子(did)
		if d != null:
			总战力 += int(d.战力)
	var 找回率 = clamp(float(总战力) / float(max(难度 * 1500, 1)), 0.2, 0.92)
	var 调查成功 = randf() < 找回率
	调查进行中.erase(实例ID)
	var 失踪者 = _获取弟子(失踪弟子ID)
	var 结果文本: String = ""
	var tid = 实例.get("任务ID", "")
	if 调查成功:
		# 寻回后按难度判生还/陨落（高风险关卡常客死）
		var 生还率 = clamp(1.0 - 难度 * 0.12, 0.3, 0.95)
		var 生还 = randf() < 生还率
		if 生还:
			if 失踪者 != null:
				失踪者.状态 = "在宗"
			if Game != null:
				Game.灵石 += int(任务.get("奖励灵石", 200))
				if "贡献点" in Game:
					Game.贡献点 += int(任务.get("奖励贡献点", 20))
				Game.添加纪事("历练", "寻回弟子", "高阶弟子寻得%s，安然归来，宗门已发赏赐" % (失踪者.姓名 if 失踪者 != null else "失踪弟子"), 1)
			结果文本 = "寻得%s，安然归来" % (失踪者.姓名 if 失踪者 != null else "失踪弟子")
		else:
			var 已转世: bool = false
			if 失踪者 != null:
				if Game != null and Game._转世判定(失踪者):
					已转世 = true
					Game.添加纪事("历练", "转世重修", "%s 于陨落之际转世重修，再入轮回" % 失踪者.姓名, 2)
					结果文本 = "寻得%s，竟已转世重修，再踏仙途" % 失踪者.姓名
				else:
					失踪者.状态 = "陨落"
					if Game != null:
						Game.添加纪事("历练", "弟子陨落", "寻得%s骸骨，确认陨落，命牌碎裂" % 失踪者.姓名, 2)
						结果文本 = "寻得%s骸骨，确认陨落" % 失踪者.姓名
			else:
				结果文本 = "寻得失踪弟子骸骨，确认陨落"
		if 调查任务列表.has(tid):
			调查任务列表.erase(tid)
		# 任务联动（因果链）：寻回/确认后派生后继任务（A 影响 B、B 建立在 A 之上）
		var 链 = str(任务.get("链", "失踪"))
		if 链 == "失踪":
			var nt = _派生后继任务(任务, "追凶")
			if Game != null:
				Game.添加纪事("历练", "追查真凶", "寻回后察觉事有蹊跷，宗门下令追查真凶（派生调查 %s）" % nt, 1)
		elif 链 == "追凶" or 链 == "通缉":
			var nt = _派生后继任务(任务, "肃清")
			if Game != null:
				Game.添加纪事("历练", "肃清秘境", "锁定凶巢，宗门发兵肃清秘境（派生调查 %s）" % nt, 1)
	else:
		# 调查无果：链首升级为「悬赏通缉」（B'），提高赏格与要求，重新挂出供再派
		if str(任务.get("链", "失踪")) == "失踪":
			任务["链"] = "通缉"
			任务["链序"] = 2
			任务["要求修为阶"] = int(任务.get("要求修为阶", 0)) + 10
			任务["奖励灵石"] = int(任务.get("奖励灵石", 200)) * 2
			任务["奖励贡献点"] = int(任务.get("奖励贡献点", 20)) * 2
			任务["前驱任务ID"] = tid
			调查任务列表[tid] = 任务
			if Game != null:
				Game.添加纪事("历练", "悬赏通缉", "寻找%s的调查无果，宗门悬赏通缉、广发寻人（调查 %s）" % [(失踪者.姓名 if 失踪者 != null else "失踪弟子"), tid], 1)
			结果文本 = "调查无果，宗门悬赏通缉%s" % (失踪者.姓名 if 失踪者 != null else "失踪弟子")
		else:
			# 后续链（追凶/肃清）无果：维持原任务可再派
			调查任务列表[tid] = 任务
			if Game != null:
				Game.添加纪事("历练", "调查无果", "寻找%s的调查无果，仍不知所踪" % (失踪者.姓名 if 失踪者 != null else "失踪弟子"), 1)
			结果文本 = "调查无果，%s仍不知所踪" % (失踪者.姓名 if 失踪者 != null else "失踪弟子")
	return {"成功": 调查成功, "文本": 结果文本, "生还": (调查成功 and 失踪者 != null and 失踪者.状态 == "在宗")}

func 获取调查任务列表() -> Dictionary:
	return 调查任务列表.duplicate()

func 获取调查进行中() -> Dictionary:
	return 调查进行中.duplicate()

func 获取可接取弟子(任务ID: String) -> Array:
	var 任务 = 调查任务列表.get(任务ID, {})
	if 任务.is_empty():
		return []
	var 要求 = int(任务.get("要求修为阶", 0))
	var 结果: Array = []
	if Game == null:
		return 结果
	for d in Game.弟子列表:
		if d == null:
			continue
		if d.状态 == "失踪" or d.状态 == "陨落" or d.状态 == "叛出":
			continue
		if _弟子是否在历练中(int(d.弟子ID)):
			continue
		if _修为阶(d) > 要求:
			结果.append({"id": int(d.弟子ID), "姓名": d.姓名, "境界": d.境界, "层数": d.层数})
	return 结果

# ============ 掉落计算 ============
func _计算掉落(池ID: String, 评级: String, 成功: bool) -> Dictionary:
	var 池 = 掉落池.get(池ID, {})
	if 池.is_empty():
		return {}
	var 结果: Dictionary = {}
	# 评级倍率
	var 倍率 = 1.0
	match 评级:
		"S": 倍率 = 1.3
		"A": 倍率 = 1.0
		"B": 倍率 = 0.8
		"C": 倍率 = 0.6
	if not 成功:
		倍率 *= 0.5
	# 必掉
	for item in 池.get("必掉", []):
		var 数量 = randi_range(int(item["最小"]), int(item["最大"]))
		数量 = int(float(数量) * 倍率)
		if 数量 > 0:
			结果[item["物品"]] = 结果.get(item["物品"], 0) + 数量
	# 普通掉落
	if 成功:
		for item in 池.get("普通", []):
			if randf() < float(item["概率"]):
				var 数量 = randi_range(int(item["最小"]), int(item["最大"]))
				数量 = int(float(数量) * 倍率)
				if 数量 > 0:
					结果[item["物品"]] = 结果.get(item["物品"], 0) + 数量
	# 稀有掉落（含保底）
	var 出稀有 = false
	if 成功:
		var 保底次数 = int(池.get("稀有保底", 10))
		var 当前计数 = int(稀有保底计数.get(池ID, 0))
		for item in 池.get("稀有", []):
			var 概率 = float(item["概率"])
			# 保底加成
			if 当前计数 >= 保底次数:
				概率 = 1.0
			if randf() < 概率:
				var 数量 = randi_range(int(item["最小"]), int(item["最大"]))
				数量 = int(float(数量) * 倍率)
				if 数量 > 0:
					结果[item["物品"]] = 结果.get(item["物品"], 0) + 数量
					出稀有 = true
		if 出稀有:
			稀有保底计数[池ID] = 0
		else:
			稀有保底计数[池ID] = 当前计数 + 1
	return 结果

# ============ 事件系统 ============
func _触发事件(池ID: String, 弟子ID列表: Array) -> Dictionary:
	var 池 = 事件池.get(池ID, [])
	if 池.is_empty():
		return {}
	# 15%概率触发事件
	if randf() > 0.15:
		return {}
	# 按概率加权选择
	var 总概率 = 0.0
	for ev in 池:
		总概率 += float(ev["概率"])
	if 总概率 <= 0:
		return {}
	var r = randf() * 总概率
	var 累计 = 0.0
	for ev in 池:
		累计 += float(ev["概率"])
		if r <= 累计:
			return ev.duplicate()
	return {}

func _应用事件效果(事件: Dictionary, 弟子ID列表: Array) -> void:
	if 事件.is_empty():
		return
	# 资源类效果直接加到宗门
	if 事件.has("灵石"):
		if Game != null:
			Game.灵石 += int(事件["灵石"])
	if 事件.has("贡献点"):
		if Game != null and "贡献点" in Game:
			Game.贡献点 += int(事件["贡献点"])
	if 事件.has("声望"):
		if Game != null and "声望" in Game:
			Game.声望 += int(事件["声望"])
	if 事件.has("悟道点"):
		if Game != null and "悟道点" in Game:
			Game.悟道点 += int(事件["悟道点"])
	# 弟子属性类效果（平均分配给所有弟子）
	for did in 弟子ID列表:
		var d = _获取弟子(did)
		if d == null:
			continue
		if 事件.has("心境") and d.has_method("增加心境"):
			d.增加心境(int(事件["心境"]))
		if 事件.has("道心") and d.has_method("增加道心"):
			d.增加道心(int(事件["道心"]))
		if 事件.has("心魔") and d.has_method("增加心魔"):
			d.增加心魔(int(事件["心魔"]))
		# 修真味·因果：事件可直接增减 业力/功德（配置驱动，供后续事件表扩展）
		if 事件.has("业力") and d.has_method("增加业力"):
			d.增加业力(int(事件["业力"]))
		if 事件.has("功德") and d.has_method("增加功德"):
			d.增加功德(int(事件["功德"]))

# ============ 奖励发放 ============
# S40 历练命名灵草掉落：原 else 分支仅 push_warning 直接丢弃（沉底丢失 bug），
# 现改为生成带「年份」的 ling_cai 入库，接入炼丹「料」因子与坊市价值倍率。
const 历练灵草年份: Dictionary = {
	"普通灵草": {"年份": 0, "品阶": "凡阶"},
	"千年灵草": {"年份": 1000, "品阶": "仙阶"},
	"万年灵草": {"年份": 3000, "品阶": "道阶"},
}
func _发放奖励(掉落: Dictionary) -> void:
	if Game == null:
		return
	for 物品名 in 掉落.keys():
		var 数量 = int(掉落[物品名])
		# S2 增强·毕业物掉落：神器 / 无上功法 / 奇物 / 超道阶神兽 专属授予（if/elif 链，规避 match 歧义）
		if 物品名 == "灵石":
			Game.灵石 += 数量
		elif 物品名 == "贡献点":
			if "贡献点" in Game:
				Game.贡献点 += 数量
		elif 物品名 == "声望":
			if "声望" in Game:
				Game.声望 += 数量
		elif 物品名 == "悟道点":
			if "悟道点" in Game:
				Game.悟道点 += 数量
		elif 物品名.begins_with("shenqi_"):
			var 神器ID: String = 物品名.trim_prefix("shenqi_")
			if Item.神器库.has(神器ID):
				var 神器 = Item.生成神器(神器ID)
				if 神器 != null and "宗门库房" in Game:
					Game.宗门库房.append(神器)
					if Game.has_method("添加纪事"):
						Game.添加纪事("历练", "神器现世", "秘境深处惊现神器【%s】，已收入宗门库房。" % 神器.名称, 2)
			continue
		elif 物品名.begins_with("ss_"):
			if Game.has_method("发放灵舟奖励"):
				Game.发放灵舟奖励(物品名)
			continue
		elif 物品名.begins_with("gongfa_"):
			var 功法ID: String = 物品名.trim_prefix("gongfa_")
			var 功法 = GongFaSystem.功法库.get(功法ID, {})
			if not 功法.is_empty() and "弟子列表" in Game and Game.弟子列表.size() > 0:
				var 宗主 = Game.弟子列表[0]
				if not 功法ID in 宗主.已学功法:
					宗主.已学功法.append(功法ID)
					宗主.修炼速度 = float(宗主.修炼速度) * (1.0 + float(功法.get("修炼加成", 0)))
					宗主.战力 = int(宗主.战力) + int(功法.get("战力加成", 0))
					if Game.has_method("添加纪事"):
						Game.添加纪事("历练", "无上传承", "宗主于秘境参悟无上功法【%s】！" % 功法.get("名称", ""), 2)
			continue
		elif 物品名.begins_with("奇物_"):
			var 奇物品阶: String = 物品名.trim_prefix("奇物_")
			var 奇物 = Item.生成奇物(奇物品阶)
			if 奇物 != null and "宗门库房" in Game:
				Game.宗门库房.append(奇物)
				if Game.has_method("添加纪事"):
					Game.添加纪事("历练", "奇物惊现", "秘境中得变异奇物【%s】！" % 奇物.名称, 1)
			continue
		elif 物品名 == "beast_hun":
			if "灵兽库存" in Game:
				var 兽 = Beast.new()
				兽.随机成蛋("hun_jie")
				兽.孵化()
				Game.灵兽库存.append(兽)
				if Game.has_method("添加纪事"):
					Game.添加纪事("历练", "源初现世", "秘境深处降生超道阶源初神兽【%s】！" % 兽.种类名, 2)
			continue
		elif 物品名.begins_with("frag_"):
			if Game.has_method("添加碎片"):
				Game.添加碎片(物品名, 数量)
			else:
				# 无 添加碎片 接口时不做「沉底仓储」：原实现动态创建 Game.历练仓库 且全仓零读取，物品永久丢失
				push_warning("[历练奖励] 缺少 添加碎片 接口，碎片 %s ×%d 未能入库" % [物品名, 数量])
		elif 物品名.begins_with("chest_"):
			if Game.has_method("添加宝箱"):
				Game.添加宝箱(物品名, 数量)
			else:
				# 无 添加宝箱 接口时不做「沉底仓储」：原实现动态创建 Game.历练仓库 且全仓零读取，物品永久丢失
				push_warning("[历练奖励] 缺少 添加宝箱 接口，宝箱 %s ×%d 未能入库" % [物品名, 数量])
		elif 历练灵草年份.has(物品名):
			var 配置: Dictionary = 历练灵草年份.get(物品名, {})
			var 年: int = int(配置.get("年份", 0))
			var 阶: String = str(配置.get("品阶", "凡阶"))
			for _k in range(数量):
				var it: Item = Item.new()
				it.类别 = "ling_cai"
				it.名称 = 物品名
				it.品阶 = 阶
				it.年份 = 年
				it.功效 = "秘境所得%s（%d年）" % [物品名, 年]
				if Game != null and "宗门库房" in Game:
					Game.宗门库房.append(it)
			continue
		else:
			# 无对应入库接口时不做「沉底仓储」：原实现动态创建 Game.历练仓库 且全仓零读取，物品永久丢失
			push_warning("[历练奖励] 物品 %s ×%d 无对应入库接口，未能入库" % [物品名, 数量])

# ============ 辅助函数 ============
func _获取弟子(弟子ID: int):
	if Game == null:
		return null
	var 弟子列表 = Game.get("弟子列表")
	if 弟子列表 == null:
		弟子列表 = []
	for d in 弟子列表:
		# 弟子是 Disciple（RefCounted），禁 .get(双参)——会抛错并使本函数永远返回 null
		if int(d.弟子ID) == 弟子ID:
			return d
	return null

