# 获取认主状态描述（修真化）
func 获取认主描述() -> String:
	match 认主类型:
		"无主":
			return "无主之物，可自由交易。"
		"滴血认主":
			return "此宝已滴血认主，与宿主血脉相连，不可转让。"
		"有缘者得":
			return "此乃天选之物，有缘者得之，不可转让。"
		"宗门印记":
			return "此物带有宗门印记，乃宗门传承，不可外传。"
		"宗主本命":
			return "此乃宗主本命之物，与神魂相连，他人无法使用。"
		_:
			return ""

# 解除认主（需消耗解主丹，有成功率）
func 尝试解除认主() -> Dictionary:
	if 认主类型 != "滴血认主":
		return {"成功": false, "原因": "唯有滴血认主之物可解除认主。"}
	# 成功率按品阶递减
	var 成功率: float = 1.0
	match 品阶:
		"凡阶": 成功率 = 1.0
		"灵阶": 成功率 = 0.8
		"宝阶": 成功率 = 0.6
		"王阶": 成功率 = 0.4
		"圣阶": 成功率 = 0.2
		"仙阶": 成功率 = 0.05
		"道阶": 成功率 = 0.01
	if randf() < 成功率:
		认主类型 = "无主"
		认主者ID = ""
		return {"成功": true, "原因": "认主已解除，此物恢复无主之身。"}
	else:
		return {"成功": false, "原因": "解除认主失败，此物与宿主羁绊太深。"}

# S55：化血散强行解除认主（宗门印记/宗主本命可用，但有代价）
func 化血散强行解除() -> Dictionary:
	if 认主类型 == "无主":
		return {"成功": false, "原因": "此物本就无主，无需化血。"}
	if 认主类型 == "滴血认主":
		return {"成功": false, "原因": "滴血认主之物，用解主丹即可，无需化血散这等霸道之物。"}
	# 化血散成功率
	var 成功率: float = 0.7
	match 品阶:
		"凡阶": 成功率 = 0.9
		"灵阶": 成功率 = 0.8
		"宝阶": 成功率 = 0.7
		"王阶": 成功率 = 0.5
		"圣阶": 成功率 = 0.3
		"仙阶": 成功率 = 0.15
		"道阶": 成功率 = 0.05
	if randf() < 成功率:
		var 原类型: String = 认主类型
		认主类型 = "无主"
		认主者ID = ""
		# 化血散的代价：物品品阶可能下降
		var 品阶列表: Array = ["凡阶", "灵阶", "宝阶", "王阶", "圣阶", "仙阶", "道阶"]
		var 当前索引: int = 品阶列表.find(品阶)
		if 当前索引 > 0 and randf() < 0.3:
			品阶 = 品阶列表[当前索引 - 1]
			return {"成功": true, "原因": "化血散霸道无比，强行抹去认主印记，但此物灵性受损，品阶降为%s。" % 品阶, "品阶下降": true}
		return {"成功": true, "原因": "化血散起效，强行抹去%s印记，此物恢复无主之身。" % 原类型, "品阶下降": false}
	else:
		return {"成功": false, "原因": "化血散未能抹去认主印记，此物与原主羁绊太深。"}

# 获取认主解除方式说明
func 获取认主解除方式() -> String:
	match 认主类型:
		"无主":
			return "无主之物，可直接交易。"
		"滴血认主":
			return "滴血认主之物，可使用解主丹解除（有成功率）。"
		"有缘者得":
			return "有缘者得之物，认主印记随缘分消散，无法强行解除。"
		"宗门印记":
			return "宗门印记之物，需化血散强行解除（可能导致品阶下降）。"
		"宗主本命":
			return "宗主本命之物，与神魂相连，化血散亦难解除，且代价极大。"
		_:
			return ""

# ===== S54 P4 鉴宝系统函数 =====
# 鉴定物品（揭示真实属性）
func 鉴定物品(鉴定师名: String = "聚宝阁鉴定师") -> Dictionary:
	if not 神秘物品:
		return {"成功": false, "原因": "此物并非神秘物品，无需鉴定。"}
	if 鉴定状态 == "已鉴定":
		return {"成功": false, "原因": "此物已鉴定过。"}
	# 鉴定成功率受赝品仿真度影响
	var 成功率: float = 1.0 - float(赝品仿真度) / 200.0
	if randf() < 成功率:
		# 鉴定成功
		鉴定状态 = "已鉴定"
		鉴定师 = 鉴定师名
		if Game != null:
			鉴定日 = Game.累计游戏日
		if 是赝品:
			# 赝品：揭示真实价值（低）
			return {
				"成功": true,
				"是赝品": true,
				"原因": "鉴定完毕！此物竟是赝品！仿真度%d，虽外观逼真，实则价值有限。" % 赝品仿真度,
				"真实名称": 真实名称,
				"真实品阶": 真实品阶,
				"真实描述": 真实描述,
			}
		else:
			# 真品：揭示真实价值（可能很高）
			品阶 = 真实品阶
			名称 = 真实名称
			描述 = 真实描述
			战力加成 = 真实战力
			神秘物品 = false
			return {
				"成功": true,
				"是赝品": false,
				"原因": "鉴定完毕！此物竟是%s！%s" % [真实名称, 真实描述],
				"真实名称": 真实名称,
				"真实品阶": 真实品阶,
				"真实描述": 真实描述,
				"真实战力": 真实战力,
				"激活条件": 激活条件,
			}
	else:
		# 鉴定失败
		return {"成功": false, "原因": "鉴定失败！此物玄机太深，鉴定师未能看透。"}

# 获取神秘物品显示名称（未鉴定时显示???）
func 获取显示名称() -> String:
	if 神秘物品 and 鉴定状态 != "已鉴定":
		return "???"
	return 名称

# 获取神秘物品显示品阶（未鉴定时显示未知）
func 获取显示品阶() -> String:
	if 神秘物品 and 鉴定状态 != "已鉴定":
		return "未知"
	return 品阶

# 是否需要特殊激活条件
func 需要特殊激活() -> bool:
	return 激活条件 != ""

# 获取激活条件描述
func 获取激活条件描述() -> String:
	if 激活条件 == "":
		return "无特殊激活条件"
	return 激活条件

func from_dict(d: Dictionary):
	类别 = d.get("类别", "法器")
	品阶 = d.get("品阶", "凡阶")
	穿戴位 = d.get("穿戴位", "")
	if 类别 in ["dan_yao", "ling_cai"]:
		穿戴位 = ""
	# @LEGACY-MIGRATION 旧档兼容：S1 批「职业→道途」定名迁移（老大 2026-08-02 拍板）
	道途 = d.get("道途", d.get("职业", ""))
	名称 = d.get("名称", "")
	数量 = int(d.get("数量", 1))
	# 旧档兼容：曾被误存为法器/神兵/法宝的「基础灵材」（草药/矿石具体名），归回 ling_cai 并清空穿戴属性。
	# 注：装备碎片/命格碎片等衍生材料不再强制归灵材（历史白名单已移除），须走坊市回收·市价60%。
	if 是材料名称(名称) and not (类别 in ["dan_yao", "ling_cai"]):
		类别 = "ling_cai"
		穿戴位 = ""
		道途 = ""
	功效 = d.get("功效", "")
	描述 = d.get("描述", "")
	战力加成 = d.get("战力加成", 0)
	极品 = d.get("极品", false)
	特殊 = d.get("特殊", false)
	词缀 = d.get("词缀", [])
	极品属性 = d.get("极品属性", null)
	奇遇版 = d.get("奇遇版", false)
	套装ID = d.get("套装ID", "")
	祭炼等级 = d.get("祭炼等级", 0)
	祭炼上限 = d.get("祭炼上限", 5)
	丹纹 = int(d.get("丹纹", 0))
	品级 = str(d.get("品级", "中品"))
	丹毒值 = float(d.get("丹毒值", -1.0))
	符纹 = int(d.get("符纹", 0))
	年份 = int(d.get("年份", 0))
	丹词条 = d.get("丹词条", [])
	装备词条 = d.get("装备词条", [])
	符词条 = d.get("符词条", [])
	保命 = d.get("保命", false)
	# P0-3 装备本体基础属性（旧档兼容：默认0）
	基础攻击 = int(d.get("基础攻击", 0))
	基础防御 = int(d.get("基础防御", 0))
	基础气血 = int(d.get("基础气血", 0))
	基础耐久 = int(d.get("基础耐久", 0))
	装备模板ID = str(d.get("装备模板ID", ""))
	# S53 物品认主系统（旧档兼容：默认无主）
	认主类型 = str(d.get("认主类型", "无主"))
	认主者ID = str(d.get("认主者ID", ""))
	认主日期 = int(d.get("认主日期", 0))
	# S54 P4 鉴宝系统（旧档兼容：默认已鉴定）
	神秘物品 = bool(d.get("神秘物品", false))
	鉴定状态 = str(d.get("鉴定状态", "已鉴定"))
	真实品阶 = str(d.get("真实品阶", ""))
	真实名称 = str(d.get("真实名称", ""))
	真实描述 = str(d.get("真实描述", ""))
	真实战力 = int(d.get("真实战力", 0))
	是赝品 = bool(d.get("是赝品", false))
	赝品仿真度 = int(d.get("赝品仿真度", 0))
	激活条件 = str(d.get("激活条件", ""))
	鉴定师 = str(d.get("鉴定师", ""))
	鉴定日 = int(d.get("鉴定日", 0))
