func to_dict() -> Dictionary:
	return {
		"已开启项目": 已开启项目,
		"上次执行日": 上次执行日,
		"代理日志": 代理日志,
		"法旨列表": 法旨列表,
		"法旨历史": 法旨历史,
		"闭关中": 闭关中,
	}

func from_dict(data: Dictionary) -> void:
	已开启项目 = data.get("已开启项目", {})
	上次执行日 = data.get("上次执行日", {})
	代理日志 = data.get("代理日志", [])
	法旨列表 = data.get("法旨列表", [])
	法旨历史 = data.get("法旨历史", [])
	闭关中 = bool(data.get("闭关中", false))
