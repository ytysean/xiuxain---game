# 随机物品名
func _随机物品名(类别: String, 品阶: String) -> String:
	var 前缀: Array = ["", "精品", "上品", "极品", "稀有"]
	var 前缀idx: int = min(前缀.size() - 1, ["凡阶", "灵阶", "宝阶", "王阶", "圣阶", "仙阶"].find(品阶))
	var 名前缀: String = 前缀[前缀idx]
	match 类别:
		"丹药":
			var 丹名: Array = ["回春丹", "筑基丹", "金丹", "元婴丹", "化神丹", "破障丹"]
			return 名前缀 + 丹名[randi() % 丹名.size()]
		"灵材":
			var 材名: Array = ["灵草", "灵芝", "仙果", "龙涎", "凤血", "星辰砂"]
			return 名前缀 + 材名[randi() % 材名.size()]
		"装备":
			var 装名: Array = ["飞剑", "法袍", "护盾", "玉佩", "手镯", "战靴"]
			return 名前缀 + 装名[randi() % 装名.size()]
		"符箓":
			var 符名: Array = ["火球符", "冰封符", "金甲符", "隐身符", "传送符", "天雷符"]
			return 名前缀 + 符名[randi() % 符名.size()]
		_:
			return 名前缀 + "宝物"

# 系统估价
func _系统估价(it: Item) -> int:
	var 品阶基准: Dictionary = {"凡阶": 50, "灵阶": 200, "宝阶": 800, "王阶": 3000, "圣阶": 10000, "仙阶": 50000}
	var 基: int = 品阶基准.get(it.品阶, 100)
	return max(100, int(float(基) * (1.0 + float(it.战力加成) / 500.0)))

# ===== 玩家寄拍 =====
func 玩家寄拍(物品索引: int, 底价: int, 一口价: int = 0, 时长: String = "1月") -> Dictionary:
	if 物品索引 < 0 or 物品索引 >= Game.宗门库房.size():
		return {"成功": false, "原因": "物品索引无效"}
	var it: Item = Game.宗门库房[物品索引]
	if it == null:
		return {"成功": false, "原因": "物品不存在"}
	# 认主检查
	if not it.是否可交易():
		return {"成功": false, "原因": it.获取认主描述()}
	# 价格规制
	var 估价: int = _系统估价(it)
	var 最低底价: int = max(100, int(float(估价) * 0.5))
	var 最高一口价: int = int(float(估价) * 5.0)
	if 底价 < 最低底价:
		return {"成功": false, "原因": "底价不得低于%d灵石（估价的50%%）" % 最低底价}
	if 一口价 > 0 and 一口价 < 底价:
		return {"成功": false, "原因": "一口价不得低于底价"}
	if 一口价 > 最高一口价:
		return {"成功": false, "原因": "一口价不得高于%d灵石（估价的500%%）" % 最高一口价}
	# 时长验证
	var 时长列表: Array = ["7日", "1月", "3月", "6月"]
	if not 时长列表.has(时长):
		时长 = "1月"
	# 时长对应的栈租倍率和持续天数
	var 时长配置: Dictionary = {
		"7日": {"栈租倍率": 0.5, "持续天数": 7},
		"1月": {"栈租倍率": 1.0, "持续天数": 30},
		"3月": {"栈租倍率": 2.0, "持续天数": 90},
		"6月": {"栈租倍率": 3.0, "持续天数": 180},
	}
	var 配置: Dictionary = 时长配置.get(时长, {"栈租倍率": 1.0, "持续天数": 30})
	# 每日寄拍上限（简化：最多5件待寄拍）
	if 全服拍卖.get("寄拍列表", []).size() >= 5:
		return {"成功": false, "原因": "寄拍列表已满（最多5件），请等待下次拍卖"}
	# 每日寄拍数量限制
	if not _检查每日寄拍上限():
		return {"成功": false, "原因": "今日寄拍次数已达上限"}
	全服拍卖["今日寄拍数"] = int(全服拍卖.get("今日寄拍数", 0)) + 1
	# S54 P2：累计寄拍统计
	全服拍卖["累计寄拍数"] = int(全服拍卖.get("累计寄拍数", 0)) + 1
	_检查拍卖成就()
	# 栈租（手续费5%，时长越长倍率越高）
	var 基础栈租: int = max(10, int(float(底价) * 0.05))
	var 栈租: int = int(float(基础栈租) * float(配置.get("栈租倍率", 1.0)))
	if Game.灵石 < 栈租:
		return {"成功": false, "原因": "灵石不足，栈租需%d灵石" % 栈租}
	Game.灵石 -= 栈租
	# 从库房移除
	Game.宗门库房.remove_at(物品索引)
	# 加入寄拍列表
	var lot: Dictionary = {
		"id": "player_%d_%d" % [Game.累计游戏日, randi() % 100000],
		"物品": it.to_dict(),
		"名称": it.名称,
		"类别": it.类别,
		"品阶": it.品阶,
		"底价": 底价,
		"当前价": 底价,
		"一口价": 一口价 if 一口价 > 0 else int(float(底价) * 2.0),
		"寄拍者": "宗主",
		"寄拍者类型": "玩家",
		"状态": "待开拍",
		"开始日": 0,
		"竞价记录": [],
		"最高出价者": "",
		"延时结束日": 0,
		"栈租": 栈租,
		"寄拍时长": 时长,
		"持续天数": int(配置.get("持续天数", 30)),
	}
	(全服拍卖["寄拍列表"] as Array).append(lot)
	Game.添加纪事("全服拍卖", "寄拍", "宗主将「%s」寄拍于聚宝阁，底价%d灵石，时长%s，栈租%d灵石。" % [it.名称, 底价, 时长, 栈租], 1)
	return {"成功": true, "原因": "寄拍成功，将在下次拍卖大典登场", "栈租": 栈租}

# ===== 竞价机制 =====
# 玩家出价
func 玩家出价(拍品ID: String, 出价: int) -> Dictionary:
	var lot: Dictionary = _查找拍品(拍品ID)
	if lot.is_empty():
		return {"成功": false, "原因": "拍品不存在"}
	if lot.get("状态", "") != "竞拍中":
		return {"成功": false, "原因": "该拍品已结束竞拍"}
	var 当前价: int = int(lot.get("当前价", 0))
	var 步进: int = max(10, int(float(当前价) * 0.05))
	if 出价 < 当前价 + 步进:
		return {"成功": false, "原因": "出价须高于当前价+最小加价(%d)" % (当前价 + 步进)}
	# 一口价检查
	var 一口价: int = int(lot.get("一口价", 0))
	if 一口价 > 0 and 出价 >= 一口价:
		出价 = 一口价
		_成交(lot, "玩家(宗主)", 出价)
		return {"成功": true, "原因": "一口价成交！", "成交价": 出价}
	# 正常出价
	lot["当前价"] = 出价
	lot["最高出价者"] = "玩家(宗主)"
	# S54 P2：拍卖师话术
	_拍卖师话术("出价")
	# 延时机制：最后阶段出价延时
	var 结束日: int = int(lot.get("延时结束日", int(全服拍卖.get("结束日", 0))))
	if 结束日 - int(Game.累计游戏日) <= 3:
		lot["延时结束日"] = int(Game.累计游戏日) + 1  # 延时1游戏日
	# 记录竞价
	(lot["竞价记录"] as Array).append({"出价者": "玩家(宗主)", "出价": 出价, "日": Game.累计游戏日})
	return {"成功": true, "原因": "出价成功", "当前价": 出价}

# 模拟其他玩家出价
func _模拟玩家出价() -> void:
	var 当前索引: int = int(全服拍卖.get("当前拍品索引", 0))
	var 拍品列表: Array = 全服拍卖.get("拍品列表", [])
	if 当前索引 >= 拍品列表.size():
		return
	var lot: Dictionary = 拍品列表[当前索引]
	if lot.get("状态", "") != "竞拍中":
		return
	# S54 P3：生成跨服玩家（大拍/节日/VIP时）
	var 类型: String = str(全服拍卖.get("拍卖类型", "日常"))
	if 类型 != "日常":
		_生成跨服玩家()
	# S54 P3：跨服玩家出价（20%概率）
	if 类型 != "日常":
		_跨服玩家出价(lot)
	# 随机选择买家
	for 买家 in _模拟买家池:
		if randf() > float(买家.get("活跃度", 0.5)):
			continue
		var 预算: int = int(float(lot.get("底价", 100)) * float(买家.get("预算倍率", 1.0)) * randf_range(0.8, 1.5))
		var 当前价: int = int(lot.get("当前价", 0))
		var 步进: int = max(10, int(float(当前价) * 0.05))
		if 预算 > 当前价 + 步进:
			var 出价: int = min(预算, 当前价 + 步进 + randi_range(0, 步进))
			lot["当前价"] = 出价
			lot["最高出价者"] = str(买家.get("名", "神秘买家"))
			(lot["竞价记录"] as Array).append({"出价者": 买家.get("名", "神秘买家"), "出价": 出价, "日": Game.累计游戏日})
			# 延时机制
			var 结束日: int = int(lot.get("延时结束日", int(全服拍卖.get("结束日", 0))))
			if 结束日 - int(Game.累计游戏日) <= 3:
				lot["延时结束日"] = int(Game.累计游戏日) + 1
			break  # 每次只模拟一个买家出价
	# S54 P3：模拟AI弹幕
	_模拟AI弹幕()

# 推进拍品（当前拍品结束后进入下一件）
func _推进拍品() -> void:
	var 当前索引: int = int(全服拍卖.get("当前拍品索引", 0))
	var 拍品列表: Array = 全服拍卖.get("拍品列表", [])
	if 当前索引 >= 拍品列表.size():
		return
	var lot: Dictionary = 拍品列表[当前索引]
	if lot.get("状态", "") != "竞拍中":
		全服拍卖["当前拍品索引"] = 当前索引 + 1
		return
	# S54 P1：处理委托竞价
	_处理委托竞价(lot)
	# 检查是否到期
	var 结束日: int = int(lot.get("延时结束日", int(全服拍卖.get("结束日", 0))))
	if int(Game.累计游戏日) >= 结束日:
		var 最高出价者: String = str(lot.get("最高出价者", ""))
		if 最高出价者 == "":
			_流拍处理(lot)
		else:
			_成交(lot, 最高出价者, int(lot.get("当前价", 0)))
		全服拍卖["当前拍品索引"] = 当前索引 + 1

# ===== 成交与流拍 =====
func _成交(lot: Dictionary, 竞得者: String, 成交价: int) -> void:
	lot["状态"] = "已成交"
	lot["成交价"] = 成交价
	lot["竞得者"] = 竞得者
	# 防刷子：检查异常交易
	_检查异常交易(lot, 成交价, 竞得者)
	# S55：更新供需数据
	_更新供需数据(str(lot.get("类别", "")), str(lot.get("品阶", "")), 成交价)
	# S55：大额核验
	_大额核验(成交价, str(lot.get("名称", "")), 竞得者)
	# S54 P2：累计统计
	全服拍卖["累计成交额"] = int(全服拍卖.get("累计成交额", 0)) + 成交价
	全服拍卖["累计成交数"] = int(全服拍卖.get("累计成交数", 0)) + 1
	# 检查成就
	_检查拍卖成就()
	# 拍卖师话术
	_拍卖师话术("成交")
	# 记录历史
	(全服拍卖["历史记录"] as Array).append({
		"名称": lot.get("名称", ""),
		"品阶": lot.get("品阶", ""),
		"成交价": 成交价,
		"竞得者": 竞得者,
		"日": Game.累计游戏日,
		"竞价记录": lot.get("竞价记录", []),
	})
	# 交割
	if 竞得者 == "玩家(宗主)":
		# 玩家竞得：扣除灵石，进入待交割列表
		if Game.灵石 >= 成交价:
			Game.灵石 -= 成交价
			_添加待交割(lot, 成交价)
		else:
			# 灵石不足，流拍
			_流拍处理(lot)
			return
	else:
		# AI竞得：如果是玩家寄拍，发送灵石（当场结算）
		if str(lot.get("寄拍者类型", "")) == "玩家":
			var 佣金: int = int(float(成交价) * 0.1)
			var 实得: int = 成交价 - 佣金
			Game.灵石 += 实得
			Game.添加纪事("全服拍卖", "寄拍成交", "「%s」由 %s 以 %d 灵石竞得，扣除佣金%d，实得%d灵石。" % [str(lot.get("名称", "")), 竞得者, 成交价, 佣金, 实得], 2)
	# 全服公告
	Game.添加纪事("全服拍卖", "成交", "一锤定音！「%s」由 %s 以 %d 灵石竞得！" % [str(lot.get("名称", "")), 竞得者, 成交价], 2)

func _流拍处理(lot: Dictionary) -> void:
	lot["状态"] = "流拍"
	# 如果是玩家寄拍，返还物品
	if str(lot.get("寄拍者类型", "")) == "玩家":
		_返还物品邮件(lot)
	Game.添加纪事("全服拍卖", "流拍", "「%s」无人应价，惜败流拍。" % str(lot.get("名称", "")), 1)

# ===== 邮件交割 =====
func _发送物品邮件(lot: Dictionary, 成交价: int) -> void:
	var it_dict: Dictionary = lot.get("物品", {})
	var it: Item = Item.new()
	it.from_dict(it_dict)
	Game.宗门库房.append(it)
	Game.添加纪事("全服拍卖", "竞得", "宗主竞得「%s」，花费%d灵石，物品已入宗门库房。" % [it.名称, 成交价], 2)

func _发送灵石邮件(lot: Dictionary, 实得: int, 佣金: int) -> void:
	Game.灵石 += 实得
	Game.添加纪事("全服拍卖", "寄拍成交", "宗主寄拍的「%s」以%d灵石成交，扣除佣金%d，实得%d灵石。" % [str(lot.get("名称", "")), int(lot.get("成交价", 0)), 佣金, 实得], 2)

func _返还物品邮件(lot: Dictionary) -> void:
	var it_dict: Dictionary = lot.get("物品", {})
	var it: Item = Item.new()
	it.from_dict(it_dict)
	Game.宗门库房.append(it)
	Game.添加纪事("全服拍卖", "流拍返还", "宗主寄拍的「%s」流拍，物品已返还宗门库房。" % it.名称, 1)

