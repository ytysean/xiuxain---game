```gdscript
# ─────────────────────────────────────────────────────────────
# 【前注 · margin 失效修复 · 固定样板】
#   原写法 add_theme_constant_override("margin_*", …) 挂在 VBoxContainer 上会被
#   静默忽略（margin_* 主题常量仅 MarginContainer 响应）⇒ 侧留白恒为 0、内容贴屏边。
#   本修法＝不换容器类型、不新增 helper，改为按 Control 属性直接给 offsets。
#   ⚠ 顺序不可反：先 set_anchors_and_offsets_preset 定位（它会重置 offsets），再逐边赋 offset_*。
# ─────────────────────────────────────────────────────────────
vbox.add_theme_constant_override("separation", UITheme.GRID)   # ← 保留（separation 在 VBox 上有效）
vbox.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)  # ← 必需；且必须在赋 offsets 之前
vbox.offset_left   =  UITheme.MARGIN   # 左内缩：24 物理 / 10.67 逻辑 / 16.0 frame
vbox.offset_right  = -UITheme.MARGIN   # 右内缩：24 物理 / 10.67 逻辑 / 16.0 frame
vbox.offset_top    =  UITheme.GRID     # 上内缩：12 物理 /  5.33 逻辑 /  8.0 frame（＝原 margin_top）
vbox.offset_bottom = -UITheme.GRID     # 下内缩：12 物理 /  5.33 逻辑 /  8.0 frame（＝原 margin_bottom）
