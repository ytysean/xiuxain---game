# 检查宝箱是否存在
static func 宝箱存在(宝箱ID: String) -> bool:
	return 宝箱掉落池.has(宝箱ID)

# 获取宝箱信息
static func 获取宝箱信息(宝箱ID: String) -> Dictionary:
	return 宝箱掉落池.get(宝箱ID, {})

# 打开宝箱（随机掉落，简化版本：每次掉落1个物品）
# 返回：{成功, 掉落列表[{物品ID, 物品类型, 数量}], 原因}
static func 打开宝箱(宝箱ID: String) -> Dictionary:
	if not 宝箱存在(宝箱ID):
		return {"成功": false, "掉落列表": [], "原因": "宝箱ID不存在"}
	var 宝箱 = 宝箱掉落池[宝箱ID]
	var 掉落列表 = 宝箱.get("掉落列表", [])
	if 掉落列表.is_empty():
		return {"成功": false, "掉落列表": [], "原因": "宝箱掉落池为空"}
	# 计算总权重
	var 总权重: int = 0
	for 掉落 in 掉落列表:
		总权重 += int(掉落.get("权重", 0))
	if 总权重 <= 0:
		return {"成功": false, "掉落列表": [], "原因": "宝箱掉落权重异常"}
	# 随机掉落（简化版本：每次掉落1个物品）
	var 随机值: int = randi() % 总权重
	var 累计权重: int = 0
	var 选中掉落: Dictionary = {}
	for 掉落 in 掉落列表:
		累计权重 += int(掉落.get("权重", 0))
		if 随机值 < 累计权重:
			选中掉落 = 掉落
			break
	if 选中掉落.is_empty():
		选中掉落 = 掉落列表[0]
	var 结果掉落: Array = [{
		"物品ID": 选中掉落.get("物品ID", ""),
		"物品类型": 选中掉落.get("物品类型", ""),
		"数量": int(选中掉落.get("数量", 1))
	}]
	return {
		"成功": true,
		"掉落列表": 结果掉落,
		"原因": "打开%s成功！获得%s×%d" % [宝箱.get("名称", ""), 选中掉落.get("物品ID", ""), int(选中掉落.get("数量", 1))]
	}

# 获取所有宝箱列表
static func 获取所有宝箱() -> Array:
	var 列表: Array = []
	for 宝箱ID in 宝箱掉落池.keys():
		var 宝箱 = 宝箱掉落池[宝箱ID]
		列表.append({
			"宝箱ID": 宝箱ID,
			"名称": 宝箱.get("名称", ""),
			"类型": 宝箱.get("类型", ""),
			"描述": 宝箱.get("描述", "")
		})
	return 列表
