# ============ 生成 ============
func 加权抽(权重: Dictionary) -> String:
	var 总 := 0.0
	for k in 权重:
		总 += 权重[k]
	var 抽 := randf() * 总
	for k in 权重:
		抽 -= 权重[k]
		if 抽 <= 0:
			return k
	return 权重.keys()[0]

func 随机生成():
	类别 = 加权抽(类别权重)
	品阶 = 加权抽(品阶权重)
	match 类别:
		"dan_yao":
			_填模板(_取随机(基础库["dan_yao"][品阶]))
		"ling_cai":
			_填模板(_取随机(基础库["ling_cai"][品阶]))
		"fa_qi":
			穿戴位 = 法器槽名.keys().pick_random()
			_填模板(_取随机(基础库["fa_qi"][穿戴位][品阶]))
		"shen_bing":
			职业 = 职业名.pick_random()
			_填模板(_取随机(基础库["shen_bing"][职业][品阶]))
		"fabao":
			穿戴位 = "本命法宝"
			_填模板(_取随机(基础库["fabao"][品阶]))
	滚词缀()
	滚极品()
	算战力()

func _取随机(列表: Array) -> Dictionary:
	return 列表.pick_random()

func _填模板(模板: Dictionary):
	名称 = 模板["名"]
	功效 = 模板["功效"]
	描述 = 模板["描述"]

func 滚词缀():
	词缀 = []
	var 数 := 品阶词缀数[品阶]
	if 类别 == "dan_yao" or 类别 == "ling_cai":
		数 = 0
	for i in 数:
		var 是前缀 := randf() < 0.34
		var 名 := ""
		var 区间 := []
		if 是前缀:
			var 池 := 前缀池.duplicate()
			if 类别 == "shen_bing":
				for k in 职业词缀范围:
					池[k] = 职业词缀范围[k]
			名 = 池.keys().pick_random()
			区间 = 池[名]
		else:
			名 = 后缀池.keys().pick_random()
			区间 = 后缀池[名]
		var 档 := 加权抽(档权重)
		var 数值 := randi_range(区间[0], 区间[1])
		词缀.append({"名": 名, "前缀": 是前缀, "档": 档, "数值": 数值})

func 滚极品():
	极品属性 = null
	极品 = false
	特殊 = false
	if 品阶 == "dujie_jie":
		特殊 = true
		极品 = true
		极品属性 = _取极品(true)
	elif 品阶 == "xian_jie":
		if randf() < 0.35:
			极品 = true
			极品属性 = _取极品(false)

func _取极品(渡劫: bool) -> Dictionary:
	if 渡劫:
		return _随机极品(极品渡劫)
	if 类别 == "shen_bing":
		return _随机极品({"剑修": 极品剑修, "体修": 极品体修, "法修": 极品法修}[职业])
	return _随机极品(极品通用)

func _随机极品(库: Dictionary) -> Dictionary:
	var k := 库.keys().pick_random()
	return 库[k].duplicate()

func 算战力():
	var b := 基础战力表[品阶]
	if 类别 == "fabao":
		b = int(b * 1.3)
	for a in 词缀:
		b += int(a["数值"] * 6 * 档倍(a["档"]))
	if 极品属性 != null:
		b += (1500 if 品阶 == "dujie_jie" else 600)
	战力加成 = b

func 简介() -> String:
	var s := "%s" % 名称
	s += " [%s·%s" % [类别, 品阶]
	if 穿戴位 != "":
		s += "·" + 穿戴位
	if 职业 != "":
		s += "·" + 职业
	s += "] 战力+%d" % 战力加成
	if 极品属性 != null:
		s += " ★极品特异"
	elif 特殊:
		s += " ★天道"
	s += "\n  功效：%s" % 功效
	for a in 词缀:
		var 类 := "前" if a["前缀"] else "后"
		s += "\n  ·[%s]%s %+d%%（%s）" % [类, a["名"], a["数值"], a["档"]]
	if 极品属性 != null:
		s += "\n  ☆【%s】%s" % [极品属性["名"], 极品属性["描述"]]
	return s

func to_dict() -> Dictionary:
	return {
		"类别": 类别, "品阶": 品阶, "穿戴位": 穿戴位, "职业": 职业,
		"名称": 名称, "功效": 功效, "描述": 描述,
		"战力加成": 战力加成, "极品": 极品, "特殊": 特殊,
		"词缀": 词缀, "极品属性": 极品属性,
	}

func from_dict(d: Dictionary):
	类别 = d.get("类别", "法器")
	品阶 = d.get("品阶", "凡阶")
	穿戴位 = d.get("穿戴位", "")
	职业 = d.get("职业", "")
	名称 = d.get("名称", "")
	功效 = d.get("功效", "")
	描述 = d.get("描述", "")
	战力加成 = d.get("战力加成", 0)
	极品 = d.get("极品", false)
	特殊 = d.get("特殊", false)
	词缀 = d.get("词缀", [])
	极品属性 = d.get("极品属性", null)
