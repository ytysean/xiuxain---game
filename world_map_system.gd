# 派遣化身赴大地图某区域游历（桥接到化身系统的游历地）
func 派遣化身赴大地图(化身ID: int, 区域: String) -> Dictionary:
	if not 化身游历桥接.has(区域):
		return {"成功": false, "原因": "未知区域"}
	if Game == null or not Game.has_method("派遣化身游历"):
		return {"成功": false, "原因": "化身系统未就绪"}
	var 游历地: String = str(化身游历桥接[区域])
	var 结果: Dictionary = Game.派遣化身游历(化身ID, 游历地)
	if bool(结果.get("成功", false)):
		结果["区域"] = 区域
		结果["游历地"] = 游历地
	return 结果

# 化身游历归来 → 记入足迹（由 Game._化身游历归来 调用）
func 记录化身归来(化身: Dictionary) -> void:
	if 化身 == null:
		return
	var 游历地: String = str(化身.get("游历区域", ""))
	if 游历地 == "":
		return
	for 区域 in 化身游历桥接.keys():
		if str(化身游历桥接[区域]) != 游历地:
			continue
		化身游历足迹[区域] = int(化身游历足迹.get(区域, 0)) + 1
		if not (区域 in 已探索区域):
			已探索区域.append(区域)
			if Game != null:
				Game._记录图录(区域, "天下")
		break

func 已探索区域数() -> int:
	return 已探索区域.size()

# 探索进度（综合评分；同时补上 game_state 已用 has_method 守卫调用、先前缺失的同名接口）
func 获取探索进度() -> int:
	return _计数已发现资源点() * 3 + 已探索秘境.size() * 5 + 已探索区域.size() * 10

