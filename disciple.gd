# ============ 高阶修士进阶系统（神魂+法相+领域）============
# 修真世界观：元婴修神魂，化神凝法相，炼虚辟领域
var 神魂等级: int = 0            # 神魂等级（0=未修炼，1-9级），元婴以上可修炼
var 神魂经验: int = 0            # 神魂经验
var 法相名称: String = ""         # 法相名称（化神以上凝聚，空=未凝聚）
var 法相等级: int = 0            # 法相等级（0=未凝聚，1-9级）
var 领域名称: String = ""         # 领域名称（炼虚以上开辟，空=未开辟）
var 领域等级: int = 0            # 领域等级（0=未开辟，1-9级）

## 神魂修炼加成（影响战力和悟道）
func 神魂战力加成() -> float:
	if 神魂等级 <= 0:
		return 0.0
	return 0.05 * float(神魂等级)   # 每级+5%战力

func 神魂悟道加成() -> float:
	if 神魂等级 <= 0:
		return 0.0
	return 0.03 * float(神魂等级)   # 每级+3%悟道

## 法相战力加成（大量战力加成）
func 法相战力加成() -> float:
	if 法相等级 <= 0:
		return 0.0
	return 0.10 * float(法相等级)   # 每级+10%战力

## 领域战力加成（领域内修士获得加成）
func 领域战力加成() -> float:
	if 领域等级 <= 0:
		return 0.0
	return 0.08 * float(领域等级)   # 每级+8%战力

## 高阶修士总战力加成（神魂+法相+领域）
func 高阶战力加成() -> float:
	return 神魂战力加成() + 法相战力加成() + 领域战力加成()
