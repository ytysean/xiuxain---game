	}

# P2联动：计算阵营声望加成（正道+防御，魔道+攻击）
func _计算阵营声望加成() -> Dictionary:
	if 正魔阵营 == "":
		return {"攻击加成": 0.0, "防御加成": 0.0}
	# 获取阵营声望等级（0-4）
	var 声望等级: int = 0
	if Game != null and Game.has_method("获取阵营声望等级"):
		var 等级名: String = Game.获取阵营声望等级(正魔阵营)
		var 等级映射: Dictionary = {"陌路": 0, "友善": 1, "尊敬": 2, "崇敬": 3, "崇拜": 4}
		声望等级 = int(等级映射.get(等级名, 0))
	# 正道+防御，魔道+攻击
	var 攻击加成: float = 0.0
	var 防御加成: float = 0.0
	if 正魔阵营 == "正道":
		防御加成 = float(声望等级) * 0.03  # 每级+3%防御，上限12%
	elif 正魔阵营 == "魔道":
		攻击加成 = float(声望等级) * 0.03  # 每级+3%攻击，上限12%
	return {"攻击加成": 攻击加成, "防御加成": 防御加成, "阵营": 正魔阵营, "声望等级": 声望等级}

