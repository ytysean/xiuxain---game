# ===== 初始化 =====
func _init() -> void:
	pass

# ===== 权益检查 =====
func 检查资格(项目名: String) -> Dictionary:
	if 项目名 not in 代理项目:
		return {"合格": false, "原因": "未知代理项目"}
	var 项目: Dictionary = 代理项目[项目名]
	var 所需卡级: String = str(项目["所需卡级"])
	if Game.永久卡激活:
		return {"合格": true, "原因": ""}
	if 所需卡级 == "月卡" and (Game.月卡有效() or Game.季卡有效()):
		return {"合格": true, "原因": ""}
	if 所需卡级 == "季卡" and Game.季卡有效():
		return {"合格": true, "原因": ""}
	return {"合格": false, "原因": "需%s及以上权益" % 所需卡级}

func 获取最大代理数() -> int:
	if Game.永久卡激活:
		return 6
	if Game.季卡有效():
		return 4
	if Game.月卡有效():
		return 2
	return 0

func 获取已开启数() -> int:
	var 数: int = 0
	for 项目名 in 已开启项目.keys():
		if bool(已开启项目[项目名]):
			数 += 1
	return 数

# ===== 项目开关 =====
func 开启代理(项目名: String) -> Dictionary:
	var 资格: Dictionary = 检查资格(项目名)
	if not bool(资格["合格"]):
		return {"成功": false, "原因": str(资格["原因"])}
	最大同时代理 = 获取最大代理数()
	if 获取已开启数() >= 最大同时代理:
		return {"成功": false, "原因": "同时代理项目已达上限（%d/%d）" % [获取已开启数(), 最大同时代理]}
	已开启项目[项目名] = true
	if 项目名 not in 上次执行日:
		上次执行日[项目名] = Game.累计游戏日
	_添加日志("开启【%s】代理" % 项目名)
	return {"成功": true, "原因": "已开启【%s】代理" % 项目名}

func 关闭代理(项目名: String) -> Dictionary:
	已开启项目[项目名] = false
	_添加日志("关闭【%s】代理" % 项目名)
	return {"成功": true, "原因": "已关闭【%s】代理" % 项目名}

func 是否开启(项目名: String) -> bool:
	return bool(已开启项目.get(项目名, false))

# ===== 效率计算 =====
func 获取效率(项目名: String) -> float:
	if 项目名 not in 代理项目:
		return 0.0
	var 项目: Dictionary = 代理项目[项目名]
	var 基础效率: float = float(项目["基础效率"])
	var VIP加成: float = float(项目["VIP加成"]) * float(Game.当前VIP等级())
	return clamp(基础效率 + VIP加成, 0.0, 1.0)

# ===== 每日执行 =====
func 每日推进() -> void:
	# 代理项目执行
	for 项目名 in 已开启项目.keys():
		if not bool(已开启项目[项目名]):
			continue
		if 项目名 not in 代理项目:
			continue
		var 项目: Dictionary = 代理项目[项目名]
		var 冷却日: int = int(项目["冷却日"])
		if 冷却日 <= 0:
			continue
		var 上次: int = int(上次执行日.get(项目名, 0))
		if Game.累计游戏日 - 上次 < 冷却日:
			continue
		_执行代理(项目名)
		上次执行日[项目名] = Game.累计游戏日
	# 法旨执行（闭关期间或日常）
	_执行法旨()

func _执行代理(项目名: String) -> void:
	var 效率: float = 获取效率(项目名)
	match 项目名:
		"商队自动贸易":
			_执行商队贸易(效率)
		"资源自动采集":
			_执行资源采集(效率)
		"弟子自动招募":
			_执行弟子招募(效率)
		"宗门自动建设":
			_执行宗门建设(效率)
		"坊市自动交易":
			_执行坊市交易(效率)

func _执行商队贸易(效率: float) -> void:
	var 基础收益: int = randi_range(500, 2000)
	var 实际收益: int = int(基础收益 * 效率)
	Game.灵石 += 实际收益
	_添加日志("商队自动贸易：获利%d灵石（效率%d%%）" % [实际收益, int(效率 * 100)])

func _执行资源采集(效率: float) -> void:
	var 灵气收益: int = int(randi_range(20, 80) * 效率)
	Game.灵气 += 灵气收益
	_添加日志("资源自动采集：获得%d灵气（效率%d%%）" % [灵气收益, int(效率 * 100)])

func _执行弟子招募(效率: float) -> void:
	_添加日志("弟子自动招募：招收新弟子（效率%d%%）" % int(效率 * 100))

func _执行宗门建设(效率: float) -> void:
	_添加日志("宗门自动建设：建筑升级中（效率%d%%）" % int(效率 * 100))

func _执行坊市交易(效率: float) -> void:
	_添加日志("坊市自动交易：出售多余资源（效率%d%%）" % int(效率 * 100))

# ===== 闭关前法旨系统 =====
# 下达法旨（闭关前或日常均可）
func 下达法旨(类型: String, 目标: String, 数量: int, 优先级: int = 优先级_中) -> Dictionary:
	if 类型 not in 法旨类型:
		return {"成功": false, "原因": "未知法旨类型"}
	# 选择负责人（该殿阁最高境界弟子）
	var 负责人: String = _选择法旨负责人(类型)
	var 法旨: Dictionary = {
		"id": "fuzhi_%d_%d" % [Game.累计游戏日, 法旨列表.size()],
		"类型": 类型,
		"目标": 目标,
		"数量": 数量,
		"已完成": 0,
		"优先级": 优先级,
		"下达日": Game.累计游戏日,
		"状态": "执行中",  # 执行中/已完成/已取消/已失败
		"图标": 法旨类型[类型]["图标"],
		"执行殿阁": 法旨类型[类型]["执行殿阁"],
		"负责人": 负责人,
		"完成度": 1.0,  # 最终完成度系数
		"执行记录": [],  # 执行过程中的事件记录
		"意外收获": "",  # 意外收获描述
	}
	法旨列表.append(法旨)
	_添加日志("下达法旨：%s %s×%d，由%s负责" % [法旨类型[类型]["描述"], 目标, 数量, 负责人])
	return {"成功": true, "原因": "法旨已下达", "法旨": 法旨}

# 选择法旨负责人（该殿阁最高境界弟子）
func _选择法旨负责人(类型: String) -> String:
	if Game.弟子列表.is_empty():
		return "执事弟子"
	# 简化：随机选一个弟子作为负责人
	var d = Game.弟子列表[randi() % Game.弟子列表.size()]
	return str(d.姓名)

# 取消法旨
func 取消法旨(法旨ID: String) -> Dictionary:
	for i in range(法旨列表.size()):
		if str(法旨列表[i].get("id", "")) == 法旨ID:
			法旨列表[i]["状态"] = "已取消"
			_添加日志("取消法旨：%s" % str(法旨列表[i].get("目标", "")))
			法旨列表.remove_at(i)
			return {"成功": true, "原因": "法旨已取消"}
	return {"成功": false, "原因": "法旨不存在"}

# 执行法旨（每日推进，弟子按优先级执行，完成度受多种因素影响）
func _执行法旨() -> void:
	# 按优先级排序
	var 排序法旨: Array = 法旨列表.duplicate()
	排序法旨.sort_custom(func(a, b): return int(a["优先级"]) > int(b["优先级"]))
	# 每日每个法旨推进
	for 法旨 in 排序法旨:
		if str(法旨["状态"]) != "执行中":
			continue
		# 计算当日完成量（受多种因素影响）
		var 当日完成: Dictionary = _计算当日完成(法旨)
		var 完成量: int = int(当日完成["量"])
		var 事件: String = str(当日完成["事件"])
		法旨["已完成"] = int(法旨["已完成"]) + 完成量
		if 事件 != "":
			法旨["执行记录"].append({"日": Game.累计游戏日, "事件": 事件})
		# 检查是否完成
		if int(法旨["已完成"]) >= int(法旨["数量"]):
			_法旨完成(法旨)
	# 清理已完成/已失败的
	for i in range(法旨列表.size() - 1, -1, -1):
		if str(法旨列表[i]["状态"]) in ["已完成", "已失败"]:
			法旨列表.remove_at(i)

# 计算当日完成量（仿真系统）
func _计算当日完成(法旨: Dictionary) -> Dictionary:
	var 基础量: int = randi_range(1, 3)
	var 系数: float = 1.0
	var 事件: String = ""

	# 1. 负责人资质影响（简化：随机模拟资质差异）
	var 资质系数: float = randf_range(0.7, 1.3)
	系数 *= 资质系数
	if 资质系数 > 1.2:
		事件 = "%s根骨上佳，进展神速" % str(法旨["负责人"])
	elif 资质系数 < 0.8:
		事件 = "%s资质平平，进展迟缓" % str(法旨["负责人"])

	# 2. 随机事件（20%概率）
	if randf() < 0.2:
		var 事件类型: int = randi() % 6
		match 事件类型:
			0:  # 突破
				系数 *= 0.3
				事件 = "%s闭关突破，无暇他顾" % str(法旨["负责人"])
			1:  # 受伤
				系数 *= 0.5
				事件 = "%s修炼受伤，需静养数日" % str(法旨["负责人"])
			2:  # 领悟
				系数 *= 1.5
				事件 = "%s心有所悟，技艺大进" % str(法旨["负责人"])
				法旨["意外收获"] = "领悟心得，技艺提升"
			3:  # 材料不足
				系数 *= 0.4
				事件 = "灵材不济，巧妇难为无米之炊"
			4:  # 设备故障
				系数 *= 0.6
				事件 = "丹炉/器鼎损耗，需先修缮"
			5:  # 偷懒
				系数 *= 0.5
				事件 = "弟子心生懈怠，敷衍了事"

	# 3. 忠诚影响（简化：低忠诚有概率偷懒）
	if randf() < 0.05:
		系数 *= 0.7
		if 事件 == "":
			事件 = "弟子忠诚不足，暗中偷懒"

	var 最终量: int = max(0, int(round(float(基础量) * 系数)))
	return {"量": 最终量, "事件": 事件}

# 法旨完成结算
func _法旨完成(法旨: Dictionary) -> void:
	# 计算最终完成度
	var 完成度: float = 1.0
	# 根据执行记录调整完成度
	for 记录 in 法旨["执行记录"]:
		var 事件文本: String = str(记录["事件"])
		if "神速" in 事件文本 or "大进" in 事件文本 or "领悟" in 事件文本:
			完成度 += 0.05
		elif "迟缓" in 事件文本 or "受伤" in 事件文本 or "不足" in 事件文本 or "故障" in 事件文本 or "偷懒" in 事件文本 or "懈怠" in 事件文本:
			完成度 -= 0.08
	完成度 = clamp(完成度, 0.3, 1.3)
	法旨["完成度"] = 完成度

	# 判定完成等级
	var 完成等级: String = ""
	var 完成文案: String = ""
	if 完成度 >= 1.2:
		完成等级 = "超额功果"
		完成文案 = "超额完成，弟子技艺精进，意外之喜"
	elif 完成度 >= 0.9:
		完成等级 = "圆满完成"
		完成文案 = "不辱使命，圆满完成"
	elif 完成度 >= 0.6:
		完成等级 = "略有不足"
		完成文案 = "虽有波折，尚能交差"
	elif 完成度 >= 0.3:
		完成等级 = "勉强交差"
		完成文案 = "困难重重，勉强完成"
	else:
		完成等级 = "功亏一篑"
		完成文案 = "事故频发，几近失败"
		法旨["状态"] = "已失败"

	法旨["完成等级"] = 完成等级
	法旨["完成文案"] = 完成文案

	if str(法旨["状态"]) != "已失败":
		法旨["状态"] = "已完成"

	_添加日志("法旨%s：%s %s×%d（%s，完成度%d%%）" % [
		完成等级,
		str(法旨["执行殿阁"]),
		str(法旨["目标"]),
		int(法旨["数量"]),
		完成文案,
		int(完成度 * 100)
	])
	# 移到历史
	法旨历史.append(法旨.duplicate())

# 闭关前批量下达法旨
func 闭关前下达法旨(法旨数组: Array) -> Dictionary:
	闭关前法旨 = 法旨数组.duplicate()
	闭关中 = true
	for 法旨 in 法旨数组:
		下达法旨(str(法旨["类型"]), str(法旨["目标"]), int(法旨["数量"]), int(法旨.get("优先级", 优先级_中)))
	_添加日志("宗主闭关，留下%d道法旨" % 法旨数组.size())
	return {"成功": true, "原因": "闭关法旨已下达"}

# 出关验收
func 出关验收() -> Dictionary:
	闭关中 = false
	var 完成数: int = 0
	var 失败数: int = 0
	var 未完成数: int = 0
	var 报告: Array = []
	for 法旨 in 法旨历史:
		if int(法旨["下达日"]) >= (Game.累计游戏日 - 30):
			报告.append(法旨)
			match str(法旨["状态"]):
				"已完成":
					完成数 += 1
				"已失败":
					失败数 += 1
				_:
					未完成数 += 1
	_添加日志("宗主出关，验收法旨：完成%d项，失败%d项，未完成%d项" % [完成数, 失败数, 未完成数])
	return {"完成数": 完成数, "失败数": 失败数, "未完成数": 未完成数, "报告": 报告}

# 获取当前法旨列表
func 获取当前法旨() -> Array:
	return 法旨列表.duplicate()

# 获取法旨类型列表
func 获取法旨类型() -> Array:
	var 结果: Array = []
	for 类型 in 法旨类型.keys():
		结果.append({"类型": 类型, "描述": 法旨类型[类型]["描述"], "图标": 法旨类型[类型]["图标"], "执行殿阁": 法旨类型[类型]["执行殿阁"]})
	return 结果

# ===== 日志 =====
func _添加日志(文本: String) -> void:
	代理日志.append({"日": Game.累计游戏日, "文本": 文本})
	if 代理日志.size() > 50:
		代理日志.remove_at(0)

func 获取日志(数量: int = 20) -> Array:
	var 结果: Array = 代理日志.duplicate()
	结果.reverse()
	return 结果.slice(0, min(数量, 结果.size()))

# ===== 获取所有项目状态 =====
func 获取所有项目状态() -> Array:
	var 结果: Array = []
	for 项目名 in 代理项目.keys():
		var 项目: Dictionary = 代理项目[项目名]
		var 资格: Dictionary = 检查资格(项目名)
		结果.append({
			"名称": 项目名,
			"描述": 项目["描述"],
			"图标": 项目["图标"],
			"基础效率": 项目["基础效率"],
			"当前效率": 获取效率(项目名),
			"所需卡级": 项目["所需卡级"],
			"冷却日": 项目["冷却日"],
			"已开启": 是否开启(项目名),
			"资格合格": bool(资格["合格"]),
			"资格原因": str(资格["原因"]),
		})
	return 结果

