# tests/battle_simulator.gd —— 战斗模拟器
# 功能：模拟不同配置下的战斗结果，用于战斗数值平衡分析
# 运行：在游戏中调用 BattleSimulator.simulate_xxx() 模拟战斗
class_name BattleSimulator
extends RefCounted

# ============ 模拟配置 ============

# 标准测试角色配置
const 标准配置: Dictionary = {
	"练气": {"攻": 50, "防": 30, "血": 200, "速": 10, "灵根": "金", "纯度": "双", "道途": "道修"},
	"筑基": {"攻": 200, "防": 120, "血": 800, "速": 20, "灵根": "木", "纯度": "双", "道途": "体修"},
	"金丹": {"攻": 800, "防": 500, "血": 3000, "速": 40, "灵根": "水", "纯度": "单", "道途": "法修"},
	"元婴": {"攻": 3000, "防": 2000, "血": 12000, "速": 80, "灵根": "火", "纯度": "单", "道途": "御兽师"},
	"化神": {"攻": 12000, "防": 8000, "血": 50000, "速": 150, "灵根": "土", "纯度": "单", "道途": "符箓师"},
	"仙阶": {"攻": 40000, "防": 25000, "血": 160000, "速": 300, "灵根": "金", "纯度": "单", "道途": "毒师"},
	"道阶": {"攻": 100000, "防": 60000, "血": 400000, "速": 500, "灵根": "木", "纯度": "单", "道途": "傀儡师"},
}

# 模拟结果
var 模拟结果: Dictionary = {}

# ============ 单场战斗模拟 ============

func 模拟单场战斗(攻方配置: Dictionary, 守方配置: Dictionary, 模拟次数: int = 100) -> Dictionary:
	var 胜利次数 = 0
	var 总回合数 = 0
	var 详细结果 = []

	for i in 模拟次数:
		var 结果 = _执行单场战斗(攻方配置.duplicate(), 守方配置.duplicate())
		if 结果["胜利"]:
			胜利次数 += 1
		总回合数 += 结果["回合数"]
		详细结果.append(结果)

	var 统计 = {
		"模拟次数": 模拟次数,
		"胜利次数": 胜利次数,
		"胜率": 胜利次数 / float(模拟次数) * 100,
		"平均回合数": 总回合数 / float(模拟次数),
		"详细结果": 详细结果,
	}

	return 统计

func _执行单场战斗(攻方: Dictionary, 守方: Dictionary) -> Dictionary:
	# 简化版战斗模拟
	var 攻方血量 = 攻方.get("血", 100)
	var 守方血量 = 守方.get("血", 100)
	var 回合数 = 0
	var 最大回合 = 20

	while 攻方血量 > 0 and 守方血量 > 0 and 回合数 < 最大回合:
		回合数 += 1
		# 攻方攻击
		var 攻方伤害 = _计算伤害(攻方, 守方)
		守方血量 -= 攻方伤害
		if 守方血量 <= 0:
			break
		# 守方反击
		var 守方伤害 = _计算伤害(守方, 攻方)
		攻方血量 -= 守方伤害

	return {
		"胜利": 守方血量 <= 0,
		"回合数": 回合数,
		"攻方剩余血量": max(攻方血量, 0),
		"守方剩余血量": max(守方血量, 0),
	}

func _计算伤害(攻方: Dictionary, 守方: Dictionary) -> float:
	var 攻击 = 攻方.get("攻", 10)
	var 防御 = 守方.get("防", 5)
	# 防御减伤：减伤率 = 防 / (防 + 200)，封顶75%
	var 减伤率 = min(防御 / (防御 + 200.0), 0.75)
	var 基础伤害 = 攻击 * (1 - 减伤率)
	# 浮动伤害 [0.9, 1.1]
	var 浮动 = randf_range(0.9, 1.1)
	return max(基础伤害 * 浮动, 1)

# ============ 境界对比模拟 ============

func 模拟境界对比(攻方境界: String, 守方境界: String, 模拟次数: int = 100) -> Dictionary:
	var 攻方配置 = 标准配置.get(攻方境界, 标准配置["练气"]).duplicate()
	var 守方配置 = 标准配置.get(守方境界, 标准配置["练气"]).duplicate()
	var 结果 = 模拟单场战斗(攻方配置, 守方配置, 模拟次数)
	结果["攻方境界"] = 攻方境界
	结果["守方境界"] = 守方境界
	return 结果

# ============ 跨境界碾压测试 ============

func 模拟跨境界碾压(基准境界: String, 模拟次数: int = 100) -> Dictionary:
	var 境界列表 = Disciple.境界序   # 唯一真源（2026-09-02）：原 7 阶，跨境界碾压测试覆盖不到炼虚~渡劫
	var 结果 = {}
	var 基准索引 = 境界列表.find(基准境界)

	for i in range(max(0, 基准索引 - 2), min(境界列表.size(), 基准索引 + 3)):
		var 对比境界 = 境界列表[i]
		if 对比境界 == 基准境界:
			continue
		var 模拟结果 = 模拟境界对比(基准境界, 对比境界, 模拟次数)
		结果[对比境界] = {
			"胜率": 模拟结果["胜率"],
			"平均回合数": 模拟结果["平均回合数"],
		}

	return 结果

# ============ 道途平衡测试 ============

func 模拟道途平衡(境界: String, 模拟次数: int = 100) -> Dictionary:
	var 道途列表 = ["道修", "体修", "法修", "御兽师", "符箓师", "毒师", "傀儡师"]
	var 基准配置 = 标准配置.get(境界, 标准配置["练气"]).duplicate()
	var 结果 = {}

	for 道途A in 道途列表:
		for 道途B in 道途列表:
			if 道途A == 道途B:
				continue
			var 配置A = 基准配置.duplicate()
			配置A["道途"] = 道途A
			var 配置B = 基准配置.duplicate()
			配置B["道途"] = 道途B
			var 模拟结果 = 模拟单场战斗(配置A, 配置B, 模拟次数)
			var key = "%svs%s" % [道途A, 道途B]
			结果[key] = 模拟结果["胜率"]

	return 结果

# ============ 属性敏感度测试 ============

func 模拟属性敏感度(基准配置: Dictionary, 属性名: String, 变化范围: Array, 模拟次数: int = 50) -> Dictionary:
	var 结果 = {}
	var 守方配置 = 基准配置.duplicate()

	for 变化率 in 变化范围:
		var 攻方配置 = 基准配置.duplicate()
		var 原值 = 攻方配置.get(属性名, 10)
		攻方配置[属性名] = int(原值 * 变化率)
		var 模拟结果 = 模拟单场战斗(攻方配置, 守方配置, 模拟次数)
		结果[str(变化率)] = {
			"属性值": 攻方配置[属性名],
			"胜率": 模拟结果["胜率"],
			"平均回合数": 模拟结果["平均回合数"],
		}

	return 结果

# ============ 导出报告 ============

func 导出境界对比报告(模拟次数: int = 100) -> String:
	var 境界列表 = Disciple.境界序   # 唯一真源（2026-09-02）：报告新增炼虚/合体/大乘/渡劫 四行四列
	var 报告 = ""
	报告 += "=".repeat(60) + "\n"
	报告 += "战斗模拟器 - 境界对比报告\n"
	报告 += "=".repeat(60) + "\n\n"

	报告 += "境界胜率表（行=攻方，列=守方）\n"
	报告 += "-".repeat(60) + "\n"
	报告 += "%-8s" % ""
	for 守方境界 in 境界列表:
		报告 += "%-10s" % 守方境界
	报告 += "\n"

	for 攻方境界 in 境界列表:
		报告 += "%-8s" % 攻方境界
		for 守方境界 in 境界列表:
			if 攻方境界 == 守方境界:
				报告 += "%-10s" % "50.0%"
			else:
				var 结果 = 模拟境界对比(攻方境界, 守方境界, 模拟次数)
				报告 += "%-10.1f%%" % 结果["胜率"]
		报告 += "\n"

	报告 += "\n"
	报告 += "平均回合数表（行=攻方，列=守方）\n"
	报告 += "-".repeat(60) + "\n"
	报告 += "%-8s" % ""
	for 守方境界 in 境界列表:
		报告 += "%-10s" % 守方境界
	报告 += "\n"

	for 攻方境界 in 境界列表:
		报告 += "%-8s" % 攻方境界
		for 守方境界 in 境界列表:
			if 攻方境界 == 守方境界:
				var 结果 = 模拟境界对比(攻方境界, 守方境界, 模拟次数)
				报告 += "%-10.1f" % 结果["平均回合数"]
			else:
				var 结果 = 模拟境界对比(攻方境界, 守方境界, 模拟次数)
				报告 += "%-10.1f" % 结果["平均回合数"]
		报告 += "\n"

	报告 += "\n"
	报告 += "=".repeat(60) + "\n"
	报告 += "报告结束\n"
	报告 += "=".repeat(60) + "\n"

	return 报告

func 保存报告到文件(文件路径: String, 报告: String) -> bool:
	var f = FileAccess.open(文件路径, FileAccess.WRITE)
	if f == null:
		print("[BattleSimulator] 保存报告失败: %s" % 文件路径)
		return false
	f.store_string(报告)
	f.close()
	print("[BattleSimulator] 报告已保存: %s" % 文件路径)
	return true
