## 初始化种族关系表
func _初始化种族关系() -> void:
	if not 种族关系表.is_empty():
		return
	# 基础种族关系（0为中立，正数友好，负数敌对）
	种族关系表["人族-妖族"] = 20
	种族关系表["人族-魔族"] = -30
	种族关系表["人族-鬼族"] = -10
	种族关系表["人族-龙族"] = 30
	种族关系表["人族-灵兽族"] = 40
	种族关系表["妖族-魔族"] = -20
	种族关系表["妖族-鬼族"] = 10
	种族关系表["妖族-龙族"] = 15
	种族关系表["妖族-灵兽族"] = 30
	种族关系表["魔族-鬼族"] = 25
	种族关系表["魔族-龙族"] = -15
	种族关系表["魔族-灵兽族"] = -10
	种族关系表["鬼族-龙族"] = -5
	种族关系表["鬼族-灵兽族"] = 0
	种族关系表["龙族-灵兽族"] = 20

## 获取两个种族之间的关系值
func 获取种族关系(种族1: String, 种族2: String) -> int:
	if 种族1 == 种族2:
		return 100
	var key1: String = "%s-%s" % [种族1, 种族2]
	var key2: String = "%s-%s" % [种族2, 种族1]
	if 种族关系表.has(key1):
		return int(种族关系表[key1])
	if 种族关系表.has(key2):
		return int(种族关系表[key2])
	return 0

## 修改种族关系
func 修改种族关系(种族1: String, 种族2: String, 增量: int) -> void:
	var key: String = "%s-%s" % [种族1, 种族2]
	if not 种族关系表.has(key):
		key = "%s-%s" % [种族2, 种族1]
	if 种族关系表.has(key):
		种族关系表[key] = clamp(int(种族关系表[key]) + 增量, -100, 100)
	else:
		种族关系表[key] = clamp(增量, -100, 100)

## 检查是否触发种族内部冲突

func _检查种族冲突() -> Array:
	return Game.派系系统._检查种族冲突()

## 处理种族冲突事件
func _处理种族冲突(冲突事件: Array) -> Array:
	var 处理结果: Array = []
	for 事件 in 冲突事件:
		var 种族1: String = str(事件.get("种族1", ""))
		var 种族2: String = str(事件.get("种族2", ""))
		var 严重程度: int = int(事件.get("严重程度", 1))
		var 结果: Dictionary = {"事件": 事件, "影响": ""}
		
		match 严重程度:
			1:
				# 轻微冲突：口角/小摩擦
				结果["影响"] = "%s与%s弟子发生口角，士气轻微下降。" % [种族1, 种族2]
				# 双方各一名弟子心境-5
				for d in Game.弟子列表:
					if d != null and (d is Disciple) and d.种族 == 种族1 and d.状态 == "在宗":
						d.心境 = max(0, d.心境 - 5)
						break
				for d in Game.弟子列表:
					if d != null and (d is Disciple) and d.种族 == 种族2 and d.状态 == "在宗":
						d.心境 = max(0, d.心境 - 5)
						break
			2:
				# 中等冲突：打架/受伤
				结果["影响"] = "%s与%s弟子发生斗殴，有弟子受伤。" % [种族1, 种族2]
				# 双方各一名弟子受伤（修炼效率下降30天）
				for d in Game.弟子列表:
					if d != null and (d is Disciple) and d.种族 == 种族1 and d.状态 == "在宗":
						d.增加心魔(10)
						break
				for d in Game.弟子列表:
					if d != null and (d is Disciple) and d.种族 == 种族2 and d.状态 == "在宗":
						d.增加心魔(10)
						break
			3:
				# 严重冲突：群殴/有人叛逃
				结果["影响"] = "%s与%s弟子发生群殴，有弟子叛逃！" % [种族1, 种族2]
				# 有概率一名弟子叛逃
				if randf() < 0.3:
					for d in Game.弟子列表:
						if d != null and (d is Disciple) and d.种族 == 种族2 and d.状态 == "在宗":
							d.状态 = "失踪"
							结果["影响"] += " %s叛逃！" % d.姓名
							break
		处理结果.append(结果)
	return 处理结果

## 检查异族联姻
func _检查种族通婚() -> Array:
	var 通婚事件: Array = []
	# 不同种族弟子之间有概率结为道侣
	var 适婚弟子: Array = []
	for d in Game.弟子列表:
		if d == null or not (d is Disciple) or d.状态 != "在宗":
			continue
		if d.境界 in ["金丹", "元婴", "化神"] and d.道侣 == "":
			适婚弟子.append(d)
	
	# 随机配对
	for i in range(适婚弟子.size()):
		for j in range(i + 1, 适婚弟子.size()):
			var d1: Disciple = 适婚弟子[i]
			var d2: Disciple = 适婚弟子[j]
			if d1.种族 == d2.种族:
				continue  # 同族通婚不在这里处理
			# 异族通婚概率（关系越好概率越高）
			var 关系: int = 获取种族关系(d1.种族, d2.种族)
			var 通婚概率: float = 0.01 + 关系 * 0.001
			if randf() < 通婚概率:
				var 事件: Dictionary = {
					"弟子1": d1.姓名,
					"弟子2": d2.姓名,
					"种族1": d1.种族,
					"种族2": d2.种族,
					"时间": Game.累计游戏日
				}
				通婚事件.append(事件)
				种族通婚记录.append(事件)
				# 结为道侣
				d1.道侣 = d2.姓名
				d2.道侣 = d1.姓名
				# 通婚改善种族关系
				修改种族关系(d1.种族, d2.种族, 10)
	return 通婚事件

## 混血后代（联姻后代有概率获得混血血脉）
func 生成混血后代(父方种族: String, 母方种族: String) -> Dictionary:
	var 后代: Dictionary = {
		"种族": 父方种族,  # 默认跟随父方
		"血脉类型": "凡人血脉",
		"混血": false,
		"描述": ""
	}
	# 30%概率混血
	if randf() < 0.3:
		后代["混血"] = true
		# 随机选择一方的血脉
		if randf() < 0.5:
			后代["种族"] = 父方种族
		else:
			后代["种族"] = 母方种族
		# 获得另一方的血脉天赋
		match 母方种族:
			"龙族":
				后代["血脉类型"] = "龙族血脉"
			"妖族":
				后代["血脉类型"] = "太古血脉"  # 简化处理
			_:
				后代["血脉类型"] = "凡人血脉"
		后代["描述"] = "%s与%s的混血后代，拥有%s血脉。" % [父方种族, 母方种族, 后代["血脉类型"]]
	else:
		后代["描述"] = "%s后代。" % 父方种族
	return 后代

