# 初始化资源点（2026-09-14 扩容：宗门左近 6 处 + 五域各 18 处 = 96 处）
# 目的：把「天下」的留白填成可采集点位，服务无缝大地图的「内容密度」（真·大世界感）。
func 初始化周边资源点() -> void:
	资源点列表.clear()
	var 全部类型: Array = ["灵脉", "矿脉", "灵草丛", "妖兽领", "灵泉"]
	var 序号: int = 0
	var 已用名: Dictionary = {}
	# 2026-09-14：资源点坐标一律存「全局口径」（= 区域逻辑范围 铺在画布上的绝对坐标），
	#   与 区域秘境 / 钓点 一致；宗门落在哪一域，其左近即以该域原点（画布框中心）向外撒点。
	var 宗门全局: Vector2 = 域内坐标转全局(宗门区域, 宗门坐标X, 宗门坐标Y)
	# 一、宗门左近 6 处（近场，开宗即勘明 —— 见 勘明山门左近）
	var 宗门框: Dictionary = 区域逻辑范围.get(宗门区域, {})
	for i in range(6):
		var 类型: String = 全部类型[randi() % 全部类型.size()]
		var 角度: float = randf() * 2.0 * PI
		var 距离: float = randf_range(50.0, 300.0)
		var px: float = 宗门全局.x + cos(角度) * 距离
		var py: float = 宗门全局.y + sin(角度) * 距离
		# 夹回本域板内（留 24 余量）：否则山门左近点会飘到各域板之外的水墨底上，像孤儿点。
		if not 宗门框.is_empty():
			px = clampf(px, float(宗门框["x1"]) + 24.0, float(宗门框["x2"]) - 24.0)
			py = clampf(py, float(宗门框["y1"]) + 24.0, float(宗门框["y2"]) - 24.0)
		# 距离按夹取后的实际落点重算，保持「距离」字段与坐标自洽
		var 实距: float = Vector2(px - 宗门全局.x, py - 宗门全局.y).length()
		_建资源点("宗门左近", 类型, px, py, 实距, 序号, 已用名)
		序号 += 1
	# 二、五域各 18 处（广域铺陈，跨域探明是长期目标）
	for 区域 in 所有区域:
		var 类型池: Array = 区域资源类型池.get(区域, 全部类型)
		var 范围: Dictionary = 区域逻辑范围.get(区域, {"x1": -200.0, "y1": -200.0, "x2": 200.0, "y2": 200.0})
		for j in range(18):
			var 类型: String = str(类型池[randi() % 类型池.size()])
			var x: float = randf_range(float(范围["x1"]), float(范围["x2"]))
			var y: float = randf_range(float(范围["y1"]), float(范围["y2"]))
			# 距离一律在同一（全局）口径下量，否则跨口径相减会得出无意义的大距离，
			#   使 采集 的 距离衰减 clamp(1-距/1000, 0.5, 1.0) 恒落到 0.5 下限。
			var 距: float = Vector2(x - 宗门全局.x, y - 宗门全局.y).length()
			_建资源点(str(区域), 类型, x, y, 距, 序号, 已用名)
			序号 += 1

	# 三、开宗即勘明山门左近（详见 勘明山门左近 注释）
	勘明山门左近()

# 勘明山门左近（2026-09-14）
# 修真逻辑：开宗立派之时，山门方圆数百里本宗早已勘明，无需再遣弟子探查。
# 修正的缺陷：此前 96 处资源点一律 已发现=false ⇒ 地图页图例列了「灵脉/矿脉/灵草丛/妖兽领/灵泉」
#   五类，首屏却一个资源点都不显示（图例成了空头承诺），新宗主也没有任何「采集」目标。
# 幂等：只把距宗门 半径（逻辑坐标）以内的未发现点翻为已发现，可重复调用（老档自愈）。
func 勘明山门左近(半径: float = 320.0) -> int:
	var 宗门全局: Vector2 = 域内坐标转全局(宗门区域, 宗门坐标X, 宗门坐标Y)
	var 数: int = 0
	for 资源点 in 资源点列表:
		if bool(资源点.get("已发现", false)):
			continue
		var dx: float = float(资源点.get("x", 0.0)) - 宗门全局.x
		var dy: float = float(资源点.get("y", 0.0)) - 宗门全局.y
		if sqrt(dx * dx + dy * dy) <= 半径:
			资源点["已发现"] = true
			数 += 1
	return 数

# 域内坐标 → 全局坐标（2026-09-14）
# 工程里并存两套口径，本函数是唯一换乘站：
#   ①「域内口径」±200 + 区域 字段 —— 城镇坐标表 / 生成模拟宗门 / 随机分配宗门位置 / 宗门坐标
#     （距离公式也按此口径算，故逻辑层不动）
#   ②「全局口径」—— 区域逻辑范围 铺在画布上的绝对坐标，渲染层只认这个
#     （区域秘境 / 资源点 / 钓点 都存这个口径）
# 域内 ±200 恒在各域画布框半宽/半高之内（最窄的东域/西域半宽 225 > 200），故抬升后必落在本域板内。
func 域内坐标转全局(域: String, x: float, y: float) -> Vector2:
	var 范围: Dictionary = 区域逻辑范围.get(域, {})
	if 范围.is_empty():
		return Vector2(x, y)
	var cx: float = (float(范围["x1"]) + float(范围["x2"])) * 0.5
	var cy: float = (float(范围["y1"]) + float(范围["y2"])) * 0.5
	return Vector2(cx + x, cy + y)

# 生成单个资源点（名称带地域前缀，便于图面辨识）
# 已用名：同一批初始化内去重（同域同类型池 12 名 > 单域同类型最多 6 处 ⇒ 不会重名）
func _建资源点(地域: String, 类型: String, x: float, y: float, 距离: float, 序号: int, 已用名: Dictionary = {}) -> void:
	var 配置: Dictionary = 资源点配置.get(类型, {})
	var 池: Array = 资源名池.get(类型, [类型])
	var 全名: String = ""
	for k in range(池.size()):
		var 候选: String = "%s·%s" % [地域, str(池[(k + 序号) % 池.size()])]
		if not 已用名.has(候选):
			全名 = 候选
			break
	if 全名 == "":
		全名 = "%s·%s" % [地域, str(池[序号 % 池.size()])]
	已用名[全名] = true
	资源点列表.append({
		"ID": "resource_%d" % 序号,
		"类型": 类型,
		"名称": 全名,
		"x": x,
		"y": y,
		"坐标系": "全局",   # 2026-09-14：老档缺此字段 ⇒ from_dict 里做一次性口径抬升
		"距离": 距离,
		"等级": randi_range(1, 5),
		"描述": 配置.get("描述", ""),
		"已发现": false,
	})

# 获取可采集的资源点列表
func 获取可采集资源点() -> Array:
	var 可采集: Array = []
	for 资源点 in 资源点列表:
		if not 资源点.get("已发现", false):
			continue
		var ID: String = str(资源点["ID"])
		var 类型: String = str(资源点["类型"])
		var 配置: Dictionary = 资源点配置.get(类型, {})
		var 上次采集: int = int(资源采集记录.get(ID, 0))
		var 冷却小时: int = int(配置.get("冷却小时", 6))
		var 冷却游戏日: float = float(冷却小时) / 24.0 * 15.0  # 现实1小时=游戏15日（参考之前的设定）
		var 今日次数: int = int(今日采集次数.get(ID, 0))
		var 每日上限: int = int(配置.get("每日上限", 5))
		var 可采: bool = (Game.累计游戏日 - 上次采集) >= 冷却游戏日 and 今日次数 < 每日上限
		可采集.append({
			"ID": ID,
			"名称": 资源点["名称"],
			"类型": 类型,
			"距离": 资源点["距离"],
			"等级": 资源点["等级"],
			"可采集": 可采,
			"今日次数": 今日次数,
			"每日上限": 每日上限,
			"冷却剩余": max(0, int(冷却游戏日 - (Game.累计游戏日 - 上次采集))),
		})
	return 可采集

# 采集资源点
func 采集资源点(资源点ID: String) -> Dictionary:
	# 查找资源点
	var 目标资源点: Dictionary = {}
	for 资源点 in 资源点列表:
		if str(资源点["ID"]) == 资源点ID:
			目标资源点 = 资源点
			break
	if 目标资源点.is_empty():
		return {"成功": false, "原因": "资源点不存在"}
	if not 目标资源点.get("已发现", false):
		return {"成功": false, "原因": "该资源点尚未发现"}
	var 类型: String = str(目标资源点["类型"])
	var 配置: Dictionary = 资源点配置.get(类型, {})
	# 冷却检查
	var 上次采集: int = int(资源采集记录.get(资源点ID, 0))
	var 冷却小时: int = int(配置.get("冷却小时", 6))
	var 冷却游戏日: float = float(冷却小时) / 24.0 * 15.0
	if Game.累计游戏日 - 上次采集 < 冷却游戏日:
		return {"成功": false, "原因": "资源尚未恢复，还需%d日" % int(冷却游戏日 - (Game.累计游戏日 - 上次采集))}
	# 每日上限检查
	var 今日次数: int = int(今日采集次数.get(资源点ID, 0))
	var 每日上限: int = int(配置.get("每日上限", 5))
	if 今日次数 >= 每日上限:
		return {"成功": false, "原因": "今日已采集%d次，达到上限" % 今日次数}
	# 计算产量（受等级和距离影响）
	var 基础产量: int = int(配置.get("基础产量", 100))
	var 等级: int = int(目标资源点.get("等级", 1))
	var 距离: float = float(目标资源点.get("距离", 100))
	var 距离衰减: float = clamp(1.0 - 距离 / 1000.0, 0.5, 1.0)
	var 实际产量: int = int(基础产量 * 等级 * 距离衰减 * randf_range(0.8, 1.2))
	# 记录
	资源采集记录[资源点ID] = Game.累计游戏日
	今日采集次数[资源点ID] = 今日次数 + 1
	# 产出真正入账（接生产系统：灵气/矿石/灵草 直加，妖兽材料走 Game.增加妖兽材料）
	var 入库: Dictionary = 采集资源入库存(资源点ID, 实际产量)
	var 产出类型: String = str(配置.get("产出", "资源"))
	var 入账文案: String = ""
	if bool(入库.get("成功", false)):
		入账文案 = "，已入宗门库藏"
	# 添加纪事
	Game.添加纪事("探索", "资源采集", "在%s采集到%s x%d%s" % [目标资源点["名称"], 产出类型, 实际产量, 入账文案], 0)
	return {"成功": true, "资源点": 目标资源点["名称"], "产出": 产出类型, "数量": 实际产量, "等级": 等级, "入库": 入库}

# 发现资源点（探索时调用）
func 发现资源点(资源点ID: String) -> Dictionary:
	for 资源点 in 资源点列表:
		if str(资源点["ID"]) == 资源点ID:
			资源点["已发现"] = true
			Game.添加纪事("探索", "发现资源", "发现%s：%s" % [资源点["类型"], 资源点["名称"]], 1)
			return {"成功": true, "资源点": 资源点}
	return {"成功": false, "原因": "资源点不存在"}

# 重置每日采集次数（每日结算时调用）
func 重置每日采集次数() -> void:
	今日采集次数.clear()

