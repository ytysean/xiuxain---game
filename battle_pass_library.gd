## 取指定等级的整行配置
static func 取等级(等级: int) -> Dictionary:
	for r in 等级表:
		if int(r.get("等级", -1)) == 等级:
			return r
	return {}

## 获取当前赛季
static func 获取当前赛季(游戏日: int) -> Dictionary:
	for 赛季 in 赛季列表:
		if 游戏日 >= int(赛季.get("开始日", 0)) and 游戏日 < int(赛季.get("结束日", 90)):
			return 赛季
	return 赛季列表[0]

## 计算升级所需经验
static func 计算所需经验(当前等级: int) -> int:
	if 当前等级 >= 最大等级:
		return 0
	var 配置 = 取等级(当前等级)
	return int(配置.get("所需经验", 100))

## 添加战令经验
static func 添加经验(当前等级: int, 当前经验: int, 添加值: int) -> Dictionary:
	var 新经验 = 当前经验 + 添加值
	var 新等级 = 当前等级
	var 升级次数 = 0
	while 新等级 < 最大等级:
		var 所需 = 计算所需经验(新等级)
		if 所需 == 0 or 新经验 < 所需:
			break
		新经验 -= 所需
		新等级 += 1
		升级次数 += 1
	return {"新等级": 新等级, "新经验": 新经验, "升级次数": 升级次数}

## 获取免费奖励
static func 获取免费奖励(等级: int) -> Dictionary:
	var 配置 = 取等级(等级)
	return 配置.get("免费奖励", {})

## 获取付费奖励
static func 获取付费奖励(等级: int) -> Dictionary:
	var 配置 = 取等级(等级)
	return 配置.get("付费奖励", {})

## 检查是否可以领取奖励
static func 可领取奖励(当前等级: int, 已领取等级: Array, 等级: int, 付费轨: bool = false) -> bool:
	if 等级 > 当前等级:
		return false
	if 已领取等级.has(等级):
		return false
	if 等级 == 0:
		return false
	return true

## 获取每周任务进度
static func 获取每周任务(游戏日: int) -> Array:
	# 简化：返回所有每周任务，实际应根据游戏日计算周次
	return 每周任务.duplicate()

## 获取每日任务进度
static func 获取每日任务(游戏日: int) -> Array:
	# 简化：返回所有每日任务，实际应根据游戏日计算
	return 每日任务.duplicate()

## 更新任务进度
static func 更新任务进度(任务列表: Array, 任务类型: String, 完成次数: int = 1) -> Array:
	var 新列表 = 任务列表.duplicate()
	for i in range(新列表.size()):
		var 任务 = 新列表[i]
		if str(任务.get("类型", "")) == 任务类型:
			var 当前进度 = int(任务.get("当前进度", 0)) + 完成次数
			任务["当前进度"] = min(当前进度, int(任务.get("目标", 1)))
			if 任务["当前进度"] >= int(任务.get("目标", 1)):
				任务["已完成"] = true
			新列表[i] = 任务
	return 新列表

## 领取任务奖励
static func 领取任务奖励(任务: Dictionary) -> Dictionary:
	if not bool(任务.get("已完成", false)):
		return {"成功": false, "原因": "任务未完成"}
	if bool(任务.get("已领取", false)):
		return {"成功": false, "原因": "奖励已领取"}
	任务["已领取"] = true
	return {"成功": true, "经验": int(任务.get("经验", 0)), "原因": "领取成功，获得法旨功绩%d" % int(任务.get("经验", 0))}
