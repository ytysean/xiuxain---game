[resource]
; ── P1-B 字号 Token：全局默认档（FS_BODY=15，正文下限，误继承也不违规）──
default_font_size = 15

; ── P1-B 字号 Token：基础控件类型档（key 为 Godot 4 真实 item 名，非规范表的语义名）──
Label/font_sizes/font_size = 15                ; FS_BODY
Button/font_sizes/font_size = 17               ; FS_BUTTON（规范 §2 按钮=17）
LineEdit/font_sizes/font_size = 16             ; FS_VALUE（规范 §2 输入=16）
OptionButton/font_sizes/font_size = 17         ; FS_BUTTON（继承 Button 语义）
CheckBox/font_sizes/font_size = 15             ; FS_BODY
TabBar/font_sizes/font_size = 13               ; FS_AUX（底部导航文字）
PopupMenu/font_sizes/font_size = 15            ; FS_BODY
TooltipLabel/font_sizes/font_size = 13         ; FS_AUX
RichTextLabel/font_sizes/normal_font_size = 15 ; FS_BODY
RichTextLabel/font_sizes/bold_font_size = 15   ; FS_BODY（同字号加粗，不跳档）
RichTextLabel/font_sizes/italic_font_size = 15 ; FS_BODY
RichTextLabel/font_sizes/mono_font_size = 15   ; FS_BODY

; ── Button ──
Button/styles/normal = SubResource("sb_btn_normal")
Button/styles/hover = SubResource("sb_btn_hover")
Button/styles/pressed = SubResource("sb_btn_pressed")
Button/styles/disabled = SubResource("sb_btn_disabled")
Button/colors/font_color = Color(0.8784, 0.8353, 0.7451, 1)        ; body #E0D5BE
Button/colors/font_hover_color = Color(0.9412, 0.9020, 0.8235, 1)  ; title2 #F0E6D2
Button/colors/font_pressed_color = Color(0.9020, 0.7804, 0.4706, 1) ; title1 #E6C778
Button/colors/font_disabled_color = Color(0.3333, 0.3333, 0.3098, 1) ; disabled-text #55554F

; ── PanelContainer ──
PanelContainer/styles/panel = SubResource("sb_panel")

; ── Label（默认色；字号自 P1-B 起由上方 Label/font_sizes + default_font_size 接管，
;    apply_*_font 仅保留「设字体资源」职责；其残留的设字号行为待 P1-D 清理）──
Label/colors/font_color = Color(0.8784, 0.8353, 0.7451, 1)        ; body #E0D5BE

; ── TabBar ──
TabBar/styles/tab_selected = SubResource("sb_tab_selected")
TabBar/styles/tab_unselected = SubResource("sb_tab_unselected")
TabBar/colors/font_color = Color(0.5412, 0.4941, 0.4078, 1)        ; 未选中 hint 色 → aux #8A7E68
TabBar/colors/font_selected_color = Color(0.9020, 0.7804, 0.4706, 1) ; 选中 title1 #E6C778
TabBar/colors/font_hover_color = Color(0.7843, 0.7216, 0.5882, 1)  ; 悬浮略提亮 body-dim #C8B896

; ── ScrollBar ──
ScrollBar/styles/scroll = SubResource("sb_scroll")
ScrollBar/styles/grabber = SubResource("sb_grabber")
ScrollBar/styles/grabber_hover = SubResource("sb_grabber_hover")
ScrollBar/styles/grabber_pressed = SubResource("sb_grabber_pressed")

; ── ProgressBar ──
ProgressBar/styles/background = SubResource("sb_pbar_bg")
ProgressBar/styles/fill = SubResource("sb_pbar_fill")

; ── M2/M3 单源化收口：命名变体（.tscn 经 theme_type_variation 引用，消除字面量）──
SectNavBtn/styles/normal = SubResource("sb_nav_btn")
SectNavBtn/styles/pressed = SubResource("sb_nav_btn")
SectNavBtn/styles/hover = SubResource("sb_nav_btn")
SectNavActive/styles/normal = SubResource("sb_nav_active")
SectNavActive/styles/pressed = SubResource("sb_nav_active")
SectNavActive/styles/hover = SubResource("sb_nav_active")
SectFold/styles/panel = SubResource("sb_fold")
SectAvatar/styles/panel = SubResource("sb_avatar")
SectLv/styles/panel = SubResource("sb_lv")
SectTopBg/styles/panel = SubResource("sb_top_bg")
SectResBg/styles/panel = SubResource("sb_res_bg")
SectHomePanel/styles/panel = SubResource("sb_home_panel")

; ── M2/M3 单源化收口：命名变体 base_type 注册（Godot4 变体解析必需，否则 theme_type_variation 回落默认）──
SectNavBtn/base_type = &"Button"
SectNavActive/base_type = &"Button"
SectFold/base_type = &"Panel"
SectAvatar/base_type = &"Panel"
SectLv/base_type = &"Panel"
SectTopBg/base_type = &"Panel"
SectResBg/base_type = &"Panel"
SectHomePanel/base_type = &"Panel"

; ── P1-B 字号单源化：命名变体（偏离 default 15 时使用，.tscn 经 theme_type_variation 引用）──
; 同一 Label 类型需出多档字号，单条 Label/font_sizes/font_size 无法表达 → 必须走变体（与 M2/M3 StyleBox 同构）。
; FS_BODY(15) 不设变体：它就是 default，直接删覆写即可。
TxTitle17/font_sizes/font_size = 17            ; FS_BUTTON — 页内小标题
TxValue16/font_sizes/font_size = 16            ; FS_VALUE  — 资源/数值
TxAux13/font_sizes/font_size = 13              ; FS_AUX    — 辅助说明、导航文字

; ── P1-B 变体 base_type 注册（Godot4 变体解析必需，否则 theme_type_variation 静默回落默认）──
TxTitle17/base_type = &"Label"
TxValue16/base_type = &"Label"
TxAux13/base_type = &"Label"
