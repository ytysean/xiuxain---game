## P1-5：玩家委托拍卖（寄售系统）—— 玩家将背包物品上架拍卖行
## S53：增加认主检查、时长选项、底价/天价规制
func 玩家寄售物品_S34(物品索引: int, 起拍价: int, 时长类型: String = "7日") -> Dictionary:
	if 物品索引 < 0 or 物品索引 >= Game.宗门库房.size():
		return {"成功": false, "原因": "物品索引无效"}
	var it: Item = Game.宗门库房[物品索引]
	if it == null:
		return {"成功": false, "原因": "物品不存在"}
	# S53：认主检查（认主物品不可寄售）
	if not it.是否可交易():
		return {"成功": false, "原因": it.获取认主描述()}
	# S53：底价/天价规制
	var 系统估价: int = _基准估值(it)
	var 底价: int = int(float(系统估价) * 0.2)
	var 天价: int = int(float(系统估价) * 5.0)
	if 起拍价 < 底价:
		return {"成功": false, "原因": "起拍价不得低于底价%d灵石（系统估价%d的20%%）" % [底价, 系统估价]}
	if 起拍价 > 天价:
		return {"成功": false, "原因": "起拍价不得高于天价%d灵石（系统估价%d的500%%）" % [天价, 系统估价]}
	if 起拍价 < 10:
		return {"成功": false, "原因": "起拍价不能低于10灵石"}
	# S53：拍卖时长选项（7日/1月/3月/6月）
	var 时长日: int = 7
	match 时长类型:
		"7日": 时长日 = 7
		"1月": 时长日 = 30
		"3月": 时长日 = 90
		"6月": 时长日 = 180
		_: 时长日 = 7
	# S53：宗门等级限制（防小号刷钱）
	if Game.门派等级 < 3:
		return {"成功": false, "原因": "宗门品级不足三品，暂不可寄售物品"}
	# 从背包移除
	Game.宗门库房.remove_at(物品索引)
	# 生成寄售拍品
	var 拍品ID: String = "寄售_" + str(Time.get_unix_time_from_system())
	var 新拍品: Dictionary = {
		"id": 拍品ID,
		"物品": it.to_dict(),
		"名称": str(it.名称),
		"品类": "玩家寄售",
		"品阶": str(it.品阶),
		"类别": str(it.类别),
		"起拍价": 起拍价,
		"当前价": 起拍价,
		"基准估值": 系统估价,
		"最高出价者": "（暂无）",
		"最高出价": 0,
		"结束日": Game.累计游戏日 + 时长日,
		"状态": "竞拍中",
		"竞价台词": [],
		"委托列表": [],
		"寄售者类型": "玩家",
		"寄售者ID": "玩家",
		"寄售者姓名": "宗主",
		"佣金率": 0.10,
		"时长类型": 时长类型,
	}
	(拍卖会["常驻拍品"] as Array).append(新拍品)
	# 记录寄售
	var 寄售记录: Dictionary = {
		"拍品ID": 拍品ID,
		"物品名称": str(it.名称),
		"起拍价": 起拍价,
		"结束日": Game.累计游戏日 + 时长日,
		"状态": "竞拍中",
	}
	(拍卖会["寄售列表"] as Array).append(寄售记录)
	return {"成功": true, "原因": "已上架「%s」，起拍价%d灵石，%d游戏日后结算" % [str(it.名称), 起拍价, 时长日]}

