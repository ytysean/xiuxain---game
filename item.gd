# S25 储物层收敛：物品复制（灵田/矿脉按产量入库需 N 份独立实例）
# 背景：Item extends RefCounted，无 duplicate()；原 产出.duplicate() 调用直接崩溃（灵田收获/矿脉开采）
func 克隆() -> Item:
	var c: Item = Item.new()
	c.类别 = 类别
	c.品阶 = 品阶
	c.穿戴位 = 穿戴位
	c.道途 = 道途
	c.名称 = 名称
	c.数量 = 数量
	c.功效 = 功效
	c.描述 = 描述
	c.战力加成 = 战力加成
	c.极品 = 极品
	c.特殊 = 特殊
	c.词缀 = 词缀.duplicate()
	c.极品属性 = 极品属性
	c.奇遇版 = 奇遇版
	c.套装ID = 套装ID
	c.祭炼等级 = 祭炼等级
	c.祭炼上限 = 祭炼上限
	c.保命 = 保命
	c.奇物 = 奇物
	c.奇物类型 = 奇物类型
	c.奇物技能 = 奇物技能
	c.神器技能 = 神器技能
	c.神器技能2 = 神器技能2
	c.独一无二 = 独一无二
	c.年份 = 年份
	c.丹词条 = 丹词条.duplicate()
	c.装备词条 = 装备词条.duplicate()
	c.符词条 = 符词条.duplicate()
	# P0-3 装备本体基础属性
	c.基础攻击 = 基础攻击
	c.基础防御 = 基础防御
	c.基础气血 = 基础气血
	c.基础耐久 = 基础耐久
	c.装备模板ID = 装备模板ID
	return c

