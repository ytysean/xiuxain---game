	return 全服拍卖.get("担保交易列表", [])

# ===== S54 P4：鉴宝系统 =====
# 鉴定拍品（拍卖中或已购得的神秘物品）
func 鉴定拍品(拍品ID: String) -> Dictionary:
	var lot: Dictionary = _查找拍品(拍品ID)
	if lot.is_empty():
		# 可能在库房中
		return _鉴定库房物品(拍品ID)
	var it_dict: Dictionary = lot.get("物品", {})
	var it: Item = Item.new()
	it.from_dict(it_dict)
	if not it.神秘物品:
		return {"成功": false, "原因": "此物并非神秘物品，无需鉴定。"}
	# 鉴定费：底价的10%
	var 鉴定费: int = max(100, int(float(lot.get("底价", 1000)) * 0.1))
	if Game.灵石 < 鉴定费:
		return {"成功": false, "原因": "灵石不足，鉴定费需%d灵石。" % 鉴定费}
	Game.灵石 -= 鉴定费
	# 鉴定
	var 果: Dictionary = it.鉴定物品("聚宝阁鉴定师")
	# 更新拍品物品
	lot["物品"] = it.to_dict()
	lot["名称"] = it.获取显示名称()
	lot["品阶"] = it.获取显示品阶()
	lot["神秘物品"] = it.神秘物品
	if bool(果.get("成功", false)):
		if bool(果.get("是赝品", false)):
			Game.添加纪事("全服拍卖", "鉴定结果", "鉴定完毕！「%s」竟是赝品！" % str(果.get("真实名称", "")), 1)
		else:
			Game.添加纪事("全服拍卖", "鉴定结果", "鉴定完毕！「%s」竟是%s！%s" % [lot.get("名称", ""), str(果.get("真实名称", "")), str(果.get("真实描述", ""))], 2)
	return 果

# 鉴定库房物品
func _鉴定库房物品(物品名: String) -> Dictionary:
	for it in Game.宗门库房:
		if it.名称 == 物品名 and it.神秘物品:
			var 鉴定费: int = max(100, int(float(it.战力加成) * 10))
			if Game.灵石 < 鉴定费:
				return {"成功": false, "原因": "灵石不足，鉴定费需%d灵石。" % 鉴定费}
			Game.灵石 -= 鉴定费
			var 果: Dictionary = it.鉴定物品("聚宝阁鉴定师")
			if bool(果.get("成功", false)):
				if bool(果.get("是赝品", false)):
					Game.添加纪事("全服拍卖", "鉴定结果", "鉴定完毕！「%s」竟是赝品！" % str(果.get("真实名称", "")), 1)
				else:
					Game.添加纪事("全服拍卖", "鉴定结果", "鉴定完毕！「%s」竟是%s！%s" % [物品名, str(果.get("真实名称", "")), str(果.get("真实描述", ""))], 2)
			return 果
	return {"成功": false, "原因": "未找到该神秘物品。"}

