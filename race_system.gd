# ===== 多种族修炼体系 P3：种族平衡监控 =====
## 获取宗门种族构成统计
func 获取种族构成统计() -> Dictionary:
	var 统计: Dictionary = {}
	var 总数: int = 0
	for d in Game.弟子列表:
		if d == null or not (d is Disciple) or d.状态 != "在宗":
			continue
		统计[d.种族] = int(统计.get(d.种族, 0)) + 1
		总数 += 1
	统计["总数"] = 总数
	统计["种族数"] = 统计.size() - 1  # 减去总数
	return 统计

## 检查种族平衡（某种族占比过高/过低）
func 检查种族平衡() -> Array:
	var 警告: Array = []
	var 统计: Dictionary = 获取种族构成统计()
	var 总数: int = int(统计.get("总数", 0))
	if 总数 == 0:
		return 警告
	
	for 种族 in 统计:
		if 种族 == "总数" or 种族 == "种族数":
			continue
		var 占比: float = float(统计[种族]) / float(总数)
		if 占比 > 0.7:
			警告.append({"种族": 种族, "类型": "过高", "占比": 占比, "消息": "%s弟子占比过高（%.0f%%），可能影响种族多样性。" % [种族, 占比 * 100]})
		elif 占比 < 0.05 and int(统计[种族]) > 0:
			警告.append({"种族": 种族, "类型": "过低", "占比": 占比, "消息": "%s弟子占比过低（%.0f%%），种族多样性不足。" % [种族, 占比 * 100]})
	return 警告

