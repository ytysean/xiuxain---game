var _当前发展路线: String = "均衡发展"
var _殿阁负责人: Dictionary = {}  # 殿阁名 -> 弟子ID
var _弟子任职: Dictionary = {}  # 弟子ID -> {殿阁, 岗位}
var _待裁决违规: Array = []  # 待裁决的违规事件
var _待批阅事务: Array = []  # 待批阅的宗门事务
var _待回应请示: Array = []  # 待回应的弟子请示
var _核心弟子: Array = []  # 核心弟子ID列表（资源倾斜）
var _宗门科技: Dictionary = {}  # 已研究的科技
var _对外关系: Dictionary = {}  # 其他宗门ID -> 关系状态
var _议事会记录: Array = []  # 议事会记录
var _队伍预设: Dictionary = {}  # 弟子队伍预设（预设名 -> 弟子ID数组）
var _待处理护法: Dictionary = {}  # 待处理的护法请求（弟子ID -> {境界, 护法方式}）

func _ready() -> void:
	_初始化默认数据()
	# 初始化默认队伍预设
	if not _队伍预设.has("历练队1"):
		_队伍预设["历练队1"] = []
	if not _队伍预设.has("历练队2"):
		_队伍预设["历练队2"] = []
	if not _队伍预设.has("秘境队"):
		_队伍预设["秘境队"] = []

func _初始化默认数据() -> void:
	# 初始化殿阁负责人为空
	for 殿阁 in 殿阁列表:
		if not _殿阁负责人.has(殿阁):
			_殿阁负责人[殿阁] = -1

## ========== 宗门发展路线 ==========
func 设置发展路线(路线: String) -> void:
	if 发展路线.has(路线):
		_当前发展路线 = 路线

func 获取发展路线() -> String:
	return _当前发展路线

func 获取发展路线加成(殿阁: String) -> float:
	if _当前发展路线 == "均衡发展":
		return 1.0
	var 路线数据 = 发展路线[_当前发展路线]
	match 殿阁:
		"丹堂":
			return 路线数据.get("丹堂加成", 路线数据.get("其他加成", 1.0))
		"器堂":
			return 路线数据.get("器堂加成", 路线数据.get("其他加成", 1.0))
		"阵法堂":
			return 路线数据.get("阵法堂加成", 路线数据.get("其他加成", 1.0))
		_:
			return 路线数据.get("其他加成", 1.0)

## ========== 殿阁负责人任命 ==========
func 任命殿阁负责人(殿阁: String, 弟子ID: int) -> void:
	if _殿阁负责人.has(殿阁):
		_殿阁负责人[殿阁] = 弟子ID

func 获取殿阁负责人(殿阁: String) -> int:
	return _殿阁负责人.get(殿阁, -1)

func 获取负责人加成(殿阁: String, 弟子数据) -> float:
	# 根据弟子天赋提供加成，默认10%
	if 弟子数据 == null:
		return 1.0
	var 天赋 = str(弟子数据.资质) if 弟子数据 != null else "平庸"
	match 天赋:
		"妖孽", "旷世":
			return 1.3
		"天才":
			return 1.2
		"优良":
			return 1.1
		_:
			return 1.05

## ========== 弟子任职 ==========
func 分配弟子任职(弟子ID: int, 殿阁: String, 岗位: String) -> void:
	_弟子任职[弟子ID] = {"殿阁": 殿阁, "岗位": 岗位}

func 获取弟子任职(弟子ID: int) -> Dictionary:
	return _弟子任职.get(弟子ID, {})

func 解除弟子任职(弟子ID: int) -> void:
	if _弟子任职.has(弟子ID):
		_弟子任职.erase(弟子ID)

func 获取任职效率加成(弟子ID: int) -> float:
	var 任职 = 获取弟子任职(弟子ID)
	if 任职.is_empty():
		return 1.0
	# 任职弟子在对应领域效率+50%
	return 1.5

## ========== 核心弟子 ==========
func 设为核心弟子(弟子ID: int) -> void:
	if not _核心弟子.has(弟子ID):
		_核心弟子.append(弟子ID)

func 取消核心弟子(弟子ID: int) -> void:
	_核心弟子.erase(弟子ID)

func 是否核心弟子(弟子ID: int) -> bool:
	return _核心弟子.has(弟子ID)

func 获取核心弟子加成() -> float:
	# 核心弟子修炼速度+50%
	return 1.5

func 获取核心弟子列表() -> Array:
	return _核心弟子.duplicate()

## ========== 戒律裁决 ==========
func 上报违规(弟子ID: int, 违规类型: String, 详情: String) -> void:
	_待裁决违规.append({"弟子ID": 弟子ID, "违规类型": 违规类型, "详情": 详情, "时间": Time.get_datetime_string_from_system()})
	戒律违规上报.emit(弟子ID, 违规类型, 详情)

func 获取待裁决违规() -> Array:
	return _待裁决违规

func 裁决违规(索引: int, 处罚: String) -> Dictionary:
	if 索引 < 0 or 索引 >= _待裁决违规.size():
		return {"成功": false, "消息": "无效的裁决索引"}
	var 违规 = _待裁决违规[索引]
	_待裁决违规.remove_at(索引)
	return {"成功": true, "弟子ID": 违规["弟子ID"], "违规类型": 违规["违规类型"], "处罚": 处罚}

## ========== 弟子请示 ==========
func 发起请示(弟子ID: int, 请示类型: String, 详情: Dictionary) -> void:
	_待回应请示.append({"弟子ID": 弟子ID, "请示类型": 请示类型, "详情": 详情, "时间": Time.get_datetime_string_from_system()})
	弟子请示.emit(弟子ID, 请示类型, 详情)

func 获取待回应请示() -> Array:
	return _待回应请示

func 回应请示(索引: int, 决定: String) -> Dictionary:
	if 索引 < 0 or 索引 >= _待回应请示.size():
		return {"成功": false, "消息": "无效的请示索引"}
	var 请示 = _待回应请示[索引]
	_待回应请示.remove_at(索引)
	return {"成功": true, "弟子ID": 请示["弟子ID"], "请示类型": 请示["请示类型"], "决定": 决定}

## ========== 宗主批阅 ==========
func 提交事务批阅(事务ID: String, 标题: String, 详情: Dictionary) -> void:
	_待批阅事务.append({"事务ID": 事务ID, "标题": 标题, "详情": 详情, "时间": Time.get_datetime_string_from_system()})
	宗门事务待批阅.emit(事务ID, 标题, 详情)

func 获取待批阅事务() -> Array:
	return _待批阅事务

func 批阅事务(索引: int, 决定: String) -> Dictionary:
	if 索引 < 0 or 索引 >= _待批阅事务.size():
		return {"成功": false, "消息": "无效的事务索引"}
	var 事务 = _待批阅事务[索引]
	_待批阅事务.remove_at(索引)
	return {"成功": true, "事务ID": 事务["事务ID"], "标题": 事务["标题"], "决定": 决定}

## ========== 宗门科技树 ==========
func 是否已研究科技(科技ID: String) -> bool:
	return _宗门科技.has(科技ID)

func 获取已研究科技() -> Dictionary:
	return _宗门科技

## ========== 对外关系 ==========
func 设置对外关系(宗门ID: String, 关系: String) -> void:
	_对外关系[宗门ID] = 关系

func 获取对外关系(宗门ID: String) -> String:
	return _对外关系.get(宗门ID, "中立")

func 获取所有对外关系() -> Dictionary:
	return _对外关系

## ========== 议事会 ==========
func 召开议事会(议题: String, 提议: Array) -> void:
	_议事会记录.append({"议题": 议题, "提议": 提议, "时间": Time.get_datetime_string_from_system(), "决议": ""})
	议事会召开.emit(议题, 提议)

func 获取议事会记录() -> Array:
	return _议事会记录

func 记录议事会决议(索引: int, 决议: String) -> void:
	if 索引 >= 0 and 索引 < _议事会记录.size():
		_议事会记录[索引]["决议"] = 决议

## ========== 弟子队伍预设 ==========
func 获取队伍预设列表() -> Dictionary:
	return _队伍预设

func 获取队伍预设(预设名: String) -> Array:
	return _队伍预设.get(预设名, [])

func 保存队伍预设(预设名: String, 弟子ID列表: Array) -> void:
	_队伍预设[预设名] = 弟子ID列表.duplicate()

func 添加队伍预设(预设名: String) -> void:
	if not _队伍预设.has(预设名):
		_队伍预设[预设名] = []

func 删除队伍预设(预设名: String) -> void:
	if _队伍预设.has(预设名):
		_队伍预设.erase(预设名)

func 应用队伍预设(预设名: String) -> Array:
	return 获取队伍预设(预设名).duplicate()

## ========== 突破护法系统 ==========
func 请求突破护法(弟子ID: int, 境界: String) -> void:
	# 记录待处理的护法请求，默认自行突破
	if not _待处理护法.has(弟子ID):
		_待处理护法[弟子ID] = {"境界": 境界, "护法方式": "自行突破", "已处理": false}
	突破护法请求.emit(弟子ID, 境界)

func 设置护法方式(弟子ID: int, 护法方式: String) -> void:
	if _待处理护法.has(弟子ID):
		_待处理护法[弟子ID]["护法方式"] = 护法方式

func 获取护法方式(弟子ID: int) -> String:
	if _待处理护法.has(弟子ID):
		return _待处理护法[弟子ID].get("护法方式", "自行突破")
	return "自行突破"

func 获取护法成功率加成(弟子ID: int) -> float:
	var 护法方式 = 获取护法方式(弟子ID)
	match 护法方式:
		"亲自护法":
			return 0.2
		"长老护法":
			return 0.1
		_:
			return 0.0

func 标记护法已处理(弟子ID: int) -> void:
	if _待处理护法.has(弟子ID):
		_待处理护法[弟子ID]["已处理"] = true
		# 保留记录一段时间后清除，这里立即清除
		_待处理护法.erase(弟子ID)

func 获取待处理护法列表() -> Dictionary:
	return _待处理护法

## ========== 宗门科技树 ==========
func 可研究科技() -> Array:
	var 结果 = []
	for 科技ID in 科技树配置.keys():
		if _宗门科技.has(科技ID):
			continue
		var 科技数据 = 科技树配置[科技ID]
		# 检查前置科技
		if 科技数据.has("前置") and not _宗门科技.has(科技数据["前置"]):
			continue
		结果.append(科技ID)
	return 结果

func 研究科技(科技ID: String) -> Dictionary:
	if _宗门科技.has(科技ID):
		return {"成功": false, "消息": "该科技已研究"}
	if not 科技树配置.has(科技ID):
		return {"成功": false, "消息": "未知科技"}
	var 科技数据 = 科技树配置[科技ID]
	# 检查前置科技
	if 科技数据.has("前置") and not _宗门科技.has(科技数据["前置"]):
		return {"成功": false, "消息": "需要先研究前置科技：" + 科技数据["前置"]}
	# 这里应该检查资源是否足够，暂时简化
	_宗门科技[科技ID] = {"研究时间": Time.get_datetime_string_from_system(), "消耗": 科技数据.get("消耗", {})}
	return {"成功": true, "消息": "研究成功：" + 科技ID}

func 获取科技加成(加成类型: String) -> float:
	var 总加成 = 0.0
	for 科技ID in _宗门科技.keys():
		if 科技树配置.has(科技ID):
			var 效果 = 科技树配置[科技ID].get("效果", {})
			if 效果.has(加成类型):
				总加成 += 效果[加成类型]
	return 总加成

func 获取所有科技加成() -> Dictionary:
	var 结果 = {}
	for 科技ID in _宗门科技.keys():
		if 科技树配置.has(科技ID):
			var 效果 = 科技树配置[科技ID].get("效果", {})
			for 加成类型 in 效果.keys():
				if not 结果.has(加成类型):
					结果[加成类型] = 0.0
				结果[加成类型] += 效果[加成类型]
	return 结果

## ========== 突破护法扩展 ==========
func 执行护法(弟子ID: int, 护法类型: String) -> Dictionary:
	match 护法类型:
		"亲自护法":
			return {"成功率加成": 0.2, "消耗": "宗主灵力"}
		"长老护法":
			return {"成功率加成": 0.1, "消耗": "长老时间"}
		"自行突破":
			return {"成功率加成": 0.0, "消耗": "无"}
		_:
			return {"成功率加成": 0.0, "消耗": "无"}

