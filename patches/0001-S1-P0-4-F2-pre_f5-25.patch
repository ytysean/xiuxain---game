+    性格 = 性格表.pick_random()
+    # ▼ 新增：特质生成时赋值（1~2 个，加权不重复）
+    var n = randi_range(1, 2)                       # 生成 1~2 特质
+    traits = 加权抽n(弟子特质表.keys(), 生成权重列, n)   # 生成权重=[数值待填]
+
+# —— 修炼乘系数（性格乘区，登记 §4.6）——
+# 总修炼速度倍率() 末尾：对 traits 中 作用属性=修炼速度 的特质，乘 (1 ± 系数值/100)
