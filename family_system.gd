## 计算家族阵法加成
func 计算家族阵法加成(弟子: Disciple) -> Dictionary:
	if 弟子 == null or not (弟子 is Disciple) or 弟子.家族ID == "":
		return {"修炼加成": 0.0, "战力加成": 0.0, "防御加成": 0.0}
	var 家族: Dictionary = 获取家族(弟子.家族ID)
	if 家族.is_empty() or 家族.get("家族阵法", "") == "":
		return {"修炼加成": 0.0, "战力加成": 0.0, "防御加成": 0.0}
	var 阵法ID: String = str(家族.get("家族阵法", ""))
	if not _家族阵法配置.has(阵法ID):
		return {"修炼加成": 0.0, "战力加成": 0.0, "防御加成": 0.0}
	var 阵法: Dictionary = _家族阵法配置[阵法ID]
	var 阵法等级: int = int(家族.get("阵法等级", 1))
	var 驻守人数: int = 家族.get("阵法驻守弟子", []).size()
	# 人数加成：每多1人驻守，阵法威力+10%，最多+100%（10人）
	var 人数系数: float = 1.0 + min(驻守人数 * 0.1, 1.0)
	# 等级加成：每级+20%
	var 等级系数: float = 1.0 + (阵法等级 - 1) * 0.2
	var 修炼加成: float = float(阵法.get("基础修炼加成", 0.0)) * 人数系数 * 等级系数
	var 战力加成: float = float(阵法.get("基础战力加成", 0.0)) * 人数系数 * 等级系数
	var 防御加成: float = float(阵法.get("基础防御加成", 0.0)) * 人数系数 * 等级系数
	# 数值红线：家族阵法单源子帽≤1%（全局等效）
	修炼加成 = min(修炼加成, 0.01)
	战力加成 = min(战力加成, 0.01)
	防御加成 = min(防御加成, 0.01)
	return {"修炼加成": 修炼加成, "战力加成": 战力加成, "防御加成": 防御加成}

