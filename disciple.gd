## 道心战斗增益：修真味——道心通明者同阶无敌，心神失守者施法反噬
## 道心 0~100，基准线 40：初始 20 → -1.67%；满值 100 → +5.0%；0 → -3.33%
## 返回战斗伤害乘区增量（如 +0.05 表示伤害 +5%）
func 道心战斗增益() -> float:
	return clamp((float(道心) - 40.0) / 60.0, -1.0, 1.0) * 0.05

## 综合突破成功率修正（心境+道心-心魔+法财侣地）
func 突破成功率修正() -> float:
	var 宗主突破加成: float = 0.0
	if Game != null and Game.has_method("获取宗主称号加成"):
		宗主突破加成 = Game.获取宗主称号加成("全宗突破") * 100.0
	# 弟子个人称号突破率加成
	var 个人突破加成: float = 0.0
	if Game != null and Game.has_method("获取称号加成"):
		个人突破加成 = Game.获取称号加成(self, "突破率") * 100.0
	# 护道人系统：护道人突破加成
	var 护道人突破加成: float = 0.0
	if Game != null and Game.has_method("获取护道人突破加成"):
		护道人突破加成 = Game.获取护道人突破加成(弟子ID) * 100.0
	# P0联动：宗主护法加成（待护法突破时生效，生效后清除）
	var 护法突破加成: float = 0.0
	if 待护法突破:
		护法突破加成 = 护法加成 * 100.0
		待护法突破 = false  # 生效后清除
		护法加成 = 0.0
	# 法（功法品阶和熟练度加成）
	var 功法突破加成: float = 0.0
	if 已学功法.size() > 0:
		# 已学功法数量加成（每部+1%，最高+5%）
		功法突破加成 = min(5.0, float(已学功法.size()) * 1.0)
		# 功法大圆满加成（检查是否有大圆满功法）
		# [PLACEHOLDER] 待功法熟练度系统完善后添加
	# 地（洞府品质加成）
	var 洞府突破加成: float = 0.0
	if 洞府等级 > 0:
		洞府突破加成 = float(洞府等级) * 2.0  # 每级洞府+2%，7级=14%
	# 地（灵脉等级加成，从宗门获取）
	var 灵脉突破加成: float = 0.0
	if Game != null and "灵脉等级" in Game:  # P0修复（2026-09-11）：Object 无 has()，改用 in 操作符（等价且合法）
		灵脉突破加成 = float(Game.灵脉等级) * 1.5  # 每级灵脉+1.5%
	# 财（突破丹药加成，检查是否服用了对应丹药）
	# [PLACEHOLDER] 待丹药系统完善后添加
	# 侣（道侣双修加成）
	# [PLACEHOLDER] 待道侣系统完善后添加
	return 心境突破加成() + 道心突破加成() + 心魔突破成功率惩罚() + 誓约突破加成() * 100.0 + 因果突破修正() + 宗主突破加成 + 个人突破加成 + 护道人突破加成 + 护法突破加成 + 功法突破加成 + 洞府突破加成 + 灵脉突破加成

## 修真味·因果：功德护体则天心眷顾，业力缠身则心魔扰道（单位：百分点）
## 功德 每 10 点 +0.5%（帽 +10%）；业力 每 10 点 -0.5%（帽 -15%）
## rationale：与 tribulation.因果天劫倍率 同量级（天劫 ±10%），避免因果成为唯一主导项；
##            业力惩罚上限略高于功德奖励，取「杀业易积、功德难修」的修真惯例。
## 安全性：业力=功德=0 → 返回 0.0，既有突破标定不受影响。
func 因果突破修正() -> float:
	var 功: float = clamp(float(功德) * 0.05, 0.0, 10.0)
	var 业: float = clamp(float(业力) * 0.05, 0.0, 15.0)
	return 功 - 业

