# tests/numerical_stats.gd —— 数值统计工具
# 功能：记录玩家的资源收入、消耗、成长速度，用于数值平衡分析
# 运行：在游戏中调用 NumericalStats.record_xxx() 记录数据，调用 export_report() 导出报告
class_name NumericalStats
extends RefCounted

# ============ 统计数据结构 ============

# 资源收支统计
var 资源收支: Dictionary = {
	"灵石": {"收入": 0, "支出": 0, "次数": 0},
	"灵气": {"收入": 0, "支出": 0, "次数": 0},
	"灵草": {"收入": 0, "支出": 0, "次数": 0},
	"矿石": {"收入": 0, "支出": 0, "次数": 0},
	"绑定仙玉": {"收入": 0, "支出": 0, "次数": 0},
}

# 弟子成长统计
var 弟子成长: Dictionary = {
	"突破次数": 0,
	"突破成功": 0,
	"突破失败": 0,
	"境界分布": {},  # {"练气": 人数, "筑基": 人数, ...}
	"修炼总天数": 0,
}

# 战斗统计
var 战斗统计: Dictionary = {
	"总场次": 0,
	"胜利": 0,
	"失败": 0,
	"平均回合数": 0.0,
	"境界胜率": {},  # {"练气vs筑基": 胜率, ...}
}

# 时间统计
var 时间统计: Dictionary = {
	"游戏开始时间": "",
	"游戏总天数": 0,
	"游戏总月数": 0,
	"游戏总年数": 0,
	"实际游玩时间": 0.0,  # 秒
}

# 系统使用统计
var 系统使用: Dictionary = {
	"灵田种植次数": 0,
	"矿脉开采次数": 0,
	"炼丹次数": 0,
	"炼器次数": 0,
	"坊市交易次数": 0,
	"任务完成次数": 0,
	"弟子招募次数": 0,
}

var _记录开始时间: float = 0.0
var _已初始化: bool = false

# ============ 初始化 ============

func _init():
	_记录开始时间 = Time.get_ticks_msec() / 1000.0
	时间统计["游戏开始时间"] = Time.get_datetime_string_from_system()
	_已初始化 = true
	print("[NumericalStats] 数值统计工具已初始化")

# ============ 资源收支记录 ============

func 记录资源收入(资源类型: String, 数量: int) -> void:
	if not 资源收支.has(资源类型):
		资源收支[资源类型] = {"收入": 0, "支出": 0, "次数": 0}
	资源收支[资源类型]["收入"] += 数量
	资源收支[资源类型]["次数"] += 1

func 记录资源支出(资源类型: String, 数量: int) -> void:
	if not 资源收支.has(资源类型):
		资源收支[资源类型] = {"收入": 0, "支出": 0, "次数": 0}
	资源收支[资源类型]["支出"] += 数量
	资源收支[资源类型]["次数"] += 1

# ============ 弟子成长记录 ============

func 记录突破(境界: String, 成功: bool) -> void:
	弟子成长["突破次数"] += 1
	if 成功:
		弟子成长["突破成功"] += 1
	else:
		弟子成长["突破失败"] += 1

func 更新境界分布(弟子列表: Array) -> void:
	弟子成长["境界分布"] = {}
	for d in 弟子列表:
		var 境界 = d.境界 if d.has_method("get") else d.get("境界", "未知")
		if not 弟子成长["境界分布"].has(境界):
			弟子成长["境界分布"][境界] = 0
		弟子成长["境界分布"][境界] += 1

func 记录修炼天数(天数: float) -> void:
	弟子成长["修炼总天数"] += 天数

# ============ 战斗记录 ============

func 记录战斗(攻方境界: String, 守方境界: String, 胜利: bool, 回合数: int) -> void:
	战斗统计["总场次"] += 1
	if 胜利:
		战斗统计["胜利"] += 1
	else:
		战斗统计["失败"] += 1
	# 更新平均回合数
	var 总回合 = 战斗统计["平均回合数"] * (战斗统计["总场次"] - 1) + 回合数
	战斗统计["平均回合数"] = 总回合 / 战斗统计["总场次"]
	# 记录境界胜率
	var key = "%svs%s" % [攻方境界, 守方境界]
	if not 战斗统计["境界胜率"].has(key):
		战斗统计["境界胜率"][key] = {"胜": 0, "负": 0}
	if 胜利:
		战斗统计["境界胜率"][key]["胜"] += 1
	else:
		战斗统计["境界胜率"][key]["负"] += 1

# ============ 时间记录 ============

func 更新游戏时间(游戏天数: int) -> void:
	时间统计["游戏总天数"] = 游戏天数
	时间统计["游戏总月数"] = 游戏天数 / 30
	时间统计["游戏总年数"] = 游戏天数 / 365

func 获取实际游玩时间() -> float:
	return Time.get_ticks_msec() / 1000.0 - _记录开始时间

# ============ 系统使用记录 ============

func 记录系统使用(系统名: String) -> void:
	if 系统使用.has(系统名):
		系统使用[系统名] += 1
	else:
		系统使用[系统名] = 1

# ============ 导出报告 ============

func 导出报告() -> String:
	var 报告 = ""
	报告 += "=".repeat(60) + "\n"
	报告 += "《太玄宗门录》数值统计报告\n"
	报告 += "=".repeat(60) + "\n\n"

	# 时间统计
	报告 += "一、时间统计\n"
	报告 += "-".repeat(40) + "\n"
	报告 += "游戏开始时间: %s\n" % 时间统计["游戏开始时间"]
	报告 += "游戏总天数: %d 天 (%.1f 月, %.1f 年)\n" % [时间统计["游戏总天数"], 时间统计["游戏总月数"], 时间统计["游戏总年数"]]
	报告 += "实际游玩时间: %.1f 秒 (%.1f 分钟)\n" % [获取实际游玩时间(), 获取实际游玩时间() / 60]
	报告 += "\n"

	# 资源收支
	报告 += "二、资源收支统计\n"
	报告 += "-".repeat(40) + "\n"
	报告 += "%-10s %-12s %-12s %-10s %-10s\n" % ["资源类型", "总收入", "总支出", "净收入", "操作次数"]
	for 资源类型 in 资源收支.keys():
		var 数据 = 资源收支[资源类型]
		var 净收入 = 数据["收入"] - 数据["支出"]
		报告 += "%-10s %-12d %-12d %-10d %-10d\n" % [资源类型, 数据["收入"], 数据["支出"], 净收入, 数据["次数"]]
	报告 += "\n"

	# 弟子成长
	报告 += "三、弟子成长统计\n"
	报告 += "-".repeat(40) + "\n"
	报告 += "突破总次数: %d\n" % 弟子成长["突破次数"]
	报告 += "突破成功: %d (%.1f%%)\n" % [弟子成长["突破成功"], 弟子成长["突破成功"] / max(弟子成长["突破次数"], 1) * 100]
	报告 += "突破失败: %d (%.1f%%)\n" % [弟子成长["突破失败"], 弟子成长["突破失败"] / max(弟子成长["突破次数"], 1) * 100]
	报告 += "修炼总天数: %d 天\n" % 弟子成长["修炼总天数"]
	报告 += "境界分布:\n"
	for 境界 in 弟子成长["境界分布"].keys():
		报告 += "  %s: %d 人\n" % [境界, 弟子成长["境界分布"][境界]]
	报告 += "\n"

	# 战斗统计
	报告 += "四、战斗统计\n"
	报告 += "-".repeat(40) + "\n"
	报告 += "总场次: %d\n" % 战斗统计["总场次"]
	报告 += "胜利: %d (%.1f%%)\n" % [战斗统计["胜利"], 战斗统计["胜利"] / max(战斗统计["总场次"], 1) * 100]
	报告 += "失败: %d (%.1f%%)\n" % [战斗统计["失败"], 战斗统计["失败"] / max(战斗统计["总场次"], 1) * 100]
	报告 += "平均回合数: %.1f\n" % 战斗统计["平均回合数"]
	报告 += "境界胜率:\n"
	for key in 战斗统计["境界胜率"].keys():
		var 数据 = 战斗统计["境界胜率"][key]
		var 总场次 = 数据["胜"] + 数据["负"]
		var 胜率 = 数据["胜"] / max(总场次, 1) * 100
		报告 += "  %s: %.1f%% (%d胜%d负)\n" % [key, 胜率, 数据["胜"], 数据["负"]]
	报告 += "\n"

	# 系统使用
	报告 += "五、系统使用统计\n"
	报告 += "-".repeat(40) + "\n"
	for 系统名 in 系统使用.keys():
		报告 += "%s: %d 次\n" % [系统名, 系统使用[系统名]]
	报告 += "\n"

	报告 += "=".repeat(60) + "\n"
	报告 += "报告结束\n"
	报告 += "=".repeat(60) + "\n"

	return 报告

func 保存报告到文件(文件路径: String) -> bool:
	var 报告 = 导出报告()
	var f = FileAccess.open(文件路径, FileAccess.WRITE)
	if f == null:
		print("[NumericalStats] 保存报告失败: %s" % 文件路径)
		return false
	f.store_string(报告)
	f.close()
	print("[NumericalStats] 报告已保存: %s" % 文件路径)
	return true

func 重置统计() -> void:
	资源收支 = {}
	弟子成长 = {"突破次数": 0, "突破成功": 0, "突破失败": 0, "境界分布": {}, "修炼总天数": 0}
	战斗统计 = {"总场次": 0, "胜利": 0, "失败": 0, "平均回合数": 0.0, "境界胜率": {}}
	时间统计 = {"游戏开始时间": "", "游戏总天数": 0, "游戏总月数": 0, "游戏总年数": 0, "实际游玩时间": 0.0}
	系统使用 = {}
	_记录开始时间 = Time.get_ticks_msec() / 1000.0
	时间统计["游戏开始时间"] = Time.get_datetime_string_from_system()
	print("[NumericalStats] 统计已重置")
