+var _品阶秩: Dictionary = {"凡阶": 0, "灵阶": 1, "宝阶": 2, "王阶": 3, "圣阶": 4, "仙阶": 5, "道阶": 6}
+func _品阶不小于(a: String, b: String) -> bool:
+	var ia: int = _品阶秩.get(a, -1)
