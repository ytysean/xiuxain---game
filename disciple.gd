## 获取当前最迫切的需求
func 获取最迫切需求() -> String:
	var 需求字典: Dictionary = {
		"修炼": 需求修炼,
		"社交": 需求社交,
		"休息": 需求休息,
		"安全": 需求安全
	}
	var 最低需求: String = "修炼"
	var 最低值: float = 100.0
	for 需求 in 需求字典:
		if float(需求字典[需求]) < 最低值:
			最低值 = float(需求字典[需求])
			最低需求 = 需求
	return 最低需求

## 需求衰减（每天调用）
func 需求衰减() -> void:
	需求修炼 = max(0, 需求修炼 - 2)
	需求社交 = max(0, 需求社交 - 3)
	需求休息 = max(0, 需求休息 - 1)
	match 性格:
		"勤奋": 需求修炼 = max(0, 需求修炼 - 1)
		"社交": 需求社交 = max(0, 需求社交 - 1)
		"懒散": 需求休息 = max(0, 需求休息 - 1)
		"谨慎": 需求安全 = max(0, 需求安全 - 0.5)
	match 情绪:
		"喜悦": 需求社交 = min(100, 需求社交 + 5)
		"愤怒": 需求休息 = max(0, 需求休息 - 2)
		"恐惧": 需求安全 = max(0, 需求安全 - 5)
		"悲伤": 需求社交 = max(0, 需求社交 - 5)

## 满足需求
func 满足需求(需求类型: String, 增量: float) -> void:
	match 需求类型:
		"修炼": 需求修炼 = min(100, 需求修炼 + 增量)
		"社交": 需求社交 = min(100, 需求社交 + 增量)
		"休息": 需求休息 = min(100, 需求休息 + 增量)
		"安全": 需求安全 = min(100, 需求安全 + 增量)

