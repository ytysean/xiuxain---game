# 取玄榜
func 取玄榜(类型: String, 指标: String, 范围: String) -> Array:
	# P2 修复：玄榜虚拟宗门原仅在 game_state 的新档/读档分支播种，登录等路径未必经过
	#   → 榜单只剩玩家自己一行，「宗门势力榜」形同虚设。此处兜底（_种子化玄 幂等，非空即直返）。
	_种子化玄()
	var 榜: Array = []
	if 类型 == "个人":
		榜 = _取个人榜数据()
	else:
		榜 = _取宗门榜数据()
	var 带榜: Array = []
	for e in 榜:
		var 分: int = _玄榜指标(e, 指标)
		# P2-3.2 修复（原 bug）：分算完未写入字典，而排序 _玄榜_按值降 与榜单 UI 均读 "值" 键
		#   → 全榜条目值恒为 0、排序等于原顺序、界面所有指标显示 0。此处补写 "值"（排序与展示同源）。
		带榜.append({"名": e.get("名") if "名" in e else "", "称号": e.get("称号") if "称号" in e else "", "自己": e.get("自己") if "自己" in e else false, "值": 分})
	带榜.sort_custom(_玄榜_按值降)
	if 范围 == "本服":
		带榜 = _裁剪到范(带榜, 5)
	elif 范围 == "赛区":
		带榜 = _裁剪到范(带榜, 8)
	return 带榜

func _取个人榜数据() -> Array:
	var 榜: Array = []
	for d in Game.弟子列表:
		if d == null:
			continue
		var 名: String = ""
		if d.姓名 != "":
			名 = "%s·%s" % [Game.宗门名, d.姓名]
		else:
			名 = "%s·%s" % [Game.宗门名, d.道号]
		榜.append({"名": 名, "战力": int(d.战力), "境界值": Disciple.境界序.find(d.境界), "自己": false})
	var 掌门战力: int = _宗主战力()
	榜.append({"名": "%s·%s（你方）" % [Game.宗门名, Game.宗主名], "战力": 掌门战力, "境界值": _宗主境界(), "自己": true})
	return 榜

func _取宗门榜数据() -> Array:
	var 榜: Array = []
	for v in 玄榜虚拟宗门:
		榜.append({"名": v.get("名") if "名" in v else "", "战力": int(v.get("战力") if "战力" in v else 0), "境界值": int(v.get("境界值") if "境界值" in v else 0),
			"功勋": int(v.get("功勋") if "功勋" in v else 0), "探索": int(v.get("探索") if "探索" in v else 0), "商道": int(v.get("商道") if "商道" in v else 0),
			"名望": int(v.get("名望") if "名望" in v else 0), "财富": int(v.get("财富") if "财富" in v else 0),
			"功法": int(v.get("功法") if "功法" in v else 0), "弟子": int(v.get("弟子") if "弟子" in v else 0),
			"丹道": int(v.get("丹道") if "丹道" in v else 0), "器道": int(v.get("器道") if "器道" in v else 0),
			"称号": v.get("称号") if "称号" in v else "", "自己": false})
	var 自己战力: int = _宗门总战()
	# P2优化：计算玩家宗门的新指标
	# 注：game_state 侧仙玉为「绑定/非绑定」双字段，无单一「仙玉」属性。
	#     取二者之和折算财富，避免访问不存在字段触发 Invalid access 中断周结算。
	var 仙玉值: int = (int(Game.仙玉_绑定) + int(Game.仙玉_非绑定)) if Game != null else 0
	# P2-3.2：财富补入门派基业存量（等级越高基业越厚），使口径与虚拟宗门的「累计财富」可比
	var 玩家财富: int = Game.灵石 + 仙玉值 * 100 + Game.门派等级 * 50000  # 仙玉按1:100折算灵石
	var 玩家功法: int = Game.宗门库房.size()  # 库房物品数量作为功法指标（简化）
	var 玩家弟子: int = Game.弟子列表.size()
	var 玩家丹道: int = Game.门派等级 * 10 + 50  # 丹道等级简化为门派等级相关
	var 玩家器道: int = Game.门派等级 * 10 + 45  # 器道等级简化为门派等级相关
	# P2联动：成就点数加分（成就完成率越高，排行榜加分越多）
	var 成就统计: Dictionary = Game.成就系统.获取成就统计() if Game.成就系统 != null else {"完成率": 0.0}
	var 成就完成率: float = float(成就统计.get("完成率", 0.0))
	var 成就加分: int = int(成就完成率 * 10000)  # 完成率100%=10000分
	# P2-3.2：探索接真实探索度真源（世界地图系统 获取探索进度 = 已发现资源点×3 + 已探索秘境×5 + 已探索区域×10），
	#   换算为与虚拟宗门同量级的「探索功业」（×120），再叠加门派规模与成就加成。
	var 探索真实: int = 0
	if Game.世界地图系统 != null and Game.世界地图系统.has_method("获取探索进度"):
		探索真实 = int(Game.世界地图系统.获取探索进度())
	var 探索功业: int = 探索真实 * 120 + Game.门派等级 * 3000 + 成就加分 / 2
	榜.append({"名": "%s（你方）" % Game.宗门名, "战力": 自己战力, "境界值": _宗主境界(),
		"功勋": Game.门派等级 * 8000 + 成就加分, "探索": 探索功业, "商道": Game.门派等级 * 5000, "名望": Game.门派等级 * 7000 + 成就加分,
		"财富": 玩家财富, "功法": 玩家功法, "弟子": 玩家弟子, "丹道": 玩家丹道, "器道": 玩家器道,
		"称号": "正道魁首", "自己": true, "成就加分": 成就加分})
	return 榜

func _玄榜指标(e: Dictionary, 指标: String) -> int:
	match 指标:
		"战力":
			return int(e.get("战力") if "战力" in e else 0)
		"境界":
			return int(e.get("境界值") if "境界值" in e else 0)
		"功勋":
			return int(e.get("功勋") if "功勋" in e else 0)
		"探索":
			return int(e.get("探索") if "探索" in e else 0)
		"商道":
			return int(e.get("商道") if "商道" in e else 0)
		"名望":
			return int(e.get("名望") if "名望" in e else 0)
		# P2优化：新增榜单指标
		"财富":
			return int(e.get("财富") if "财富" in e else 0)
		"功法":
			return int(e.get("功法") if "功法" in e else 0)
		"弟子":
			return int(e.get("弟子") if "弟子" in e else 0)
		"丹道":
			return int(e.get("丹道") if "丹道" in e else 0)
		"器道":
			return int(e.get("器道") if "器道" in e else 0)
	return int(e.get("战力") if "战力" in e else 0)

func _玄榜_按值降(a: Dictionary, b: Dictionary) -> bool:
	return int(a.get("值") if "值" in a else 0) > int(b.get("值") if "值" in b else 0)

func _裁剪到范(带榜: Array, n: int) -> Array:
	if 带榜.size() <= n:
		return 带榜
	var 自己或: Dictionary = {}
	var 含自己: bool = false
	for e in 带榜:
		if e.get("自己") if "自己" in e else false:
			自己或 = e
			含自己 = true
			break
	var 裁剪: Array = 带榜.slice(0, n)
	if 含自己 and not 裁剪.has(自己或):
		裁剪.append(自己或)
	return 裁剪

func _宗门总战() -> int:
	var s: int = 0
	for d in Game.弟子列表:
		if d != null:
			s += int(d.战力)
	return s

func _宗主境界() -> int:
	var mx: int = 0
	for d in Game.弟子列表:
		if d != null:
			var 境界顺序: Array = Disciple.境界序
			var idx: int = 境界顺序.find(d.境界)
			if idx > mx:
				mx = idx
	return mx

func _宗主战力() -> int:
	var mx: int = 0
	for d in Game.弟子列表:
		if d != null:
			if int(d.战力) > mx:
				mx = int(d.战力)
	return mx + Game.门派等级 * 500

func 取玄榜_self(类型: String, 指标: String, 范围: String) -> Dictionary:
	var 榜: Array = 取玄榜(类型, 指标, 范围)
	var rank: int = 0
	var val: int = 0
	for i in range(榜.size()):
		if 榜[i].get("自己", false):
			rank = i + 1
			# P2-3.2 修复（原 bug）：此处硬取 "境界值"，与当前 _指标 无关 → 切换指标时自己分数不变。
			#   改为取与排序同源的 "值"（即当前指标得分）。
			val = int(榜[i].get("值", 0))
			break
	var gap: int = 0
	if rank > 1 and 榜.size() >= rank:
		gap = int(榜[rank - 2].get("值", 0)) - val
	var name: String = "%s（你方）" % Game.宗门名
	if 类型 == "个人":
		name = "%s·%s（你方）" % [Game.宗门名, Game.宗主名]
	return {"rank": rank, "name": name, "val": val, "gap": gap}

# 序列化
func to_dict() -> Dictionary:
	return {
		"玄榜虚拟宗门": 玄榜虚拟宗门,
		"上次结算周": 上次结算周,
	}

# 反序列化
func from_dict(data: Dictionary) -> void:
	玄榜虚拟宗门 = data.get("玄榜虚拟宗门", [])
	上次结算周 = int(data.get("上次结算周", 0))

# P2优化：排行榜每周结算（每7游戏日结算一次）
# 返回：是否结算了，以及玩家的排名和奖励
func 每周结算(当前游戏日: int) -> Dictionary:
	# 检查是否到了结算时间（每7天结算一次）
	if 当前游戏日 - 上次结算周 < 7:
		return {"已结算": false}
	上次结算周 = 当前游戏日
	# 获取宗门战力榜排名
	var 榜: Array = 取玄榜("宗门", "战力", "赛区")  # 赛区前8名
	var 玩家排名: int = 0
	for i in range(榜.size()):
		if 榜[i].get("自己", false):
			玩家排名 = i + 1
			break
	if 玩家排名 <= 0 or 玩家排名 > 8:
		return {"已结算": true, "排名": 玩家排名, "奖励": {}}
	# 获取奖励配置
	var 奖励: Dictionary = 排行榜奖励配置.get(玩家排名, {})
	if 奖励.is_empty():
		return {"已结算": true, "排名": 玩家排名, "奖励": {}}
	# 发放奖励
	var 灵石奖励: int = int(奖励.get("灵石", 0))
	var 声望奖励: int = int(奖励.get("声望", 0))
	var 称号奖励: String = str(奖励.get("称号", ""))
	Game.灵石 += 灵石奖励
	Game.声望 += 声望奖励
	# 返回结算结果
	return {
		"已结算": true,
		"排名": 玩家排名,
		"灵石": 灵石奖励,
		"声望": 声望奖励,
		"称号": 称号奖励,
	}

# ===== P3联动：玄榜跨服排名 → 宗门声望加成 =====
# 根据玄榜排名获取宗门声望加成（排名越高，声望加成越多）
func 获取玄榜声望加成() -> float:
	var 榜: Array = 取玄榜("宗门", "战力", "赛区")
	var 玩家排名: int = 0
	for i in range(榜.size()):
		if 榜[i].get("自己", false):
			玩家排名 = i + 1
			break
	if 玩家排名 <= 0:
		return 0.0
	# 排名加成：第1名+20%，第2名+15%，第3名+10%，第4-8名+5%
	var 排名加成: Dictionary = {
		1: 0.20,
		2: 0.15,
		3: 0.10,
		4: 0.05,
		5: 0.05,
		6: 0.05,
		7: 0.05,
		8: 0.05,
	}
	return float(排名加成.get(玩家排名, 0.0))

# 获取玄榜排名称号（修真化描述）
func 获取玄榜排名称号() -> String:
	var 榜: Array = 取玄榜("宗门", "战力", "赛区")
	var 玩家排名: int = 0
	for i in range(榜.size()):
		if 榜[i].get("自己", false):
			玩家排名 = i + 1
			break
	match 玩家排名:
		1:
			return "玄榜魁首"
		2:
			return "玄榜亚魁"
		3:
			return "玄榜探花"
		4, 5, 6, 7, 8:
			return "玄榜上榜"
		_:
			return "玄榜无名"
