## 获取矿脉矿点数量（按等级）
static func 获取矿点数(矿脉等级: int) -> int:
	return 3 + max(0, 矿脉等级 - 1)  # 1级3个，每升1级+1个

## 初始化矿脉数据（如果不存在）
static func 初始化(矿脉等级: int) -> Array:
	var 矿点数 = 获取矿点数(矿脉等级)
	var 矿点: Array = []
	for i in range(矿点数):
		矿点.append({"索引": i, "状态": "空闲", "开采ID": "", "开采时间": 0, "完成时间": 0})
	return 矿点

## 检查矿点是否开采完成
static func 是否完成(矿点: Dictionary, 当前天: int) -> bool:
	if str(矿点.get("状态", "")) != "开采中":
		return false
	return 当前天 >= int(矿点.get("完成时间", 0))

## 开始开采
## 返回：{成功, 原因}
static func 开采(矿点列表: Array, 矿点索引: int, 矿石ID: String, 当前天: int, 矿脉等级: int) -> Dictionary:
	if 矿点索引 < 0 or 矿点索引 >= 矿点列表.size():
		return {"成功": false, "原因": "矿点不存在"}
	var 矿点 = 矿点列表[矿点索引]
	if str(矿点.get("状态", "")) != "空闲":
		return {"成功": false, "原因": "该矿点已在开采中"}
	var 矿石 = 矿石库.get(矿石ID, {})
	if 矿石.is_empty():
		return {"成功": false, "原因": "未知矿石"}
	var 开采天数 = int(矿石.get("开采天数", 1))
	矿点["状态"] = "开采中"
	矿点["开采ID"] = 矿石ID
	矿点["开采时间"] = 当前天
	矿点["完成时间"] = 当前天 + 开采天数
	return {"成功": true, "原因": "已开采%s，%d天后完成" % [str(矿石.get("名称","")), 开采天数]}

## 收获矿石
## 返回：{成功, 产出物品(Item/null), 数量, 原因}
static func 收获(矿点列表: Array, 矿点索引: int, 当前天: int, 矿脉等级: int) -> Dictionary:
	if 矿点索引 < 0 or 矿点索引 >= 矿点列表.size():
		return {"成功": false, "产出": null, "数量": 0, "原因": "矿点不存在"}
	var 矿点 = 矿点列表[矿点索引]
	if str(矿点.get("状态", "")) != "开采中":
		return {"成功": false, "产出": null, "数量": 0, "原因": "该矿点未在开采"}
	if not 是否完成(矿点, 当前天):
		var 剩余 = int(矿点.get("完成时间", 0)) - 当前天
		return {"成功": false, "产出": null, "数量": 0, "原因": "尚未完成，还需%d天" % 剩余}
	var 矿石ID = str(矿点.get("开采ID", ""))
	var 矿石 = 矿石库.get(矿石ID, {})
	if 矿石.is_empty():
		return {"成功": false, "产出": null, "数量": 0, "原因": "未知矿石"}
	# 计算产量：基础产量 + 矿脉等级加成（每级+10%）
	var 基础产量 = int(矿石.get("基础产量", 1))
	var 产量加成 = 1.0 + float(max(0, 矿脉等级 - 1)) * 0.1
	var 实际产量 = max(1, int(round(float(基础产量) * 产量加成)))
	# 创建物品
	var 新品 = Item.new()
	新品.类别 = "ling_cai"  # 矿石归为灵材类（材料通用）
	新品.品阶 = str(矿石.get("品阶", "凡阶"))
	新品.名称 = str(矿石.get("名称", ""))
	新品.功效 = "矿脉开采的%s" % 新品.名称
	新品.描述 = str(矿石.get("名称", ""))
	新品.战力加成 = 0
	新品.算战力()
	# 重置矿点
	矿点["状态"] = "空闲"
	矿点["开采ID"] = ""
	矿点["开采时间"] = 0
	矿点["完成时间"] = 0
	return {"成功": true, "产出": 新品, "数量": 实际产量, "原因": "收获%s×%d" % [新品.名称, 实际产量]}
