extends Node

const 码位: Array = [
	0x25C6, 0x25C7, 0x25CF, 0x25CB, 0x25A0, 0x25A1, 0x25B2, 0x25BC, 0x25B8, 0x25C0, 0x25B6, 0x2605, 0x2606, 0x00D7, 0x2713, 0x203B, 0x221A, 0x2014, 0x2013, 0x00B7, 0xFF0B, 0x2192, 0x2190, 0x2191, 0x2193, 0x26A0, 0x2B50, 0x2726, 0x2717, 0x3001, 0x300C, 0x3010, 0x2500, 0x2502, 0x2514, 0x251C, 0x2022, 0x00A7, 0x00B0, 0x2260, 0x2264, 0x2265, 0x00B1, 0x2194, 0x21D2, 0x00AB, 0x00BB, 0x300A, 0x300B, 0x25EF, 0x2B1B, 0x2B1C, 0x2B24, 0x23F3, 0x23F0, 0x2694, 0x2697, 0x26CF, 0x26A1, 0x2705, 0x274C, 0x2611, 0x2610, 0x2795, 0x2796, 0x2716, 0x2718, 0x2714, 0x2709, 0x2764, 0x2B06, 0x2B07
]

const 字体路径: Array = [
	"res://art/fonts/SourceHanSansCN-Regular.otf",
]


func _ready() -> void:
	print(">>>CAND_BEGIN n=%d" % 码位.size())
	for 路径 in 字体路径:
		var ff: FontFile = FontFile.new()
		if ff.load_dynamic_font(路径) != OK:
			print(">>>FONT_FAIL %s" % 路径)
			continue
		var 有列表: Array = []
		var 无列表: Array = []
		for c in 码位:
			if ff.has_char(c):
				有列表.append("U+%04X" % c)
			else:
				无列表.append("U+%04X" % c)
		print(">>>CAND_YES %s" % "、".join(有列表))
		print(">>>CAND_NO %s" % "、".join(无列表))
	print(">>>CAND_END")
	get_tree().quit()

