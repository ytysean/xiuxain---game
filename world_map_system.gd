# ===== 宗门位置管理 =====
# 随机分配宗门位置（创建宗门时调用）
func 随机分配宗门位置() -> Dictionary:
	# 随机选择区域（中州概率稍高，因为是新手区）
	var 区域权重: Dictionary = {
		区域_中州: 0.35,
		区域_东域: 0.20,
		区域_西域: 0.15,
		区域_南疆: 0.15,
		区域_北域: 0.15,
	}
	var 随机值: float = randf()
	var 累计: float = 0.0
	var 选中区域: String = 区域_中州
	for 区域 in 所有区域:
		累计 += float(区域权重.get(区域, 0.2))
		if 随机值 <= 累计:
			选中区域 = 区域
			break

	# 在区域内随机坐标（域内口径 ±200）；上限再按本域画布框半宽/半高收敛（留 60 余量），
	#   避免宗门贴到本域板边缘 —— 贴边会让初始揭示圈一半落在板外，且山门左近点位溢出板外。
	var 限X: float = 200.0
	var 限Y: float = 200.0
	var 范围: Dictionary = 区域逻辑范围.get(选中区域, {})
	if not 范围.is_empty():
		限X = maxf(40.0, minf(200.0, (float(范围["x2"]) - float(范围["x1"])) * 0.5 - 60.0))
		限Y = maxf(40.0, minf(200.0, (float(范围["y2"]) - float(范围["y1"])) * 0.5 - 60.0))
	var x: float = randf_range(-限X, 限X)
	var y: float = randf_range(-限Y, 限Y)

	宗门区域 = 选中区域
	宗门坐标X = x
	宗门坐标Y = y

	return {"区域": 选中区域, "x": x, "y": y}

# 设置宗门位置
func 设置宗门位置(区域: String, x: float, y: float) -> void:
	宗门区域 = 区域
	宗门坐标X = x
	宗门坐标Y = y

# S58-P1：宗门迁移
# 消耗：灵石10000 + 灵晶5，冷却30游戏日
# 迁移后宗门位置改变，影响商路距离和区域加成
func 迁移宗门(目标区域: String, 目标x: float, 目标y: float) -> Dictionary:
	# 冷却检查
	if Game.累计游戏日 < 迁移冷却日:
		return {"成功": false, "原因": "宗门大阵尚未恢复，还需%d日方可再次迁移" % (迁移冷却日 - Game.累计游戏日)}
	# 区域校验
	if 目标区域 not in 所有区域:
		return {"成功": false, "原因": "未知区域"}
	# 资源校验
	var 迁移费用: int = 10000
	var 灵晶费用: int = 5
	if Game.灵石 < 迁移费用:
		return {"成功": false, "原因": "灵石不足，需%d灵石" % 迁移费用}
	if Game.仙玉_绑定 < 灵晶费用 and Game.仙玉_非绑定 < 灵晶费用:
		return {"成功": false, "原因": "灵晶不足，需%d灵晶" % 灵晶费用}
	# 扣除资源
	Game.灵石 -= 迁移费用
	if Game.仙玉_非绑定 >= 灵晶费用:
		Game.仙玉_非绑定 -= 灵晶费用
	else:
		var 余: int = 灵晶费用 - Game.仙玉_非绑定
		Game.仙玉_非绑定 = 0
		Game.仙玉_绑定 -= 余
	# 执行迁移
	var 旧区域: String = 宗门区域
	宗门区域 = 目标区域
	宗门坐标X = 目标x
	宗门坐标Y = 目标y
	迁移冷却日 = Game.累计游戏日 + 30
	# 纪事
	Game.添加纪事("神异", "宗门迁移", "太玄宗举宗迁移，从%s迁至%s，大阵耗灵无数，三十日内不可再动。" % [旧区域, 目标区域], 3)
	return {"成功": true, "原因": "宗门迁移成功，新址：%s(%.0f, %.0f)" % [目标区域, 目标x, 目标y]}

# 获取迁移消耗
func 获取迁移消耗() -> Dictionary:
	return {"灵石": 10000, "灵晶": 5, "冷却日": 30}

# 获取迁移冷却剩余
func 获取迁移冷却剩余() -> int:
	return max(0, 迁移冷却日 - Game.累计游戏日)

# 获取宗门位置
func 获取宗门位置() -> Dictionary:
	return {"区域": 宗门区域, "x": 宗门坐标X, "y": 宗门坐标Y}

# ===== 距离计算 =====
# 计算两点之间的距离
func 计算距离(x1: float, y1: float, x2: float, y2: float) -> float:
	var dx: float = x2 - x1
	var dy: float = y2 - y1
	return sqrt(dx * dx + dy * dy)

# 计算宗门到城镇的距离
func 计算到城镇距离(城镇ID: String) -> float:
	if 城镇ID not in 城镇坐标表:
		return 999.0
	var 城镇: Dictionary = 城镇坐标表[城镇ID]
	return 计算距离(宗门坐标X, 宗门坐标Y, float(城镇["x"]), float(城镇["y"]))

# 计算两个宗门之间的距离
func 计算宗门间距离(区域1: String, x1: float, y1: float, 区域2: String, x2: float, y2: float) -> float:
	# 同区域直接计算
	if 区域1 == 区域2:
		return 计算距离(x1, y1, x2, y2)
	# 跨区域增加额外距离（区域间有山川阻隔）
	var 基础距离: float = 计算距离(x1, y1, x2, y2)
	var 区域距离加成: Dictionary = {
		区域_中州: {区域_东域: 50, 区域_西域: 50, 区域_南疆: 80, 区域_北域: 80},
		区域_东域: {区域_中州: 50, 区域_西域: 100, 区域_南疆: 60, 区域_北域: 120},
		区域_西域: {区域_中州: 50, 区域_东域: 100, 区域_南疆: 100, 区域_北域: 60},
		区域_南疆: {区域_中州: 80, 区域_东域: 60, 区域_西域: 100, 区域_北域: 150},
		区域_北域: {区域_中州: 80, 区域_东域: 120, 区域_西域: 60, 区域_南疆: 150},
	}
	var 加成: float = 0.0
	if 区域1 in 区域距离加成 and 区域2 in 区域距离加成[区域1]:
		加成 = float(区域距离加成[区域1][区域2])
	return 基础距离 + 加成

# ===== 运输时间计算 =====
# 根据距离计算运输时间（游戏日）
func 计算运输时间(距离: float, 运输方式: String) -> int:
	var 基础速度: float = 20.0  # 每日行进20距离单位
	match 运输方式:
		"普通商队":
			基础速度 = 15.0
		"精锐商队":
			基础速度 = 30.0
		"传送阵":
			return 0  # 实时送达
	var 时间: float = 距离 / 基础速度
	return max(1, int(ceil(时间)))

# S58-P2：计算宗门战行军时间（游戏日）
# 基础速度：每日行进25距离单位，跨区域增加50%时间
func 计算行军时间(目标区域: String, 目标x: float, 目标y: float) -> int:
	var 距离: float = 计算宗门间距离(宗门区域, 宗门坐标X, 宗门坐标Y, 目标区域, 目标x, 目标y)
	var 基础速度: float = 25.0  # 大军每日行进25距离单位
	var 时间: float = 距离 / 基础速度
	# 跨区域行军增加50%时间（翻山越岭，补给困难）
	if 目标区域 != 宗门区域:
		时间 *= 1.5
	return max(1, int(ceil(时间)))

# S58-P2：计算宗门战行军消耗（灵石）
# 基础消耗：每日100灵石，跨区域增加50%
func 计算行军消耗(目标区域: String, 目标x: float, 目标y: float) -> int:
	var 行军日: int = 计算行军时间(目标区域, 目标x, 目标y)
	var 基础消耗: int = 行军日 * 100
	# 跨区域增加50%消耗
	if 目标区域 != 宗门区域:
		基础消耗 = int(基础消耗 * 1.5)
	return 基础消耗

# 根据距离计算被劫风险
func 计算被劫风险(距离: float, 运输方式: String) -> float:
	var 基础风险: float = 距离 / 500.0  # 每500距离增加10%风险
	match 运输方式:
		"普通商队":
			基础风险 *= 1.5
		"精锐商队":
			基础风险 *= 0.5
		"传送阵":
			return 0.0
	return clamp(基础风险, 0.05, 0.6)

# ===== 周边城镇查询 =====
# 获取周边城镇（按距离排序）
func 获取周边城镇(数量: int = 5) -> Array:
	var 城镇列表: Array = []
	for 城镇ID in 城镇坐标表.keys():
		var 城镇: Dictionary = 城镇坐标表[城镇ID]
		var 距离: float = 计算到城镇距离(城镇ID)
		城镇列表.append({"id": 城镇ID, "名称": 城镇["名称"], "区域": 城镇["区域"], "距离": 距离})
	# 按距离排序
	城镇列表.sort_custom(func(a, b): return a["距离"] < b["距离"])
	return 城镇列表.slice(0, min(数量, 城镇列表.size()))

# ===== 区域特性 =====
func 获取当前区域特性() -> Dictionary:
	return 区域特性.get(宗门区域, {})

func 获取区域特性(区域: String) -> Dictionary:
	return 区域特性.get(区域, {})

# ===== 模拟其他宗门（用于大地图显示）=====
func 生成模拟宗门(数量: int = 20) -> void:
	其他宗门列表.clear()
	var 宗门名前缀: Array = ["天", "地", "玄", "黄", "宇", "宙", "洪", "荒", "日", "月", "盈", "昃", "辰", "宿", "列", "张"]
	# 注：不含「玄宗」后缀 —— 避免与玩家宗门「太玄宗」近似撞名（天玄宗/玄玄宗易误认）。
	var 宗门名后缀: Array = ["剑宗", "丹宗", "符宗", "器宗", "灵宗", "仙宗", "魔宗", "佛门", "道门", "儒门", "妖族"]
	for i in range(数量):
		var 区域: String = 所有区域[randi() % 所有区域.size()]
		var x: float = randf_range(-200.0, 200.0)
		var y: float = randf_range(-200.0, 200.0)
		var 名称: String = 宗门名前缀[randi() % 宗门名前缀.size()] + 宗门名后缀[randi() % 宗门名后缀.size()]
		var 战力: int = randi_range(1000, 50000)
		var 距离: float = 计算宗门间距离(宗门区域, 宗门坐标X, 宗门坐标Y, 区域, x, y)
		其他宗门列表.append({"名称": 名称, "区域": 区域, "x": x, "y": y, "战力": 战力, "距离": 距离})
	# 按距离排序
	其他宗门列表.sort_custom(func(a, b): return a["距离"] < b["距离"])

# ===== 存档/读档 =====
func to_dict() -> Dictionary:
	return {
		"宗门区域": 宗门区域,
		"宗门坐标X": 宗门坐标X,
		"宗门坐标Y": 宗门坐标Y,
		"其他宗门列表": 其他宗门列表,
		"迁移冷却日": 迁移冷却日,
		"已探索秘境": 已探索秘境,
		"事件冷却日": 事件冷却日,
		"今日已触发事件数": 今日已触发事件数,
		"事件历史": 事件历史,
		"资源点列表": 资源点列表,
		"资源采集记录": 资源采集记录,
		"今日采集次数": 今日采集次数,
	"探索中弟子": 探索中弟子,
	"城镇通商记录": 城镇通商记录,
		"化身游历足迹": 化身游历足迹,
		"已探索区域": 已探索区域,
		"累计采集次数": 累计采集次数,
		"宗门结交记录": 宗门结交记录,
		"附近频道记录": 附近频道记录,
		"已探索网格": 已探索网格,
	}

func from_dict(data: Dictionary) -> void:
	宗门区域 = str(data.get("宗门区域", 区域_中州))
	宗门坐标X = float(data.get("宗门坐标X", 0.0))
	宗门坐标Y = float(data.get("宗门坐标Y", 0.0))
	其他宗门列表 = data.get("其他宗门列表", [])
	迁移冷却日 = int(data.get("迁移冷却日", 0))
	已探索秘境 = data.get("已探索秘境", [])
	事件冷却日 = int(data.get("事件冷却日", 0))
	今日已触发事件数 = int(data.get("今日已触发事件数", 0))
	事件历史 = data.get("事件历史", [])
	资源点列表 = data.get("资源点列表", [])
	资源采集记录 = data.get("资源采集记录", {})
	今日采集次数 = data.get("今日采集次数", {})
	探索中弟子 = data.get("探索中弟子", {})
	城镇通商记录 = data.get("城镇通商记录", {})
	化身游历足迹 = data.get("化身游历足迹", {})
	已探索区域 = data.get("已探索区域", [])
	累计采集次数 = int(data.get("累计采集次数", 0))
	宗门结交记录 = data.get("宗门结交记录", {})
	附近频道记录 = data.get("附近频道记录", [])
	已探索网格 = data.get("已探索网格", {})
	# 如果没有位置，随机分配
	if 宗门坐标X == 0.0 and 宗门坐标Y == 0.0 and 其他宗门列表.is_empty():
		随机分配宗门位置()
		生成模拟宗门(20)
	# 如果没有资源点，初始化
	if 资源点列表.is_empty():
		初始化周边资源点()   # 内部已含 勘明山门左近()
	else:
		# 老档自愈 A：2026-09-14 前的存档里山门左近资源点一律未勘明（地图图例因此形同虚设），
		#   此处补勘一次；幂等，已勘明者不受影响。
		勘明山门左近()
	# 老档自愈 B：坐标口径迁移。旧档「宗门左近·」系列资源点存的是域内口径（±200），
	#   新口径统一为全局口径；按 坐标系 字段一次性抬升（幂等，抬升后打标不再重复）。
	var 迁: int = 0
	for 资源点 in 资源点列表:
		if str(资源点.get("坐标系", "")) == "全局":
			continue
		if str(资源点.get("名称", "")).begins_with("宗门左近·"):
			var 全: Vector2 = 域内坐标转全局(宗门区域, float(资源点.get("x", 0.0)), float(资源点.get("y", 0.0)))
			资源点["x"] = 全.x
			资源点["y"] = 全.y
			迁 += 1
		资源点["坐标系"] = "全局"

