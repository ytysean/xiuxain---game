# ===== S53 副宗主代拍系统 =====
# 检查是否可以代拍（月卡/VIP功能 + 代管权能开启）
func _可代拍_S53() -> bool:
	# 检查代管权能
	if not Game.代管权能.get("拍卖代拍", false):
		return false
	# 检查代拍方略是否启用
	if not Game.代拍方略.get("启用", false):
		return false
	# 检查是否有副宗主
	if Game.副宗主弟子ID < 0:
		return false
	# 检查预算
	var 已花费: int = int(Game.代拍方略.get("已花费", 0))
	var 总预算: int = int(Game.代拍方略.get("总预算上限", 0))
	if 已花费 >= 总预算:
		return false
	return true

# 副宗主AI竞价（大拍期间自动调用）
func _副宗主代拍竞价_S53() -> void:
	if not _可代拍_S53():
		return
	var 方略: Dictionary = Game.代拍方略
	var 可代拍品类: Array = 方略.get("可代拍品类", [])
	var 最低品阶: String = 方略.get("最低品阶", "宝阶")
	var 单件上限: int = int(方略.get("单件出价上限", 5000))
	var 优先策略: String = 方略.get("优先策略", "品阶优先")
	var 品阶序: Array = ["凡阶", "灵阶", "宝阶", "王阶", "圣阶", "仙阶", "道阶"]
	var 最低品阶序: int = 品阶序.find(最低品阶)
	if 最低品阶序 < 0:
		最低品阶序 = 2  # 默认宝阶
	# 遍历大拍拍品，寻找符合条件的物品
	for lot in (拍卖会.get("大拍拍品", []) as Array):
		if lot.get("状态", "") != "竞拍中":
			continue
		var 品类: String = str(lot.get("品类", ""))
		var 品阶: String = str(lot.get("品阶", ""))
		var 品阶idx: int = 品阶序.find(品阶)
		# 检查品类和品阶
		if 品类 not in 可代拍品类 and 品类 != "玩家寄售":
			continue
		if 品阶idx < 最低品阶序:
			continue
		# 检查是否已经出价
		var 已出价: bool = false
		for b in (lot.get("委托列表", []) as Array):
			if str(b.get("委托者类型", "")) == "副宗主":
				已出价 = true
				break
		if 已出价:
			continue
		# 评估价值
		var 系统估价: int = int(lot.get("基准估值", lot.get("起拍价", 100)))
		var 当前价: int = int(lot.get("当前价", lot.get("起拍价", 100)))
		# 根据优先策略决定出价上限
		var 出价上限: int = 单件上限
		match 优先策略:
			"品阶优先":
				# 高品阶可以追到估价150%
				if 品阶idx >= 4:  # 圣阶及以上
					出价上限 = min(单件上限, int(float(系统估价) * 1.5))
				else:
					出价上限 = min(单件上限, int(float(系统估价) * 1.2))
			"价格优先":
				# 只在估价120%以内出价
				出价上限 = min(单件上限, int(float(系统估价) * 1.2))
			"品类优先":
				# 指定品类可以追到估价180%
				出价上限 = min(单件上限, int(float(系统估价) * 1.8))
		# 检查预算
		var 已花费: int = int(Game.代拍方略.get("已花费", 0))
		var 总预算: int = int(Game.代拍方略.get("总预算上限", 0))
		if 已花费 + 出价上限 > 总预算:
			出价上限 = 总预算 - 已花费
		if 出价上限 <= 当前价:
			continue
		# 副宗主出价（模拟真实玩家，加价10%）
		var 出价: int = min(出价上限, int(float(当前价) * 1.1) + 1)
		if 出价 > 出价上限:
			出价 = 出价上限
		# 记录委托
		var 委托: Dictionary = {
			"委托者类型": "副宗主",
			"委托者ID": Game.副宗主弟子ID,
			"委托者姓名": "副宗主",
			"出价": 出价,
			"状态": "有效",
		}
		(lot["委托列表"] as Array).append(委托)
		lot["当前价"] = 出价
		lot["最高出价者"] = "副宗主"
		lot["最高出价"] = 出价
		# 冻结灵石（从宗门灵石扣除）
		Game.灵石 -= 出价
		lot["副宗主冻结灵石"] = 出价
		# 记录代拍行为
		var 记录: Dictionary = {
			"日期": Game.累计游戏日,
			"物品": str(lot.get("名称", "")),
			"品阶": 品阶,
			"出价": 出价,
			"估价": 系统估价,
			"状态": "竞价中",
		}
		(Game.代拍方略["代拍记录"] as Array).append(记录)
		Game.添加纪事("拍卖", "副宗主代拍", "副宗主依代拍方略，为%s出价%d灵石。" % [str(lot.get("名称", "")), 出价], 1)

# 代拍结算（拍品成交时调用）
func _代拍结算_S53(lot: Dictionary) -> void:
	var 最高者: String = str(lot.get("最高出价者", ""))
	if 最高者 != "副宗主":
		# 未竞得，解冻灵石
		var 冻结: int = int(lot.get("副宗主冻结灵石", 0))
		if 冻结 > 0:
			Game.灵石 += 冻结
			lot["副宗主冻结灵石"] = 0
		# 更新记录
		for r in (Game.代拍方略.get("代拍记录", []) as Array):
			if str(r.get("物品", "")) == str(lot.get("名称", "")) and r.get("状态", "") == "竞价中":
				r["状态"] = "未竞得"
				r["原因"] = "被高价截胡"
		return
	# 竞得，扣除灵石（已冻结）
	var 成交价: int = int(lot.get("最高出价", 0))
	Game.代拍方略["已花费"] = int(Game.代拍方略.get("已花费", 0)) + 成交价
	# 物品入宗门库房
	var it_dict: Dictionary = lot.get("物品", {})
	if it_dict.is_empty():
		# 生成物品
		var it: Item = Item.new()
		it.名称 = str(lot.get("名称", ""))
		it.品阶 = str(lot.get("品阶", "凡阶"))
		it.类别 = str(lot.get("类别", "法器"))
		it.战力加成 = int(lot.get("战力加成", 0))
		Game.宗门库房.append(it)
	else:
		var it: Item = Item.new()
		it.from_dict(it_dict)
		Game.宗门库房.append(it)
	# 更新记录
	for r in (Game.代拍方略.get("代拍记录", []) as Array):
		if str(r.get("物品", "")) == str(lot.get("名称", "")) and r.get("状态", "") == "竞价中":
			r["状态"] = "已竞得"
			r["成交价"] = 成交价
	# 纪事
	Game.添加纪事("拍卖", "代拍成功", "副宗主代拍成功，以%d灵石竞得%s，物品已入宗门库房。" % [成交价, str(lot.get("名称", ""))], 2)

# 设置代拍方略
func 设置代拍方略_S53(方略: Dictionary) -> Dictionary:
	# 检查月卡/VIP权限（简化版，实际可接入VIP系统）
	if Game.门派等级 < 2:
		return {"成功": false, "原因": "宗门品级不足二品，暂不可使用代拍功能"}
	# 更新方略
	for k in 方略.keys():
		if Game.代拍方略.has(k):
			Game.代拍方略[k] = 方略[k]
	# 如果启用代拍，自动开启代管权能
	if Game.代拍方略.get("启用", false):
		Game.代管权能["拍卖代拍"] = true
	return {"成功": true, "原因": "代拍方略已设置"}

# 获取代拍报告（玩家上线时调用）
func 获取代拍报告_S53() -> Dictionary:
	var 记录: Array = Game.代拍方略.get("代拍记录", [])
	var 已竞得: Array = []
	var 未竞得: Array = []
	var 竞价中: Array = []
	for r in 记录:
		match r.get("状态", ""):
			"已竞得":
				已竞得.append(r)
			"未竞得":
				未竞得.append(r)
			"竞价中":
				竞价中.append(r)
	return {
		"已竞得": 已竞得,
		"未竞得": 未竞得,
		"竞价中": 竞价中,
		"总花费": Game.代拍方略.get("已花费", 0),
		"剩余预算": int(Game.代拍方略.get("总预算上限", 0)) - int(Game.代拍方略.get("已花费", 0)),
		"启用": Game.代拍方略.get("启用", false),
	}
