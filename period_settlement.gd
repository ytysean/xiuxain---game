class_name PeriodSettlement
extends RefCounted

# 周期结算评分（年结：游戏年 = 365 日）
# 三大维度综合计分，按「门派等级期望」归一化后用同段位基准线绝对分判级 D~SSS。
# 所有权重 / 阈值 / 期望均为可配常量，调参无需改逻辑。
# 联网版接入时，仅需将「归一化期望」替换为「全服同段位玩家排名占比」，判级逻辑不变。

const 评级序: Array = ["D", "C", "B", "A", "A+", "S", "SS", "SSS"]

# 维度权重（合计 1.0）—— 2026-09 扩展：加入宗主成长、宗门技艺、洞府建设、综合底蕴
const 权重: Dictionary = {
	"经营": 0.15,
	"收益": 0.20,
	"弟子": 0.20,
	"宗主": 0.10,
	"技艺": 0.10,
	"洞府": 0.10,
	"底蕴": 0.15,
}

# 评级阈值（总分 → 最低评级）。分数已按「门派等级期望」归一化，
# 故阈值与等级无关（等级差异已在前置归一化中消除），实现
# 「同段位横向对比、等级高不直接等于评级高」的核心诉求。
const 评级阈值: Dictionary = {
	"SSS": 108.0,
	"SS": 95.0,
	"S": 82.0,
	"A+": 70.0,
	"A": 58.0,
	"B": 45.0,
	"C": 30.0,
	"D": 0.0,
}

# 本期计数器（年由 Game 在各事件点调用 记X() 累加，结算后清零）
var 计数: Dictionary = {
	"灵石获取": 0,
	"稀有道具": 0,
	"突破": 0,
	"高品质新弟子": 0,
	"首通": 0,
}

# 历史周期评级（近 12，最新在末尾）
var 历史: Array = []

func 记灵石获取(n: int = 1):
	计数["灵石获取"] += n

func 记稀有道具(n: int = 1):
	计数["稀有道具"] += n

func 记突破(n: int = 1):
	计数["突破"] += n

func 记高品质新弟子(n: int = 1):
	计数["高品质新弟子"] += n

func 记首通(n: int = 1):
	计数["首通"] += n

# 期望基准（按门派等级缩放），用于归一化。可调。
func _期望(等级: int) -> Dictionary:
	var L: int = max(1, 等级)
	var 表: Dictionary = {
		"资源产能": 100 * L,
		"灵石增量": 500 * L,
		"稀有道具": 3 * L,
		"首通": 2 * L,
		"总战力增量": 200 * L,
		"突破": 2 * L,
		"高品质新弟子": 1 * L,
		# 新增维度期望
		"宗主战力增量": 100 * L,
		"宗主境界提升": 0.5 * L,
		"技艺殿阁等级": 2 * L,
		"高阶产出": 1 * L,
		"洞府数量": 3 * L,
		"灵田等级": 2 * L,
		# 综合底蕴维度期望（毒道/傀儡/休闲/飞升/世界探索）
		"毒道境界": 1 * L,
		"傀儡数量": 2 * L,
		"休闲等级": 3 * L,
		"飞升弟子": 0.5 * L,
		"世界探索度": 5 * L,
	}
	return 表

# 单维度归一化得分（封顶 120%）
func _归一(实际: float, 期望: float) -> float:
	if 期望 <= 0.0:
		return 0.0
	return min(实际 / 期望, 1.2)

# 主结算：入参 快照 = {资源产能, 灵石增量, 总战力增量, 宗主战力增量, 宗主境界提升, 技艺殿阁等级, 高阶产出, 洞府数量, 灵田等级}
func 结算(门派等级: int, 快照: Dictionary) -> Dictionary:
	var 期望: Dictionary = _期望(门派等级)
	# 经营建设分（资源产能能力）
	var 经营分: float = _归一(float(快照.get("资源产能", 0)), float(期望["资源产能"])) * float(权重["经营"]) * 100.0
	# 收益积累分（灵石增量 + 稀有道具 + 首通）
	var 收益分: float = (
		_归一(float(快照.get("灵石增量", 0)), float(期望["灵石增量"])) * 0.5 +
		_归一(float(计数["稀有道具"]), float(期望["稀有道具"])) * 0.3 +
		_归一(float(计数["首通"]), float(期望["首通"])) * 0.2
	) * float(权重["收益"]) * 100.0
	# 弟子发展分（总战力增量 + 突破 + 高品质新弟子）
	var 弟子分: float = (
		_归一(float(快照.get("总战力增量", 0)), float(期望["总战力增量"])) * 0.5 +
		_归一(float(计数["突破"]), float(期望["突破"])) * 0.3 +
		_归一(float(计数["高品质新弟子"]), float(期望["高品质新弟子"])) * 0.2
	) * float(权重["弟子"]) * 100.0
	# 宗主成长分（宗主战力增量 + 宗主境界提升）—— 宗主双角色系统
	var 宗主分: float = (
		_归一(float(快照.get("宗主战力增量", 0)), float(期望["宗主战力增量"])) * 0.6 +
		_归一(float(快照.get("宗主境界提升", 0)), float(期望["宗主境界提升"])) * 0.4
	) * float(权重["宗主"]) * 100.0
	# 宗门技艺分（技艺殿阁等级 + 高阶产出）—— 炼丹/炼器/制符系统
	var 技艺分: float = (
		_归一(float(快照.get("技艺殿阁等级", 0)), float(期望["技艺殿阁等级"])) * 0.5 +
		_归一(float(快照.get("高阶产出", 0)), float(期望["高阶产出"])) * 0.5
	) * float(权重["技艺"]) * 100.0
	# 洞府建设分（洞府数量 + 灵田等级）—— 个人洞府灵田系统
	var 洞府分: float = (
		_归一(float(快照.get("洞府数量", 0)), float(期望["洞府数量"])) * 0.6 +
		_归一(float(快照.get("灵田等级", 0)), float(期望["灵田等级"])) * 0.4
	) * float(权重["洞府"]) * 100.0
	# 综合底蕴分（毒道境界 + 傀儡数量 + 休闲等级 + 飞升弟子 + 世界探索度）—— 新增系统综合评估
	var 底蕴分: float = (
		_归一(float(快照.get("毒道境界", 0)), float(期望["毒道境界"])) * 0.25 +
		_归一(float(快照.get("傀儡数量", 0)), float(期望["傀儡数量"])) * 0.20 +
		_归一(float(快照.get("休闲等级", 0)), float(期望["休闲等级"])) * 0.20 +
		_归一(float(快照.get("飞升弟子", 0)), float(期望["飞升弟子"])) * 0.20 +
		_归一(float(快照.get("世界探索度", 0)), float(期望["世界探索度"])) * 0.15
	) * float(权重["底蕴"]) * 100.0
	var 总分: float = 经营分 + 收益分 + 弟子分 + 宗主分 + 技艺分 + 洞府分 + 底蕴分
	var 评级: String = _判级(总分)
	var 卡: Dictionary = {
		"周期": 历史.size() + 1,
		"总分": int(round(总分)),
		"评级": 评级,
		"分维度": {
			"经营": int(round(经营分)),
			"收益": int(round(收益分)),
			"弟子": int(round(弟子分)),
			"宗主": int(round(宗主分)),
			"技艺": int(round(技艺分)),
			"洞府": int(round(洞府分)),
			"底蕴": int(round(底蕴分)),
		},
		"明细": {
			"资源产能": int(快照.get("资源产能", 0)),
			"灵石增量": int(快照.get("灵石增量", 0)),
			"总战力增量": int(快照.get("总战力增量", 0)),
			"稀有道具": 计数["稀有道具"],
			"首通": 计数["首通"],
			"突破": 计数["突破"],
			"高品质新弟子": 计数["高品质新弟子"],
			"宗主战力增量": int(快照.get("宗主战力增量", 0)),
			"宗主境界提升": int(快照.get("宗主境界提升", 0)),
			"技艺殿阁等级": int(快照.get("技艺殿阁等级", 0)),
			"高阶产出": int(快照.get("高阶产出", 0)),
			"洞府数量": int(快照.get("洞府数量", 0)),
			"灵田等级": int(快照.get("灵田等级", 0)),
			"毒道境界": int(快照.get("毒道境界", 0)),
			"傀儡数量": int(快照.get("傀儡数量", 0)),
			"休闲等级": int(快照.get("休闲等级", 0)),
			"飞升弟子": int(快照.get("飞升弟子", 0)),
			"世界探索度": int(快照.get("世界探索度", 0)),
		},
	}
	历史.append({"周期": 卡["周期"], "总分": 卡["总分"], "评级": 评级})
	if 历史.size() > 12:
		历史 = 历史.slice(历史.size() - 12)
	# 清零计数器（供下一周期累计）
	计数 = {"灵石获取": 0, "稀有道具": 0, "突破": 0, "高品质新弟子": 0, "首通": 0}

	# === F2 全局调节阀门（ECON-02 跨功能强约束 · S1-P0 · IMPL-ENG-01）===
	# 仅在此「结算最终输出节点」插入一次调用：对原始经济数值做系数修正 + 熔断，
	# 写回最终值。其余结算主流程不变（零侵入核心结算铁律）。
	# D 类具体功能逻辑（坊市 / 运维 / 负面影响）不在本模块实现，本模块仅提供旋钮与熔断；
	# 默认配置下 平衡() 恒等，与原结算对齐无跳变。
	var _平衡器 := EconomyBalance.new()
	卡["明细"]["灵石增量"] = int(_平衡器.平衡(float(快照.get("灵石增量", 0))))

	return 卡

# 由高到低取首个满足阈值的评级
func _判级(总分: float) -> String:
	var 序: Array = 评级序.duplicate()
	序.reverse()
	for 级 in 序:
		if 总分 >= float(评级阈值[级]):
			return 级
	return "D"
