# 检查是否领悟新丹方
func 检查领悟丹方(丹方ID: String, 成功: bool, 纹数: int) -> Dictionary:
	for 丹方 in 领悟丹方池:
		var 已领悟: bool = false
		# 检查是否已领悟（通过全局变量）
		if AlchemySystem != null and "已领悟丹方" in AlchemySystem:
			已领悟 = str(丹方["ID"]) in AlchemySystem.已领悟丹方
		if 已领悟:
			continue
		var 概率: float = float(丹方.get("领悟概率", 0.0))
		var 触发: bool = false
		# 简化判定：纹数>=3（明纹以上）概率翻倍，失败也有概率领悟
		if 成功 and 纹数 >= 3:
			触发 = randf() < 概率 * 2.0
		elif not 成功:
			触发 = randf() < 概率
		if 触发:
			return 丹方.duplicate()
	return {}

# 获取所有可用丹方（基础+已领悟）
func 获取所有丹方() -> Dictionary:
	var 所有: Dictionary = 丹方库.duplicate()
	if AlchemySystem != null and "已领悟丹方" in AlchemySystem:
		for 丹方 in 领悟丹方池:
			if str(丹方["ID"]) in AlchemySystem.已领悟丹方:
				所有[str(丹方["ID"])] = 丹方.duplicate()
	return 所有

# ===== 炼丹过程叙事 =====
func 生成炼丹叙事(丹方ID: String, 成功: bool, 纹数: int = 0) -> Array:
	var 叙事: Array = []
	var 丹方: Dictionary = 丹方库.get(丹方ID, {})
	if 丹方.is_empty():
		for d in 领悟丹方池:
			if str(d["ID"]) == 丹方ID:
				丹方 = d
				break
	var 丹方名: String = str(丹方.get("名称", "未知丹方"))
	var 丹药名: String = str(丹方.get("产出", "未知丹药"))

	叙事.append("【准备药材】将%s所需药材一一备好，仔细甄别品质。" % 丹方名)
	叙事.append("【生火起炉】点燃丹炉，控制火候，待炉温渐升。")
	叙事.append("【投药炼化】依次投入药材，以灵力催动丹炉，药材渐渐融化。")

	if 成功:
		叙事.append("【凝丹成型】药力凝聚，丹药渐渐成型，丹香四溢！")
		if 纹数 > 0:
			var 纹名: String = "丹纹"
			if Game != null and Game.has_method("丹纹名"):
				纹名 = Game.丹纹名(纹数)
			叙事.append("  丹成之时，丹身浮现%s，此乃丹道大成之兆！" % 纹名)
			if 纹数 >= 4:
				叙事.append("  天降异象，天地共鸣，此丹非凡品！")
		else:
			叙事.append("  丹药中规中矩，无纹无象。")
		叙事.append("【炼丹成功】获得%s" % 丹药名)
	else:
		var 失败类型: String = "炼丹失败"
		var 随机: float = randf()
		if 随机 < 0.2:
			失败类型 = "炸炉"
			叙事.append("【炸炉】火候失控，丹炉炸裂！药材尽毁，还受了些伤。")
		elif 随机 < 0.5:
			失败类型 = "废丹"
			叙事.append("【废丹】药力溃散，炼成废丹，毫无用处。")
		else:
			失败类型 = "半成品"
			叙事.append("【半成品】丹药未能完全成型，虽是半成品，但仍有些许药力。")
		叙事.append("【%s】材料已消耗，再接再厉。" % 失败类型)

	return 叙事

# ===== 增强版炼丹（带丹纹+叙事+领悟） =====
# 整合workbuddy的丹纹系统：调用Game.赋予丹纹()
func 炼丹增强(丹方ID: String, 背包: Array, 丹堂等级: int = 1, 额外成功率: float = 0.0) -> Dictionary:
	var 检查 = 检查材料(丹方ID, 背包)
	if not 检查["足够"]:
		return {"成功": false, "产出": null, "消耗": [], "原因": 检查.get("原因", "材料不足"), "纹数": 0, "叙事": [], "领悟": {}}

	var 丹方 = 丹方库.get(丹方ID, {})
	if 丹方.is_empty():
		# 检查领悟丹方
		for d in 领悟丹方池:
			if str(d["ID"]) == 丹方ID:
				丹方 = d
				break
	if 丹方.is_empty():
		return {"成功": false, "产出": null, "消耗": [], "原因": "丹方不存在", "纹数": 0, "叙事": [], "领悟": {}}

	# 计算成功率
	var 成功率: float = float(丹方.get("基础成功率", 50)) + float(max(0, 丹堂等级 - 1)) * 2.0 + 额外成功率 * 100.0
	成功率 = clampf(成功率, 5.0, 95.0)

	# 消耗材料
	var 消耗列表: Array = []
	for mat in 丹方["材料"]:
		var 需求名: String = str(mat["名"])
		var 需求数: int = int(mat["数量"])
		var 已消耗: int = 0
		for i in range(背包.size() - 1, -1, -1):
			if 已消耗 >= 需求数:
				break
			var item = 背包[i]
			if item != null and typeof(item) == TYPE_OBJECT and "名称" in item and str(item.名称) == 需求名:
				消耗列表.append(item)
				背包.remove_at(i)
				已消耗 += 1

	# 成功率判定
	var 成功: bool = randf() * 100.0 <= 成功率
	var 纹数: int = 0
	var 新品 = null

	if 成功:
		var 丹药名: String = str(丹方.get("产出", "未知丹药"))
		var 品阶: String = str(丹方.get("品阶", "凡阶"))
		新品 = Item.new()
		新品.类别 = "dan_yao"
		新品.品阶 = 品阶
		新品.名称 = 丹药名
		var 效果描述: String = ""
		if 丹药效果.has(丹药名):
			效果描述 = str(丹药效果[丹药名].get("描述", ""))
		elif 领悟丹药效果.has(丹药名):
			效果描述 = str(领悟丹药效果[丹药名].get("描述", ""))
		新品.功效 = 效果描述
		新品.描述 = str(丹方.get("描述", ""))
		新品.战力加成 = 0
		新品.算战力()
		# 调用workbuddy的丹纹系统
		if Game != null and Game.has_method("赋予丹纹"):
			纹数 = Game.赋予丹纹(新品, 品阶, 丹堂等级)
		背包.append(新品)

	# 检查领悟丹方（传入纹数代替品质）
	var 领悟: Dictionary = 检查领悟丹方(丹方ID, 成功, 纹数)

	# 生成叙事
	var 叙事: Array = 生成炼丹叙事(丹方ID, 成功, 纹数)
	if not 领悟.is_empty():
		叙事.append("")
		叙事.append("【领悟丹方】炼丹过程中灵光一闪，领悟了%s！" % str(领悟.get("名称", "新丹方")))

	var 原因: String = ""
	if 成功:
		if 纹数 > 0:
			var 纹名: String = "丹纹"
			if Game != null and Game.has_method("丹纹名"):
				纹名 = Game.丹纹名(纹数)
			原因 = "炼丹成功！获得%s（%s，成功率%.0f%%）" % [新品.名称, 纹名, 成功率]
		else:
			原因 = "炼丹成功！获得%s（成功率%.0f%%）" % [新品.名称, 成功率]
	else:
		原因 = "炼丹失败，材料已消耗（成功率%.0f%%）" % 成功率

	return {
		"成功": 成功, "产出": 新品, "消耗": 消耗列表, "原因": 原因,
		"纹数": 纹数, "叙事": 叙事, "领悟": 领悟, "成功率": 成功率
	}

# ===== 批量炼丹 =====
func 批量炼丹(丹方ID: String, 背包: Array, 次数: int, 丹堂等级: int = 1, 额外成功率: float = 0.0) -> Dictionary:
	var 成功次数: int = 0
	var 失败次数: int = 0
	var 产出列表: Array = []
	var 纹数统计: Dictionary = {"0纹": 0, "1纹": 0, "2纹": 0, "3纹": 0, "4纹+": 0}
	var 最高纹数: int = 0
	var 领悟列表: Array = []
	var 总叙事: Array = []

	for i in range(次数):
		var 结果 = 炼丹增强(丹方ID, 背包, 丹堂等级, 额外成功率)
		if bool(结果.get("成功", false)):
			成功次数 += 1
			产出列表.append(结果.get("产出"))
			var 纹: int = int(结果.get("纹数", 0))
			if 纹 > 最高纹数:
				最高纹数 = 纹
			var 纹key: String = "%d纹" % min(纹, 4)
			if 纹 >= 4:
				纹key = "4纹+"
			if 纹数统计.has(纹key):
				纹数统计[纹key] = int(纹数统计[纹key]) + 1
		else:
			失败次数 += 1
		if not 结果.get("领悟", {}).is_empty():
			领悟列表.append(结果.get("领悟"))
		if i == 0:
			总叙事 = 结果.get("叙事", [])

	return {
		"总次数": 次数, "成功次数": 成功次数, "失败次数": 失败次数,
		"产出列表": 产出列表, "纹数统计": 纹数统计, "最高纹数": 最高纹数,
		"领悟列表": 领悟列表, "叙事": 总叙事,
		"成功率": "%.0f%%" % (float(成功次数) / float(max(1, 次数)) * 100.0)
	}

# ===== 炼丹记录系统 =====
var 炼丹记录列表: Array = []

func 添加炼丹记录(丹方ID: String, 成功: bool, 纹数: int, 领悟: Dictionary) -> void:
	var 记录: Dictionary = {
		"丹方ID": 丹方ID, "成功": 成功, "纹数": 纹数,
		"领悟": str(领悟.get("名称", "")), "时间": (int(Game.get("累计游戏日")) if Game != null else 0)
	}
	# 静态函数无法直接访问实例变量，通过全局单例
	# 倒序插入（最新的在最前），最多保留100条
	if AlchemySystem != null and "炼丹记录列表" in AlchemySystem:
		AlchemySystem.炼丹记录列表.insert(0, 记录)
		if AlchemySystem.炼丹记录列表.size() > 100:
			AlchemySystem.炼丹记录列表.resize(100)

func 获取炼丹统计() -> Dictionary:
	var 统计: Dictionary = {"总次数": 0, "成功次数": 0, "失败次数": 0, "纹数统计": {"0纹": 0, "1纹": 0, "2纹": 0, "3纹": 0, "4纹+": 0}, "最高纹数": 0, "领悟丹方数": 0}
	if AlchemySystem != null and "炼丹记录列表" in AlchemySystem:
		for 记录 in AlchemySystem.炼丹记录列表:
			统计["总次数"] = int(统计["总次数"]) + 1
			if bool(记录.get("成功", false)):
				统计["成功次数"] = int(统计["成功次数"]) + 1
				var 纹: int = int(记录.get("纹数", 0))
				if 纹 > int(统计["最高纹数"]):
					统计["最高纹数"] = 纹
				var 纹key: String = "%d纹" % min(纹, 4)
				if 纹 >= 4:
					纹key = "4纹+"
				if 统计["纹数统计"].has(纹key):
					统计["纹数统计"][纹key] = int(统计["纹数统计"][纹key]) + 1
			else:
				统计["失败次数"] = int(统计["失败次数"]) + 1
			if str(记录.get("领悟", "")) != "":
				统计["领悟丹方数"] = int(统计["领悟丹方数"]) + 1
	return 统计

# 获取炼丹历史记录（UI用，支持分页）
func 获取炼丹历史(页码: int = 0, 每页: int = 20) -> Array:
	if AlchemySystem == null or not "炼丹记录列表" in AlchemySystem:
		return []
	var 列表: Array = AlchemySystem.炼丹记录列表
	var 开始: int = 页码 * 每页
	var 结束: int = min(开始 + 每页, 列表.size())
	if 开始 >= 列表.size():
		return []
	var 结果: Array = []
	for i in range(开始, 结束):
		结果.append(列表[i])
	return 结果

# 清除炼丹记录
func 清除炼丹记录() -> void:
	if AlchemySystem != null and "炼丹记录列表" in AlchemySystem:
		AlchemySystem.炼丹记录列表.clear()

# ===== 存档系统（P0-3完善：保存炼丹记录和已领悟丹方，防止重新加载后丢失）=====
func to_dict() -> Dictionary:
	return {
		"炼丹记录列表": 炼丹记录列表.duplicate(),
		"已领悟丹方": 已领悟丹方.duplicate(),
	}

func from_dict(d: Dictionary) -> void:
	炼丹记录列表 = d.get("炼丹记录列表", [])
	已领悟丹方 = d.get("已领悟丹方", [])
