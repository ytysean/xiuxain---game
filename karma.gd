extends RefCounted
class_name Karma

# ============ 因果文本层（修真味·感知设计）============
# 设计原则：玩家永远读不到因果数字，只能读懂征兆。
#   L1 寂灭：默认不可见
#   L2 望气：主动施术 → 五档气象词（本文件 业力气象/功德气象/望气）
#   L3 征兆：世界回响 → 异象传闻（本文件 征兆/宗门异闻）
#   L4 结算：天象与幻境（本文件 天象描述/翻旧账/入魔幻境）
# 数值口径唯一真源仍为 Disciple.业力/功德 + Tribulation.因果天劫倍率，本文件只做「翻译」。
# 约束：仅 static func / const。gdtoolkit 不支持 static var，禁止使用。

# —— tuning levers ——
# [PLACEHOLDER] 望气价 50 灵石：按当前弟子月供量级取「不至于随手连点，也不至于心疼」的档；
#   验证路径：观察玩家是否每月望气全员的次数，若普遍 <=1 次/月则下调至 20。
const 望气价: int = 50
# [PLACEHOLDER] 望气有效期 180 游戏日（= 半年）：因果变动缓慢，半年一次足够；
#   若玩家反馈「刚望完就杀人结果不准」，缩短至 90。
const 望气有效期: int = 180
# 翻旧账门槛：历史业力达到此值，渡劫/心魔劫时旧业会被翻出
const 旧业门槛: int = 100
# 消业（超度法事）一次可销的业力
const 超度消业量: int = 30
const 超度价: int = 200
# [PLACEHOLDER] 望宗门价 120 灵石：一次看全宗整体气象（不点名）。
#   定价逻辑：个人望气 50，宗门望气覆盖全宗但只给粗信号，取 2~3 倍个人价。
const 望宗门价: int = 120

# —— 业力档（煞气，自低到高；取最后一个满足项 = 最高档）——
# 门槛 40 而非 20 的 rationale：斩一名修士 = +20 业力。门槛 20 意味着「杀一人即挂相」，
# 相术比当事人还敏感，且杀人立刻显形会剥夺玩家的侥幸心理。抬到 40 → 杀两人才露形，
# 第一次杀人是「天知地知你知」，第二次才进入可被观察的范围。
const 业力档: Array = [
	[40, "眉间微有晦色，似有血光隐隐"],
	[100, "印堂发黑，寻常小儿见之避走"],
	[200, "煞气缠身，夜行时有鬼影随侍"],
	[400, "血光冲天，方圆百丈生灵不安"],
]

# —— 功德档（德辉，自低到高）——
const 功德档: Array = [
	[20, "面有德辉，紫气东来三寸"],
	[100, "金光罩体，寻常邪祟不敢近身"],
	[200, "庆云垂顶，鸟兽自来亲附"],
	[400, "德光冲霄，天地为之降瑞"],
]

# —— 短词档（德业驳杂时组合使用，控制单行长度）——
const 业力短档: Array = [
	[40, "晦色微现"],
	[100, "印堂发黑"],
	[200, "煞气缠身"],
	[400, "血光冲天"],
]
const 功德短档: Array = [
	[20, "面有德辉"],
	[100, "金光罩体"],
	[200, "庆云垂顶"],
	[400, "德光冲霄"],
]

# —— 天象（按天劫倍率；不给玩家数字）——
const 天象表: Array = [
	[1.25, "九霄雷云翻涌，紫霄神雷将降——此劫非比寻常"],
	[1.10, "阴云蔽日，雷蛇游走，劫威更胜往常"],
	[1.02, "云层略厚，隐隐有闷雷之声"],
	[0.98, "劫云如常，天道无喜无怒"],
	[0.90, "云色清薄，雷光温润，似有转机"],
	[0.00, "劫云仅三丈，天心似有眷顾"],
]

# —— 征兆：异象传闻池（业力侧，自高到低匹配）——
const 业征兆池: Array = [
	[200, ["夜半，%s洞府传来厉啸，守夜弟子言见黑影幢幢",
			"%s所用佩剑近日自鸣不止，鞘中似有呜咽之声"]],
	[100, ["%s闭关时似与人对骂，推门却空无一人",
			"有弟子言，路过%s居所时无故心慌，如坠冰窟"]],
	[40, ["%s近日气色不佳，常言梦中见血",
			"%s所用器物无故生裂，门下议论纷纷"]],
]

# —— 征兆：功德侧——
const 功征兆池: Array = [
	[200, ["%s讲道之时，有灵蝶绕身三匝不去",
			"夜观星象，%s居所上空有庆云凝结"]],
	[100, ["%s行经之处，枯木竟发新芽",
			"门中孩童皆喜亲近%s，言其身上有暖意"]],
	[20, ["%s近日气色清朗，同门皆愿与之论道"]],
