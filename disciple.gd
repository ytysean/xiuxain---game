# ===== 多种族修炼体系 P1：妖族化形系统 =====
## 检查是否可以化形（妖族金丹圆满后）
func 可以化形() -> bool:
	if 种族 != "妖族":
		return false
	if 化形状态 != "未化形":
		return false
	if 境界 != "金丹" or 层数 < 10:
		return false
	if 化形冷却 > 0:
		return false
	return true

## 计算化形劫成功率
func 计算化形成功率() -> float:
	if not 可以化形():
		return 0.0
	# 基础成功率50%
	var 率: float = 0.5
	# 资质加成
	率 *= 资质突破系数.get(资质, 1.0)
	# 化形准备度加成（每10点+5%）
	率 += 化形准备度 * 0.005
	# 化形尝试次数加成（失败后下次+5%，最多+25%）
	率 += min(化形尝试次数 * 0.05, 0.25)
	# 心境/道心加成
	率 += 心境 * 0.002
	率 += 道心 * 0.003
	# 心魔减成
	率 -= 心魔值 * 0.005
	return clamp(率, 0.1, 0.95)

## 尝试化形（化形劫）
func 尝试化形() -> Dictionary:
	if not 可以化形():
		return {"成功": false, "因": "不满足化形条件"}
	
	化形尝试次数 += 1
	var 成功率: float = 计算化形成功率()
	var 结果: Dictionary = {"成功": false, "率": 成功率}
	
	if randf() < 成功率:
		# 化形成功
		化形状态 = "已化形"
		当前形态 = "人形"
		化形进度 = 100.0
		# 化形成功奖励：全属性+10%，修炼速度恢复正常
		心境 = min(100, 心境 + 10)
		道心 = min(100, 道心 + 5)
		# 重新计算修炼速度
		基础修炼速度 = _基础修炼速度值()
		修炼速度 = 基础修炼速度 * 总修炼速度倍率()
		结果["成功"] = true
		结果["消息"] = "%s化形成功！获得人形，可学习人族功法，修炼速度恢复正常。" % 姓名
	else:
		# 化形失败
		化形冷却 = 90.0  # 90天冷却
		化形准备度 = max(0, 化形准备度 - 20)
		心境 = max(0, 心境 - 10)
		增加心魔(randi_range(5, 15))
		结果["消息"] = "%s化形失败，道心受损，需休养90天后可再次尝试。" % 姓名
	
	# 清除战力缓存
	本体战力 = 0
	人形战力 = 0
	战力 = 计算战力()
	return 结果

## 提升化形准备度（闭关/丹药/阵法）
func 提升化形准备度(增量: float) -> void:
	if 种族 != "妖族" or 化形状态 != "未化形":
		return
	化形准备度 = clamp(化形准备度 + 增量, 0, 100)

## 月度推进化形进度（妖族金丹后自动积累）
func 月度推进化形() -> void:
	if 种族 != "妖族" or 化形状态 != "未化形":
		return
	if 境界 == "金丹" and 层数 >= 10:
		# 金丹圆满后每月自动积累化形进度（基础2点，心境高加成）
		var 增量: float = 2.0 + 心境 * 0.02
		化形进度 = clamp(化形进度 + 增量, 0, 100)
	# 化形冷却递减
	if 化形冷却 > 0:
		化形冷却 = max(0, 化形冷却 - 30)

# ===== 多种族修炼体系 P1：魔族心魔劫系统 =====
## 检查是否走火入魔
func 是否走火入魔() -> bool:
	return 走火入魔

## 计算走火入魔概率
func 计算走火入魔概率() -> float:
	var 概率: float = 0.0
	# 心魔值越高概率越大
	概率 += 心魔值 * 0.005
	# 突破失败增加概率
	概率 += 突破失败次数 * 0.02
	# 道心高降低概率
	概率 -= 道心 * 0.003
	# 修真味·种族差异：魔族魔念天生易走火(×1.5)；人族道心坚韧(×0.6)；其余种族(×1.0)
	# 注：原实现 `if 种族 != "魔族": return 0.0` 把人族完全排除——修真小说里人族同样会走火入魔，
	#     此处保留魔族更易入魔的设定，同时让人族在「心魔高/屡破失败」时也会入魔。
	match 种族:
		"魔族":
			概率 *= 1.5
		"人族":
			概率 *= 0.6
		_:
			概率 *= 1.0
	# 修真味·因果：业力缠身者心魔易动（帽 +15%）；功德护体者心神澄澈（帽 -10%）
	#   业力=功德=0 → 增量恒 0，既有入魔标定完全不变。
	概率 += clamp(float(业力) / 999.0, 0.0, 1.0) * 0.15
	概率 -= clamp(float(功德) / 999.0, 0.0, 1.0) * 0.10
	return clamp(概率, 0, 0.5)

## 触发走火入魔
func 触发走火入魔() -> void:
	走火入魔 = true
	走火入魔天数 = randi_range(30, 90)
	心境 = max(0, 心境 - 20)
	增加业力(10)
	# 走火入魔时战力临时变化（攻击+30%，防御-20%）
	战力 = 计算战力()

## 化解走火入魔
func 化解走火入魔(方式: String = "闭关") -> Dictionary:
	if not 走火入魔:
		return {"成功": false, "因": "未走火入魔"}
	
	var 成功率: float = 0.3
	match 方式:
		"闭关":
			成功率 = 0.3 + 道心 * 0.005
		"丹药":
			成功率 = 0.6  # 需要清心丹等
		"佛法":
			成功率 = 0.8  # 需要佛门功法/道具
		_:
			成功率 = 0.3
	
	if randf() < 成功率:
		走火入魔 = false
		走火入魔天数 = 0
		心魔值 = max(0, 心魔值 - 20)
		心境 = min(100, 心境 + 10)
		# 修真味·因果：救回一名入魔弟子 = 积德（功德可抵消业力带来的天劫加难）
		增加功德(20)
		战力 = 计算战力()
		return {"成功": true, "消息": "%s走火入魔已化解，道心恢复，功德+20。" % 姓名}
	else:
		走火入魔天数 = max(0, 走火入魔天数 - 10)
		return {"成功": false, "消息": "%s走火入魔化解失败，仍需休养。" % 姓名}

## 月度推进魔族（业力增长/心魔积累/走火入魔检查）
func 月度推进魔族() -> void:
	if 种族 != "魔族":
		return
	# 每月业力+2
	增加业力(2)
	# 心魔值自然增长（修炼越快心魔越多）
	心魔值 = clamp(心魔值 + 修炼速度 * 0.5, 0, 100)
	# 走火入魔天数递减
	if 走火入魔:
		走火入魔天数 = max(0, 走火入魔天数 - 30)
		if 走火入魔天数 <= 0:
			走火入魔 = false
			心境 = min(100, 心境 + 5)
	# 心魔值过高时检查走火入魔
	if 心魔值 > 80 and not 走火入魔:
		if randf() < 计算走火入魔概率():
			触发走火入魔()

## 增加业力（杀业/恶行累积；修真味：业力缠身天劫加难）
## 典型量级：走火入魔 +10 / 杀一名修士 +50 / 屠城灭宗 +200
func 增加业力(增量: int) -> void:
	业力 = clamp(业力 + 增量, 0, 999)
	# 业力不灭：当前业力可被功德压制，历史杀业永不清零（渡劫/心魔劫翻旧账）
	if 增量 > 0:
		历史业力 = clamp(历史业力 + 增量, 0, 9999)

## 增加功德（救人/行善累积；修真味：功德圆满天降甘霖，可抵消业力加难）
## 典型量级：救一人 +20 / 护送商队 +10 / 宗门大义之举 +50
func 增加功德(增量: int) -> void:
	功德 = clamp(功德 + 增量, 0, 999)

## 超度法事：唯一能让旧业真正消散的途径（当前业力与历史业力同步削减）
func 消业(量: int) -> void:
	业力 = clamp(业力 - 量, 0, 999)
	历史业力 = clamp(历史业力 - 量, 0, 9999)

# ===== 多种族修炼体系 P1：鬼族阴雷劫系统 =====
## 获取阴气修炼加成
func 获取阴气修炼加成() -> float:
	if 种族 != "鬼族":
		return 1.0
	# 阴气值越高修炼越快（最多+30%）
	return 1.0 + 阴气值 * 0.003

## 获取白天修炼惩罚
func 获取白天修炼惩罚() -> float:
	if 种族 != "鬼族":
		return 1.0
	# 白天修炼效率-30%（阳气抗性可减少惩罚）
	var 惩罚: float = 0.7 + 阳气抗性 * 0.003
	return clamp(惩罚, 0.7, 1.0)

## 获取雷系伤害加成（鬼族怕雷）
func 获取雷系伤害加成() -> float:
