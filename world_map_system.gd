	区域_东域: {"描述": "海域辽阔，群岛林立，水产丰富，海运发达", "修炼加成": 0.05, "商路加成": 0.20, "危险度": 0.2},
	区域_西域: {"描述": "荒漠戈壁，商路要冲，矿藏丰富，风沙肆虐", "修炼加成": 0.05, "商路加成": 0.25, "危险度": 0.25},
	区域_南疆: {"描述": "瘴气弥漫，毒虫遍地，灵药众多，巫族聚居", "修炼加成": 0.15, "商路加成": 0.05, "危险度": 0.35},
	区域_北域: {"描述": "冰原万里，妖兽横行，天材地宝，苦寒之地", "修炼加成": 0.20, "商路加成": 0.0, "危险度": 0.4},
}

# ===== 状态变量 =====
var 宗门区域: String = 区域_中州     # 宗门所在区域
var 宗门坐标X: float = 0.0           # 宗门X坐标
var 宗门坐标Y: float = 0.0           # 宗门坐标Y
var 城镇坐标表: Dictionary = {}      # 城镇ID -> {区域, x, y}
var 其他宗门列表: Array = []          # 其他玩家宗门（模拟）
var 迁移冷却日: int = 0              # 宗门迁移冷却（游戏日）
# 迷雾探索持久化（2026-09-14 修）：原迷雾格是 page_world_map_visual 的页面局部变量，
# 重进地图页必清零 ⇒「迷雾探索」玩法实际不成立（探索完一关页面就全白回来）。
# 现提升为系统状态并纳入存档；键为「列_行」（视觉网格），旧档缺键 → 默认空（不迁移）。
var 已探索网格: Dictionary = {}
var _已初始化: bool = false

# ===== 初始化 =====
