# ===== S54 P1：防刷子机制 =====
# 检查交易是否异常
func _检查异常交易(lot: Dictionary, 成交价: int, 竞得者: String) -> bool:
	var 估价: int = _系统估价_from_dict(lot.get("物品", {}))
	# 价格异常：成交价低于估价30%或高于估价500%
	if 成交价 < int(float(估价) * 0.3):
		_记录异常交易(lot, 成交价, "价格过低", 竞得者)
		return true
	if 成交价 > int(float(估价) * 5.0):
		_记录异常交易(lot, 成交价, "价格过高", 竞得者)
		return true
	return false

# 从物品字典估价
func _系统估价_from_dict(it_dict: Dictionary) -> int:
	var 品阶: String = str(it_dict.get("品阶", "凡阶"))
	var 战力: int = int(it_dict.get("战力加成", 0))
	var 品阶基准: Dictionary = {"凡阶": 50, "灵阶": 200, "宝阶": 800, "王阶": 3000, "圣阶": 10000, "仙阶": 50000}
	var 基: int = 品阶基准.get(品阶, 100)
	return max(100, int(float(基) * (1.0 + float(战力) / 500.0)))

# 记录异常交易
func _记录异常交易(lot: Dictionary, 成交价: int, 原因: String, 竞得者: String) -> void:
	var 记录: Dictionary = {
		"物品": lot.get("名称", ""),
		"成交价": 成交价,
		"原因": 原因,
		"竞得者": 竞得者,
		"日": Game.累计游戏日,
	}
	(全服拍卖["异常交易记录"] as Array).append(记录)
	Game.添加纪事("全服拍卖", "异常交易", "检测到异常交易：「%s」成交价%d灵石（%s），已记录审查。" % [lot.get("名称", ""), 成交价, 原因], 1)

# ===== S55：价格供需机制 =====
# 更新供需数据（每次成交时调用）
func _更新供需数据(类别: String, 品阶: String, 成交价: int, 供应量: int = 1) -> void:
	var 键: String = "%s_%s" % [类别, 品阶]
	var 供需数据: Dictionary = 全服拍卖.get("供需数据", {})
	if not 供需数据.has(键):
		供需数据[键] = {"成交量": 0, "供应量": 0, "价格指数": 1.0, "累计成交额": 0}
	var 数据: Dictionary = 供需数据[键]
	数据["成交量"] = int(数据.get("成交量", 0)) + 1
	数据["供应量"] = int(数据.get("供应量", 0)) + 供应量
	数据["累计成交额"] = int(数据.get("累计成交额", 0)) + 成交价
	# 计算供需比（成交量/供应量），大于1表示供不应求
	var 供需比: float = float(数据.get("成交量", 1)) / float(max(1, 数据.get("供应量", 1)))
	# 调整价格指数：供不应求上涨，供大于求下降
	var 新指数: float = 1.0 + (供需比 - 1.0) * 0.2
	新指数 = clamp(新指数, 0.5, 2.0)  # 限制在0.5-2.0之间
	# 平滑过渡
	数据["价格指数"] = float(数据.get("价格指数", 1.0)) * 0.7 + 新指数 * 0.3
	供需数据[键] = 数据
	全服拍卖["供需数据"] = 供需数据

# 获取物品价格指数
func 获取价格指数(类别: String, 品阶: String) -> float:
	var 键: String = "%s_%s" % [类别, 品阶]
	var 供需数据: Dictionary = 全服拍卖.get("供需数据", {})
	if 供需数据.has(键):
		return float(供需数据[键].get("价格指数", 1.0))
	return 1.0

# 获取供需状态文字
func 获取供需状态(类别: String, 品阶: String) -> String:
	var 指数: float = 获取价格指数(类别, 品阶)
	if 指数 >= 1.5:
		return "供不应求，价格高涨"
	elif 指数 >= 1.2:
		return "需求旺盛，价格偏高"
	elif 指数 >= 0.8:
		return "供需平衡，价格稳定"
	elif 指数 >= 0.5:
		return "供应充足，价格偏低"
	else:
		return "供大于求，价格低迷"

