class_name FamilySystem extends RefCounted

# ===== 家族系统状态变量 =====
var 家族列表: Dictionary = {}
var _血脉类型配置: Dictionary = {}
var _家族功法叠加配置: Dictionary = {}

func 创建家族(家族名: String, 老祖: Disciple) -> Dictionary:
	if 家族名 == "" or 老祖 == null:
		return {"成功": false, "因": "家族名或老祖为空"}
	var 家族ID: String = "family_%d" % randi()
	# 创建家族时自动生成专属血脉功法（家传绝学，名字随机生成）
	var 血脉功法名: String = 随机生成功法名字(家族名)
	var 家族血脉功法: Dictionary = {
		"名": 血脉功法名,
		"ID": "family_xuemai_%s" % 家族ID,
		"描述": "%s家传血脉功法，世代传承，威力随家族底蕴提升" % 家族名,
		"创立时间": Game.累计游戏日
	}
	var 家族: Dictionary = {
		"id": 家族ID,
		"名": 家族名,
		"老祖ID": 老祖.弟子ID,
		"老祖名": 老祖.姓名,
		"创立时间": Game.累计游戏日,
		"等级": 1,
		"成员列表": [老祖.弟子ID],
		"长老列表": [],
		"家族功法": [],
		"血脉功法": 家族血脉功法,
		"家族阵法": "",
		"家族秘宝": [],
		"家族宝库": {},
		"家族贡献池": 0,
		"家族声望": 0,
		"家族气运": 0.0,
		"联盟家族": [],
		"敌对家族": [],
		"联姻家族": [],
		"描述": "%s创立的修仙家族，以%s为老祖，家传功法「%s」" % [家族名, 老祖.姓名, 血脉功法名]
	}
	家族列表[家族ID] = 家族
	老祖.家族ID = 家族ID
	老祖.家族名 = 家族名
	老祖.家族职位 = "老祖"
	# 老祖自动学习家族血脉功法
	老祖.血脉功法列表.append("family_xuemai_%s" % 家族ID)
	Game.添加纪事("家族", "家族创立", "%s 创立修仙家族「%s」，家传功法「%s」，家族血脉自此传承" % [老祖.姓名, 家族名, 血脉功法名], 1)
	return {"成功": true, "家族ID": 家族ID, "家族名": 家族名, "血脉功法名": 血脉功法名}

## 获取家族数据
func 获取家族(家族ID: String) -> Dictionary:
	if 家族ID == "" or not 家族列表.has(家族ID):
		return {}
	return 家族列表[家族ID]

## 弟子加入家族
func 加入家族(弟子: Disciple, 家族ID: String) -> Dictionary:
	if 弟子 == null or 家族ID == "" or not 家族列表.has(家族ID):
		return {"成功": false, "因": "弟子或家族无效"}
	var 家族: Dictionary = 家族列表[家族ID]
	if 弟子.家族ID == 家族ID:
		return {"成功": false, "因": "已是该家族成员"}
	if 弟子.家族ID != "":
		# 先退出原家族
		退出家族(弟子)
	弟子.家族ID = 家族ID
	弟子.家族名 = str(家族.get("名", ""))
	弟子.家族职位 = "外门"
	if not 家族.get("成员列表", []).has(弟子.弟子ID):
		家族["成员列表"].append(弟子.弟子ID)
	家族列表[家族ID] = 家族
	Game.添加纪事("家族", "加入家族", "%s 加入家族「%s」" % [弟子.姓名, str(家族.get("名", ""))], 1)
	return {"成功": true}

## 弟子退出家族
func 退出家族(弟子: Disciple) -> Dictionary:
	if 弟子 == null or 弟子.家族ID == "":
		return {"成功": false, "因": "弟子无家族"}
	var 家族ID: String = 弟子.家族ID
	if 家族列表.has(家族ID):
		var 家族: Dictionary = 家族列表[家族ID]
		var 成员列表: Array = 家族.get("成员列表", [])
		成员列表.erase(弟子.弟子ID)
		家族["成员列表"] = 成员列表
		# 如果是老祖，家族解散
		if str(家族.get("老祖ID", -1)) == str(弟子.弟子ID):
			解散家族(家族ID)
		家族列表[家族ID] = 家族
	弟子.家族ID = ""
	弟子.家族名 = ""
	弟子.家族职位 = "外门"
	弟子.家族功法列表 = []
	# 退出家族时清除家族血脉功法（家传功法不外传）
	var 家族功法ID: String = "family_xuemai_%s" % 家族ID
	if 家族功法ID in 弟子.血脉功法列表:
		弟子.血脉功法列表.erase(家族功法ID)
	Game.添加纪事("家族", "退出家族", "%s 退出家族，家传功法已收回" % 弟子.姓名, 1)
	return {"成功": true}

## 解散家族
func 解散家族(家族ID: String) -> void:
	if not 家族列表.has(家族ID):
		return
	var 家族: Dictionary = 家族列表[家族ID]
	# 所有成员退出家族
	for 成员ID in 家族.get("成员列表", []):
		var d: Object = Game._取弟子(成员ID)
		if d != null and d is Disciple:
			d.家族ID = ""
			d.家族名 = ""
			d.家族职位 = "外门"
			d.家族功法列表 = []
			# 解散家族时清除所有成员的家族血脉功法
			var 家族功法ID: String = "family_xuemai_%s" % 家族ID
			if 家族功法ID in d.血脉功法列表:
				d.血脉功法列表.erase(家族功法ID)
	家族列表.erase(家族ID)
	Game.添加纪事("家族", "家族解散", "家族「%s」解散，血脉传承断绝，家传功法已失传" % str(家族.get("名", "")), 2)

## 计算血脉加成（修炼速度/战力/突破成功率）
func 计算血脉加成(弟子: Disciple) -> Dictionary:
	if 弟子 == null or not (弟子 is Disciple):
		return {"修炼加成": 0.0, "战力加成": 0.0, "突破加成": 0.0}
	var 血脉类型: String = 弟子.血脉类型
	if 血脉类型 == "凡人血脉" or not _血脉类型配置.has(血脉类型):
		return {"修炼加成": 0.0, "战力加成": 0.0, "突破加成": 0.0}
	var 配置: Dictionary = _血脉类型配置[血脉类型]
	var 纯度系数: float = clamp(float(弟子.血脉纯度) / 100.0, 0.0, 1.0)
	var 觉醒系数: float = 1.0
	if 弟子.血脉觉醒:
		觉醒系数 = 1.0 + clamp(float(弟子.血脉觉醒度) / 100.0, 0.0, 1.0)
	# 未觉醒血脉时，只有30%效果；觉醒后效果翻倍
	var 效果系数: float = 0.3 if not 弟子.血脉觉醒 else 觉醒系数
	var 修炼加成: float = float(配置.get("修炼加成", 0.0)) * 纯度系数 * 效果系数
	var 战力加成: float = float(配置.get("战力加成", 0.0)) * 纯度系数 * 效果系数
	var 突破加成: float = float(配置.get("突破加成", 0.0)) * 纯度系数 * 效果系数
	# 数值红线：血脉类单源子帽≤1.5%（全局等效）
	修炼加成 = min(修炼加成, 0.015)
	战力加成 = min(战力加成, 0.015)
	突破加成 = min(突破加成, 0.015)
	return {"修炼加成": 修炼加成, "战力加成": 战力加成, "突破加成": 突破加成}

## 计算家族功法叠加效果
func 计算家族功法叠加(弟子: Disciple) -> Dictionary:
	if 弟子 == null or not (弟子 is Disciple) or 弟子.家族功法列表.is_empty():
		return {"修炼加成": 0.0, "战力加成": 0.0, "叠加数": 0}
	var 叠加数: int = min(弟子.家族功法列表.size(), int(_家族功法叠加配置.get("max_stack", 3)))
	var 修炼加成: float = 0.0
	var 战力加成: float = 0.0
	if 叠加数 >= 2:
		修炼加成 += float(_家族功法叠加配置.get("stack_bonus", 0.02)) * (叠加数 - 1)
	if 叠加数 >= 3:
		战力加成 += float(_家族功法叠加配置.get("combo_bonus", 0.05))
	# 数值红线：家族功法叠加单源子帽≤1%（全局等效）
	修炼加成 = min(修炼加成, 0.01)
	战力加成 = min(战力加成, 0.01)
	return {"修炼加成": 修炼加成, "战力加成": 战力加成, "叠加数": 叠加数}

## 学习家族功法（家族功法不外传，只有家族成员能学）
func 学习家族功法(弟子: Disciple, 功法ID: String) -> Dictionary:
	if 弟子 == null or 功法ID == "":
		return {"成功": false, "因": "弟子或功法ID为空"}
	if 弟子.家族ID == "":
		return {"成功": false, "因": "无家族，无法学习家族功法"}
	var 家族: Dictionary = 获取家族(弟子.家族ID)
	if 家族.is_empty():
		return {"成功": false, "因": "家族不存在"}
	var 家族功法: Array = 家族.get("家族功法", [])
	if not 家族功法.has(功法ID):
		return {"成功": false, "因": "该功法不是家族功法，或家族尚未拥有此功法"}
	if 功法ID in 弟子.家族功法列表:
		return {"成功": false, "因": "已学习此功法"}
	# 检查家族职位权限（长老及以上可以学习所有家族功法，核心及以上可以学习大部分）
	var 职位权限: Dictionary = {
		"老祖": 10, "长老": 8, "核心": 6, "内门": 4, "外门": 2, "附庸": 1
	}
	var 功法权限: int = 3  # 默认需要内门及以上
	if 职位权限.get(弟子.家族职位, 0) < 功法权限:
		return {"成功": false, "因": "家族职位不足，无法学习此功法（需要内门及以上）"}
	弟子.家族功法列表.append(功法ID)
	Game.添加纪事("家族", "学习家族功法", "%s 学习家族功法「%s」" % [弟子.姓名, 功法ID], 1)
	return {"成功": true, "功法ID": 功法ID}

## 觉醒血脉（需要特殊机缘或道具）
func 觉醒血脉(弟子: Disciple) -> Dictionary:
	if 弟子 == null or not (弟子 is Disciple):
		return {"成功": false, "因": "弟子无效"}
	if 弟子.血脉类型 == "凡人血脉":
		return {"成功": false, "因": "凡人血脉无法觉醒"}
	if 弟子.血脉觉醒:
		return {"成功": false, "因": "血脉已觉醒"}
	if 弟子.血脉纯度 < 30:
		return {"成功": false, "因": "血脉纯度不足30%，无法觉醒"}
	弟子.血脉觉醒 = true
	弟子.血脉觉醒度 = 10.0  # 初始觉醒度10%
	Game.添加纪事("家族", "血脉觉醒", "%s 的%s觉醒！血脉之力开始涌现，修炼速度和道行大幅提升" % [弟子.姓名, 弟子.血脉类型], 1)
	return {"成功": true, "血脉类型": 弟子.血脉类型, "觉醒度": 弟子.血脉觉醒度}

# ============ §6.16 家族宝库系统（P1实现）============
# 修真世界设定：家族藏宝阁，成员存取，老祖/长老审批，镇族之宝不外传

## 存入家族宝库
func 存入家族宝库(弟子: Disciple, 物品: Dictionary, 数量: int = 1) -> Dictionary:
	if 弟子 == null or 物品 == null or 弟子.家族ID == "":
		return {"成功": false, "因": "弟子无效或无家族"}
	var 家族: Dictionary = 获取家族(弟子.家族ID)
	if 家族.is_empty():
		return {"成功": false, "因": "家族不存在"}
	var 物品ID: String = str(物品.get("id", ""))
	if 物品ID == "":
		return {"成功": false, "因": "物品ID无效"}
	# 检查弟子背包是否有足够物品
	var 背包数量: int = 0
	for it in 弟子.背包:
		if str(it.id) == 物品ID:
			背包数量 += 1
	if 背包数量 < 数量:
		return {"成功": false, "因": "背包中该物品数量不足"}
	# 从背包移除物品
	var 已移除: int = 0
	for it in 弟子.背包.duplicate():
		if 已移除 >= 数量:
			break
		if str(it.id) == 物品ID:
			弟子.背包.erase(it)
			已移除 += 1
	# 存入家族宝库
	var 宝库: Dictionary = 家族.get("家族宝库", {})
	宝库[物品ID] = int(宝库.get(物品ID, 0)) + 数量
	家族["家族宝库"] = 宝库
	# 增加家族贡献
	弟子.家族贡献 += 数量 * 10  # 每件物品10点贡献
	家族列表[弟子.家族ID] = 家族
	Game.添加纪事("家族", "存入宝库", "%s 向家族宝库存入 %s×%d，获得家族贡献%d" % [弟子.姓名, str(物品.get("名", 物品ID)), 数量, 数量 * 10], 1)
	return {"成功": true, "物品ID": 物品ID, "数量": 数量, "家族贡献": 弟子.家族贡献}

## 从家族宝库取出（需要审批）
func 从家族宝库取出(弟子: Disciple, 物品ID: String, 数量: int = 1) -> Dictionary:
	if 弟子 == null or 物品ID == "" or 弟子.家族ID == "":
		return {"成功": false, "因": "弟子无效或无家族"}
	var 家族: Dictionary = 获取家族(弟子.家族ID)
	if 家族.is_empty():
		return {"成功": false, "因": "家族不存在"}
	var 宝库: Dictionary = 家族.get("家族宝库", {})
	var 库存: int = int(宝库.get(物品ID, 0))
	if 库存 < 数量:
		return {"成功": false, "因": "家族宝库中该物品数量不足"}
	# 职位权限检查：老祖/长老可直接取出，其他职位需要审批
	var 职位权限: Dictionary = {"老祖": 10, "长老": 8, "核心": 6, "内门": 4, "外门": 2, "附庸": 1}
	var 需要审批: bool = 职位权限.get(弟子.家族职位, 0) < 6  # 核心及以上可直接取出
	if 需要审批:
		# 记录审批申请（简化版：直接拒绝，提示需要长老审批）
		return {"成功": false, "因": "家族职位不足，需要长老及以上审批后才能取出"}
	# 从宝库移除
	宝库[物品ID] = 库存 - 数量
	if 宝库[物品ID] <= 0:
		宝库.erase(物品ID)
	家族["家族宝库"] = 宝库
	# 加入弟子背包
	var 物品: Dictionary = {"id": 物品ID, "名": 物品ID, "数量": 数量}
	弟子.背包.append(物品)
	# 扣除家族贡献
	弟子.家族贡献 = max(0, 弟子.家族贡献 - 数量 * 20)  # 取出每件20点贡献
	家族列表[弟子.家族ID] = 家族
	Game.添加纪事("家族", "取出宝库", "%s 从家族宝库取出 %s×%d，消耗家族贡献%d" % [弟子.姓名, 物品ID, 数量, 数量 * 20], 1)
	return {"成功": true, "物品ID": 物品ID, "数量": 数量, "家族贡献": 弟子.家族贡献}

## 查看家族宝库
func 查看家族宝库(家族ID: String) -> Dictionary:
	if 家族ID == "" or not 家族列表.has(家族ID):
		return {}
	var 家族: Dictionary = 家族列表[家族ID]
	return 家族.get("家族宝库", {})

