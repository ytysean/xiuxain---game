		"功法被动": SkillCultivationLoader.功法被动加成(_合并已修功法列表()),   # S1 批3：功法被动四维增量（合并已修功法+弟子技能字典）
		"灵力上限": int(灵力上限),   # 灵力系统：灵力上限
