	var 累计寄拍数: int = int(全服拍卖.get("累计寄拍数", 0))
	# 成交额成就
	var 成交额成就: Array = [
		{"名": "初入拍卖", "条件": 1000, "描述": "累计成交额达1000灵石"},
		{"名": "小有名气", "条件": 10000, "描述": "累计成交额达1万灵石"},
		{"名": "拍卖达人", "条件": 100000, "描述": "累计成交额达10万灵石"},
