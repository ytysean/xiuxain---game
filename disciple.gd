# disciple.gd —— 弟子数据类（对应策划案 §3 弟子体系 / §3.9 三修职业 / §3.7 命格性格）
class_name Disciple
extends RefCounted

const Item = preload("res://item.gd")
const Beast = preload("res://beast.gd")

const 资质表 := {
	"fan_su": {"上限": "练气", "速度": 1.0},
	"pingyong": {"上限": "筑基", "速度": 1.4},
	"youliang": {"上限": "金丹", "速度": 1.8},
	"tiancai": {"上限": "元婴", "速度": 2.5},
	"yaonie": {"上限": "化神", "速度": 3.5},
	"kuangshi": {"上限": "道阶", "速度": 4.8},
}
const 资质权重 := {"fan_su": 50.0, "pingyong": 30.0, "youliang": 14.0, "tiancai": 5.0, "yaonie": 0.9, "kuangshi": 0.1}

const 灵根五行 := ["金", "木", "水", "火", "土"]
const 灵根变异 := ["雷", "冰", "风", "光", "暗"]
const 命格表 := ["战狂","剑痴","战体","武曲","将星","福星","寻宝","商道","聚灵","丹心",
				"匠心","书香","阵道","符道","御兽","长生","桃花","衰星","孤煞","血光"]
# 十二修仙性格：独立显示字段，决定日后道号与奇遇/任务抉择（不替代命格）
const 性格表 := ["沉稳守道","锐意争先","恬淡悟道","桀骜不羁","仁心济世","杀伐果断",
				"谨慎多疑","豪迈仗义","孤僻清修","贪心逐缘","守礼尊师","狂傲绝世"]

# 全部职业：基础 3（开局可招）+ 后期解锁 4（门派达品阶后解锁）
const 职业名 := ["剑修","体修","法修","御兽师","符箓师","毒师","傀儡师"]
const 职业天赋 := {
	"剑修": "极速破防、斩灵克法",
	"体修": "厚血高防、近战碾压",
	"法修": "远程群攻、道法制衡",
	"御兽师": "灵兽协同、兽魂增益",
	"符箓师": "符箓术法、范围控场",
	"毒师": "毒伤持续、减益削弱",
	"傀儡师": "傀儡代战、机关增幅",
}
# 职业初始属性权重（攻/防/血/速，合计=1）：总属性不变，仅侧重不同
const 职业属性权重 := {
	"剑修": {"攻":0.40,"防":0.15,"血":0.20,"速":0.25},
	"体修": {"攻":0.20,"防":0.40,"血":0.30,"速":0.10},
	"法修": {"攻":0.35,"防":0.10,"血":0.15,"速":0.40},
	"御兽师": {"攻":0.20,"防":0.20,"血":0.25,"速":0.35},
	"符箓师": {"攻":0.30,"防":0.10,"血":0.10,"速":0.50},
	"毒师": {"攻":0.30,"防":0.15,"血":0.15,"速":0.40},
	"傀儡师": {"攻":0.25,"防":0.35,"血":0.20,"速":0.20},
}

# 境界表（战力/寿元，对应七品阶；仙阶/道阶为顶两阶，渡劫数值归入道阶）
const 境界表 := {
	"练气": {"品阶": "fan_jie", "战力": 100, "寿元": 80},
	"筑基": {"品阶": "ling_jie", "战力": 400, "寿元": 200},
	"金丹": {"品阶": "bao_jie", "战力": 1500, "寿元": 500},
	"元婴": {"品阶": "wang_jie", "战力": 6000, "寿元": 1200},
	"化神": {"品阶": "sheng_jie", "战力": 25000, "寿元": 3000},
	"仙阶": {"品阶": "xian_jie", "战力": 35000, "寿元": 5000},
	"道阶": {"品阶": "dao_jie", "战力": 40000, "寿元": 8000},
}

const 姓库 := ["云","玄","青","墨","尘","凌","苏","叶","林","楚","姬","慕容","南宫","东方"]
const 名库 := ["霄","霜","青","渊","岚","芷","瑶","尘","逸","寒","羽","冥","玄","翰"]

var 姓名 := ""
var 资质 := ""
var 灵根 := ""
var 命格 := ""
var 性格 := ""
var 境界 := "练气"
var 寿元 := 80
var 修炼速度 := 1.0
var 战力 := 100
var 备注 := ""
var 职业 := "剑修"
var 物品: Array[Item] = []
var 灵兽: Beast = null
var 属性: Dictionary = {}

func _init():
	随机生成()

func 总战力() -> int:
	var s := 战力
	for it in 物品:
		s += it.战力加成
	if 灵兽 != null and not 灵兽.孵化中:
		s += 灵兽.战力贡献(战力)
	return s

func 加权随机(权重: Dictionary) -> String:
	var 总 := 0.0
	for k in 权重:
		总 += 权重[k]
	var 抽 := randf() * 总
	for k in 权重:
		抽 -= 权重[k]
		if 抽 <= 0:
			return k
	return 权重.keys()[0]

func 随机生成():
	资质 = 加权随机(资质权重)
	修炼速度 = 资质表[资质]["速度"]
	var r := randf()
	if r < 0.02:
		灵根 = "天灵根"
	elif r < 0.20:
		灵根 = 灵根变异.pick_random()
	else:
		灵根 = 灵根五行.pick_random()
	if randf() < 0.01:
		命格 = "天命"
	else:
		命格 = 命格表.pick_random()
	性格 = 性格表.pick_random()
	职业 = 职业名.slice(0, 3).pick_random()   # 默认基础三职业；招收时由宗门解锁池覆盖
	姓名 = 姓库.pick_random() + 名库.pick_random()
	境界 = "练气"
	寿元 = 境界表["练气"]["寿元"]
	战力 = 境界表["练气"]["战力"]
	算属性()

# 初始属性：总属性随资质缩放；职业仅决定侧重（合计不变）
func 算属性():
	var 总量 := int(80 + 修炼速度 * 8)
	var w: Dictionary = 职业属性权重[职业]
	属性 = {
		"攻": int(总量 * w["攻"]),
		"防": int(总量 * w["防"]),
		"血": int(总量 * w["血"]),
		"速": int(总量 * w["速"]),
	}

# 灵根决定可修职业数（变异/天灵根/全灵根→3；单双五行→2；杂灵根→1）
func 可修职业数() -> int:
	if 灵根 == "天灵根" or 灵根 == "先天五行全灵根":
		return 3
	if 灵根 in 灵根变异:
		return 3
	if 灵根 in 灵根五行:
		return 2
	return 1

func 简介() -> String:
	var 显示名 := 姓名
	if 备注 != "":
		显示名 = "%s（%s）" % [姓名, 备注]
	var s := "%s\n资质:%s  灵根:%s  命格:%s  性格:%s  职业:%s\n境界:%s  寿元:%d  战力:%d(总%d)  修炼x%.1f" % \
		[显示名, 资质, 灵根, 命格, 性格, 职业, 境界, 寿元, 战力, 总战力(), 修炼速度]
	s += "\n  属性(攻%d/防%d/血%d/速%d)  可修职业:%d" % [属性["攻"], 属性["防"], 属性["血"], 属性["速"], 可修职业数()]
	if 物品.size() > 0:
		s += "\n  持有："
		for it in 物品:
			s += "\n    · " + it.简介()
	if 灵兽 != null:
		s += "\n  灵兽：" + 灵兽.简介(战力)
		var 联动 := 灵兽联动()
		if 联动 != "":
			s += "\n    ☆ " + 联动
	return s

# 灵兽联动：基于灵兽「随机天赋」的关联（灵根/职业）与弟子匹配，不再依赖灵兽适配职业
func 灵兽联动() -> String:
	if 灵兽 == null or 灵兽.孵化中:
		return ""
	var 类型 := 灵兽.天赋类型
	var 关联 := 灵兽.天赋关联
	# 灵根契合
	if 类型 == "灵根" and 关联 == 灵根:
		return "【天赋共鸣】灵兽天赋契合%s灵根：%s" % [灵根, 灵兽.天赋]
	# 职业契合（含极品专属联动：弟子持有对应极品装备才触发）
	if 类型 == "职业" and 关联 == 职业:
		var 极品名 := _持有极品名()
		if 极品名 == "万法可破":
			return "【万法可破】+剑修灵兽天赋：对战法修额外获得短时法术无敌帧"
		if 极品名 == "金刚不坏":
			return "【金刚不坏】+体修灵兽天赋：锁血阈值由20%提升至25%"
		if 极品名 == "焚身灭甲":
			return "【焚身灭甲】+法修灵兽天赋：真实伤害小幅扩散溅射"
		return "【天赋共鸣】灵兽天赋契合%s：%s" % [职业, 灵兽.天赋]
	return ""

# 取弟子当前持有的某一极品装备中文名（用于灵兽极品联动判定）
func _持有极品名() -> String:
	for it in 物品:
		if it.极品属性 != null:
			return it.极品属性["名"]
	return ""

func to_dict() -> Dictionary:
	var 物品列表 := []
	for it in 物品:
		物品列表.append(it.to_dict())
	return {
		"姓名": 姓名, "资质": 资质, "灵根": 灵根, "命格": 命格, "性格": 性格,
		"境界": 境界, "寿元": 寿元, "修炼速度": 修炼速度, "战力": 战力, "备注": 备注,
		"职业": 职业, "属性": 属性, "物品": 物品列表,
		"灵兽": (灵兽.to_dict() if 灵兽 != null else null)
	}

func from_dict(d: Dictionary):
	姓名 = d.get("姓名", "")
	资质 = d.get("资质", "")
	灵根 = d.get("灵根", "")
	命格 = d.get("命格", "")
	性格 = d.get("性格", "")
	境界 = d.get("境界", "练气")
	寿元 = d.get("寿元", 80)
	修炼速度 = d.get("修炼速度", 1.0)
	战力 = d.get("战力", 100)
	备注 = d.get("备注", "")
	职业 = d.get("职业", "剑修")
	属性 = d.get("属性", {})
	物品.clear()
	for itd in d.get("物品", []):
		var it := Item.new()
		it.from_dict(itd)
		物品.append(it)
	灵兽 = null
	if d.has("灵兽") and d["灵兽"] != null:
		var b := Beast.new()
		b.from_dict(d["灵兽"])
		灵兽 = b
