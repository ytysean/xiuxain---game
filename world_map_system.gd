# 大地图五区域 → 化身游历六地 的桥接（两套命名体系对齐的唯一真源）
const 化身游历桥接: Dictionary = {
	"中州": "仙城闹市",
	"东域": "东海之滨",
	"西域": "蛮荒之地",
	"南疆": "南疆密林",
	"北域": "北境雪原",
}

var 化身游历足迹: Dictionary = {}   # 大地图区域 → 化身游历次数
var 已探索区域: Array = []          # 已踏足的大地图区域（化身游历归来即记）
var 累计采集次数: int = 0           # 累计成功采集次数（成就「资源猎手」真源）

# 查询某区域对应的化身游历去向
func 获取区域游历去向(区域: String) -> Dictionary:
	if not 化身游历桥接.has(区域):
		return {}
	return {
		"区域": 区域,
		"游历地": str(化身游历桥接[区域]),
		"已探索": 区域 in 已探索区域,
		"游历次数": int(化身游历足迹.get(区域, 0)),
	}

# 五区域游历总览（UI 消费）
func 获取化身游历总览() -> Array:
