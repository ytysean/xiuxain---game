var 已探索秘境: Array = []

# 探索秘境门户（消耗灵石，解锁对应历练秘境）
func 探索秘境门户(秘境ID: String) -> Dictionary:
	# 检查是否已探索
	if 秘境ID in 已探索秘境:
		return {"成功": false, "原因": "该秘境已探索"}
	# 秘境配置
	var 秘境配置: Dictionary = {
		"秘境古木洞天": {"城镇ID": "10", "消耗灵石": 500, "推荐战力": 3000, "描述": "古木参天，灵气浓郁，据传有古修遗府"},
		"秘境剑冢": {"城镇ID": "10", "消耗灵石": 1000, "推荐战力": 8000, "描述": "剑气纵横，万剑悲鸣，为上古剑修陨落之地"},
		"秘境妖域": {"城镇ID": "10", "消耗灵石": 2000, "推荐战力": 15000, "描述": "妖兽横行，危机四伏，亦有大机缘"},
		"秘境万兽渊": {"城镇ID": "10", "消耗灵石": 5000, "推荐战力": 30000, "描述": "万兽汇聚，渊深莫测，传说有神兽蛰伏"},
	}
	if 秘境ID not in 秘境配置:
		return {"成功": false, "原因": "未知秘境"}
	var 配置: Dictionary = 秘境配置[秘境ID]
	# 检查距离（秘境门户在西域，距离越远消耗越大）
	var 距离: float = 计算到城镇距离(配置["城镇ID"])
	var 距离加成: float = 距离 / 100.0  # 每100距离增加10%消耗
	var 实际消耗: int = int(float(配置["消耗灵石"]) * (1.0 + 距离加成))
	# 检查灵石
	if Game.灵石 < 实际消耗:
		return {"成功": false, "原因": "灵石不足（需%d，当前%d）" % [实际消耗, Game.灵石]}
	# 消耗灵石
	Game.灵石 -= 实际消耗
	# 标记已探索
	已探索秘境.append(秘境ID)
	Game._记录图录(秘境ID, "天下")
	# 添加纪事
	Game.添加纪事("探索", "秘境探索", "探索%s成功，消耗灵石%d，该秘境已对宗门弟子开放" % [秘境ID, 实际消耗], 0)
	Game._加推演条目("【探索】宗门弟子探索%s成功，该秘境已开放历练" % 秘境ID, "探索", "中")
	return {"成功": true, "秘境": 秘境ID, "消耗": 实际消耗, "推荐战力": 配置["推荐战力"], "描述": 配置["描述"]}

