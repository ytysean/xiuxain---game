# ============ 存档 ============
func to_dict() -> Dictionary:
	# 存档时确保进行中历练包含所有新增字段（路线/奇遇记录/决策状态）
	var 存档历练: Dictionary = {}
	for 实例ID in 进行中历练.keys():
		var 实例: Dictionary = 进行中历练[实例ID].duplicate()
		# 确保新增字段存在（兼容旧存档）
		if not 实例.has("路线"):
			实例["路线"] = "稳妥"
		if not 实例.has("奇遇记录"):
			实例["奇遇记录"] = []
		if not 实例.has("提前结束"):
			实例["提前结束"] = false
		if not 实例.has("继续深入"):
			实例["继续深入"] = false
		if not 实例.has("待处理奇遇"):
			实例["待处理奇遇"] = []
		存档历练[实例ID] = 实例
	return {
		"进行中历练": 存档历练,
		"已完成日常": 已完成日常.duplicate(),
		"已完成秘境": 已完成秘境.duplicate(),
		"稀有保底计数": 稀有保底计数.duplicate(),
		"历练实例计数器": 历练实例计数器,
		"调查任务列表": 调查任务列表.duplicate(),
		"调查进行中": 调查进行中.duplicate(),
		"调查实例计数器": 调查实例计数器,
		"历练历史记录": 历练历史记录.duplicate(),
	}

func from_dict(d: Dictionary) -> void:
	进行中历练 = d.get("进行中历练", {})
	# 兼容旧存档：为每个进行中历练补充新增字段
	for 实例ID in 进行中历练.keys():
		var 实例: Dictionary = 进行中历练[实例ID]
		if not 实例.has("路线"):
			实例["路线"] = "稳妥"
		if not 实例.has("奇遇记录"):
			实例["奇遇记录"] = []
		if not 实例.has("提前结束"):
			实例["提前结束"] = false
		if not 实例.has("继续深入"):
			实例["继续深入"] = false
		if not 实例.has("待处理奇遇"):
			实例["待处理奇遇"] = []
		进行中历练[实例ID] = 实例
	已完成日常 = d.get("已完成日常", [])
	已完成秘境 = d.get("已完成秘境", [])
	稀有保底计数 = d.get("稀有保底计数", {})
	历练实例计数器 = int(d.get("历练实例计数器", 0))
	调查任务列表 = d.get("调查任务列表", {})
	调查进行中 = d.get("调查进行中", {})
	调查实例计数器 = int(d.get("调查实例计数器", 0))
	历练历史记录 = d.get("历练历史记录", [])

