const 字体路径: Array = [
	"res://art/fonts/SourceHanSansCN-Regular.otf",
	"res://art/fonts/SourceHanSansCN-Bold.otf",
]


func _ready() -> void:
	print(">>>GLYPH_BEGIN n=%d" % 码位.size())
	for 路径 in 字体路径:
		var ff: FontFile = FontFile.new()
		var err: int = ff.load_dynamic_font(路径)
		print(">>>FONT %s err=%d" % [路径.get_file(), err])
		if err != OK:
			continue
		var 缺: int = 0
		for c in 码位:
			var 有: bool = ff.has_char(c)
			if not 有:
				缺 += 1
			print(">>>GLYPH %s U+%04X 有=%s" % [路径.get_file(), c, str(有)])
		print(">>>FONT_SUM %s 缺=%d/%d" % [路径.get_file(), 缺, 码位.size()])
	print(">>>GLYPH_END")
	get_tree().quit()

