## 尝试觉醒龙族传承
func 尝试觉醒龙族传承() -> Dictionary:
	if 种族 != "龙族":
		return {"成功": false, "因": "非龙族"}
	if 龙族传承 != "":
		return {"成功": false, "因": "已觉醒传承"}
	
	# 传承概率：普通50%/血脉30%/始祖10%/失败10%
	var rand: float = randf()
	var 结果: Dictionary = {"成功": false}
	if rand < 0.1:
		龙族传承 = "始祖传承"
		传承觉醒度 = 30.0
		全属性临时提升(20)
		结果 = {"成功": true, "传承": "始祖传承", "消息": "%s觉醒始祖传承！龙族始祖之力涌现，全属性大幅提升！" % 姓名}
	elif rand < 0.4:
		龙族传承 = "血脉传承"
		传承觉醒度 = 20.0
		全属性临时提升(10)
		结果 = {"成功": true, "传承": "血脉传承", "消息": "%s觉醒血脉传承！龙族血脉之力觉醒，属性提升。" % 姓名}
	elif rand < 0.9:
		龙族传承 = "普通传承"
		传承觉醒度 = 10.0
		全属性临时提升(5)
		结果 = {"成功": true, "传承": "普通传承", "消息": "%s觉醒普通传承，获得龙族基础传承。" % 姓名}
	else:
		结果 = {"成功": false, "消息": "%s传承觉醒失败，需继续积累。" % 姓名}
	
	战力 = 计算战力()
	return 结果

