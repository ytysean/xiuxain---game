	var 职位权限: Dictionary = {"老祖": 10, "长老": 8, "核心": 6, "内门": 4, "外门": 2, "附庸": 1}
	if 职位权限.get(布置者.家族职位, 0) < 8:
		return {"成功": false, "因": "家族职位不足，只有老祖/长老才能布置阵法"}
	# 特殊阵法需要家族等级5以上
