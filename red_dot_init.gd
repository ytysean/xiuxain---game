## 红点系统初始化模块
## 统一管理全游戏所有红点的注册、更新和层级关系
## 覆盖：任务可领 / 弟子请示 / 历练奇遇 / 宗门宗务·灵讯 / 日供 / 殿阁升级 / 纪事未读
## 全表设计判据见下方「红点判据铁则」。

extends Node

const RedDotManager := preload("res://red_dot_manager.gd")

## ★ 红点判据铁则（2026-09-16 定 · 本项目核心差异点，改红点前必读）
## 红点 = **宗主待裁决队列**的可视化，而不是「弟子进度提醒」。
## 判据一句话：「这件事宗主不做，弟子 AI 会不会替自己做？」——会自决的，一律不产生红点。
## 依据：门下弟子**全员内驱**（`disciple.gd::自动穿戴`／`私库自动用度`／`AI决定是否突破`／
##   `AI主动准备突破` 取库房丹药自服，全程无宗主参与）；宗主只在被「请示」时批复。
## ⇒ 弟子自穿装备、自服丹药、自行突破、自寻机缘 —— 走「纪事／传讯」**告知**，绝不红点催办。
##   （违例后果实证：`弟子_装备` 曾按「空槽 < 9」计 ⇒ 有弟子就常亮、点进去无事可做 ⇒
##    红点失去可信度，玩家对整个红点体系脱敏。）

## 红点ID常量定义（全游戏统一）
const 红点ID := {
	# 底部 Tab 层级 —— ★ 必须与 ui/bottom_tab_bar.gd 的 TABS 逐字一致。
	# 旧字典写的是 宗门/弟子/历练/坊市/更多，与真实底栏（宗门/弟子/殿阁/历练/纪事）
	#   有两个身份错位：多了不存在的「坊市」、少了真实的「殿阁」「纪事」；
	#   而底栏的红点节点又从未建过 ⇒ 这套 ID 既对不上、也没人承接，整体是死配置。
	"TAB_宗门": "TAB_宗门",
	"TAB_弟子": "TAB_弟子",
	"TAB_殿阁": "TAB_殿阁",
	"TAB_历练": "TAB_历练",
	"TAB_纪事": "TAB_纪事",

	# 宗门首页
	"宗门_宗务": "宗门_宗务",
	"宗门_灵讯": "宗门_灵讯",
	# （原 宗门_图录 已删：判据恒 false，属死配置 —— 留着只会污染红点表且永不可达）

	# 任务系统
	"任务_日常": "任务_日常",
	"任务_周常": "任务_周常",
	"任务_成就": "任务_成就",

	# 弟子系统 —— 只保留「弟子请示宗主裁夺」这一条。
	# 已删 弟子_突破／弟子_装备：二者均为弟子 AI 内驱自决项（见文件头铁则），
	#   挂红点即等于催宗主做弟子自己会做的事。
	# 弟子_请示 = 待抉择（极品道具交宗 or 自留）+ 请誓待批（批准 / 驳回），
	#   二者都落在弟子录内且必须宗主落笔，才是该 Tab 唯一合法的红点来源。
	"弟子_请示": "弟子_请示",

	# 历练系统
	# 已删 历练_结算（判据「到期未领」）：`检查并结算历练()` 在每日推演里自动跑，
	#   玩家只做「派遣」配置 ⇒ 该红点恒为 0，是自动结算改造后遗留的死判断。
	# 历练真正的宗主项 = 途中奇遇待抉择（`expedition.待处理奇遇`，玩家须选项）。
	"历练_奇遇": "历练_奇遇",

	# 快捷栏系统
	"快捷_日供": "快捷_日供",
	# （原 快捷_库藏 已删：判据恒 false，死配置）

	# 殿阁系统
	"殿阁_升级": "殿阁_升级",
	# ★ PH7-BATCH1E·C3：执法堂「待裁决违规 + 弟子请命」= 第三待裁决队列（须宗主落笔）。
	#   独立 ID，**不复用 宗门_宗务**（后者已被新手目标链绑定，塞两源会让数字与语义一起错）。
	"宗门_执法": "宗门_执法",

	# 纪事系统
	"纪事_未读": "纪事_未读",
}

var _管理器: RedDotManager = null

func _ready() -> void:
	初始化()

## 初始化红点系统
func 初始化() -> void:
	_管理器 = RedDotManager.new()
	add_child(_管理器)
	_注册层级关系()
	刷新所有红点()
	# 自注册为全项目红点状态源：UITheme 是 autoload，任何页面/控件都能只读访问
	# （子页面拿不到 main 的私有 _红点系统，逐层透传不现实）。
	UITheme.红点源 = _管理器

## 获取红点管理器
func 获取管理器() -> RedDotManager:
	return _管理器

## 注册红点层级关系（父级聚合子级）。
## 父级自身 count 恒为 0、只靠子级点亮 ⇒ 角标形态天然分档：
##   父级有 count（如 弟子_请示 3 件）→ 数字角标；父级仅状态（如 殿阁_升级）→ 圆点。
## 注：任务_日常/周常/成就 无对应底部 Tab（任务页是二级页），故不挂父子关系，
##   状态仍在管理器内维护，由任务页自身承接显示。
func _注册层级关系() -> void:
	# 底部 Tab 聚合（★ 右值必须是 bottom_tab_bar.TABS 里真实存在的项）
	_管理器.注册父子(红点ID.TAB_宗门, 红点ID.宗门_宗务)
	_管理器.注册父子(红点ID.TAB_宗门, 红点ID.宗门_灵讯)

	# 弟子 Tab 只有一条子源：弟子请示（数字型 → Tab 走数字角标）。
	# 弟子 AI 自穿装备 / 自服丹药 / 自行突破 全部不上红点（见文件头铁则）。
	_管理器.注册父子(红点ID.TAB_弟子, 红点ID.弟子_请示)

	_管理器.注册父子(红点ID.TAB_殿阁, 红点ID.殿阁_升级)
	_管理器.注册父子(红点ID.TAB_殿阁, 红点ID.宗门_执法)

	_管理器.注册父子(红点ID.TAB_历练, 红点ID.历练_奇遇)

	_管理器.注册父子(红点ID.TAB_纪事, 红点ID.纪事_未读)

## 刷新所有红点状态（数据变化时调用）
func 刷新所有红点() -> void:
	if _管理器 == null:
		return
	_刷新任务红点()
	_刷新弟子红点()
	_刷新历练红点()
	_刷新宗门红点()
	_刷新快捷栏红点()
	_刷新执法红点()
	_管理器.刷新所有()

## 刷新任务红点
func _刷新任务红点() -> void:
	# 日常任务可领取
	var 日常可领取: int = 0
	if Game != null and "当前日常" in Game and "日常已领" in Game:
		var 当前日常 = Game.当前日常
		var 日常已领 = Game.日常已领
		if 当前日常 != null and 日常已领 != null:
			for i in range(min(当前日常.size(), 日常已领.size())):
				if not bool(日常已领[i]):
					日常可领取 += 1
	_管理器.设置红点数量(红点ID.任务_日常, 日常可领取)

	# 周常任务可领取
	var 周常可领取: int = 0
	if Game != null and "周常已领" in Game:
		if not bool(Game.周常已领):
			周常可领取 = 1
	_管理器.设置红点数量(红点ID.任务_周常, 周常可领取)

	# 成就已达成
	var 成就已达成: int = 0
	if Game != null and "成就_已达成" in Game:
		var 已达成 = Game.成就_已达成
		if 已达成 != null:
			成就已达成 = 已达成.size()
	_管理器.设置红点数量(红点ID.任务_成就, 成就已达成)

## 刷新弟子红点。
## ★ 只统计「必须宗主落笔」的请示件数；弟子 AI 的内驱行为（装备 / 丹药 / 突破 / 机缘）
##   一律不进红点 —— 那是弟子自己会做的事，催宗主毫无意义且会钝化红点可信度。
## 数据源均为弟子录内已有的可点条目，红点与落点 1:1，不存在"点了没事干"。
func _刷新弟子红点() -> void:
	var 待裁: int = 0
	if Game != null and "待抉择" in Game:
		var 待抉择 = Game.待抉择
		if 待抉择 is Array:
			待裁 += 待抉择.size()
	if Game != null and "誓约待批" in Game:
		var 请誓 = Game.誓约待批
		if 请誓 is Array:
			待裁 += 请誓.size()
	_管理器.设置红点数量(红点ID.弟子_请示, 待裁)

## 刷新历练红点。
## 判据 = 历练途中「待处理奇遇」件数（存档内每实例至多 1 件，玩家须在历练页做选择）。
## 不用「到期可领取」：`检查并结算历练()` 已在每日推演自动跑完，该条件恒不成立。
func _刷新历练红点() -> void:
	var 待选: int = 0
	if ExpeditionSystem != null and ExpeditionSystem.has_method("获取进行中历练"):
		var 进行中 = ExpeditionSystem.获取进行中历练()
		if 进行中 is Dictionary:
			for 实例ID in 进行中.keys():
				var 实例 = 进行中[实例ID]
				if not (实例 is Dictionary):
					continue
				var 列 = 实例.get("待处理奇遇", [])
				if 列 is Array:
					待选 += 列.size()
	_管理器.设置红点数量(红点ID.历练_奇遇, 待选)

## 刷新宗门首页红点
func _刷新宗门红点() -> void:
	# 宗务红点（新手目标）
	var 宗务红点: bool = false
	if Game != null and Game.has_method("新手_有红点"):
		宗务红点 = bool(Game.新手_有红点())
	_管理器.设置红点(红点ID.宗门_宗务, 宗务红点)

	# 灵讯红点（未读邮件）
	var 未读邮件数: int = 0
	if Game != null and "邮件列表" in Game:
		var 邮件列表 = Game.邮件列表
		if 邮件列表 != null:
			for 邮件 in 邮件列表:
				if 邮件 != null and 邮件.has("未读") and bool(邮件["未读"]):
					未读邮件数 += 1
	_管理器.设置红点数量(红点ID.宗门_灵讯, 未读邮件数)

## 刷新执法红点（C3 · 第三待裁决队列）。
## 判据铁则：执法堂「待裁决违规」+「弟子请命」均须宗主落笔 ⇒ 合法亮红点；
## 数据源 = SectManager 真实待办队列 ⇒ 数量天然 == 真实待办数，处理完即回落（点进处理即消）。
func _刷新执法红点() -> void:
	var 待办: int = 0
	if SectManager != null:
		if SectManager.has_method("获取待裁决违规"):
			var 违规 = SectManager.获取待裁决违规()
			if 违规 is Array:
				待办 += 违规.size()
		if SectManager.has_method("获取待回应请示"):
			var 请示 = SectManager.获取待回应请示()
			if 请示 is Array:
				待办 += 请示.size()
	_管理器.设置红点数量(红点ID.宗门_执法, 待办)

## 刷新快捷栏红点
func _刷新快捷栏红点() -> void:
	# 日供红点：今日可领取时显示
	var 日供可领: bool = false
	if Game != null and Game.has_method("日供_今日可领"):
		日供可领 = bool(Game.日供_今日可领())
	_管理器.设置红点(红点ID.快捷_日供, 日供可领)

	# 殿阁升级红点：有可升级的殿阁时显示（宗主付费动土 ⇒ 合法红点）
	var 殿阁可升级: bool = false
	if Game != null and Game.has_method("有可升级殿阁"):
		殿阁可升级 = bool(Game.有可升级殿阁())
	_管理器.设置红点(红点ID.殿阁_升级, 殿阁可升级)

	# 纪事未读红点：有未读纪事时显示
	var 纪事未读: bool = false
	if Game != null and Game.has_method("有未读纪事"):
		纪事未读 = bool(Game.有未读纪事())
	_管理器.设置红点(红点ID.纪事_未读, 纪事未读)
