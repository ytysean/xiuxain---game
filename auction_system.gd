## 全局开关：是否允许弟子参与拍卖行（默认开启）
func 设置弟子拍卖权限_S34(弟子ID: int, 允许: bool) -> Dictionary:
	for d in Game.弟子列表:
		if d.弟子ID == 弟子ID:
			if 允许:
				d.拍卖权限 = true
				return {"成功": true, "原因": "已允许 %s 参与拍卖行" % str(d.姓名)}
			else:
				# 取消所有活跃委托
				for lot in 拍卖会.get("常驻拍品", []):
					for w in (lot.get("委托列表", []) as Array):
						if str(w.get("委托者类型", "")) == "弟子" and int(w.get("委托者ID", -1)) == 弟子ID:
							w["状态"] = "已取消"
							d.私库灵石 += int(w.get("冻结灵石", 0))
				for lot in 拍卖会.get("大拍拍品", []):
					for w in (lot.get("委托列表", []) as Array):
						if str(w.get("委托者类型", "")) == "弟子" and int(w.get("委托者ID", -1)) == 弟子ID:
							w["状态"] = "已取消"
							d.私库灵石 += int(w.get("冻结灵石", 0))
				d.拍卖权限 = false
				return {"成功": true, "原因": "已禁止 %s 参与拍卖行，所有委托已取消" % str(d.姓名)}
