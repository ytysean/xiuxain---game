		"仁心济世": return 0.05    # 惜身
		"贪心逐缘": return 0.05    # 精算利害
		"沉稳守道": return 0.10
		"守礼尊师": return 0.10
		"谨慎多疑": return 0.15    # 最不冒险
		"孤僻清修": return 0.00
