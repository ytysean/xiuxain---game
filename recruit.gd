## 计算招募消耗（按接引殿等级）
static func 招募消耗(接引殿等级: int) -> int:
	# 基础100灵石，每级+50
	return 100 + max(0, 接引殿等级 - 1) * 50

## 计算招募冷却（游戏日）
static func 招募冷却(接引殿等级: int) -> int:
	# 基础3天，每级-0.5天（最低1天）
	return max(1, 3 - int((接引殿等级 - 1) * 0.5))

## 随机生成弟子品质
static func 随机品质(接引殿等级: int) -> String:
	# 根据接引殿等级获取品质概率
	var 概率表 = 品质概率.get(1, 品质概率[1])
	if 接引殿等级 >= 10:
		概率表 = 品质概率[10]
	elif 接引殿等级 >= 8:
		概率表 = 品质概率[8]
	elif 接引殿等级 >= 5:
		概率表 = 品质概率[5]
	elif 接引殿等级 >= 3:
		概率表 = 品质概率[3]
	# 接引殿等级额外加成
	var 等级加成 = float(max(0, 接引殿等级 - 1)) * 0.01
	# 随机品质
	var 随机值 = randf()
	var 累计概率 = 0.0
	for 品质 in 品质列表:
		累计概率 += float(概率表.get(品质, 0)) + 等级加成
		if 随机值 <= 累计概率:
			return 品质
	return "凡品"

## 随机生成灵根
static func 随机灵根(品质: String) -> String:
	# 高品质弟子更容易获得特殊灵根
	var 特殊灵根概率加成 = 0.0
	match 品质:
		"良品": 特殊灵根概率加成 = 0.05
		"上品": 特殊灵根概率加成 = 0.1
		"极品": 特殊灵根概率加成 = 0.15
		"天品": 特殊灵根概率加成 = 0.2
		"仙品": 特殊灵根概率加成 = 0.3
		"神品": 特殊灵根概率加成 = 0.5
	# 随机灵根
	var 随机值 = randf()
	var 累计概率 = 0.0
	for 灵根 in 灵根列表:
		var 概率 = float(灵根概率.get(灵根, 0.1))
		if 灵根 in ["风雷根", "冰灵根", "雷灵根", "混沌灵根"]:
			概率 += 特殊灵根概率加成
		累计概率 += 概率
		if 随机值 <= 累计概率:
			return 灵根
	return "金灵根"

## 随机生成特殊背景
static func 随机背景(品质: String) -> Dictionary:
	# 高品质弟子更容易获得特殊背景
	var 背景概率 = 0.05
	match 品质:
		"上品": 背景概率 = 0.1
		"极品": 背景概率 = 0.15
		"天品": 背景概率 = 0.2
		"仙品": 背景概率 = 0.3
		"神品": 背景概率 = 0.5
	if randf() > 背景概率:
		return {}
	return 特殊背景.pick_random()

## 随机触发招募事件
static func 随机事件() -> Dictionary:
	var 随机值 = randf()
	var 累计概率 = 0.0
	for 事件 in 招募事件:
		累计概率 += float(事件.get("概率", 0))
		if 随机值 <= 累计概率:
			return 事件
	return 招募事件[-1]

## 生成新弟子（完整属性）
static func 招募弟子(接引殿等级: int) -> Dictionary:
	var 消耗 = 招募消耗(接引殿等级)
	var 冷却 = 招募冷却(接引殿等级)
	# 触发招募事件
	var 事件 = 随机事件()
	# 随机品质
	var 品质 = 随机品质(接引殿等级)
	# 事件效果
	if 事件.get("名", "") == "偶遇高人":
		var 品质索引 = 品质列表.find(品质)
		if 品质索引 < 品质列表.size() - 1:
			品质 = 品质列表[品质索引 + 1]
	elif 事件.get("名", "") == "世家投奔":
		var 品质索引 = max(品质列表.find("上品"), 品质列表.find(品质))
		品质 = 品质列表[品质索引]
	elif 事件.get("名", "") == "仙人转世":
		var 品质索引 = max(品质列表.find("天品"), 品质列表.find(品质))
		品质 = 品质列表[品质索引]
	# 随机灵根
	var 灵根 = 随机灵根(品质)
	if 事件.get("名", "") == "天降祥瑞":
		灵根 = ["风雷根", "冰灵根", "雷灵根", "混沌灵根"].pick_random()
	# 随机特殊背景
	var 背景 = 随机背景(品质)
	# 等级加成
	var 等级加成: float = float(max(0, 接引殿等级 - 1)) * 0.02
	return {
		"消耗": 消耗,
		"冷却": 冷却,
		"品质": 品质,
		"灵根": 灵根,
		"背景": 背景,
		"事件": 事件,
		"等级加成": 等级加成,
		"描述": "接引殿Lv.%d：消耗%d灵石，冷却%d天，招募到【%s】%s，灵根：%s%s" % [
			接引殿等级, 消耗, 冷却, 品质,
			背景.get("名", "普通弟子") if not 背景.is_empty() else "普通弟子",
			灵根,
			"，触发事件：%s" % 事件.get("名", "") if 事件.get("名", "") != "普通招募" else ""
		]
	}
