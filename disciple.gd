# ============ 防御属性溢出治理双结算接口（§9.4.5-9.4.7）============
# 接口1：面板等效战力（get_defense_power）—— 用于UI显示，25%封顶
# 接口2：机制层减伤·规避（get_battle_defense）—— 用于战斗结算，独立硬上限

## 面板等效战力（§9.4.5 生存时间等价法，25%封顶）
## 返回：防御等效战力（不超过基础战力的25%）
func get_defense_power() -> int:
	var combat_attr: Dictionary = get_final_combat_attr()
	var base_power: int = int(combat_attr.get("战力", 0))
	var defense: int = int(combat_attr.get("属性", {}).get("防", 0))
	var evasion_rate: float = float(combat_attr.get("闪避率", 0.0))
	var reduction_rate: float = BattleUtil.calc_dmg_reduction(defense)
	return BattleUtil.calc_defense_power(base_power, defense, evasion_rate, reduction_rate)

## 机制层减伤·规避（§9.4.6 四层防御独立乘区，独立硬上限）
## 返回：战斗防御字典 {evasion_rate, reduction_rate, resist_rate, defense_value}
func get_battle_defense() -> Dictionary:
	var combat_attr: Dictionary = get_final_combat_attr()
	var defense: int = int(combat_attr.get("属性", {}).get("防", 0))
	var base_evasion: float = float(combat_attr.get("闪避率", 0.0))
	# 技能/功法闪避加成（从已修功法被动中获取，当前简化为0）
	var skill_evasion: float = 0.0
	# 装备/套装闪避加成（从装备词缀中获取，当前简化为0）
	var equip_evasion: float = 0.0
	# 大阵/特殊闪避加成（从当前法阵中获取，当前简化为0）
	var array_evasion: float = 0.0
	# 统一计算闪避率（自动卡40%上限）
	var evasion_rate: float = BattleUtil.calc_evasion_rate(base_evasion, skill_evasion, equip_evasion, array_evasion)
	# 统一计算减伤率（自动卡75%上限）
	var reduction_rate: float = BattleUtil.calc_dmg_reduction(defense)
	# 统一计算抗性率（自动卡80%上限，当前简化为0）
	var resist_rate: float = BattleUtil.calc_resist(0.0, 0.0, 0.0, 0.0)
	return {
		"evasion_rate": evasion_rate,
		"reduction_rate": reduction_rate,
		"resist_rate": resist_rate,
		"defense_value": defense,
		"defense_power": get_defense_power(),
	}

## 境界压制检查（§9.4.7 独立处理）
## 参数：opponent_realm 对手境界
## 返回：境界压制效果字典
func check_realm_suppress(opponent_realm: String) -> Dictionary:
	return BattleUtil.realm_suppress(境界, opponent_realm)

## 最终伤害计算（整合所有防御乘区，供战斗结算使用）
## 参数：base_damage 基础伤害, attacker 攻击者战斗属性
## 返回：最终伤害字典
func calc_final_damage_taken(base_damage: int, attacker: Dictionary) -> Dictionary:
	var defender_attr: Dictionary = get_final_combat_attr()
	return BattleUtil.calc_final_damage(base_damage, attacker, defender_attr)
