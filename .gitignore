# Godot 编辑器缓存（本地生成，绝不进版本库）
.godot/

# Godot 用户数据目录（APPDATA 缺失时 user:// 退化为工程内相对路径，
# 会把玩家存档 save.json / profiles 落进仓库并可能被打进 pck —— 上线级隐患，绝不进库）
Godot/

# Python 缓存
__pycache__/

# Agent 工作内存（项目私有，不进游戏仓库）
.workbuddy/

# Godot CSV 翻译导入产物（随 CSV 导入自动再生，非手维护）
*.translation

# 本地冗余备份（原始文件有 Git 版本管理兜底，禁止进库）
*.bak

# Godot 自动生成导入元数据（随资源导入自动再生，非手维护，不进库）
*.import

# 本地临时校验报告（pre_f5 本地生成，不进库）
validate_report.txt

# 会话临时脚本（Agent 跑校验/生成器/负向测试的 scratch 产物，非交付物，禁进库）
.cache_*
.p1c_*
.p1q_*
.zz_*
.pchk.txt
.rmlog.txt
.tmp_cleanup.txt

# 图标管线本地派生/备份（_bases 可由 tier_system.py 重生成；cohesion_backup 为本地还原快照，均禁进库）
icon/_bases/
icon/_validation/cohesion_backup/

# 全量 UI 实机验收产物（本地验证截图 + 总览页，非源码，不进库）
# 说明：tests/ui_full_accept.tscn 是防线本体（要进库）；它跑出来的 PNG 是本地产物（不进库）
accept_shots/
accept_shots_full/
accept_shots_p2/
accept_shots_p2b/
accept_report.html
accept_fangshi_before_after.png
accept_font_pilot*

# 备份文件的时间戳/标签后缀变体（上面的 *.bak 只覆盖了后缀恰好为 .bak 的）
*.bak_*

# 美术资源（本地保留、不进版本库；历史已在 filter-branch 中剔除，远端的美术走本地/备份同步）
# 说明：art/ 含全部立绘/图标/纹理（4900+ 文件，数 GB），icon/ 为旧废弃图标根，美术资源/ 为 UI mockups 参考图
art/
icon/
美术资源/
验收图/
generated-images/
.scratch_backup/
backup_scripts/
