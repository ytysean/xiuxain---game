	for 事件名 in 稀有种族事件:
		var 配置: Dictionary = 稀有种族事件[事件名]
		var 概率: float = float(配置.get("概率", 0.01))
		if randf() < 概率:
			# 检查条件
			var 条件: Dictionary = 配置.get("条件", {})
			var 满足条件: bool = true
			# TODO: 检查宗门等级/气运/业力等条件
			if 满足条件:
				var 事件: Dictionary = {
					"事件名": 事件名,
					"种族": str(配置.get("种族", "")),
					"效果": str(配置.get("效果", "")),
					"奖励": 配置.get("奖励", {}),
					"时间": Game.累计游戏日,
					"已处理": false
				}
				事件列表.append(事件)
	return 事件列表

## 处理稀有种族事件（玩家选择接纳/拒绝）
func 处理稀有种族事件(事件: Dictionary, 接纳: bool) -> Dictionary:
	var 事件名: String = str(事件.get("事件名", ""))
	var 种族: String = str(事件.get("种族", ""))
	var 配置: Dictionary = 稀有种族事件.get(事件名, {})
	
	if 接纳:
		# 接纳：获得该种族弟子
		var 新弟子: Dictionary = {"种族": 种族, "来源": 事件名}
		# TODO: 创建新弟子并加入弟子列表
		var 奖励: Dictionary = 配置.get("奖励", {})
		return {"成功": true, "消息": "接纳%s修士，获得%s弟子！" % [种族, 种族], "弟子": 新弟子, "奖励": 奖励}
	else:
		# 拒绝：失去机会
		return {"成功": true, "消息": "拒绝了%s修士的请求。" % 种族}

# ===== 多种族修炼体系 P3：月度种族推进 =====
func _月度种族推进_P3() -> void:
	# 初始化种族关系
	_初始化种族关系()
	# 检查种族冲突
	var 冲突事件: Array = _检查种族冲突()
	if not 冲突事件.is_empty():
		var 处理结果: Array = _处理种族冲突(冲突事件)
		for 结果 in 处理结果:
			Game._加推演条目("⚠ " + str(结果.get("影响", "")), "种族冲突", "高")
	# 检查种族通婚
	var 通婚事件: Array = _检查种族通婚()
	for 事件 in 通婚事件:
		Game._加推演条目("★ %s与%s结为道侣（异族联姻）！" % [str(事件.get("弟子1", "")), str(事件.get("弟子2", ""))], "异族联姻", "中")
	# 检查稀有种族事件
	var 稀有事件: Array = _检查稀有种族事件()
	for 事件 in 稀有事件:
		Game._加推演条目("★ " + str(事件.get("效果", "")), "稀有种族", "高")
	# 种族关系自然恢复（每月+1）
	for key in 种族关系表:
		种族关系表[key] = clamp(int(种族关系表[key]) + 1, -100, 100)

# ===== 序列化/反序列化（用于存档）=====
func to_dict() -> Dictionary:
	var data: Dictionary = {}
	data["种族关系表"] = 种族关系表
	data["种族冲突事件记录"] = 种族冲突事件记录
	data["种族通婚记录"] = 种族通婚记录
	return data

func from_dict(data: Dictionary) -> void:
	if "种族关系表" in data: 种族关系表 = data["种族关系表"]
	if "种族冲突事件记录" in data: 种族冲突事件记录 = data["种族冲突事件记录"]
	if "种族通婚记录" in data: 种族通婚记录 = data["种族通婚记录"]
