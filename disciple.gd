# ============ 灵兽契约战力（P0 双槽 + 双层适配加成）============
# 公式：灵兽总战力 = Σ(主宠/副宠) [ 本体战力 × (1+适配加成) × 战力比例(0.30) × 槽位比例(主1.0/副0.3) ]
# 适配加成 = 道途类型适配 +20% + 灵根属性适配 +8%，加法叠加，上限 28%（无匹配不惩罚，基础全额）
func 灵兽契约战力() -> int:
	var 总和: int = 0
	for b in [主宠灵兽, 副宠灵兽]:
		if b == null or b.孵化中:
			continue
		var 本体: int = b.本体战力()
		var 加成后: int = int(float(本体) * (1.0 + calc_beast_bonus(b, self)))
		总和 += b.战力贡献(加成后)
	return 总和

# P0 双槽双层适配加成：道途类型适配 +20% + 灵根属性适配 +8%，加法叠加，上限 28%
# 第一层：灵兽类型 ↔ 弟子道途适配（attack→道修/法修；defense→体修；support→御兽师/符箓师/毒师/傀儡师）
# 第二层：灵根属性适配（原"随机天赋契合"转化；天赋为灵根类型且关联=弟子灵根）
func calc_beast_bonus(兽: Beast, 弟子: Disciple) -> float:
	var 加成: float = 0.0
	if 弟子.道途 != "" and 兽.beast_type in Beast.类型适配道途:
		if 弟子.道途 in Beast.类型适配道途[兽.beast_type]:
			加成 += 0.20
	if 兽.天赋类型 == "灵根" and 兽.天赋关联 == 弟子.灵根:
		加成 += 0.08
	# T14 忠诚度：满忠诚额外+8%加法叠加，忠诚0不惩罚（只加不减），与道途/灵根同链路
	加成 += (float(兽.忠诚度) / 100.0) * 0.08
	return min(加成, 0.36)   # 道途0.20+灵根0.08+忠诚0.08 = 0.36 总上限

# ============ 灵兽实战属性映射（S1 战斗生效·优先级1）============
# 与 灵兽契约战力() 共用同一「本体战力 × 战力比例帽(0.30) × 槽位比例(主1.0/副0.3) × 适配加成(1+bonus)」因子；
# 仅前者坍缩为标量战力（进 总战力()/战力 字段）、后者按类型权重分发为 攻防血速 四维增量。
# 加法叠加进 get_final_combat_attr 的 战斗属性（经 _聚合未来战力来源 统一入口），不新增独立乘区，满足战力映射铁律。
func 灵兽单宠实战属性(兽: Beast) -> Dictionary:
	var 零: Dictionary = {"攻": 0, "防": 0, "血": 0, "速": 0}
	if 兽 == null or 兽.孵化中:
		return 零
	if not 兽.is_main_pet and not 兽.is_deputy_pet:
		return 零   # 仅持有未出战：不折算实战属性
	var 槽位比例: float = 1.0 if 兽.is_main_pet else 0.3
	var 系数: float = 兽.战力比例 * 槽位比例 * (1.0 + calc_beast_bonus(兽, self))
	var 本体: Dictionary = 兽.本体属性()
	var r: Dictionary = {}
	for _st in ["攻", "防", "血", "速"]:
		r[_st] = int(float(本体.get(_st, 0)) * 系数)
	return r

# 双槽灵兽折算后的实战属性增量汇总（主宠100%帽内 + 副宠30%帽内）
func 灵兽属性加成() -> Dictionary:
	var 聚合: Dictionary = {"攻": 0, "防": 0, "血": 0, "速": 0}
	for b in [主宠灵兽, 副宠灵兽]:
		if b == null or b.孵化中:
			continue
		var 单兽: Dictionary = 灵兽单宠实战属性(b)
		for _st in ["攻", "防", "血", "速"]:
			聚合[_st] += 单兽.get(_st, 0)
	return 聚合

# 出战灵兽快照（S1 战斗生效·优先级2）：仅含已设主/副宠的 名/类型/主副，供 BattleManager 编排层注入战斗日志
func _灵兽出战快照() -> Array:
	var r: Array = []
	for b in [主宠灵兽, 副宠灵兽]:
		if b != null and not b.孵化中 and (b.is_main_pet or b.is_deputy_pet):
			r.append({"名": b.种类名, "类型": Beast.类型中文.get(b.beast_type, ""), "主副": "主" if b.is_main_pet else "副"})
	return r

# ============ 装备穿戴（ADR-001 D1 / Epic A2）============
# 背包=未穿戴；装备=槽位 key -> Item（仅已穿戴）。槽位 key 取 item.穿戴位（本 Sprint 沿用既有 9 值，9→7 重命名留后续 Sprint）
func 穿戴(槽: String, it: Item):
	if it == null or 槽 == "" or not it.可穿戴():
		return
	# S53：滴血认主（穿戴无主装备时自动认主）
	if it.认主类型 == "无主":
		it.滴血认主(str(弟子ID))
	# 检查装备是否已经被其他弟子穿戴，如果是就先从其他弟子那里卸载
	# 使用装备的名称、品阶、穿戴位等属性来比较，而不是比较对象引用
	if is_instance_valid(Game):
		for other in Game.弟子列表:
			if other != self and other != null:
				for k in other.装备.keys():
					var other_it = other.装备[k]
					if other_it != null and other_it.名称 == it.名称 and other_it.品阶 == it.品阶 and other_it.穿戴位 == it.穿戴位:
						other.卸载(k)
						break
	if 背包.has(it):
		背包.erase(it)
	# 若 it 已在其它槽，先摘下（防同物双槽）
	for k in 装备.keys():
		if 装备[k] == it:
			装备.erase(k)
			break
	if 装备.has(槽):
		var 旧: Item = 装备[槽]
		背包.append(旧)        # 原槽物退回背包
	装备[槽] = it
	# 穿戴装备后自动更新战力
	战力 = 计算战力()
	_应用命格养成加成()	# S43：装备修炼词条随穿戴刷新
	if is_instance_valid(Game):
		Game.弟子变动.emit()

func 卸载(槽: String):
	if 装备.has(槽):
		var 旧: Item = 装备[槽]
		装备.erase(槽)
		if not 背包.has(旧):
			背包.append(旧)
		# 卸载装备后自动更新战力
		战力 = 计算战力()
		_应用命格养成加成()	# S43：装备修炼词条随卸载刷新
		if is_instance_valid(Game):
			Game.弟子变动.emit()

# §4.0 弟子自主层：储物法宝容量
#   激活 equip_019 储物袋「背包容量+20」/ equip_024 空间戒指「背包容量+200」——
#   此前这两张图纸的效果描述全仓零消费，是空头支票；此处为其唯一真源。
const 私库基础容量: int = 20


## 私库容量上限：基础 20 + 随身储物法宝加成（已穿戴 与 背包内 均计入）
##   容量是私藏的硬闸门：藏满了就只能老实上报，逼玩家在「给弟子配储物法宝」与「产出归公」间取舍
func 私库容量上限() -> int:
	var 上限: int = 私库基础容量
	for 槽 in 装备.keys():
		上限 += _储物容量加成(装备[槽])
	for 物 in 背包:
		上限 += _储物容量加成(物)
	return 上限


## 单件法宝提供的储物容量（按名称匹配，与 game_state 图纸表 equip_019/equip_024 对齐）
func _储物容量加成(it: Item) -> int:
	if it == null:
		return 0
	var 名: String = str(it.名称)
	if 名.contains("空间戒指"):
		return 200
	if 名.contains("储物袋"):
		return 20
	return 0


# 获得物品：入背包并尝试自动穿戴（更优则替换）；受 品阶≤境界 佩戴限制
func 获得物品(it: Item):
	背包.append(it)
	自动穿戴(it)

# 自动穿戴：空槽直接上；占槽则 战力加成 更高者替换（贪心，对齐 UX 一键最优口径）
func 自动穿戴(it: Item):
	if it == null or not it.可穿戴():
		return
	if not _品阶不高于境界(it):
		return
	var 槽: String = it.穿戴位
	var 现: Item = 装备.get(槽)
	if 现 == null or it.战力加成 > 现.战力加成:
		穿戴(槽, it)

# 一键最优穿戴：遍历背包可穿戴物，按 战力加成 贪心填各槽（受 品阶≤境界 限制）
func 一键最优穿戴():
	var 候选: Array = 背包.duplicate()
	for it in 候选:
		if it.可穿戴() and _品阶不高于境界(it):
			var 槽: String = it.穿戴位
			var 现: Item = 装备.get(槽)
			if 现 == null or it.战力加成 > 现.战力加成:
				穿戴(槽, it)

func _品阶不高于境界(it: Item) -> bool:
	var 境阶: String = 境界表[境界].get("品阶", "fan_jie")
	var i物: int = Item.品阶序key.find(it.品阶)
	var i境: int = Item.品阶序key.find(境阶)
	if i物 < 0 or i境 < 0:
		return true      # 未知品阶不拦截（防御）
	return i物 <= i境

# ===================== S34-P0 私库物品自动使用 =====================
# §4.0 弟子自主层：私库物品自动使用（信息不对称的核心乐趣）
#   宗主看不到具体使用过程，只能看到战力/心魔/受伤等状态变化
#   触发时机：月度推演时调用，弟子自主决定使用哪些私藏物品
#   设计原则：复用现有穿戴/丹药逻辑，不重复造轮子；旧装备留私库不回背包（保持隐秘性）

## 私库自动使用总入口：月度推演时调用，依次执行装备穿戴、丹药服用
func 私库自动使用() -> void:
	if 私库.is_empty():
		return
	私库自动穿戴()
	私库自动服用丹药()
	# 功法自动学习、符箓自动使用在P1阶段实现

## 私库装备自动穿戴：遍历私库可穿戴物，按战力加成贪心替换
#   穿戴限制：品阶≤境界（复用 _品阶不高于境界）
#   旧装备留在私库，不回背包（保持私库的"隐秘性"）
#   安全实现：先收集候选，再统一穿戴，避免遍历中修改数组
func 私库自动穿戴() -> void:
	# 第一步：收集所有可穿戴且品阶合格的候选物品，按战力加成降序
	var 候选: Array = []
	for it in 私库:
		if it == null or not it.可穿戴():
			continue
		if not _品阶不高于境界(it):
			continue
		候选.append(it)
	候选.sort_custom(func(a: Item, b: Item) -> bool: return a.战力加成 > b.战力加成)
	# 第二步：逐个尝试穿戴，旧装备放回私库
	var 已穿戴: Array = []
	for it in 候选:
		if 已穿戴.has(it):
			continue
		var 槽: String = it.穿戴位
		var 现: Item = 装备.get(槽)
		if 现 == null or it.战力加成 > 现.战力加成:
			if 现 != null and not 已穿戴.has(现):
				私库.append(现)
			穿戴(槽, it)
			已穿戴.append(it)
	# 第三步：从私库中移除已穿戴的物品
	for it in 已穿戴:
		私库.erase(it)

## 私库丹药自动服用：根据弟子状态自动服用对应丹药
#   触发条件：心魔高→清心丹、受伤→疗伤丹、瓶颈期→突破丹、正常→修炼丹
#   服用后丹药从私库消失，属性变化不通知宗主（信息不对称）
#   安全实现：先收集应服用丹药，应用效果后统一移除
func 私库自动服用丹药() -> void:
	var 已服用: Array = []
	for it in 私库:
		if it == null or it.类别 != "dan_yao":
			continue
		var 名: String = str(it.名称)
		var 应服用: bool = false
		# 清心丹：心魔值>50时服用，降低心魔
		if 名.contains("清心") and 心魔值 > 50:
			心魔值 = max(0, 心魔值 - 20)
			应服用 = true
		# 疗伤丹：受伤剩余>0时服用，加速恢复
		elif 名.contains("疗伤") and 受伤剩余 > 0:
			受伤剩余 = max(0, 受伤剩余 - 5)
			应服用 = true
		# 突破丹/筑基丹/破境丹：瓶颈打磨值>0时服用，加速瓶颈打磨
		elif (名.contains("突破") or 名.contains("筑基") or 名.contains("破境")) and 瓶颈打磨值 > 0:
			瓶颈打磨值 = min(1.0, 瓶颈打磨值 + 0.1)
			应服用 = true
		# 修炼丹/培元丹/聚灵丹：丹毒不高时服用，增加修炼进度（S1修复：原只加丹毒纯亏）
		elif (名.contains("修炼") or 名.contains("培元") or 名.contains("聚灵")) and 丹毒 < 50:
			丹毒 += 1
			# 按丹药品质给修炼进度加成：修炼丹0.03/培元丹0.06/聚灵丹0.1
			var 丹加成: float = 0.03
			if 名.contains("培元"):
				丹加成 = 0.06
			elif 名.contains("聚灵"):
				丹加成 = 0.1
			修炼进度 = min(1.0, 修炼进度 + 丹加成)
			应服用 = true
		# 其他丹药：10%概率尝试性使用（弟子好奇/尝试）
		elif randf() < 0.1:
			应服用 = true
		if 应服用:
			已服用.append(it)
	# 从私库中移除已服用的丹药
	for it in 已服用:
		私库.erase(it)

# §11.21.5 自修复：装备物不应重复出现在背包；穿戴位须与槽 key 一致；材料/丹药不可穿戴
func _修复装备一致性():
	for 槽 in 装备.keys():
		var it = 装备[槽]
		if it == null:
			装备.erase(槽)
			continue
		# 防御旧档/历史 bug：材料或丹药误穿到装备槽，卸载回背包并清空穿戴位
		# 双保险：按类别判断 + 按名称兜底（旧档中材料名被误存为法器/神兵/法宝类别）
		if it.类别 in ["ling_cai", "dan_yao"] or it.是材料名称(it.名称):
			it.穿戴位 = ""
			it.类别 = "ling_cai"
			背包.append(it)
			装备.erase(槽)
			continue
		if not it.可穿戴():
			背包.append(it)
			装备.erase(槽)
			continue
		if 背包.has(it):
			背包.erase(it)
		if it.穿戴位 != 槽:
			if 装备.has(it.穿戴位):
				背包.append(it)
				装备.erase(槽)
			else:
				装备.erase(槽)
				装备[it.穿戴位] = it
	_去重背包()

func _去重背包():
	var 唯一: Array[Item] = []
	for it in 背包:
		if not 唯一.has(it):
			唯一.append(it)
	背包 = 唯一

func 加权随机(权重: Dictionary) -> String:
	var 总: float = 0.0
	for k in 权重:
		总 += 权重[k]
	var 抽: float = randf() * 总
	for k in 权重:
		抽 -= 权重[k]
		if 抽 <= 0:
			return k
	return 权重.keys()[0]

# 命格生成：按品质档权重池抽取 destiny_id（CSV 驱动，无隐藏特殊概率）
func _按权重抽命格(权重: Dictionary) -> String:
	var 池: Array = []
	for g in 权重.keys():
		for id in DestinyDataLoader.ids_by_grade().get(g, []):
			池.append({"id": id, "w": float(权重[g])})
	if 池.is_empty():
		return ""
	var 总: float = 0.0
	for x in 池:
		总 += x["w"]
	var r: float = randf() * 总
	for x in 池:
		r -= x["w"]
		if r <= 0:
			return x["id"]
	return 池[池.size() - 1]["id"]

# 修炼速度倍率（乘性归集）：灵根主导已并入 基础修炼速度；此处仅叠加 修行型命格。
# 宗门加成（灵脉/负责人/藏经阁/气运）改为 推演一月 加法叠加封顶，不在此乘入，避免双重叠加。
func 总修炼速度倍率() -> float:
	var 倍率: float = 1.0
	# 来源：修行型命格（常驻）
	var 命格数据: Dictionary = DestinyDataLoader.get_destiny(destiny_id)
	if 命格数据.get("类型", "") == "修行" and 命格数据.get("维度", "") == "修炼":
		倍率 *= (1.0 + float(命格数据.get("数值", 0)) / 100.0)
	# S1 批6-B：当前单人法阵·修炼辅助（乘性并入；宗门大阵聚灵走 推演一月 宗门加成pct，不在此）
	if not 当前法阵.is_empty():
		var 阵cfg: Dictionary = Game.阵法配置表.get(当前法阵.get("array_id", ""), {})
		if not 阵cfg.is_empty() and "修炼" in 阵cfg.get("eff_dim", ""):
			var 阵eff: float = float(阵cfg.get("eff_val_base", "0")) * (1.0 + (int(当前法阵.get("等级", 1)) - 1) * float(阵cfg.get("level_growth_coef", "0")))
			if _灵根匹配法阵(阵cfg):
				阵eff *= 1.05
			倍率 *= (1.0 + clamp(阵eff, 0.0, 0.15))   # 单源子帽 ≤15%（[PLACEHOLDER] 真机校准）
	# 宗主皮肤全宗加成
	if Game != null and Game.has_method("取宗主皮肤全宗加成"):
		var 宗主加成: Dictionary = Game.取宗主皮肤全宗加成()
		var 修为加成: float = float(宗主加成.get("修为", 0))
		if 修为加成 > 0:
			倍率 *= (1.0 + 修为加成 / 100.0)
	# 宗主称号全宗修炼加成
	if Game != null and Game.has_method("获取宗主称号加成"):
		var 称号修炼加成: float = Game.获取宗主称号加成("全宗修炼")
		if 称号修炼加成 > 0:
			倍率 *= (1.0 + 称号修炼加成)
	# 弟子个人称号修炼速度加成
	if Game != null and Game.has_method("获取称号加成"):
		var 个人修炼加成: float = Game.获取称号加成(self, "修炼速度")
		if 个人修炼加成 > 0:
			倍率 *= (1.0 + 个人修炼加成)
	# 天骄/俊杰：修炼速度 +20%（判据在 Game，避免此处再写一份天骄集合判定）
	if Game != null and Game.has_method("获取天骄修炼加成"):
		倍率 *= float(Game.获取天骄修炼加成(int(弟子ID)))
	# 特殊体质修炼加成
	倍率 *= (1.0 + 体质修炼加成())
	return 倍率

# 基础修炼速度（灵根主导×种族系数；旧规则回退资质速度）
func _基础修炼速度值() -> float:
	var base: float = 1.0
	if 新修炼规则:
		base = 灵根品阶速度.get(灵根品阶, 1.0)
	else:
		base = 资质表.get(资质, {}).get("速度", 1.0)
	# 多种族修炼体系：种族修炼速度系数（妖族化形后恢复正常）
	return base * 获取种族修炼速度()

# 修行型命格常驻加成：乘入修炼速度（含突破加速等效）
func _应用命格养成加成():
	# 先回到基础值，避免 from_dict / 重复调用时累乘
	修炼速度 = 基础修炼速度 * 总修炼速度倍率()
	# 多种族修炼体系 P1：种族特色修炼加成
	if 种族 == "鬼族":
		# 鬼族阴气修炼加成
		修炼速度 *= 获取阴气修炼加成()
		# 鬼族白天修炼惩罚（简化：每月平均按70%计算）
		修炼速度 *= 获取白天修炼惩罚()
	elif 种族 == "龙族":
		# 龙族龙珠修炼加成
		修炼速度 *= 获取龙珠修炼加成()
	elif 种族 == "魔族" and 走火入魔:
		# 魔族走火入魔时修炼速度-50%
		修炼速度 *= 0.5
	# S43 装备词条·修炼：聚合已穿戴装备的「修炼」类词条（穿戴/卸载时重算）
	if is_instance_valid(Game) and Game.has_method("装备修炼加成"):
		修炼速度 += Game.装备修炼加成(self)
	# S45-5 符词条·修炼：聚合佩戴护身符的「修炼」类词条
	if is_instance_valid(Game) and Game.has_method("护身符修炼加成"):
		修炼速度 += Game.护身符修炼加成(self)

# S52：随机休闲天赋（修真世界观：弟子各有所好）
func _随机休闲天赋() -> String:
	var rp: float = randf()
	if rp < 0.05:
		return "钓道"
	elif rp < 0.10:
		return "酿道"
	elif rp < 0.15:
		return "茶道"
	elif rp < 0.20:
		return "琴道"
	elif rp < 0.25:
		return "厨道"
	elif rp < 0.28:
		return "棋道"
	elif rp < 0.31:
		return "画道"
	else:
		return "无"

func 随机生成():
	# 资质与宗门等级挂钩（低等级宗门招不到高资质弟子）
	# 1-3级：凡俗60%/平庸30%/优良10%（无天才/妖孽/旷世）
	# 4-6级：凡俗45%/平庸30%/优良18%/天才6%/妖孽1%（无旷世）
	# 7-9级：凡俗30%/平庸25%/优良25%/天才14%/妖孽5%/旷世1%
	# 10级：凡俗20%/平庸20%/优良25%/天才20%/妖孽10%/旷世5%
	var 宗门等级: int = 1
	if Game != null:
		宗门等级 = int(Game.门派等级)
	var 资质权重_调整: Dictionary = 资质权重.duplicate()
	if 宗门等级 <= 3:
		资质权重_调整 = {"fan_su": 60.0, "pingyong": 30.0, "youliang": 10.0, "tiancai": 0.0, "yaonie": 0.0, "kuangshi": 0.0}
	elif 宗门等级 <= 6:
		资质权重_调整 = {"fan_su": 45.0, "pingyong": 30.0, "youliang": 18.0, "tiancai": 6.0, "yaonie": 1.0, "kuangshi": 0.0}
	elif 宗门等级 <= 9:
		资质权重_调整 = {"fan_su": 30.0, "pingyong": 25.0, "youliang": 25.0, "tiancai": 14.0, "yaonie": 5.0, "kuangshi": 1.0}
	else:
		资质权重_调整 = {"fan_su": 20.0, "pingyong": 20.0, "youliang": 25.0, "tiancai": 20.0, "yaonie": 10.0, "kuangshi": 5.0}
	资质 = 加权随机(资质权重_调整)
	# 性格先于立绘确定：立绘变体由「气质」（性格派生）决定，见「气质轴」
	性格 = str(性格表.pick_random())
	# 立绘三维（对齐美术 90 原型 = 灵根5 × 气质6 × 资质3）：
	#   底模（文件名第 2 段） = 气质（确定性 → 外观读出气质）
	#   变体槽位 _v{n}         = 灵根（确定性 → 视觉表现 = 服装主色）
	#   后缀                   = 资质（无 / _elite / _top）
	# 缺图时 取立绘路径() 逐档 fallback（零破坏）；美术按
	#   depth_{气质底模}_{性别}_{姿势}[_v{灵根序}][_年龄段][_资质档].png 出图即自动生效
	var 可用类型: Array = 扫描可用立绘类型()
	var 底模: String = 获取立绘底模()
	if not 可用类型.is_empty() and not 可用类型.has(底模):
		底模 = 可用类型.pick_random()   # 该气质底模缺图 → 回退任意可用底模（不报错）
	立绘类型 = 底模 if 底模 != "" else "chen"
	性别 = 性别列表.pick_random()
	立绘变体 = 获取灵根序()   # 变体槽位 = 灵根序（0金 1木 2水 3火 4土；5=变异/天灵根）
	年龄段 = "少年" if 年龄 < 18 else "青年"  # 初始外观按入门年龄
	基础修炼速度 = _基础修炼速度值()
	修炼速度 = 基础修炼速度 * 总修炼速度倍率()
	# 灵根品阶轴（根据宗门等级调整概率：低等级宗门招不到高品质弟子）
	# 1-3级：凡品70%/良品25%/上品5%（无极品天品）
	# 4-6级：凡品50%/良品30%/上品15%/极品5%（无天品）
	# 7-9级：凡品30%/良品30%/上品25%/极品12%/天品3%
	# 10级：凡品20%/良品25%/上品30%/极品18%/天品7%
	# 宗门等级已在上方「资质轴」处声明并赋值，此处原为重复声明（GDScript 编译阻断），已移除。
	var 天品概率: float = 0.0
	var 极品概率: float = 0.0
	var 上品概率: float = 0.05
	var 良品概率: float = 0.25
	if 宗门等级 <= 3:
		天品概率 = 0.0; 极品概率 = 0.0; 上品概率 = 0.05; 良品概率 = 0.25
	elif 宗门等级 <= 6:
		天品概率 = 0.0; 极品概率 = 0.05; 上品概率 = 0.15; 良品概率 = 0.30
	elif 宗门等级 <= 9:
		天品概率 = 0.03; 极品概率 = 0.12; 上品概率 = 0.25; 良品概率 = 0.30
	else:
		天品概率 = 0.07; 极品概率 = 0.18; 上品概率 = 0.30; 良品概率 = 0.25
	var rp: float = randf()
	if rp < 天品概率:
		灵根 = "天灵根"; 灵根品阶 = "天品"
	elif rp < 天品概率 + 极品概率:
		灵根 = 灵根变异.pick_random(); 灵根品阶 = "极品"
	elif rp < 天品概率 + 极品概率 + 上品概率:
		灵根 = 灵根五行.pick_random(); 灵根品阶 = "上品"
	elif rp < 天品概率 + 极品概率 + 上品概率 + 良品概率:
		灵根 = 灵根五行.pick_random(); 灵根品阶 = "良品"
	else:
		灵根 = 灵根五行.pick_random(); 灵根品阶 = "凡品"
	# 特殊体质觉醒（修真世界观：先天道体/玄剑之体等，低概率）
	特殊体质 = 随机觉醒体质(灵根品阶)
	体质觉醒 = (特殊体质 != "凡体")
	if 体质觉醒 and Game != null:
		Game._加推演条目("【测灵大典】%s觉醒%s，%s" % [姓名, 特殊体质, str(特殊体质表[特殊体质]["描述"])], Game.ET_INFO, Game.PRIO_HIGH, {})
		Game.添加纪事("测灵", "体质觉醒", "%s觉醒%s" % [姓名, 特殊体质], 2)
	# 命格：弟子品质 → 品级权重池抽取（废弃旧 1% 天命特殊分支）
	var 档: String = 资质到品质档.get(资质, "凡品")
	var 权重: Dictionary = 品质档命格权重.get(档, {"凡品": 100.0})
	destiny_id = _按权重抽命格(权重)
	# 性格已于「立绘赋值」处提前确定（气质派生需要），此处不再重复赋值
	道途 = ""            # 延后至筑基判定
	司职 = ""
	# S52：休闲天赋随机生成（修真世界观：弟子各有所好）
	休闲天赋 = _随机休闲天赋()
	休闲技能 = {"钓道": 0, "酿道": 0, "茶道": 0, "琴道": 0, "厨道": 0, "棋道": 0, "画道": 0}
	上月休闲产出 = {}
	修炼进度 = 0.0
	# 初始年龄：按渠道规则（§6.10.1.5），默认=下山测灵招募 10~16 岁凡人少年
	# 后续渠道扩展（散修/招贤阁）可加参数覆盖
	年龄 = randi_range(10, 16)
	# 名字生成：70%单名（姓+单字），30%双名（姓+双字），组合数从196提升到数万种
	var 生成名: String = ""
	if randf() < 0.7:
		生成名 = 名库单字.pick_random()
	else:
		生成名 = 名库双字首.pick_random() + 名库双字尾.pick_random()
	姓名 = 姓库.pick_random() + 生成名
	# 排除玩家名字：如果生成的名字与宗主/玩家同名，重新生成一次
	if Game != null and Game.get("宗主名") != null:
		var 玩家名: String = str(Game.宗主名)
		if 玩家名 != "" and 姓名 == 玩家名:
			姓名 = 姓库.pick_random() + 名库单字.pick_random()
	境界 = "练气"
	寿元 = 境界表["练气"]["寿元"]
	战力 = 境界表["练气"]["战力"]
	算属性()
	_应用命格养成加成()   # 命格修行加成乘入修炼速度（含突破加速等效）

# 初始属性：总属性随资质缩放；道途仅决定侧重（合计不变）；未入门用中性权重
func 算属性():
	var 总量: int = int(150 + 资质系数表.get(资质, 1.0) * 30)
	var w: Dictionary = 道途属性权重.get(道途, 道途属性权重[""])
	属性 = {
		"攻": int(总量 * w["攻"]),
		"防": int(总量 * w["防"]),
		"血": int(总量 * w["血"]),
		"速": int(总量 * w["速"]),
	}
	# 六维深层属性（体魂/根骨/悟性/机缘/心性/气运），受资质影响
	var 六维总量: float = 400.0 + 资质系数表.get(资质, 1.0) * 200.0
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var 六维权重: Array = [0.17, 0.20, 0.18, 0.14, 0.16, 0.15]
	var 六维名: Array = ["体魂", "根骨", "悟性", "机缘", "心性", "气运"]
	for i in range(6):
		var 波动: float = rng.randf_range(0.8, 1.2)
		属性[六维名[i]] = int(六维总量 * 六维权重[i] * 波动)

# 根据实际年龄+境界动态计算外观年龄段
# 规则：驻颜丹锁定 > 境界减缓衰老（高境界驻颜有术但不强制年轻）> 按年龄衰老
# 境界越高，衰老阈值越晚（修仙者驻颜有术，大器晚成者保留成熟外观）
func 获取外观年龄段() -> String:
	if 驻颜锁定 != "":
		return 驻颜锁定
	var a: float = 年龄
	# 按境界设定衰老阈值（少年/青年/中年/老年分界）
	var 青年上限: float = 60.0
	var 中年上限: float = 100.0
	if 境界.begins_with("筑基"):
		青年上限 = 120.0; 中年上限 = 250.0
	elif 境界.begins_with("金丹"):
		青年上限 = 200.0; 中年上限 = 400.0
	elif 境界.begins_with("元婴"):
		青年上限 = 350.0; 中年上限 = 700.0
	elif 境界.begins_with("化神") or 境界.begins_with("炼虚") or 境界.begins_with("合体") or 境界.begins_with("大乘") or 境界.begins_with("渡劫") or 境界.begins_with("仙阶") or 境界.begins_with("道阶"):
		青年上限 = 500.0; 中年上限 = 1000.0
	# 主动驻颜判定：年龄达到青年上限60%时，女修高概率主动服用驻颜丹
	if not _已检查主动驻颜 and a >= 青年上限 * 0.6:
		_已检查主动驻颜 = true
		_尝试主动驻颜()
	if a < 18:
		return "少年"
	elif a < 青年上限:
		return "青年"
	elif a < 中年上限:
		return "中年"
	return "老年"

# 主动驻颜：女修在意外貌，高概率主动寻找/服用驻颜丹；男修概率低
# 资质越高资源越多，概率越高
func _尝试主动驻颜() -> void:
	if 驻颜锁定 != "":
		return
	var 概率: float = 0.05  # 男修基础5%
	if 性别 == "女":
		概率 = 0.30  # 女修30%
	# 资质加成
	if 资质 == "天才":
		概率 += 0.10
	elif 资质 == "妖孽":
		概率 += 0.15
	elif 资质 == "旷世":
		概率 += 0.20
	概率 = clampf(概率, 0.0, 0.85)
	if randf() < 概率:
		服用驻颜丹()

# 服用驻颜丹：锁定当前外观年龄段，此后不再随年龄变化
func 服用驻颜丹() -> bool:
	if 驻颜锁定 != "":
		return false  # 已锁定
	驻颜锁定 = 获取外观年龄段()
	年龄段 = 驻颜锁定
	return true

# 每周期刷新外观年龄段（由game_state周期调用）
func 刷新外观年龄段() -> void:
	年龄段 = 获取外观年龄段()

# 立绘路径：按 立绘类型+性别+姿势+灵根变体+年龄段+资质档 选取文件；姿势=stand(全身)/halfbody(半身)/battle(战斗)
# 千人千面 v4：灵根变体（_v0-_v4）+ 年龄段（少年/青年/中年/老年），缺图逐项自动 fallback（零破坏）
## ★ 按资质分风格（美术裁定 · 见《RULING-立绘参考与美术资产冲突_致豆包》§3 冲突③）
##   普通档 → 新版「灵根变体」_v{n}    ：半写实 · 纯色暗青黛底 · 1024×2048 竖构图（216 张 = 6气质×2性×6变体×3姿势）
##   精英档 → 旧版「_elite」（无变体）：油画 · 暖色特效（72 张：stand 48 / halfbody 12 / battle 12；半身·战斗无变体图，共用青年档）
##   顶级档 → 新版「_v{n}_top」（v0-v5）：水墨金 · 最华丽（72 张已落地，仅 stand 姿势）；缺图降级到旧「_v{n}_elite」→「_elite」
## 铁则：高资质档**不得降级**到低资质档的图 —— 宁可换形态，也不丢档次
##   （否则「精英 halfbody/battle」会退化成普通外观，层次感尽失）
## 每项 = [灵根变体, 年龄段, 资质后缀] 三段；数组顺序即优先级（高 → 低）
func 立绘候选链() -> Array:
	var 变体: String = "_v" + str(立绘变体)
	var 年龄: String = "_" + 年龄段 if 年龄段 != "青年" else ""
	if 资质 in 顶级版资质阈值:
		return [
			[变体, 年龄, 立绘顶级版后缀], [变体, "", 立绘顶级版后缀],
			["", 年龄, 立绘顶级版后缀], ["", "", 立绘顶级版后缀],
			[变体, 年龄, 立绘精英版后缀], [变体, "", 立绘精英版后缀],
			["", 年龄, 立绘精英版后缀], ["", "", 立绘精英版后缀],
			[变体, 年龄, ""], [变体, "", ""], ["", 年龄, ""], ["", "", ""],
		]
	if 资质 in 精英版资质阈值:
		return [
			["", 年龄, 立绘精英版后缀], ["", "", 立绘精英版后缀],
			[变体, 年龄, 立绘精英版后缀], [变体, "", 立绘精英版后缀],
			["", 年龄, ""], ["", "", ""],
			[变体, 年龄, ""], [变体, "", ""],
		]
	return [
		[变体, 年龄, ""], [变体, "", ""], ["", 年龄, ""], ["", "", ""],
	]

func 取立绘路径(姿势: String = "stand") -> String:
	年龄段 = 获取外观年龄段()  # 动态刷新外观
	# 皮肤系统：如果装备了皮肤，优先使用皮肤立绘
	if 当前皮肤 != "":
		var 皮肤路径: String = 皮肤路径前缀 + 当前皮肤 + "/" + 性别 + "_" + 姿势 + ".png"
		if _立绘文件存在(皮肤路径):
			return 皮肤路径
	# 多种族弟子立绘：非人族使用种族专属立绘（化形后带种族特征）
	if 种族 != "人族":
		var 种族英文: String = _种族转英文(种族)
		if 种族英文 != "":
			# 多种族立绘只有全身(stand)姿势，halfbody/battle也用全身图（头像裁切）
			var 种族立绘路径: String = 多种族立绘路径前缀 + 种族英文 + "_" + 性别 + 多种族立绘后缀
			if _立绘文件存在(种族立绘路径):
				return 种族立绘路径
	var 基础: String = 立绘路径前缀 + 立绘类型 + "_" + 性别 + "_" + 姿势
	# 按「资质分风格」候选链逐项探测，命中即返回（缺图自动降级，零破坏）
	# 每项再按 立绘扩展名列表 逐个试（.png → .webp → .jpg），兼容出图批次的格式不一致
	for 候选 in 立绘候选链():
		var 主干: String = 基础 + str(候选[0]) + str(候选[1]) + str(候选[2])
		for 扩展 in 立绘扩展名列表:
			if _立绘文件存在(主干 + 扩展):
				return 主干 + 扩展
	# 最终兜底：返回普通档原始底图（缺图交由 UI 侧 fallback 处理）
	for 扩展 in 立绘扩展名列表:
		if _立绘文件存在(基础 + 扩展):
			return 基础 + 扩展
	return 基础 + ".png"

# 检查立绘文件是否存在（带缓存，避免频繁IO）
static var _文件存在缓存: Dictionary = {}
static func _立绘文件存在(路径: String) -> bool:
	if _文件存在缓存.has(路径):
		return _文件存在缓存[路径]
	var 存在: bool = ResourceLoader.exists(路径)
	_文件存在缓存[路径] = 存在
	return 存在

# 是否使用非普通档立绘（精英或顶级，供UI判断是否显示资质光效）
func 是否精英版立绘() -> bool:
	return 资质 in 精英版资质阈值 or 资质 in 顶级版资质阈值

# ============ 皮肤系统（仙衣阁）============
# 装备皮肤（需要先拥有）
func 装备皮肤(皮肤ID: String) -> bool:
	if 皮肤ID == "":
		当前皮肤 = ""
		return true
	if not 已拥有皮肤.has(皮肤ID):
		return false
	当前皮肤 = 皮肤ID
	return true

# 卸下皮肤（恢复基础立绘）
func 卸下皮肤():
	当前皮肤 = ""

# 检查是否拥有某皮肤
func 是否拥有皮肤(皮肤ID: String) -> bool:
	return 已拥有皮肤.has(皮肤ID)

# 获得皮肤（购买/抽奖/活动奖励后调用）
func 获得皮肤(皮肤ID: String):
	if not 已拥有皮肤.has(皮肤ID):
		已拥有皮肤.append(皮肤ID)

# 获取当前皮肤的属性加成（修为速度%/灵石产出%/全属性%）
func 获取皮肤加成() -> Dictionary:
	var 加成: Dictionary = {"修为速度": 0.0, "灵石产出": 0.0, "全属性": 0.0}
	if 当前皮肤 == "":
		return 加成
	# 从皮肤配置读取加成（获取皮肤配置是静态方法，直接调用）
	var 配置: Dictionary = SkinManager.获取皮肤配置(当前皮肤)
	if not 配置.is_empty():
		加成["修为速度"] = float(配置.get("bonus_cultivation", 0))
		加成["灵石产出"] = float(配置.get("bonus_lingshi", 0))
		加成["全属性"] = float(配置.get("bonus_all_attr", 0))
	return 加成

# 获取当前皮肤专属称号
func 获取皮肤称号() -> String:
	if 当前皮肤 == "":
		return ""
	var 配置: Dictionary = SkinManager.获取皮肤配置(当前皮肤)
	if not 配置.is_empty():
		return 配置.get("title", "")
	return ""

# 获取当前皮肤名称
func 获取皮肤名称() -> String:
	if 当前皮肤 == "":
		return ""
	var 配置: Dictionary = SkinManager.获取皮肤配置(当前皮肤)
	if not 配置.is_empty():
		return 配置.get("name", "")
	return ""

# 头像路径：用半身立绘裁圆（列表卡片小头像用）
func 取头像路径() -> String:
	return 取立绘路径("halfbody")

# 灵根决定可修道途数（变异/天灵根/全灵根→3；单双五行→2；杂灵根→1）
func 可修道途数() -> int:
	if 灵根 == "天灵根" or 灵根 == "先天五行全灵根":
		return 3
	if 灵根 in 灵根变异:
		return 3
	if 灵根 in 灵根五行:
		return 2
	return 1

# 层基准日（按开关返回新旧；speed=1.0 时每层所需游戏日）
func _层基准日(境: String) -> float:
	if 新修炼规则:
		return 每层所需日_新.get(境, 99999.0)
	return 每层所需日_旧.get(境, 99999.0)

# 瓶颈打磨（D方案）：筑基大圆满后修为停涨，累计打磨值，满1.0解锁突破；
# 自然增长按资质，且受「年龄/22」硬锁，最快突破不早于22岁（杜绝道具堆早金丹）
const 瓶颈灵气消耗 := 10                     # 灵气助破瓶颈：单次消耗灵气（config化待S1）
const 瓶颈灵气打磨加成 := 0.05               # 单次打磨加成，严守单buff≤5%红线
# 节奏校准（双周期评级配套）：稳固期/瓶颈打磨分阶系数由 config/节奏校准.csv 驱动，缺失回落默认
func _稳固期天数(境: String) -> float:
	if Game.节奏校准.is_empty():
		Game._加载节奏校准()
	var s: String = Game.节奏校准.get("稳固期_" + 境, "")
	if s == "":
		return 0.0   # CSV 为单一数据源；缺失时回落 0（由 节奏校准.csv 保障）
	return float(s)

func _瓶颈打磨系数(境: String) -> float:
	if Game.节奏校准.is_empty():
		Game._加载节奏校准()
	var s: String = Game.节奏校准.get("瓶颈打磨_" + 境, "")
	if s == "":
		return 1.0
	return float(s)

# 瓶颈打磨年龄系数：软门槛调制（原硬clamp致培养收益被吃掉92%）
# 年龄不足时打磨速度降低，但不会完全卡住；达到门槛后系数为1.0
# 高阶门槛由 最低突破年龄 原样保留，防道具堆早突破的意图不变
func _瓶颈打磨年龄系数() -> float:
	var i: int = 境界序.find(境界)
	var 下一境: String = 境界序[i + 1] if (i >= 0 and i + 1 < 境界序.size()) else ""
	if 下一境 == "":
		return 1.0
	var 门槛: float = float(最低突破年龄.get(下一境, 14.0))
	if 年龄 >= 门槛:
		return 1.0
	# 年龄不足时：系数 = 年龄/门槛 的平滑曲线，最低0.3（不会完全卡死）
	return clamp(0.3 + 0.7 * (年龄 / 门槛), 0.3, 1.0)

func 累计瓶颈打磨(日: float):
	if 瓶颈打磨值 >= 1.0:
		return
	var 自然增量: float = 日 * 资质突破系数.get(资质, 1.0) / 2880.0 * _瓶颈打磨系数(境界) * _瓶颈打磨年龄系数()
	瓶颈打磨值 = min(1.0, 瓶颈打磨值 + 自然增量)

# 主动打磨入口（历练/讲道/悟道丹药/奇遇 调用，增量0~1；年龄系数调制）
func 加瓶颈打磨(增量: float):
	if 增量 <= 0 or 瓶颈打磨值 >= 1.0:
		return
	瓶颈打磨值 = min(1.0, 瓶颈打磨值 + 增量 * _瓶颈打磨年龄系数())

# 灵气助破瓶颈（经济S0：灵气→瓶颈打磨消耗出口，复用D方案瓶颈系统）
# 消耗灵气加快瓶颈打磨进度，是灵气的首个真实消耗出口；无灵气/已满则失败，不惩罚
func 灵气助破瓶颈() -> bool:
	if 瓶颈打磨值 >= 1.0:
		return false
	if Game.灵气 < 瓶颈灵气消耗:
		return false
	Game.灵气 -= 瓶颈灵气消耗
	加瓶颈打磨(瓶颈灵气打磨加成)
	return true

# 推进修炼（游戏日）；修炼乘区 由宗门传入（加法叠加封顶后的总倍率，默认1.0）
# 10层体系：每日积累当前层进度 → 满则升层数 → 大圆满累计打磨 → 打磨满尝试突破
func 推进修炼(日: float, 修炼乘区: float = 1.0, 渡劫准备供给: Callable = Callable()):
	年龄 += 日 / 360.0
	# 稳固期：修炼效率减半，且期间不可突破（P1）
	var 效率: float = 1.0
	if 稳固期剩余 > 0:
		稳固期剩余 = max(0.0, 稳固期剩余 - 日)
		效率 = 0.5
	# 观礼感悟衰减（每日削减剩余天数；归零则倍率失效——限时 buff，衰减即 sink 防通胀）
	# 注意：观礼感悟只走独立乘区 感悟系数，不得改动 效率（效率减半是「稳固期」专利，二者解耦）
	if 观礼感悟剩余 > 0:
		观礼感悟剩余 = max(0.0, 观礼感悟剩余 - 日)
		if 观礼感悟剩余 <= 0:
			观礼感悟倍率 = 0.0
	# 丹毒自然消解（每月-1，P1基础）
	if 丹毒 > 0:
		丹毒 = max(0.0, 丹毒 - 日 / 30.0)
	var 层基准日: float = _层基准日(境界)
	if 层基准日 >= 99999.0:
		return   # 已至顶阶，不再推进
	# 失败冷却倒计时（冷却期内不积累突破进度，但仍正常升层）
	if 突破冷却剩余 > 0:
		突破冷却剩余 = max(0.0, 突破冷却剩余 - 日)
	# 渡劫重伤养伤倒计时（>0 时修炼效率×0.7，且不可突破）
	if 受伤剩余 > 0:
		受伤剩余 = max(0, 受伤剩余 - int(日))
		效率 *= 0.7
	# 灵气加成（修真世界观：灵气充足修炼快，灵气不足修炼慢）
	var 灵气系数: float = _灵气修炼系数()
	# 洞府修炼加成（个人洞府等级影响修炼效率）
	var 洞府系数: float = 1.0 + 洞府修炼加成()
	# 修炼消耗灵气（按境界递增，练气1/日，渡劫10/日）
	if Game != null and Game.灵气 != null:
		var 境界序_idx: int = 境界序.find(境界)
		var 日消耗: float = float(max(1, 境界序_idx + 1)) * 日
		Game.灵气 = max(0, int(Game.灵气) - int(日消耗))
	# 积累当前层进度（灵根主导速度 × 宗门加算封顶乘区 × 稳固期效率 × 心魔效率 × 灵气系数）
	# 观礼感悟独立乘区：限时修炼加速 buff（与 修炼乘区 加法叠加解耦，避免被封顶吞噬）
	var 感悟系数: float = 1.0 + (观礼感悟倍率 if 观礼感悟剩余 > 0 else 0.0)
	修炼进度 += 日 * 修炼速度 * 效率 * 心魔修炼效率系数() * 修炼乘区 * 誓约修炼系数() * 灵气系数 * 感悟系数 * 洞府系数 / 层基准日
	# 顿悟机制（修真世界观：修炼中灵光一闪，豁然开朗）
	# 每月（30日）基础2%概率，道心高者+1%，上限5%
	if Game != null and 日 >= 1.0 and randf() < (0.02 + float(min(100, 道心)) / 10000.0) * (日 / 30.0):
		_触发顿悟()
	# 升层循环（溢出结转：一天内可能连升多层）
	while 修炼进度 >= 1.0 and 层数 < 10:
		修炼进度 -= 1.0
		层数 += 1
	# 大圆满(10层) → 累计瓶颈打磨值（D方案：替代纯空等，进度受年龄上限锁）
	if 层数 >= 10 and 突破冷却剩余 <= 0:
		累计瓶颈打磨(日)
	# 大圆满 + 打磨满 + 无冷却 → 尝试突破
	# §4.0 目标驱动：突破时机——激进度越高，所需瓶颈打磨越低（激进提前冲关，保守厚积薄发）
	if 层数 >= 10 and 修炼进度 >= 1.0 and 突破冷却剩余 <= 0 and 瓶颈打磨值 >= Goal.突破打磨门槛(Goal.弟子目标(self)):
		尝试突破(渡劫准备供给)

## 顿悟机制（修真世界观：修炼中灵光一闪，豁然开朗）
## 三选一随机效果：修炼进度+10% / 功法精进 / 悟道点+20
## P1优化：顿悟时有5%概率直接突破瓶颈（大圆满状态下）
func _触发顿悟() -> void:
	if Game == null:
		return
	# P1：大圆满状态下，顿悟有5%概率直接突破瓶颈
	if 层数 >= 10 and 瓶颈打磨值 < 1.0 and randf() < 0.05:
		瓶颈打磨值 = 1.0
		Game._加推演条目("【%s·顿悟】大彻大悟，瓶颈自破，可尝试突破！" % 姓名, Game.ET_BREAKTHROUGH, Game.PRIO_HIGH, {})
		Game.添加纪事("修炼", "顿悟破瓶颈", "%s顿悟之际，瓶颈自破" % 姓名, 2)
		return
	var 顿悟类型: int = randi() % 3
	match 顿悟类型:
		0:
			# 豁然开朗，修为大进
			修炼进度 = min(1.0, 修炼进度 + 0.1)
			Game._加推演条目("【%s·顿悟】豁然开朗，修为大进，修炼进度+10%%" % 姓名, Game.ET_INFO, Game.PRIO_NORMAL, {})
			Game.添加纪事("修炼", "顿悟", "%s修炼中豁然开朗，修为大进" % 姓名, 1)
		1:
			# 灵光一闪，功法精进
			Game.悟道点 += 10
			Game._加推演条目("【%s·顿悟】灵光一闪，功法精进，悟道点+10" % 姓名, Game.ET_INFO, Game.PRIO_NORMAL, {})
			Game.添加纪事("修炼", "顿悟", "%s灵光一闪，功法精进" % 姓名, 1)
		2:
			# 心有所悟，道法自然
			Game.悟道点 += 20
			Game._加推演条目("【%s·顿悟】心有所悟，道法自然，悟道点+20" % 姓名, Game.ET_INFO, Game.PRIO_NORMAL, {})
			Game.添加纪事("修炼", "顿悟", "%s心有所悟，道法自然" % 姓名, 1)

## 灵气修炼系数（修真世界观：灵气充足修炼快，灵气不足修炼慢）
## 灵气充足（人均≥100）：+10%
## 灵气一般（人均≥50）：+0%
## 灵气不足（人均≥10）：-20%
## 灵气匮乏（人均<10）：-50%
func _灵气修炼系数() -> float:
	if Game == null or Game.灵气 == null:
		return 1.0
	var 弟子数: int = max(1, Game.弟子列表.size())
	var 人均灵气: float = float(Game.灵气) / float(弟子数)
	if 人均灵气 >= 100.0:
		return 1.10
	elif 人均灵气 >= 50.0:
		return 1.0
	elif 人均灵气 >= 10.0:
		return 0.80
	else:
		return 0.50

# 终局机制 P0：资质→境界天花板查询与判定
func 资质上限境界() -> String:
	return 资质境界天花板.get(资质, "道阶")

# 是否已触及资质天花板（达到上限境即封顶，无法再突破）
func 是否达资质上限() -> bool:
	return 境界序.find(境界) >= 境界序.find(资质上限境界())

# 尝试突破到下一境界（仅在大圆满时调用）；返回是否成功
# 渡劫准备供给：Callable，仅在确认需渡劫时才回调构建（避免每月为每位弟子重复扣灵石）
# ============ 弟子AI行为决策（真人模拟：大圆满主动寻突破、性格驱动、风险评估）============
## 计算当前突破成功率（用于AI风险评估）
func 计算突破成功率预估() -> float:
	if 层数 < 10:
		return 0.0
	var 基础率: float = 突破成功率.get(境界, 0.0)
	var 率: float = min(1.0, 基础率 * 资质突破系数.get(资质, 1.0) * 获取种族突破系数() * (1.0 + 临时突破护法加成))
	率 = max(0.0, 率 - 丹毒 * 0.08)
	# P0修复（2026-09-11）：预估必须"只读"——突破成功率修正() 会消费"待护法突破"（宗主护法 buff），
	# 若直接调用，则每次打开弟子详情查成功率 / 每月 AI 风险预估，都会把护法 buff 悄悄吃掉。
	# 故先备份、算完恢复，保证预估不产生副作用。
	var 备份待护法突破: bool = 待护法突破
	var 备份护法加成: float = 护法加成
	率 = clamp(率 + 突破成功率修正() / 100.0, 0.0, 0.95)
	待护法突破 = 备份待护法突破
	护法加成 = 备份护法加成
	return 率

## 弟子AI突破决策（性格驱动+风险评估）
## 返回：true=决定突破，false=继续打磨/历练
func AI决定是否突破() -> bool:
	if 层数 < 10 or 瓶颈打磨值 < 1.0:
		return false  # 未到突破时机
	var 成功率: float = 计算突破成功率预估()
	var 目标境: String = 下一境界名(境界)
	# 性格驱动决策阈值
	var 决策阈值: float = 0.4  # 普通性格：成功率40%以上才尝试
	if 资质 in ["tiancai", "yaonie", "kuangshi"]:
		决策阈值 = 0.25  # 天才/妖孽/旷世：激进，25%就敢冲
	elif 资质 in ["fan_su", "pingyong"]:
		决策阈值 = 0.55  # 凡俗/平庸：谨慎，55%以上才尝试
	# 性格影响（对齐 12 修仙性格；原 match 激进/谨慎/懦弱 三值从不被产出，属失效分支）
	决策阈值 += 性格突破修正(性格)
	# 寿元压力：寿元不足时，即使成功率低也会拼命
	var 寿元压力: bool = 寿元 < 50.0 and 境界 in ["元婴", "化神", "炼虚"]
	if 寿元压力:
		决策阈值 -= 0.2  # 寿元将尽，拼死一搏
	# 连续失败次数：失败越多越谨慎
	if 突破失败次数 >= 3:
		决策阈值 += 0.1  # 连败三次，更谨慎
	# 宗门突破方针（§4.14 C3 宗主干预接口③）：宗主定方向 —— 整体平移决策阈值
	if Game != null and Game.has_method("获取突破方针阈值偏移"):
		决策阈值 += float(Game.获取突破方针阈值偏移())
	# 最终决策
	return 成功率 >= 决策阈值

## 弟子AI主动准备突破（服用丹药、请求护法、闭关）
func AI主动准备突破() -> void:
	if Game == null:
		return
	# 1. 主动服用突破丹药（如果库房有对应品阶丹药）
	var 目标境: String = 下一境界名(境界)
	var 丹药名: String = ""
	match 目标境:
		"筑基": 丹药名 = "筑基丹"
		"金丹": 丹药名 = "凝金丹"
		"元婴": 丹药名 = "破婴丹"
		"化神": 丹药名 = "化神蕴神丹"
	if 丹药名 != "":
		# 检查库房是否有该丹药
		for it in Game.宗门库房:
			if it != null and it.名称 == 丹药名:
				# 主动服用
				Game.宗门库房.erase(it)
				丹毒 = max(0, 丹毒 - 5)  # 突破丹药降低丹毒
				if Game != null:
					Game._加推演条目("【主动服药】%s为冲击%s，主动服用%s，药力流转，根基稳固。" % [姓名, 目标境, 丹药名], Game.ET_SECT, Game.PRIO_NORMAL, {"弟子": 姓名})
				break
	# 2. 请示宗主护法（§4.14 C3 宗主干预接口①）
	# 原实现直接授予 +15%（无代价、玩家无选择）→ 违 §4.14「护法请求 MUST 可批复」。
	# 改为发「宗门请示·护法」传讯，由宗主在「宗门气象」抽屉批复（亲临 +20% / 长老 +10% / 自行 0%），
	# 加成与灵石代价同在批复处结算 —— 决策留给宗主，弟子只负责发起。
	if 资质 in ["tiancai", "yaonie", "kuangshi"] and randf() < 0.3 and not 待护法突破:
		if Game != null and Game.has_method("弟子护法传讯"):
			Game.弟子护法传讯(弟子ID)
	# 3. 闭关打磨（增加瓶颈打磨值）
	瓶颈打磨值 = min(1.0, 瓶颈打磨值 + 0.1)

## 弟子AI主动申请洞府（§4.14 C3 宗主干预接口②：宗门洞府是有限资源，给谁＝资源倾斜）
## 触发条件：大圆满 + 未得道阶洞府（<7级）；月概率 8%（低，避免刷屏）
## 批复前不占用任何资源；宗主批复时受「洞府容量」与「灵石」双重约束
func AI申请洞府() -> void:
	if Game == null or 洞府等级 >= 7:
		return
	if randf() >= 0.08:
		return
	if Game.has_method("弟子洞府传讯"):
		Game.弟子洞府传讯(弟子ID)


## 弟子AI主动寻机缘（外出历练、参与奇遇、结交道友）
func AI主动寻机缘() -> String:
	# 根据性格和境界选择行为
	var 行为: String = "修炼"  # 默认继续修炼
	if 层数 >= 10 and not AI决定是否突破():
		# 大圆满但决定不突破，外出寻机缘
		var rand: float = randf()
		if rand < 0.4:
			行为 = "历练"  # 外出历练寻机缘
		elif rand < 0.6:
			行为 = "闭关"  # 闭关打磨心境
		elif rand < 0.75:
			行为 = "论道"  # 找同门论道
		else:
			行为 = "修炼"  # 继续修炼
	elif 层数 < 10:
		# 未大圆满，正常修炼
		行为 = "修炼"
	return 行为

func 尝试突破(渡劫准备供给: Callable = Callable()) -> bool:
	var i: int = 境界序.find(境界)
	if i < 0 or i >= 境界序.size() - 1:
		return false   # 已至顶阶或非法境界
	if 层数 < 10:
		return false   # 非大圆满不可突破
	if 受伤剩余 > 0:
		return false   # 带伤不突破（渡劫受创后须先养伤）
	# D方案：瓶颈打磨未满 / 年龄未达下限 → 不突破（无惩罚，仅不突破，避免空等期误触失败）
	var 目标境: String = 境界序[i + 1]
	# 终局机制 P0：资质天花板硬锁——目标境超出资质上限则永久无法突破（不消耗资源、不触发失败惩罚）
	if 境界序.find(目标境) > 境界序.find(资质上限境界()):
		return false
	if 瓶颈打磨值 < 1.0:
		return false
	if 最低突破年龄.has(目标境) and 年龄 < 最低突破年龄[目标境]:
		return false
	# === 天劫分支：元婴→化神 起，至 渡劫→仙阶 止，须渡天劫（数据层见 Tribulation）===
	var 准备: Dictionary = {}
	if Tribulation.需渡劫(目标境):
		pass
	if 渡劫准备供给.is_valid():
		准备 = 渡劫准备供给.call(self)
		return _渡天劫(目标境, 准备)
	# 常规突破（凡境顺渡）
	# 突破率 = 境界基础率 × 资质突破系数 × 种族突破系数（资质低→难破，呼应偏科天才）；丹毒降率（P1）
	# 心境/道心/心魔修正：+心境×0.2% +道心×0.3% -心魔×0.5%
	# P0修复：护法加成正确应用到突破率（原错位乘进修炼速度）
	var 基础率: float = 突破成功率.get(境界, 0.0)
	var 率: float = min(1.0, 基础率 * 资质突破系数.get(资质, 1.0) * 获取种族突破系数() * (1.0 + 临时突破护法加成))
	临时突破护法加成 = 0.0  # 使用后清零
	率 = max(0.0, 率 - 丹毒 * 0.08)
	# 叠加心境/道心/心魔修正（百分比转小数）
	率 = clamp(率 + 突破成功率修正() / 100.0, 0.0, 0.95)
	if 率 >= 1.0 or randf() < 率:
		# 突破成功
		突破()
		return true
	else:
		# 突破失败（严酷型惩罚：回退层数 + 进度清零 + 冷却 + 心魔增加 + 寿元损耗 + 死亡风险）
		var 回退: int = 突败回退层.get(境界, 3)
		层数 = max(1, 层数 - 回退)
		修炼进度 = 0.0
		突破冷却剩余 = 突败冷却日.get(境界, 60.0)
		突破失败次数 += 1
		# 心魔增加（境界越高，心魔增加越多）
		var 心魔增量: int = randi_range(5, 15) + 境界序.find(境界) * 2
		增加心魔(心魔增量)
		# 寿元损耗（突破失败折寿，境界越高折寿越多，种族寿元系数影响）
		var 折寿年: float = (float(randi_range(1, 3)) + float(境界序.find(境界)) * 0.5) / 种族寿元系数.get(种族, 1.0)
		寿元 -= 折寿年
		if Game != null:
			Game._加推演条目("【突破折寿】%s突破失败，元气大伤，折寿%.1f年。" % [姓名, 折寿年], Game.ET_SECT, Game.PRIO_HIGH, {"弟子": 姓名})
		# 渡劫期及以上突破失败有死亡风险（天才也要活着到最后）
		if 境界 in ["渡劫", "仙阶", "道阶"] and randf() < 0.05 * 种族天劫难度系数.get(种族, 1.0):
			# 检查保命道具（师尊赐予/宗门发放）
			if 保命护身 > 0:
				保命护身 -= 1
				if Game != null:
					Game._加推演条目("【保命符消劫】%s冲击%s失败，生死关头，师尊所赐保命符化作流光替死，虽重伤却保住性命。" % [姓名, 下一境界名(境界)], Game.ET_SECT, Game.PRIO_HIGH, {"弟子": 姓名})
				# 重伤但不死
				受伤剩余 = 90.0
			else:
				# 死亡（渡劫失败，魂飞魄散），魔族/龙族天劫难度更高
				状态 = "陨落"
				if Game != null:
					Game._加推演条目("【渡劫陨落】%s冲击%s失败，天劫加身，魂飞魄散，陨落道消。" % [姓名, 下一境界名(境界)], Game.ET_SECT, Game.PRIO_HIGH, {"弟子": 姓名})
				return false
		# P1优化：突破失败时有概率走火入魔（心魔越高概率越大，种族系数影响）
		var 入魔概率: float = 计算走火入魔概率() * 0.5 * 种族走火入魔系数.get(种族, 1.0)  # 突破失败时入魔概率为常规的50%
		if randf() < 入魔概率:
			触发走火入魔()
			if Game != null:
				Game._加推演条目("【走火入魔】%s突破失败，走火入魔！" % 姓名, Game.ET_SECT, Game.PRIO_HIGH, {"弟子": 姓名})
		return false

# ============ 临阵突破（修真小说常见桥段：战斗中/绝境中突破）============
## 临阵突破：在战斗/历练/绝境中，压力激发潜能，可能突破境界
## 特点：突破率+30%（绝境激发），但失败惩罚加重（走火入魔概率+50%）
## 触发条件：大圆满 + 瓶颈打磨≥0.8 + 战斗/绝境中
func 临阵突破(场景: String = "战斗") -> Dictionary:
	var i: int = 境界序.find(境界)
	if i < 0 or i >= 境界序.size() - 1:
		return {"成功": false, "原因": "已至顶阶"}
	if 层数 < 10:
		return {"成功": false, "原因": "非大圆满不可突破"}
	if 瓶颈打磨值 < 0.8:
		return {"成功": false, "原因": "瓶颈打磨不足"}
	var 目标境: String = 境界序[i + 1]
	# 终局机制：资质天花板硬锁
	if 境界序.find(目标境) > 境界序.find(资质上限境界()):
		return {"成功": false, "原因": "资质不足，无法突破"}
	# 临阵突破率：基础率 × 资质系数 × 种族系数 × 1.3（绝境激发）
	var 基础率: float = 突破成功率.get(境界, 0.0)
	var 率: float = min(1.0, 基础率 * 资质突破系数.get(资质, 1.0) * 获取种族突破系数() * 1.3 * (1.0 + 临时突破护法加成))
	临时突破护法加成 = 0.0
	率 = max(0.0, 率 - 丹毒 * 0.08)
	率 = clamp(率 + 突破成功率修正() / 100.0, 0.0, 0.95)
	if randf() < 率:
		# 临阵突破成功
		突破()
		var 文案: String = ""
		match 场景:
			"战斗":
				文案 = "%s于生死战斗中突破至%s，战力暴涨！" % [姓名, 境界]
			"历练":
				文案 = "%s于历练绝境中突破至%s，道心愈发坚定！" % [姓名, 境界]
			"秘境":
				文案 = "%s于秘境压力下突破至%s，机缘造化！" % [姓名, 境界]
			_:
				文案 = "%s临阵突破至%s！" % [姓名, 境界]
		if Game != null:
			Game._加推演条目("【临阵突破】" + 文案, Game.ET_BREAKTHROUGH, Game.PRIO_HIGH, {"弟子": 姓名, "境界": 境界, "场景": 场景})
			Game.添加纪事("修炼", "临阵突破", 文案, 2)
		return {"成功": true, "原因": 文案, "新境界": 境界}
	else:
		# 临阵突破失败：惩罚加重（走火入魔概率+50%）
		var 回退: int = 突败回退层.get(境界, 3) + 1  # 多退1层
		层数 = max(1, 层数 - 回退)
		修炼进度 = 0.0
		突破冷却剩余 = 突败冷却日.get(境界, 60.0) * 1.5  # 冷却+50%
		突破失败次数 += 1
		增加心魔(randi_range(10, 25))  # 心魔增加更多
		# 临阵突破失败有50%概率走火入魔
		if randf() < 0.5:
			触发走火入魔()
		var 失败文案: String = "%s临阵突破失败，走火入魔！" % 姓名 if 走火入魔 else "%s临阵突破失败，修为倒退！" % 姓名
		if Game != null:
			Game._加推演条目("【突破失败】" + 失败文案, Game.ET_SECT, Game.PRIO_NORMAL, {"弟子": 姓名, "场景": 场景})
		return {"成功": false, "原因": 失败文案, "走火入魔": 走火入魔}

# ============ 天劫渡劫（数据层见 Tribulation，执行层在本文件）============
# 覆盖区间：元婴→化神（小天劫）… 渡劫→仙阶（九九重劫）；凡境与仙阶→道阶 无劫。

## 渡天劫：完美/成功→突破；重伤→跌落+养伤；陨落→殒命（保命护身可替死一次）
func _渡天劫(目标境: String, 准备: Dictionary) -> bool:
	# S46 观礼前置：召集观礼者（弟子自动遴选 / 宗主按 UI 配置），缓存名单供余波使用
	if Game != null:
		Game.大能渡劫观礼前置(self)
	var r: Dictionary = Tribulation.计算渡劫结果(self, 准备)
	渡劫详情 = r
	# S46 观礼后置：成功→发放感悟；受创/陨落→观礼者承担雷劫余波
	if Game != null:
		Game.大能渡劫观礼后置(self, r)
	var 结: String = str(r.get("结果", "重伤"))
	if 结 == "完美" or 结 == "成功":
		突破()
		_渡劫嘉奖(r, 结)
		return true
	if 结 == "重伤":
		_渡劫受创(r)
		return false
	# 陨落：保命护身替死，降档为重伤
	if 保命护身 > 0:
		保命护身 -= 1
		_渡劫受创(r)
		Game.添加纪事("天劫", "%s 渡%s 险死还生" % [姓名, str(r.get("天劫名", ""))],
			"雷劫临体几近殒命，幸有保命护身替死，跌落%d层、重伤%d日。" % [int(r.get("跌落层数", 1)), 受伤剩余], 3)
		return false
	状态 = "陨落"
	Game.添加纪事("天劫", "%s 渡%s 失败" % [姓名, str(r.get("天劫名", ""))],
		"雷劫之下形神俱灭，一代修士就此殒落。", 3)
	return false

## 公开渡劫入口（供宗主复用：绕开「层数/瓶颈打磨」门槛）
## 弟子由 推进修炼 → 尝试突破 校验层数后调用；宗主以「修炼进度满」为就绪信号，自行保证就绪，
## 故直接走天劫执行核心，不复用 尝试突破 的层数校验。
func 渡天劫(目标境: String, 准备: Dictionary = {}) -> bool:
	return _渡天劫(目标境, 准备)

## 渡劫成功/完美：发放声望与道心，完美另记待领奖励
func _渡劫嘉奖(r: Dictionary, 结: String) -> void:
	var 声望增: int = int(r.get("声望", 0))
	if 结 == "完美":
		声望增 = int(round(float(声望增) * 1.5))
		增加道心(10)
		var 奖: String = str(r.get("完美奖励", ""))
		if 奖 != "":
			待领渡劫奖励 = 奖
	if 声望增 > 0:
		Game.声望 += 声望增
	var 心魔文: String = ""
	var 心魔结: Dictionary = r.get("心魔", {})
	if not 心魔结.is_empty():
		心魔文 = "渡劫前遇%s，%s。" % [str(心魔结.get("心魔名", "心魔")), "心境澄明" if bool(心魔结.get("成功", false)) else "心魔翻涌"]
	Game.添加纪事("天劫",
		"%s %s渡%s → %s" % [姓名, "完美" if 结 == "完美" else "成功", str(r.get("天劫名", "")), 境界],
		"%s共历%d道天雷。%s%s" % [心魔文, int(r.get("雷数", 0)),
			"声望+%d。" % 声望增 if 声望增 > 0 else "", "道心大进。" if 结 == "完美" else ""],
		3 if 结 == "完美" else 2)

## 渡劫受创（未陨落）：跌落层数、清空进度、进入冷却、养伤、心魔增长
func _渡劫受创(r: Dictionary) -> void:
	var 跌落: int = int(r.get("跌落层数", 1))
	层数 = max(1, 层数 - 跌落)
	修炼进度 = 0.0
	瓶颈打磨值 = max(0.0, 瓶颈打磨值 - 0.5)
	突破冷却剩余 = 突败冷却日.get(境界, 60.0)
	受伤剩余 = int(r.get("受伤天数", 0))
	增加心魔(randi_range(8, 18))
	Game.添加纪事("天劫", "%s 渡%s 受创" % [姓名, str(r.get("天劫名", ""))],
		"雷劫难承，跌落%d层、重伤%d日，道心蒙尘。" % [跌落, 受伤剩余], 2)

# 突破到下一境界；练气→筑基 触发道途判定 + 入堂
func 突破():
	# === S1 端口：突破「走火入魔」小概率负面效果（心魔/损伤/药毒反噬）===
	# 调用位置：突破() 成功（境界已升、属性已重算、_刷新身份 已执行）之后插入判定。
	# 入参（S1 实装时）：无（读取 self.境界 / 灵根品阶 / 药毒）
	# 返回值：void；副作用：randf() 命中则施加负面状态（心魔标记 / 属性临时下降 / 突破冷却延长）
	# 依赖：突破链路（本函数）、药毒机制（§四）。状态：仅注释标记，未插入判定。
	var i: int = 境界序.find(境界)
	if i < 0 or i >= 境界序.size() - 1:
		return
	境界 = 境界序[i + 1]
	层数 = 1          # 重置到新境界第1层
	修炼进度 = 0.0    # 层内进度清零
	突破冷却剩余 = 0.0 # 清除冷却
	瓶颈打磨值 = 0.0  # 重置瓶颈打磨（新境界重新打磨）
	稳固期剩余 = _稳固期天数(境界)  # P1 突破后强制稳固期（效率减半），天数由节奏校准驱动
	寿元 = 境界表[境界]["寿元"]
	战力 = 境界表[境界]["战力"]
	算属性()
	_刷新身份()
	if 境界 == "筑基" and 道途 == "":
		判定道途(解锁道途池)
		入堂()

# 身份（宗门层级）随境界晋升：只升不降；天品/极品测灵时已破格，保持或继续抬升
func _刷新身份():
	# 身份层级（外门→长老）仅由境界晋升驱动，只升不降。
	# 注意：身份层级 与「天赋标签（天纵奇才/天资卓绝）」是两件独立的事——
	# 天赋标签仅由灵根品阶决定且永久唯一（见 简介()），不因境界晋升获得；
	# 常规弟子（凡/良/上品）堆到金丹也会成「核心弟子」层级，但不携带天赋标签、不触发天赋特权，
	# 从而保住天品/极品弟子的稀缺性（后续 S1 修炼位准入以灵根品阶值为准，而非身份层级）。
	var 身份序: Array = 身份层级序   # S1 端口：引用类级常量，便于晋升/分层逻辑复用
	var 境界身份: Dictionary = {
		"筑基": "内门弟子", "金丹": "核心弟子", "元婴": "亲传弟子",
		"化神": "长老", "炼虚": "长老", "合体": "长老", "大乘": "长老",
		"渡劫": "长老", "仙阶": "长老", "道阶": "长老"
	}
	if not 境界身份.has(境界):
		return
	var 目标: String = 境界身份[境界]
	if 身份序.find(目标) > 身份序.find(身份):
		身份 = 目标

# 旧存档兼容：身份字段缺失时的默认身份。
# 规则：破格优先级高于境界晋升——天品必核心弟子、极品必内门弟子（保住天赋稀缺性）；
#       常规弟子按境界映射（炼气外门 / 筑基内门 / 金丹核心 / 元婴亲传 / 化神及以上长老）。
func _默认身份(品阶: String, 境: String) -> String:
	if 品阶 == "天品":
		return "核心弟子"
	if 品阶 == "极品":
		return "内门弟子"
	match 境:
		"练气": return "外门"
		"筑基": return "内门弟子"
		"金丹": return "核心弟子"
		"元婴": return "亲传弟子"
		_: return "长老"

# === S1 批1：阶位轴边界 / 默认函数（与身份轴正交，互不写对方字段）===
# 旧档弟子（存档无 阶位 键）按身份轴层级推导 legacy 阶位（祖父条款，D1 豁免名额上限）
func _默认阶位(身份值: String) -> String:
	match 身份值:
		"内门弟子": return "执事"
		"核心弟子": return "堂主"
		"亲传弟子": return "长老"
		"长老": return "供奉"
		_: return "无"

# 至少内门弟子才可授阶（身份层级序索引 ≥ 1）
func 可授阶() -> bool:
	return 身份层级序.find(身份) >= 1

# 当前阶位索引（"无" → -1）
func 阶位索引() -> int:
	return 阶位层级序.find(阶位)

# 阶位上限索引（破格 +1 阶，仍须 ≥ 内门；封顶 3=供奉）。D2。
func 阶位上限索引(破格: bool) -> int:
	var i: int = 身份层级序.find(身份)
	var cap: int = clamp(i - 1, -1, 3)
	if 破格:
		cap = clamp(i, -1, 3)
	return cap

# 特殊命格（经营/宗门类）→ 破格/试炼加成资格。数据来自 DestinyDataLoader.类型。
func 有特殊命格() -> bool:
	var 数据: Dictionary = DestinyDataLoader.get_destiny(destiny_id)
	return 数据.get("类型", "") == "经营"

# 阶位试炼成功率（基础 60% / 满配 90%，clamp）。D3：复用全局 贡献点；D5：灵根/命格加成。
func 试炼成功率() -> float:
	var P: float = 0.60
	P += clamp(float(Game.贡献点) / Game.试炼贡献阈值, 0.0, 1.0) * 0.20
	if 灵根品阶 in ["极品", "天品"]:
		P += 0.05
	if 有特殊命格():
		P += 0.05
	if 试炼心得:
		P += 0.10
	return clamp(P, 0.0, 0.90)

# 筑基判定道途：按属性/灵根对各道途打分，取候选池中最高分者
func 判定道途(候选: Array = ["道修","体修","法修"]):
	var 分: Dictionary = {
		"道修": 属性.get("攻", 0)*1.5 + 属性.get("速", 0)*1.0,
		"体修": 属性.get("防", 0)*1.5 + 属性.get("血", 0)*1.5,
		"法修": 属性.get("速", 0)*1.5 + 属性.get("攻", 0)*1.0,
		"御兽师": 属性.get("速", 0)*1.0 + 属性.get("血", 0)*1.0,
		"符箓师": 属性.get("速", 0)*1.8,
		"毒师": 属性.get("攻", 0)*1.2 + 属性.get("速", 0)*1.0,
		"傀儡师": 属性.get("防", 0)*1.3 + 属性.get("攻", 0)*1.0,
	}
	if 灵根 in ["火","雷"]:
		分["法修"] += 20; 分["毒师"] += 10
	if 灵根 in ["冰","水"]:
		分["御兽师"] += 15
	if 灵根 in ["土","金"]:
		分["体修"] += 15; 分["傀儡师"] += 10
	var 最佳: String = "道修"
	var 最佳分: float = -1.0
	for 职 in 候选:
		var v: float = 分.get(职, -1.0)
		if v > 最佳分:
			最佳分 = v; 最佳 = 职
	道途 = 最佳

# 筑基后按道途加入对应司职
func 入堂():
	司职 = Lore.道途司职.get(道途, "yuying")

# P0-BUILD-2：道途 → 对口殿阁（加成评分道途对口加权用；不影响战斗数值，仅用于负责人竞争/排序）
const 道途对口殿阁: Dictionary = {
	"毒师": ["dantang"], "傀儡师": ["qitang"], "御兽师": ["yushou"],
	"符箓师": ["cangjing", "futang"], "道修": ["cangjing", "qitang"],
	"法修": ["cangjing"], "体修": ["qitang", "zhifa"],
}

# 加成评分（供司职负责人自动任命/替换用）；维度来自司职定义的加成维度
func 加成评分(维度: String) -> float:
	var 总和: float = float(属性.get("攻", 0) + 属性.get("防", 0) + 属性.get("血", 0) + 属性.get("速", 0))
	var k: float = 资质系数表.get(资质, 1.0) / 1.6
	var s: float = 总和 * (0.5 + 0.5 * k)
	if 维度 in ["攻","防","血","速"]:
		var 占比: float = 属性.get(维度, 0) / max(1.0, 总和)
		s *= (1.0 + 占比)
	if 维度 == "木" and (灵根 in 灵根五行 or 灵根 == "天灵根" or 灵根 == "先天五行全灵根"):
		s *= 1.1
	# P0-BUILD-2 加成评分权重①：弟子道途对口当前殿阁职能 → ×1.2
	var 对口key: String = 司职
	if 对口key != "" and 对口key in 道途对口殿阁.get(道途, []):
		s *= 1.2
	# P0-BUILD-2 加成评分权重②：经营型 + 对应维度命格 → ×1.15（参考 _资源殿阁产出 经营命格判定）
	var 命格数据: Dictionary = DestinyDataLoader.get_destiny(destiny_id)
	if 命格数据.get("类型", "") == "经营" and 命格数据.get("维度", "") == 维度:
		s *= 1.15
	return s

# 天赋标签：灵根品阶 × 资质 双维度组合（P0 映射，纯文案、零数值影响）
# 仅双高组合（高灵根+高资质）标「天纵奇才」；高灵根+低资质标「灵根绝世·璞玉待琢」点明偏科短板
# 异常数据（灵根/资质不在枚举内）降级为「庸碌之辈」，符合降级不崩铁律
func _天赋标签() -> String:
	var 灵根档: String = "低"
	match 灵根品阶:
		"凡品": 灵根档 = "低"
		"良品", "上品": 灵根档 = "中"
		"极品", "天品": 灵根档 = "高"
	var 资质档: String = "低"
	match 资质:
		"fan_su", "pingyong": 资质档 = "低"
		"youliang": 资质档 = "中"
		"tiancai", "yaonie", "kuangshi": 资质档 = "高"
	var 表: Dictionary = {
		"低": {"低": "庸碌之辈", "中": "勤能补拙", "高": "根基扎实"},
		"中": {"低": "偏科之资", "中": "中规中矩", "高": "可造之材"},
		"高": {"低": "灵根绝世·璞玉待琢", "中": "天赋异禀", "高": "天纵奇才"},
	}
	return 表[灵根档][资质档]

func 简介() -> String:
	var 显示名: String = 姓名
	if 备注 != "":
		显示名 = "%s（%s）" % [姓名, 备注]
	# 身份标签 = 天赋标签（灵根品阶 × 资质 双维度组合，详见 _天赋标签）；
	# 仅双高组合标「天纵奇才」，高灵根+低资质标「灵根绝世·璞玉待琢」点明偏科，消除认知冲突。
	var 身份标签: String = "「" + _天赋标签() + "」"
	# 身份（宗门层级：外门/内门弟子/核心弟子/亲传弟子/长老）随境界晋升，突破练气后露出
	if 身份 != "" and 身份 != "外门":
		if 身份标签 != "":
			身份标签 += " · 身份·" + 身份
		else:
			身份标签 = " · 身份·" + 身份
	var 道途显: String = 道途 if 道途 != "" else "未入门"
	var 命格数据: Dictionary = DestinyDataLoader.get_destiny(destiny_id)
	var 命格显: String = ("%s[%s]" % [命格数据.get("名称", "—"), 命格数据.get("品级", "")]) if destiny_id != "" else "—"
	var 年龄文本: String = "??" if 年龄 <= 0 else ("%.0f岁" % 年龄)
	var 灵根显: String = "%s·%s" % [灵根, 灵根品阶]
	# 境界合并写法：练气三层·修业49%
	var 中文层数: Array = ["零","一","二","三","四","五","六","七","八","九","十"]
	var 层数中文: String = "大圆满" if 层数 >= 10 else (中文层数[层数] + "层")
	var 境界合并: String = "%s%s·修业%d%%" % [境界, 层数中文, int(修炼进度*100)]
	var s: String = "%s\n资质:%s  灵根:%s%s  命格:%s  性格:%s  道途:%s\n%s  寿元:%d  战力:%d  修炼x%.1f  年龄%s" % \
		[显示名, 资质显示.get(资质, 资质), 灵根显, 身份标签, 命格显, 性格, 道途显, 境界合并, 寿元, 战力, 修炼速度, 年龄文本]
	s += "\n  属性(攻%d/防%d/血%d/速%d)  职位:%s  来源:%s" % \
		[属性.get("攻", 0), 属性.get("防", 0), 属性.get("血", 0), 属性.get("速", 0), _职位文案(), (来源 if 来源 != "" else "—")]
	# S1 批1：阶位轴双轴呈现（阶位· 前缀消歧，与 身份·长老 区分）
	var 阶位显: String = ("阶位·无（未授阶）" if 阶位 == "无" else "阶位·" + 阶位)
	s += "\n  阶位：%s" % 阶位显
	if 试炼冷却剩余 > 0:
		s += " ｜ 试炼冷却 %d 日" % 试炼冷却剩余
	if 试炼心得:
		s += " ｜ 试炼心得"
	var 上限境: String = 资质上限境界()
	if 是否达资质上限():
		s += "\n  ⚠ 资质所限，此生已无更进一步可能（上限：%s）" % 上限境
	else:
		s += "\n  资质上限：%s" % 上限境
	if 背包.size() > 0:
		s += "\n  持有(储物袋)："
		for it in 背包:
			s += "\n    · " + it.简介()
	if 装备.size() > 0:
		s += "\n  已穿戴："
		for 槽 in 装备.keys():
			var it = 装备[槽]
			s += "\n    ·[%s] %s" % [Item.槽显示.get(槽, 槽), it.名称]
	for _槽兽 in [主宠灵兽, 副宠灵兽]:
		if _槽兽 != null:
			var 显示本体: int = int(float(_槽兽.本体战力()) * (1.0 + calc_beast_bonus(_槽兽, self)))
			s += "\n  灵兽：" + _槽兽.简介(显示本体)
			var 单兽: Dictionary = 灵兽单宠实战属性(_槽兽)
			if 单兽["攻"] + 单兽["防"] + 单兽["血"] + 单兽["速"] > 0:
				s += "（实战+攻%d/防%d/血%d/速%d）" % [单兽["攻"], 单兽["防"], 单兽["血"], 单兽["速"]]
			var 联动: String = 灵兽联动(_槽兽)
			if 联动 != "":
				s += "\n    ☆ " + 联动
	return s

# 灵兽联动：基于灵兽「随机天赋」的关联（灵根/道途）与弟子匹配，不再依赖灵兽适配道途
func 灵兽联动(兽: Beast) -> String:
	if 兽 == null or 兽.孵化中:
		return ""
	var 类型: String = 兽.天赋类型
	var 关联: String = 兽.天赋关联
	# 灵根契合
	if 类型 == "灵根" and 关联 == 灵根:
		return "【天赋共鸣】灵兽天赋契合%s灵根：%s" % [灵根, 兽.天赋]
	# 道途契合（含极品专属联动：弟子持有对应极品装备才触发）
	if 类型 == "道途" and 关联 == 道途 and 道途 != "":
		var 极品名: String = _持有极品名()
		if 极品名 == "万法可破":
			return "【万法可破】+道修灵兽天赋：对战法修额外获得短时法术无敌帧"
		if 极品名 == "金刚不坏":
			return "【金刚不坏】+体修灵兽天赋：锁血阈值由20%提升至25%"
		if 极品名 == "焚身灭甲":
			return "【焚身灭甲】+法修灵兽天赋：真实伤害小幅扩散溅射"
		return "【天赋共鸣】灵兽天赋契合%s：%s" % [道途, 兽.天赋]
	return ""

# 取弟子当前持有的某一极品装备中文名（用于灵兽极品联动判定）
func _持有极品名() -> String:
	for it in 背包:
		if it.极品属性 != null:
			return it.极品属性["名"]
	for it in 装备.values():
		if it.极品属性 != null:
			return it.极品属性["名"]
	return ""

# 职位文案（S0：仅根据司职名显示"XX弟子"；S1 接入 Game.司职列表 负责人检测后区分"XX主事"）
func _职位文案() -> String:
	if 司职 == "":
		return "—"
	var 司职名: String = Lore.取司职(司职).get("名称", 司职)
	return "%s弟子" % 司职名

# 效果查询（UI 点击查看详情用）
func 命格详情() -> String:
	var 命格数据: Dictionary = DestinyDataLoader.get_destiny(destiny_id)
