extends RefCounted

# ===== 修真世界消息系统 =====
# 消息层级：天音法旨 > 仙盟邸报 > 坊市闲谈 > 密语传音 > 天机秘闻 > 宗门传令
# 符合修真世界观：传音符、神识传音、邸报、闲谈等

# ===== 状态变量 =====
var 消息列表: Array = []          # 所有消息列表（按时间倒序）
var 未读计数: Dictionary = {}     # 各类型未读计数
var 最大消息数: int = 200         # 最大保留消息数
var _已初始化: bool = false
# S56-P1：坊市闲谈验证记录
var 已验证消息: Dictionary = {}   # 消息ID -> 验证结果（真/假/半真）
# S56-P1：宗门频道聊天记录
var 宗门聊天记录: Array = []      # 宗门频道聊天消息
var 最大聊天记录: int = 100       # 最大保留聊天记录数
# S56-P1：NPC聊天池
var _npc聊天池: Array = []        # NPC聊天模板池
# S56-P2：传音符库存
var 传音符数量: int = 10          # 初始传音符数量
# S56-P2：天机秘闻已获取列表
var 已获取秘闻: Dictionary = {}   # 秘闻ID -> 获取信息
# S56-P2：主动打探冷却
var 打探冷却: int = 0             # 打探冷却（游戏日）
# S56-P2：卧底弟子列表
var 卧底弟子: Array = []          # 正在卧底的弟子ID列表
# S56-P2：天机阁声望
var 天机阁声望: int = 0           # 天机阁声望（影响秘闻质量）

# 消息类型常量
const 类型_天音法旨 = "天音法旨"
const 类型_仙盟邸报 = "仙盟邸报"
const 类型_坊市闲谈 = "坊市闲谈"
const 类型_密语传音 = "密语传音"
const 类型_天机秘闻 = "天机秘闻"
const 类型_宗门传令 = "宗门传令"

# 消息类型颜色
const 颜色_天音法旨 = Color(1.0, 0.85, 0.2)   # 金色
const 颜色_仙盟邸报 = Color(0.3, 0.7, 1.0)    # 蓝色
const 颜色_坊市闲谈 = Color(0.6, 0.8, 0.4)    # 绿色
const 颜色_密语传音 = Color(0.8, 0.5, 0.9)    # 紫色
const 颜色_天机秘闻 = Color(1.0, 0.5, 0.2)    # 橙色
const 颜色_宗门传令 = Color(0.9, 0.6, 0.3)    # 棕色

# 信号
signal 新消息(消息: Dictionary)
signal 未读更新()

# 初始化
func _init() -> void:
	if not _已初始化:
		_已初始化 = true
		未读计数 = {
			类型_天音法旨: 0,
			类型_仙盟邸报: 0,
			类型_坊市闲谈: 0,
			类型_密语传音: 0,
			类型_天机秘闻: 0,
			类型_宗门传令: 0,
		}

# ===== 发送消息 =====
# 发送一条消息
func 发送消息(类型: String, 标题: String, 内容: String, 发送者: String = "天道", 附加数据: Dictionary = {}) -> Dictionary:
	var 消息: Dictionary = {
		"id": "msg_%d_%d" % [Game.累计游戏日, randi() % 100000],
		"类型": 类型,
		"标题": 标题,
		"内容": 内容,
		"发送者": 发送者,
		"日": Game.累计游戏日,
		"已读": false,
		"附加数据": 附加数据,
	}
	消息列表.push_front(消息)
	# 限制最大消息数
	if 消息列表.size() > 最大消息数:
		消息列表.pop_back()
	# 更新未读计数
	if 类型 in 未读计数:
		未读计数[类型] = int(未读计数[类型]) + 1
	else:
		未读计数[类型] = 1
	# 发射信号
	新消息.emit(消息)
	未读更新.emit()
	return 消息

# ===== 天音法旨（系统公告）=====
# 发送天音法旨（最高优先级，全屏公告）
func 发送天音法旨(标题: String, 内容: String) -> Dictionary:
	return 发送消息(类型_天音法旨, 标题, 内容, "天道", {"全屏公告": true})

# ===== 仙盟邸报（世界新闻）=====
# 发送仙盟邸报
func 发送仙盟邸报(标题: String, 内容: String) -> Dictionary:
	return 发送消息(类型_仙盟邸报, 标题, 内容, "仙盟传令使")

# ===== 坊市闲谈（小道消息）=====
# 发送坊市闲谈
func 发送坊市闲谈(标题: String, 内容: String, 真实性: float = 0.5) -> Dictionary:
	return 发送消息(类型_坊市闲谈, 标题, 内容, "无名散修", {"真实性": 真实性, "可验证": true, "已验证": false})

# S56-P1：验证坊市闲谈消息
# 花费灵石验证，返回验证结果（真/假/半真半假）
func 验证坊市闲谈(消息ID: String) -> Dictionary:
	var 消息: Dictionary = _找消息(消息ID)
	if 消息.is_empty():
		return {"成功": false, "原因": "消息不存在"}
	var 附加数据: Dictionary = 消息.get("附加数据", {})
	if not bool(附加数据.get("可验证", false)):
		return {"成功": false, "原因": "此消息无法验证"}
	if bool(附加数据.get("已验证", false)):
		return {"成功": false, "原因": "此消息已验证过"}
	# 验证花费：100灵石
	var 验证费用: int = 100
	if Game.灵石 < 验证费用:
		return {"成功": false, "原因": "灵石不足，需%d灵石" % 验证费用}
	Game.灵石 -= 验证费用
	# 判定真实性
	var 真实性: float = float(附加数据.get("真实性", 0.5))
	var 随机值: float = randf()
	var 结果: String = ""
	var 奖励: Dictionary = {}
	if 随机值 < 真实性 * 0.7:
		结果 = "真"
		# 真消息奖励：贡献点+声望
		var 贡献奖励: int = randi_range(10, 50)
		var 声望奖励: int = randi_range(1, 5)
		Game.贡献点 += 贡献奖励
		Game.声望 += 声望奖励
		奖励 = {"贡献点": 贡献奖励, "声望": 声望奖励}
	elif 随机值 < 真实性:
		结果 = "半真半假"
		var 贡献奖励: int = randi_range(5, 20)
		Game.贡献点 += 贡献奖励
		奖励 = {"贡献点": 贡献奖励}
	else:
		结果 = "假"
		# 假消息：无奖励，可能损失声望
		if randf() < 0.3:
			Game.声望 = max(0, Game.声望 - 1)
			奖励 = {"声望": -1}
	# 标记已验证
	附加数据["已验证"] = true
	附加数据["验证结果"] = 结果
	消息["附加数据"] = 附加数据
	已验证消息[消息ID] = {"结果": 结果, "奖励": 奖励, "验证日": Game.累计游戏日}
	return {"成功": true, "结果": 结果, "奖励": 奖励, "费用": 验证费用}

