# ===== S54 P1：拍卖预告系统 =====
# 拍卖前发布预告，展示部分拍品
func 发布拍卖预告() -> Dictionary:
	if 全服拍卖.get("激活", false):
		return {"成功": false, "原因": "拍卖正在进行中"}
	if bool(全服拍卖.get("预告已发布", false)):
		return {"成功": false, "原因": "预告已发布"}
	# 计算下次拍卖类型
	var 当前日: int = int(Game.累计游戏日)
	var 拍卖次数: int = int((当前日 + 30) / 30)
	var 是大拍: bool = (拍卖次数 % 7 == 0)
	var 类型: String = "周末大拍" if 是大拍 else "日常"
	# 生成预告拍品（展示3-5件）
	var 预告拍品: Array = []
	var 预告数: int = randi_range(3, 5)
	for i in range(预告数):
		var lot: Dictionary = _生成系统拍品(类型)
		预告拍品.append({
			"名称": lot.get("名称", ""),
			"品阶": lot.get("品阶", ""),
			"类别": lot.get("类别", ""),
			"底价": lot.get("底价", 0),
		})
	全服拍卖["预告已发布"] = true
	全服拍卖["预告拍品"] = 预告拍品
	# 全服公告
	if 是大拍:
		Game.添加纪事("全服拍卖", "周末大拍预告", "★ 聚宝阁周末大拍预告！本次大典将有%s等稀世之宝登场，诸位道友可提前准备灵石！" % 预告拍品[0].get("名称", ""), 2)
	else:
