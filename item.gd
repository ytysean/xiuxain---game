# ============ 生成 ============
func 加权抽(权重: Dictionary) -> String:
	var 总 := 0.0
	for k in 权重:
		总 += 权重[k]
	var 抽: float = randf() * 总
	for k in 权重:
		抽 -= 权重[k]
		if 抽 <= 0:
			return k
	return 权重.keys()[0]

func 随机生成():
	类别 = 加权抽(类别权重)
	品阶 = 加权抽(品阶权重)
	match 类别:
		"dan_yao":
			_填模板(_取随机(基础库["dan_yao"][品阶]))
		"ling_cai":
			_填模板(_取随机(基础库["ling_cai"][品阶]))
		"fa_qi":
			穿戴位 = 法器槽名.keys().pick_random()
			_填模板(_取随机(基础库["fa_qi"][穿戴位][品阶]))
		"shen_bing":
			道途 = 道途名.pick_random()
			_填模板(_取随机(基础库["shen_bing"][道途][品阶]))
		"fabao":
			穿戴位 = "本命法宝"
			_填模板(_取随机(基础库["fabao"][品阶]))
	滚词缀()
	滚极品()
	# S2 毕业·变异小极品（奇物）：穿戴类按品阶概率(3%~8%)变异，附特殊技能+修真叙事文案
	var 奇物战力倍数: float = 1.0
	if 类别 in ["fa_qi", "shen_bing", "fabao"]:
		var 奇物概率: float = 0.03 + 0.0075 * float(品阶序.find(品阶))
		if randf() < 奇物概率:
			奇物 = true
			var 类型键: String = 奇物类型库.keys().pick_random()
			var 类型: Dictionary = 奇物类型库[类型键]
			奇物类型 = 类型键
			奇物技能 = str(类型.get("技能", ""))
			名称 = str(类型.get("前缀", "")) + 名称
			描述 = 描述 + str(类型.get("描述后缀", ""))
			奇物战力倍数 = float(类型.get("战力倍数", 1.0))
	# 套装概率：宝阶及以上15%概率生成套装件；按品阶从分层池抽取（毕业装仅仙/道阶出现）
	if 套装分层池.has(品阶) and randf() < 0.15:
		套装ID = 套装分层池[品阶].pick_random()
	# 祭炼上限按品阶
	祭炼上限 = {"凡阶":5, "灵阶":6, "宝阶":7, "王阶":8, "圣阶":9, "仙阶":10, "道阶":10}.get(品阶, 5)
	算战力()
	if 奇物:
		战力加成 = int(float(战力加成) * 奇物战力倍数)

static func _取随机(列表: Array) -> Dictionary:
	return 列表.pick_random()

func _填模板(模板: Dictionary):
	名称 = 模板["名"]
	功效 = 模板["功效"]
	描述 = 模板["描述"]

func 滚词缀():
	词缀 = []
	var 数: int = 品阶词缀数[品阶]
	if 类别 == "dan_yao" or 类别 == "ling_cai":
		数 = 0
	for i in 数:
		var 是前缀: bool = randf() < 0.34
		var 名 := ""
		var 区间 := []
		if 是前缀:
			var 池: Dictionary = 前缀池.duplicate()
			if 类别 == "shen_bing":
				for k in 道途词缀范围:
					池[k] = 道途词缀范围[k]
			名 = 池.keys().pick_random()
			区间 = 池[名]
		else:
			名 = 后缀池.keys().pick_random()
			区间 = 后缀池[名]
		var 档: String = 加权抽(档权重)
		var 数值: int = randi_range(区间[0], 区间[1])
		词缀.append({"名": 名, "前缀": 是前缀, "档": 档, "数值": 数值})

# S41 丹词条：仅炼制丹药（非随机生成/掉落）调用，按归一品阶掷 N 条
func 滚丹词条(归一品阶: String) -> void:
	丹词条 = []
	var 池: Array = Game.丹词条池().get(归一品阶, [])
	var 数: int = Game.丹词缀数().get(归一品阶, 0)
	for i in range(数):
		if 池.is_empty():
			break
		var 模板: Dictionary = 池[randi() % 池.size()]
		var v: float = randf_range(float(模板["数值下限"]), float(模板["数值上限"]))
		丹词条.append({"key": 模板["key"], "中文名": 模板["中文名"], "类型": 模板["类型"], "数值": v})

# S43 装备词条：锻造装备（矿石路径 + 配方路径）调用，按 item 内部品阶掷 N 条
func 滚装备词条(品阶: String) -> void:
	装备词条 = []
	var 池: Array = Game.装备词条池().get(品阶, [])
	var 数: int = Game.装备词缀数().get(品阶, 0)
	for i in range(数):
		if 池.is_empty():
			break
		var 模板: Dictionary = 池[randi() % 池.size()]
		var v: float = randf_range(float(模板["数值下限"]), float(模板["数值上限"]))
		装备词条.append({"key": 模板["key"], "中文名": 模板["中文名"], "类型": 模板["类型"], "数值": v})

func 滚符词条(品阶: String) -> void:
	符词条 = []
	var 池: Array = Game.符词条池().get(品阶, [])
	var 数: int = Game.符词缀数().get(品阶, 0)
	for i in range(数):
		if 池.is_empty():
			break
		var 模板: Dictionary = 池[randi() % 池.size()]
		var v: float = randf_range(float(模板["数值下限"]), float(模板["数值上限"]))
		符词条.append({"key": 模板["key"], "中文名": 模板["中文名"], "类型": 模板["类型"], "数值": v})

func 滚极品():
	极品属性 = null
	极品 = false
	特殊 = false
	if 品阶 == "道阶":
		特殊 = true
		极品 = true
		极品属性 = _取极品(true)
	elif 品阶 == "仙阶":
		if randf() < 0.35:
			极品 = true
			极品属性 = _取极品(false)

func _取极品(渡劫: bool) -> Dictionary:
	if 渡劫:
		return _随机极品(极品道祖)
	if 类别 == "shen_bing":
		return _随机极品({"道修": 极品道修, "体修": 极品体修, "法修": 极品法修}[道途])
	return _随机极品(极品通用)

func _随机极品(库: Dictionary) -> Dictionary:
	var k: String = 库.keys().pick_random()
	return 库[k].duplicate()

# S2 毕业·神器传说层生成器：构造全服唯一神器（覆盖随机生成字段）
static func 生成神器(神器ID: String) -> Item:
	var e: Dictionary = 神器库.get(神器ID, {})
	var it: Item = Item.new()
	if e.is_empty():
		return it
	it.类别 = e.get("类别", "fabao")
	it.品阶 = e.get("品阶", "道阶")
	it.穿戴位 = e.get("穿戴位", "本命法宝")
	it.道途 = e.get("道途", "")
	it.名称 = e.get("名称", "神器")
	it.描述 = e.get("描述", "")
	it.战力加成 = int(e.get("战力加成", 0))
	it.神器技能 = str(e.get("技能", ""))
	it.神器技能2 = str(e.get("技能2", ""))
	it.独一无二 = true
	it.特殊 = true
	it.极品 = true
	return it

# S2 增强·变异小极品（奇物）工厂：构造指定品阶的奇物（强制变异 + 随机奇物类型 + 修真叙事文案）。
# 仅作用于穿戴类（法器/神兵/法宝），掉落途径调用，返回可直接入库的 Item 对象。
static func 生成奇物(品阶: String = "道阶") -> Item:
	var it: Item = Item.new()
	it.品阶 = 品阶
	it.类别 = ["fa_qi", "shen_bing", "fabao"].pick_random()
	match it.类别:
		"fa_qi":
			it.穿戴位 = 法器槽名.keys().pick_random()
			it._填模板(_取随机(it.基础库["fa_qi"][it.穿戴位][品阶]))
		"shen_bing":
			it.道途 = 道途名.pick_random()
			it._填模板(_取随机(it.基础库["shen_bing"][it.道途][品阶]))
		"fabao":
			it.穿戴位 = "本命法宝"
			it._填模板(_取随机(it.基础库["fabao"][品阶]))
	# 强制变异为奇物 + 随机奇物类型
	it.奇物 = true
	var 类型键: String = 奇物类型库.keys().pick_random()
	var 类型: Dictionary = 奇物类型库[类型键]
	it.奇物类型 = 类型键
	it.奇物技能 = str(类型.get("技能", ""))
	it.名称 = str(类型.get("前缀", "")) + it.名称
	it.描述 = it.描述 + str(类型.get("描述后缀", ""))
	it.算战力()
	it.战力加成 = int(float(it.战力加成) * float(类型.get("战力倍数", 1.0)))
	return it

func 算战力():
	var b: int = 基础战力表[品阶]
	if 类别 == "fabao":
		b = int(b * 1.3)
	for a in 词缀:
		b += int(a["数值"] * 6 * 档倍(a["档"]))
	if 极品属性 != null:
		b += (1500 if 品阶 == "道阶" else 600)
	# 祭炼加成：每级+5%战力
	if 祭炼等级 > 0:
		b = int(b * (1.0 + 祭炼等级 * 0.05))
	战力加成 = b

# 祭炼：消耗灵石提升装备灵性，每级+5%战力
# 返回：true=成功，false=灵石不足或已满级
func 祭炼(拥有灵石: int) -> Dictionary:
	if 祭炼等级 >= 祭炼上限:
		return {"成功": false, "原因": "已达祭炼上限", "消耗": 0}
	# 消耗：基础10灵石 × (1 + 祭炼等级×0.5)，品阶越高越贵
	var 品阶系数: float = float(品阶序.find(品阶) + 1)
	var 消耗: int = int(10 * 品阶系数 * (1.0 + 祭炼等级 * 0.5))
	if 拥有灵石 < 消耗:
		return {"成功": false, "原因": "灵石不足", "消耗": 消耗}
	祭炼等级 += 1
	算战力()
	return {"成功": true, "原因": "祭炼成功", "消耗": 消耗, "新等级": 祭炼等级}

# ============ 装备穿戴辅助（ADR-001，ADD-ONLY，不改既有 战力加成/算战力 语义）============
# 拆分 flat 基础战力，供弟子.计算战力() 按 §4.7 并入 base 前（与词缀%通用增益区分，避免重复计入）
func 装备基础战力() -> int:
	var b: int = 基础战力表.get(品阶, 0)
	if 极品属性 != null:
		b += (1500 if 品阶 == "道阶" else 600)
	# 考虑战力加成属性（测试装备和特殊装备的额外战力）
	if 战力加成 > 0:
		b += 战力加成
	return b

# 是否可穿戴（仅法器/神兵/法宝可穿戴；丹药/灵材无论穿戴位是否非空都不可穿）
func 可穿戴() -> bool:
	if 类别 in ["dan_yao", "ling_cai"]:
		return false
	return 穿戴位 != "" and 穿戴位 != null

# 物品简称（纪事/摘要等只需短名的场景；GDScript 无参方法可省略括号，故 it.简称 即可调用）
func 简称() -> String:
	return 名称

func 简介() -> String:
	var s: String = "%s" % 名称
	var 类别名显示: String = 类别中文名.get(类别, 类别)
	s += " [%s·%s" % [类别名显示, 品阶显示[品阶]]
	if 穿戴位 != "":
		s += "·" + 槽显示.get(穿戴位, 穿戴位)
	if 道途 != "":
		s += "·" + 道途
	s += "] 道行+%d" % 战力加成
	if 极品属性 != null:
		s += " ★极品特异"
	elif 特殊:
		s += " ★天道"
	s += "\n  功效：%s" % 功效
	for a in 词缀:
		var 类: String = "前缀" if a["前缀"] else "后缀"
		var 符: String = "+" if a["数值"] >= 0 else ""
		var 中文名: String = 词缀中文名.get(a["名"], a["名"])
		var 档中文: String = 词缀档中文名.get(a["档"], a["档"])
		s += "\n  ·[%s]%s %s%d%%（%s）" % [类, 中文名, 符, a["数值"], 档中文]
	if 极品属性 != null:
		s += "\n  ☆【%s】%s" % [极品属性["名"], 极品属性["描述"]]
	# S41 丹词条显示
	for t in 丹词条:
		var 类型名: String = {"药效":"药效", "减毒":"减毒", "心境":"心境", "售价":"售价"}.get(t["类型"], str(t["类型"]))
		var 值文本: String = ""
		if t["类型"] in ["药效", "售价"]:
			值文本 = "+%.0f%%" % (float(t["数值"]) * 100)
		elif t["类型"] == "减毒":
			值文本 = "-%.1f毒" % float(t["数值"])
		else:
			值文本 = "+%d心境" % int(t["数值"])
		s += "\n  ◆丹词条【%s】%s %s" % [类型名, t["中文名"], 值文本]
	# S43 装备词条显示
	for t in 装备词条:
		var 类型名2: String = {"战力":"道行", "修炼":"修炼", "突破":"突破"}.get(t["类型"], str(t["类型"]))
		var 值文本2: String = ""
		if t["类型"] == "战力":
			值文本2 = "+%d道行" % int(t["数值"])
		elif t["类型"] == "修炼":
			值文本2 = "+%.0f%%修炼" % (float(t["数值"]) * 100)
		else:
			值文本2 = "+%.0f%%突破" % (float(t["数值"]) * 100)
		s += "\n  ◆装备词条【%s】%s %s" % [类型名2, t["中文名"], 值文本2]
	return s

func to_dict() -> Dictionary:
	return {
		"类别": 类别, "品阶": 品阶, "穿戴位": 穿戴位, "道途": 道途,
		"名称": 名称, "数量": 数量, "功效": 功效, "描述": 描述,
		"战力加成": 战力加成, "极品": 极品, "特殊": 特殊,
		"词缀": 词缀, "极品属性": 极品属性, "奇遇版": 奇遇版,
		"套装ID": 套装ID, "祭炼等级": 祭炼等级, "祭炼上限": 祭炼上限,
		"丹纹": 丹纹,
		"品级": 品级, "丹毒值": 丹毒值,
		"符纹": 符纹,
		"年份": 年份,
		"丹词条": 丹词条,
		"装备词条": 装备词条,
		"符词条": 符词条,
		"保命": 保命,
		# P0-3 装备本体基础属性
		"基础攻击": 基础攻击, "基础防御": 基础防御, "基础气血": 基础气血,
		"基础耐久": 基础耐久, "装备模板ID": 装备模板ID,
		# S53 物品认主系统
