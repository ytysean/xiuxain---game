## 统计弟子阵营分布
func _统计弟子阵营() -> Dictionary:
	var 正道数: int = 0
	var 魔道数: int = 0
	var 未加入数: int = 0
	for d in Game.弟子列表:
		if d is Disciple:
			if d.正魔阵营 == "正道":
				正道数 += 1
			elif d.正魔阵营 == "魔道":
				魔道数 += 1
			else:
				未加入数 += 1
	return {"正道": 正道数, "魔道": 魔道数, "未加入": 未加入数, "总数": Game.弟子列表.size()}

