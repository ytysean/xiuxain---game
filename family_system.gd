## 触发扩展家族事件
func 触发扩展家族事件(家族ID: String, 事件类型: String) -> Dictionary:
	if 家族ID == "" or 事件类型 == "":
		return {"成功": false, "因": "参数无效"}
	if _家族事件配置.has(事件类型):
		return 触发家族事件(家族ID, 事件类型)
	if not _家族事件扩展配置.has(事件类型):
		return {"成功": false, "因": "事件类型不存在"}
	var 家族: Dictionary = 获取家族(家族ID)
	if 家族.is_empty():
		return {"成功": false, "因": "家族不存在"}
	var 事件: Dictionary = _家族事件扩展配置[事件类型]
	if 事件.has("声望加成"):
		家族["家族声望"] = int(家族.get("家族声望", 0)) + int(事件.get("声望加成", 0))
	elif 事件.has("声望减少"):
		家族["家族声望"] = max(0, int(家族.get("家族声望", 0)) - int(事件.get("声望减少", 0)))
	var 事件记录: Dictionary = {"时间": Game.累计游戏日, "类型": 事件类型, "名": str(事件.get("名", "")), "描述": str(事件.get("描述", ""))}
	if not 家族.has("事件记录"):
		家族["事件记录"] = []
	家族["事件记录"].append(事件记录)
	if 家族["事件记录"].size() > 100:
		家族["事件记录"].pop_front()
	家族列表[家族ID] = 家族
	Game.添加纪事("家族事件", str(事件.get("名", "")), "「%s」%s" % [str(家族.get("名", "")), str(事件.get("描述", ""))], 2)
	return {"成功": true, "事件名": str(事件.get("名", ""))}

## 家族兴衰周期判定
func 家族兴衰周期判定(家族ID: String) -> String:
	if 家族ID == "" or not 家族列表.has(家族ID):
		return "未知"
	var 家族: Dictionary = 家族列表[家族ID]
	var 评分: int = 计算家族实力评分(家族ID).get("评分", 0)
	var 声望: int = int(家族.get("家族声望", 0))
	var 创立时间: int = int(家族.get("创立时间", 0))
	var 存在时间: int = Game.累计游戏日 - 创立时间
	if 评分 < 30 and 存在时间 > 365:
		return "衰落期"
	elif 评分 < 80 and 声望 < 50:
		return "起步期"
	elif 评分 < 150 and 声望 < 150:
		return "发展期"
	elif 评分 < 250 and 声望 < 300:
		return "崛起期"
	elif 评分 >= 250 and 声望 >= 300:
		return "鼎盛期"
	else:
		return "稳定期"
