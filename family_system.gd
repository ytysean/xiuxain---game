		return {"成功": false, "因": "家族品级不足，太古周天阵需家族品级五以上"}
	# 布置阵法
	家族["家族阵法"] = 阵法ID
	家族["阵法等级"] = 1
	家族["阵法耐久度"] = 100
	家族["阵法驻守弟子"] = [布置者.弟子ID]
	家族列表[家族ID] = 家族
