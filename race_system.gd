## 获取种族组队加成（不同种族组队有互补效果）
func 获取种族组队加成(队伍种族列表: Array) -> Dictionary:
	var 种族集合: Array = []
	for 种族 in 队伍种族列表:
		if not 种族集合.has(种族):
			种族集合.append(种族)
	
	var 加成: Dictionary = {
		"修炼加成": 0.0,
		"战斗加成": 0.0,
		"描述": ""
	}
	
	# 种族多样性加成：3种以上种族+5%修炼，5种以上+10%
	if 种族集合.size() >= 5:
		加成["修炼加成"] = 0.1
		加成["描述"] = "五族共和：修炼速度+10%"
	elif 种族集合.size() >= 3:
		加成["修炼加成"] = 0.05
		加成["描述"] = "三族融合：修炼速度+5%"
	
	# 特定种族组合加成
	if 种族集合.has("人族") and 种族集合.has("妖族"):
		加成["战斗加成"] += 0.05  # 人妖互补
	if 种族集合.has("魔族") and 种族集合.has("鬼族"):
		加成["战斗加成"] += 0.08  # 魔鬼联手
	if 种族集合.has("龙族") and 种族集合.has("凤凰血脉"):
		加成["战斗加成"] += 0.1  # 龙凤呈祥
	if 种族集合.has("人族") and 种族集合.has("龙族"):
		加成["修炼加成"] += 0.05  # 人龙共修
	
	return 加成

