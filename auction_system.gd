# ===== S53 P3：鉴宝玩法（大捡漏唯一途径）=====
# 鉴定未知宝物，可能增值（大捡漏）或贬值（打眼）
func 鉴定宝物_S53(lot_id: String) -> Dictionary:
	var lot: Dictionary = _查找拍品_S34(lot_id)
	if lot == null:
		return {"成功": false, "原因": "拍品不存在"}
	if not bool(lot.get("未知宝物", false)):
		return {"成功": false, "原因": "此宝并非蒙尘之物，无需鉴定。"}
	if bool(lot.get("已鉴定", false)):
		return {"成功": false, "原因": "此宝已鉴定过。"}
	# 鉴定费 = 起拍价的10%
	var 鉴定费: int = max(10, int(float(lot.get("起拍价", 100)) * 0.1))
	if Game.灵石 < 鉴定费:
		return {"成功": false, "原因": "灵石不足，鉴定费需%d灵石。" % 鉴定费}
	Game.灵石 -= 鉴定费
	# 鉴定结果：50%增值，30%保值，20%贬值
	var r: float = randf()
	var 真实倍率: float = 1.0
	var 结果: String = ""
	if r < 0.5:
		# 增值：1.5-3倍（大捡漏！）
		真实倍率 = randf_range(1.5, 3.0)
		结果 = "增值"
	elif r < 0.8:
		# 保值：0.9-1.1倍
		真实倍率 = randf_range(0.9, 1.1)
		结果 = "保值"
	else:
		# 贬值：0.3-0.7倍（打眼了）
		真实倍率 = randf_range(0.3, 0.7)
		结果 = "贬值"
	lot["已鉴定"] = true
	lot["鉴定结果"] = 结果
	lot["真实倍率"] = 真实倍率
	# 更新基准估值和保留价
	var 原基准: int = int(lot.get("基准估值", 100))
	var 新基准: int = max(10, int(float(原基准) * 真实倍率))
	lot["基准估值"] = 新基准
	lot["保留价"] = max(10, int(float(新基准) * 0.5))
	# 纪事
	var 物品名: String = str(lot.get("名称", "未知宝物"))
	if 结果 == "增值":
		Game.添加纪事("拍卖", "鉴宝", "慧眼识珠！「%s」鉴定后竟是稀世之珍，价值暴涨%.0f%%！" % [物品名, (真实倍率 - 1.0) * 100], 2)
	elif 结果 == "保值":
		Game.添加纪事("拍卖", "鉴宝", "「%s」鉴定完毕，价值与预估相若。" % 物品名, 1)
	else:
		Game.添加纪事("拍卖", "鉴宝", "可惜！「%s」鉴定后竟是寻常之物，价值大跌%.0f%%。" % [物品名, (1.0 - 真实倍率) * 100], 1)
	return {
		"成功": true,
		"结果": 结果,
		"真实倍率": 真实倍率,
		"原估值": 原基准,
		"新估值": 新基准,
		"鉴定费": 鉴定费,
	}

# ===== S53 P3：流拍处理优化 =====
# 流拍后降价重拍，连续流拍进入捡漏区
func _流拍处理_S53(lot: Dictionary) -> void:
	var 流拍次数: int = int(lot.get("流拍次数", 0)) + 1
	lot["流拍次数"] = 流拍次数
	var 物品名: String = str(lot.get("名称", "未知"))
	if 流拍次数 >= 3:
		# 第三次流拍：进入捡漏区（价格降至30%-50%）
		var 捡漏价: int = max(10, int(float(lot.get("基准估值", 100)) * randf_range(0.3, 0.5)))
		lot["起拍价"] = 捡漏价
		lot["当前价"] = 捡漏价
		lot["保留价"] = max(5, int(float(捡漏价) * 0.3))
		lot["状态"] = "竞拍中"
		lot["结束日"] = Game.累计游戏日 + 7
		lot["捡漏区"] = true
		Game.添加纪事("拍卖", "捡漏区", "「%s」三度流拍，掌柜叹惜，将其置于捡漏区，仅以%d灵石起拍，或有有缘人识之。" % [物品名, 捡漏价], 1)
	elif 流拍次数 == 2:
		# 第二次流拍：降价10%-20%重新上架
		var 降价: float = randf_range(0.8, 0.9)
		var 新价: int = max(10, int(float(lot.get("起拍价", 100)) * 降价))
		lot["起拍价"] = 新价
		lot["当前价"] = 新价
		lot["保留价"] = max(5, int(float(新价) * 0.4))
		lot["状态"] = "竞拍中"
		lot["结束日"] = Game.累计游戏日 + 5
		Game.添加纪事("拍卖", "流拍重拍", "「%s」再度流拍，掌柜降价至%d灵石重新上架。" % [物品名, 新价], 1)
	else:
		# 第一次流拍：降价10%重新上架
		var 新价: int = max(10, int(float(lot.get("起拍价", 100)) * 0.9))
		lot["起拍价"] = 新价
		lot["当前价"] = 新价
		lot["保留价"] = max(5, int(float(新价) * 0.45))
		lot["状态"] = "竞拍中"
		lot["结束日"] = Game.累计游戏日 + 5
		Game.添加纪事("拍卖", "流拍重拍", "「%s」惜败流拍，掌柜降价至%d灵石重新上架。" % [物品名, 新价], 1)

func 拍卖会确保就绪_S34() -> void:
	if 拍卖会.is_empty():
		_拍卖会补缺()
	if (拍卖会.get("常驻拍品", []) as Array).size() == 0:
		_生成常驻拍品_S34()

func 设置拍卖交付_S34(交付: Dictionary) -> void:
	拍卖会["默认交付"] = 交付 if 交付 is Dictionary else {"类型": "库房"}

func 玩家竞拍出价_S34(lot_id: String, 出价: int, 交付: Dictionary, 货币: String = "灵石") -> Dictionary:
	var lot: Dictionary = {}
	for l in (拍卖会.get("常驻拍品", []) as Array):
		if l.get("id", "") == lot_id:
			lot = l
			break
	if lot == null:
		for l in (拍卖会.get("大拍拍品", []) as Array):
			if l.get("id", "") == lot_id:
				lot = l
				break
	if lot == null:
		return {"成功": false, "原因": "拍品不存在"}
	if lot.get("状态", "") != "竞拍中":
		return {"成功": false, "原因": "该拍品已结束竞拍"}
	# ============ ECON-03 P1：混场双币出价 ============
	# ★ 2026-09-16：`当前价` 恒以**灵石口径**记账（保留价 / AI 应价 / 佣金 / 溢价全走这一口径），
	#   故 AI 应价链路**零改动**。玩家用仙玉出价时先折算为「灵石等价」再比价；
	#   折算用**原始汇率**、不加仙玉结算溢价（溢价只作用于实付额，比价再加会重复打折）。
	#   同时记录「原币」与「原值」，供成交时**按原币扣款**（拍品级隔离，互不串味）。
	var 等价: int = 出价灵石等价(出价, 货币)
	if 等价 < int(lot.get("起拍价", 0)):
		return {"成功": false, "原因": "出价低于起拍价"}
	if 等价 <= int(lot.get("当前价", 0)):
		return {"成功": false, "原因": "出价须高于当前价"}
	if 货币 == "仙玉":
		# 分池冻结：仙玉出价只校验仙玉池（绑定+非绑定），绝不占用灵石额度
		if Game.仙玉_绑定 + Game.仙玉_非绑定 < 出价:
			return {"成功": false, "原因": "仙玉不足（需%d，现有%d）" % [出价, Game.仙玉_绑定 + Game.仙玉_非绑定]}
	else:
		if Game.灵石 < 出价:
			return {"成功": false, "原因": "宗门灵石不足"}
	lot["当前价"] = 等价
	lot["玩家出价货币"] = 货币
	lot["玩家出价原值"] = 出价
	lot["最高出价者"] = "玩家(宗主)"
	lot["交付目标"] = 交付 if 交付 is Dictionary else {"类型": "库房"}
	# S34-P0：玩家直接出价后取消该拍品的玩家委托（直接出价优先于委托）
	_取消委托竞拍内部_S34(lot_id)
	# S34-P0：延时结算——出价时如果接近结束时间，延长结束时间
	_延时结算检查_S34(lot)
	_AI应价_S34(lot)
	# S34-P0：AI应价后，检查是否有委托需要代出价
	_处理委托出价_S34(lot)
	return {"成功": true, "当前价": int(lot.get("当前价", 0)), "领先": str(lot.get("最高出价者", "")), "台词": lot.get("竞价台词", [])}

func _AI应价_S34(lot: Dictionary) -> void:
	var 步进: int = max(10, int(float(lot.get("当前价", 0)) * 0.1))
	for a in (lot.get("AI列表", []) as Array):
		var 估值: int = int(a.get("估值", 0))
		var 预算: int = int(a.get("预算", 0))
		var 已出: int = int(a.get("已出", 0))
		var 新价: int = int(lot.get("当前价", 0)) + 步进
		if 新价 <= 估值 and (已出 + 步进) <= 预算:
			lot["当前价"] = 新价
			lot["最高出价者"] = str(a.get("名", ""))
			a["已出"] = 新价
			var 池: Array = a.get("台词池", [])
			if 池.size() > 0:
				lot["竞价台词"].append(str(池.pick_random()))

func _结算单个拍品_S34(lot: Dictionary) -> void:
	var 领先: String = str(lot.get("最高出价者", ""))
	var 当前价: int = int(lot.get("当前价", 0))
	var 保留价: int = int(lot.get("保留价", 0))
	# S34-P0：结算时先解冻所有非领先者的委托（领先者如果是委托则保留到扣款）
	for w in (lot.get("委托列表", []) as Array):
		if str(w.get("状态", "")) != "活跃":
			continue
		var 委ID: String = str(w.get("委托者ID", ""))
		# 如果领先者包含委托者ID，说明这个委托领先，暂时不解冻（扣款时处理）
		if 领先.find(委ID) >= 0:
			continue
		# 其他委托全部解冻
		if str(w.get("委托者类型", "")) == "玩家":
			Game.灵石 += int(w.get("冻结灵石", 0))
		w["状态"] = "未竞得"
	if 领先 == "" or 当前价 < 保留价:
		# S34-P0：流拍时解冻所有委托（包括领先者的）
		for w in (lot.get("委托列表", []) as Array):
			if str(w.get("状态", "")) == "活跃" and str(w.get("委托者类型", "")) == "玩家":
				Game.灵石 += int(w.get("冻结灵石", 0))
			w["状态"] = "流拍"
		# S34-P0：添加流拍结算通知
		_添加结算通知_S34({"类型": "流拍", "名称": str(lot.get("名称", "")), "品阶": str(lot.get("品阶", "")), "价": 0, "日": Game.累计游戏日})
		拍卖会["竞拍记录"].append({"名称": str(lot.get("名称", "")), "结果": "流拍", "价": 0, "日": Game.累计游戏日})
		Game.添加纪事("拍卖", "流拍", "「%s」无人应价至保留价，惜败流拍。" % str(lot.get("名称", "")), 1)
		# S53：流拍处理（降价重拍，连续流拍进捡漏区）
		_流拍处理_S53(lot)
		return
	if 领先 == "玩家(宗主)":
		# S34-P0：佣金率按拍卖行等级调整（Lv1=5% → Lv5=3%）
		var 佣金率: float = _拍卖当前佣金率()
		var 应付: int = 当前价 + int(float(当前价) * 佣金率)
		# ★ 2026-09-16（ECON-03 P1）：**按原币成交扣款**。
		#   拍品在出价时记下了所用货币（`玩家出价货币`）⇒ 成交从**该币种**扣款、佣金同币计，
		#   两个池子互不串味（仙玉出价绝不动用灵石额度）。
		#   仙玉侧按**当日汇率**把灵石口径的应付额折算成仙玉额 —— 汇率不落盘，
		#   故跨日读档不会出现「显示价 ≠ 实扣价」。
		var 结算货币: String = str(lot.get("玩家出价货币", "灵石"))
		if 结算货币 == "仙玉":
			var 应付仙玉: int = Game.灵石折仙玉(应付)
			if Game.仙玉_绑定 + Game.仙玉_非绑定 < 应付仙玉:
				lot["状态"] = "流拍"
				拍卖会["竞拍记录"].append({"名称": str(lot.get("名称", "")), "结果": "流拍", "价": 0, "日": Game.累计游戏日})
				return
			Game.消耗仙玉(应付仙玉)
		else:
			if Game.灵石 < 应付:
				lot["状态"] = "流拍"
				拍卖会["竞拍记录"].append({"名称": str(lot.get("名称", "")), "结果": "流拍", "价": 0, "日": Game.累计游戏日})
				return
			Game.灵石 -= 应付
		# S34-P0：玩家竞得后增加拍卖行声望（成交价×1%，大拍×2）
		_拍卖增加声望(当前价)
		# S34-P0：重置连续未竞得天数（保底机制）
		拍卖会["连续未竞得天"] = 0
		var it: Item = Item.new()
		it.from_dict(lot.get("物品", {}))
		var 交付: Dictionary = lot.get("交付目标", {"类型": "库房"})
		var 溢价: float = 0.0
		var 基准: int = int(lot.get("基准估值", 1))
		if 基准 > 0:
			溢价 = float(当前价) / float(基准)
		lot["溢价"] = 溢价
		if 交付.get("类型", "") == "私库":
			var 弟子ID: String = str(交付.get("弟子ID", ""))
			var 命中 = null
			for d in Game.弟子列表:
				if str(d.弟子ID) == 弟子ID:
					命中 = d
					break
			if 命中 != null:
				# 功法秘籍：弟子竞得后自动学习
				if it.类别 == "gongfa_book":
					var 功法ID: String = it.功效.replace("灵钓功法：", "")
					if "已学功法" not in 命中:
						命中["已学功法"] = []
					if 功法ID not in 命中["已学功法"]:
						命中["已学功法"].append(功法ID)
						Game.添加纪事("拍卖", "竞得", "%s 于拍卖会力压群雄，竞得「%s」（%d Game.灵石，溢价 %.0f%%），修习后习得此功法！" % [命中.姓名, it.名称, 当前价, int(溢价 * 100.0) - 100], 1)
					else:
						命中.私库.append(it)
						Game.添加纪事("拍卖", "竞得", "%s 于拍卖会力压群雄，竞得「%s」（%d Game.灵石，溢价 %.0f%%），已修习过此功法，归入私库。" % [命中.姓名, it.名称, 当前价, int(溢价 * 100.0) - 100], 1)
				else:
					命中.私库.append(it)
					Game.添加纪事("拍卖", "竞得", "宗主于拍卖会力压群雄，竞得「%s」（%d Game.灵石，溢价 %.0f%%），归入 %s 私库。" % [it.名称, 当前价, int(溢价 * 100.0) - 100, 命中.姓名], 1)
			else:
				Game.宗门库房.append(it)
				Game.添加纪事("拍卖", "竞得", "宗主于拍卖会力压群雄，竞得「%s」（%d Game.灵石），归入宗门库房。" % [it.名称, 当前价], 1)
		else:
			# 功法秘籍：竞得后自动学习，不入库房
			if it.类别 == "gongfa_book" and Game.宗主 != null:
				var 功法ID: String = it.功效.replace("灵钓功法：", "")
				if "已学功法" not in Game.宗主:
					Game.宗主["已学功法"] = []
				if 功法ID not in Game.宗主["已学功法"]:
					Game.宗主["已学功法"].append(功法ID)
					Game.添加纪事("拍卖", "竞得", "宗主于拍卖会力压群雄，竞得「%s」（%d Game.灵石，溢价 %.0f%%），修习后习得此功法！" % [it.名称, 当前价, int(溢价 * 100.0) - 100], 1)
				else:
					Game.宗门库房.append(it)
					Game.添加纪事("拍卖", "竞得", "宗主于拍卖会力压群雄，竞得「%s」（%d Game.灵石，溢价 %.0f%%），已修习过此功法，归入宗门库房。" % [it.名称, 当前价, int(溢价 * 100.0) - 100], 1)
			else:
				Game.宗门库房.append(it)
				Game.添加纪事("拍卖", "竞得", "宗主于拍卖会力压群雄，竞得「%s」（%d Game.灵石，溢价 %.0f%%），归入宗门库房。" % [it.名称, 当前价, int(溢价 * 100.0) - 100], 1)
		拍卖会["竞拍记录"].append({"名称": str(lot.get("名称", "")), "结果": "竞得", "价": 当前价, "日": Game.累计游戏日})
		lot["状态"] = "已成交"
		# S34-P0：添加竞得结算通知（离线后下次上线查看）
		var 交付文: String = "Game.宗门库房"
		if 交付.get("类型", "") == "私库":
			交付文 = "弟子私库"
		_添加结算通知_S34({"类型": "竞得", "名称": str(lot.get("名称", "")), "品阶": str(lot.get("品阶", "")), "价": 当前价, "佣金": int(float(当前价) * 佣金率), "交付": 交付文, "日": Game.累计游戏日})
	else:
		# S34-P0：AI竞得时，解冻所有玩家委托（如果有）并添加未竞得通知
		for w in (lot.get("委托列表", []) as Array):
			if str(w.get("状态", "")) == "活跃" and str(w.get("委托者类型", "")) == "玩家":
				Game.灵石 += int(w.get("冻结灵石", 0))
				_添加结算通知_S34({"类型": "未竞得", "名称": str(lot.get("名称", "")), "品阶": str(lot.get("品阶", "")), "价": 当前价, "领先": 领先, "日": Game.累计游戏日})
			w["状态"] = "被%s竞得" % 领先
		拍卖会["竞拍记录"].append({"名称": str(lot.get("名称", "")), "结果": "被%s竞得" % 领先, "价": 当前价, "日": Game.累计游戏日})
		Game.添加纪事("拍卖", "交割", "一锤定音！「%s」由 %s 以 %d 灵石竞得，此物终觅明主。" % [str(lot.get("名称", "")), 领先, 当前价], 1)
		lot["状态"] = "已成交"

# ===================== S34-P0 委托竞拍（核心异步机制） =====================
# 玩家设置最高委托价后离线，系统代玩家自动出价，解决"玩家在线时间不一致"问题
# 委托价内自动出价，超过则失效，灵石冻结/解冻机制保证安全

## 设置委托竞拍：冻结委托价金额灵石，记录委托信息
func 设置委托竞拍_S34(lot_id: String, 委托价: int) -> Dictionary:
	var lot: Dictionary = _查找拍品_S34(lot_id)
	if lot == null:
		return {"成功": false, "原因": "拍品不存在"}
	if lot.get("状态", "") != "竞拍中":
		return {"成功": false, "原因": "该拍品已结束竞拍"}
	var 当前价: int = int(lot.get("当前价", 0))
	var 步进: int = max(10, int(float(当前价) * 0.1))
	if 委托价 < 当前价 + 步进:
		return {"成功": false, "原因": "委托价须高于当前价+最小加价步进(%d)" % (当前价 + 步进)}
	if Game.灵石 < 委托价:
		return {"成功": false, "原因": "宗门灵石不足，无法冻结委托金额"}
	# 取消该拍品已有的委托（如果有）
	_取消委托竞拍内部_S34(lot_id)
	# 冻结灵石
	Game.灵石 -= 委托价
	# 添加委托
	var 委托: Dictionary = {
		"拍品ID": lot_id,
		"委托者类型": "玩家",
		"委托者ID": "宗主",
		"最高委托价": 委托价,
		"冻结灵石": 委托价,
		"设置时间": Game.累计游戏日,
		"状态": "活跃",
	}
	(拍卖会["委托列表"] as Array).append(委托)
	(lot["委托列表"] as Array).append(委托)
	# 立即尝试代出价（如果当前价低于委托价）
	_处理委托出价_S34(lot)
	return {"成功": true, "委托价": 委托价, "当前价": int(lot.get("当前价", 0)), "领先": str(lot.get("最高出价者", ""))}

## 取消委托竞拍：解冻灵石，移除委托
func 取消委托竞拍_S34(lot_id: String) -> Dictionary:
	var lot: Dictionary = _查找拍品_S34(lot_id)
	if lot == null:
		return {"成功": false, "原因": "拍品不存在"}
	var 结果: bool = _取消委托竞拍内部_S34(lot_id)
	if 结果:
		return {"成功": true, "原因": "委托已取消，灵石已解冻"}
	else:
		return {"成功": false, "原因": "未找到活跃委托"}

## 内部取消委托（供设置新委托和结算时调用）
func _取消委托竞拍内部_S34(lot_id: String) -> bool:
	var 找到: bool = false
	var 委托列表: Array = 拍卖会.get("委托列表", [])
	var 新列表: Array = []
	for w in 委托列表:
		if str(w.get("拍品ID", "")) == lot_id and str(w.get("状态", "")) == "活跃" and str(w.get("委托者类型", "")) == "玩家":
			Game.灵石 += int(w.get("冻结灵石", 0))
			w["状态"] = "已取消"
			找到 = true
		else:
			新列表.append(w)
	拍卖会["委托列表"] = 新列表
	# 同步从拍品的委托列表中移除
	var lot: Dictionary = _查找拍品_S34(lot_id)
	if lot != null:
		var lot委托: Array = []
		for w in (lot.get("委托列表", []) as Array):
			if str(w.get("状态", "")) != "已取消":
				lot委托.append(w)
		lot["委托列表"] = lot委托
	return 找到

## 处理委托出价：其他玩家/AI出价后，检查是否有委托需要代出价
func _处理委托出价_S34(lot: Dictionary) -> void:
	if lot == null or lot.get("状态", "") != "竞拍中":
		return
	var 步进: int = max(10, int(float(lot.get("当前价", 0)) * 0.1))
	var 继续: bool = true
	while 继续:
		继续 = false
		var 当前价: int = int(lot.get("当前价", 0))
		var 最高委托: Dictionary = {}
		var 最高委托价: int = 0
		# 找出所有活跃委托中最高的委托价
		for w in (lot.get("委托列表", []) as Array):
			if str(w.get("状态", "")) != "活跃":
				continue
			var 委价: int = int(w.get("最高委托价", 0))
			if 委价 > 最高委托价:
				最高委托价 = 委价
				最高委托 = w
		# 如果最高委托价 > 当前价+步进，则代出价
		if 最高委托 != null and 最高委托价 >= 当前价 + 步进:
			var 新价: int = 当前价 + 步进
			# 如果委托者就是当前领先者，不重复出价
			if str(lot.get("最高出价者", "")) != str(最高委托.get("委托者ID", "")):
				lot["当前价"] = 新价
				lot["最高出价者"] = str(最高委托.get("委托者ID", "")) + "（委托中）"
				# 更新委托的冻结金额（释放旧冻结，冻结新金额）
				var 旧冻结: int = int(最高委托.get("冻结灵石", 0))
				最高委托["冻结灵石"] = 新价
				# 如果是玩家委托，调整灵石冻结
				if str(最高委托.get("委托者类型", "")) == "玩家":
					Game.灵石 += (旧冻结 - 新价)
				# S34-P0：延时结算——出价时如果接近结束时间，延长结束时间
				_延时结算检查_S34(lot)
				继续 = true  # 继续检查是否有更高委托需要出价

## 查找拍品（常驻+大拍）
func _查找拍品_S34(lot_id: String) -> Dictionary:
	for l in (拍卖会.get("常驻拍品", []) as Array):
		if str(l.get("id", "")) == lot_id:
			return l
	for l in (拍卖会.get("大拍拍品", []) as Array):
		if str(l.get("id", "")) == lot_id:
			return l
	return {}

# ===================== S34-P0 延时结算与结算通知 =====================
# 延时结算：最后10秒出价延长10秒，防秒拍，最多延长4分钟
# 结算通知：离线结算后下次上线弹出通知，物品自动入库

## 延时结算检查：出价时如果接近结束时间，自动延长
func _延时结算检查_S34(lot: Dictionary) -> void:
	if lot == null:
		return
	var 结束日: int = int(lot.get("结束日", 0))
	var 延时窗口: float = 10.0 / 240.0  # 10真实秒 = 10/240 Game.累计游戏日
	var 最大延时时长: float = 240.0 / 240.0  # 最多延长240真实秒 = 1累计游戏日
	# 如果当前时间在结束前的延时窗口内，则延长
	if Game.累计游戏日 >= 结束日 - 延时窗口:
		var 原结束: int = 结束日
		var 新结束: int = int(Game.累计游戏日 + 延时窗口) + 1
		# 限制最大延长
		var 延时结束日: int = int(lot.get("延时结束日", 0))
		if 延时结束日 == 0:
			延时结束日 = 原结束 + int(最大延时时长)
			lot["延时结束日"] = 延时结束日
		if 新结束 > 延时结束日:
			新结束 = 延时结束日
		if 新结束 > 结束日:
			lot["结束日"] = 新结束

## 添加结算通知（离线结算后下次上线查看）
func _添加结算通知_S34(通知: Dictionary) -> void:
	(拍卖会["结算通知"] as Array).append(通知)
	# 最多保留50条通知
	if (拍卖会["结算通知"] as Array).size() > 50:
		(拍卖会["结算通知"] as Array).pop_front()

## 获取未读结算通知（供UI调用）
func 获取结算通知_S34() -> Array:
	return 拍卖会.get("结算通知", [])

## 清除已读结算通知
func 清除结算通知_S34() -> void:
	拍卖会["结算通知"] = []


# ===================== S34-P1 弟子参与拍卖行 =====================
# 弟子独立经济系统 + AI竞拍决策 + 委托拍卖 + 宗主管控

## 弟子月例发放：按境界发放灵石入私库，殿阁负责人/长老额外+50%
func _发放弟子月例_S34(d: Disciple) -> void:
	if d == null:
		return
	if d.状态 == "失踪" or d.状态 == "陨落" or d.状态 == "叛出":
		return
	# 按境界的月例标准
	var 月例表: Dictionary = {
		"练气": 10, "筑基": 30, "金丹": 80, "元婴": 200, "化神": 500,
		"炼虚": 1000, "合体": 2000, "大乘": 4000, "渡劫": 8000
	}
	var 基础月例: int = int(月例表.get(d.境界, 10))
	# 职位加成：殿阁负责人/长老额外+50%
	if d.司职 != "":
		基础月例 = int(float(基础月例) * 1.5)
	# 宗门灵石不足时减半发放
	if Game.灵石 < 基础月例:
		基础月例 = int(float(基础月例) * 0.5)
	# 从宗门灵石扣除，入弟子私库
	Game.灵石 -= 基础月例
	d.私库灵石 += 基础月例

## 弟子AI竞拍决策：月度推演时调用，弟子自主决定是否参与竞拍
##   决策逻辑：按道途/品阶/当前需求/性格/灵石余额计算兴趣值，兴趣>60则设置委托
func _弟子AI竞拍决策_S34(d: Disciple) -> void:
	if d == null or d.私库灵石 <= 0:
		return
	if d.状态 == "失踪" or d.状态 == "陨落" or d.状态 == "叛出":
		return
	# 遍历常驻拍品，计算兴趣值
	for lot in 拍卖会.get("常驻拍品", []):
		if lot.get("状态", "") != "竞拍中":
			continue
		var 兴趣值: int = _计算弟子拍品兴趣_S34(d, lot)
		if 兴趣值 >= 60:
			_设置弟子委托_S34(d, lot, 兴趣值)

## 计算弟子对拍品的兴趣值（0-100）
func _计算弟子拍品兴趣_S34(d: Disciple, lot: Dictionary) -> int:
	var 兴趣: int = 0
	var 品阶: String = str(lot.get("品阶", ""))
	var 类别: String = str(lot.get("类别", ""))
	# 道途匹配：体修对武器/防具兴趣+30，法修对法器/功法兴趣+30
	if d.道途 == "体修" and (类别 == "shen_bing" or 类别 == "fa_qi"):
		兴趣 += 30
	elif d.道途 == "法修" and (类别 == "fa_qi" or 类别 == "fabao"):
		兴趣 += 30
	elif d.道途 == "丹修" and 类别 == "dan_yao":
		兴趣 += 30
	# 品阶适配：品阶=境界品阶兴趣+20，高1阶+10，高2阶以上-50
	var 境阶: String = d.境界表[d.境界].get("品阶", "fan_jie")
	var i物: int = Item.品阶序key.find(品阶)
	var i境: int = Item.品阶序key.find(境阶)
	if i物 >= 0 and i境 >= 0:
		if i物 == i境:
			兴趣 += 20
		elif i物 == i境 + 1:
			兴趣 += 10
		elif i物 > i境 + 1:
			兴趣 -= 50
	# 稀缺性：圣阶以上+20，仙阶+30，道阶+50
	if 品阶 == "圣阶": 兴趣 += 20
	elif 品阶 == "仙阶": 兴趣 += 30
	elif 品阶 == "道阶": 兴趣 += 50
	# 性格修正（对齐 12 修仙性格：贪心逐缘=逐利 +10，恬淡悟道=淡泊 -10）
	if d.性格 == "贪心逐缘": 兴趣 += 10
	elif d.性格 == "恬淡悟道": 兴趣 -= 10
	return clamp(兴趣, 0, 100)

## 设置弟子委托竞拍：弟子用私库灵石设置委托，系统代出价
func _设置弟子委托_S34(d: Disciple, lot: Dictionary, 兴趣值: int) -> void:
	var 当前价: int = int(lot.get("当前价", 0))
	var 基准: int = int(lot.get("基准估值", 100))
	# 心理估值 = 基准 × (0.8 + 兴趣/200) × 性格修正
	var 估值系数: float = 0.8 + float(兴趣值) / 200.0
	if d.性格 == "锐意争先": 估值系数 *= 1.2      # 竞逐心切，出价更冲
	elif d.性格 == "沉稳守道": 估值系数 *= 0.9    # 稳健，不追高
	elif d.性格 == "贪心逐缘": 估值系数 *= 0.85   # 精算压价
	var 心理估值: int = int(float(基准) * 估值系数)
	# 委托价不超过私库灵石的80%
	var 委托价: int = min(心理估值, int(float(d.私库灵石) * 0.8))
	if 委托价 <= 当前价:
		return
	# 冻结弟子私库灵石，添加委托
	d.私库灵石 -= 委托价
	var 委托: Dictionary = {
		"拍品ID": str(lot.get("id", "")),
		"委托者类型": "弟子",
		"委托者ID": str(d.弟子ID),
		"委托者姓名": str(d.姓名),
		"最高委托价": 委托价,
		"冻结灵石": 委托价,
		"设置时间": Game.累计游戏日,
		"状态": "活跃",
	}
	(拍卖会["委托列表"] as Array).append(委托)
	(lot["委托列表"] as Array).append(委托)
	# 立即尝试代出价
	_处理委托出价_S34(lot)

## 弟子委托拍卖（寄售）：弟子出售不需要的物品，所得入私库
##   P1阶段核心：弟子月度检查背包/私库，寄售重复或用不上的物品
func _弟子委托拍卖_S34(d: Disciple) -> void:
	if d == null:
		return
	# 遍历背包，找重复装备或用不上的物品
	var 待寄售: Array = []
	for it in d.背包:
		if it == null or not it.可穿戴():
			continue
		# 如果已有更好的同槽位装备，则寄售
		var 槽: String = it.穿戴位
		var 现: Item = d.装备.get(槽)
		if 现 != null and 现.战力加成 >= it.战力加成:
			待寄售.append(it)
	# 从背包移除并生成寄售拍品（简化版：直接给弟子灵石，不实际上架）
	for it in 待寄售:
		d.背包.erase(it)
		var 估值: int = max(10, int(float(it.战力加成) * 2))
		d.私库灵石 += 估值


