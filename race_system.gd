## 计算天劫准备后的总成功率
func 计算天劫准备成功率(基础成功率: float, 准备方式列表: Array) -> float:
	var 总加成: float = 0.0
	for 方式 in 准备方式列表:
		if 天劫准备方式.has(方式):
			总加成 += float(天劫准备方式[方式].get("成功率加成", 0.0))
	return clamp(基础成功率 + 总加成, 0.0, 0.95)

## 执行天劫准备（消耗资源/耗时）
func 执行天劫准备(弟子: Disciple, 准备方式列表: Array) -> Dictionary:
	var 结果: Dictionary = {"成功": true, "消息": "", "耗时": 0, "消耗": {}}
	
	for 方式 in 准备方式列表:
		if not 天劫准备方式.has(方式):
			continue
		var 配置: Dictionary = 天劫准备方式[方式]
		结果["耗时"] = int(结果.get("耗时", 0)) + int(配置.get("耗时", 0))
		
		# 检查消耗
		var 消耗: Dictionary = 配置.get("消耗", {})
		for 物品 in 消耗:
			var 数量: int = int(消耗[物品])
			# TODO: 检查物品是否足够，扣除物品
			结果["消耗"][物品] = 数量
	
	if 结果["耗时"] > 0:
		结果["消息"] = "开始天劫准备，预计耗时%d天。" % int(结果["耗时"])
	else:
		结果["消息"] = "天劫准备完成。"
	
	return 结果

