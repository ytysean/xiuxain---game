+                    for col in id_cols:
+                        v = (row.get(col) or "").strip()
+                        if v:
+                            valid_ids.add(v)
+        except Exception:
+            return
+    _collect(ai_path, ("item_id", "id", "item"))
+    _collect(reg_path, ("item_id", "id", "item"))
+
+    if not os.path.exists(eq_path):
