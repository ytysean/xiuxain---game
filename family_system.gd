## 装备家族秘宝
func 装备家族秘宝(弟子: Disciple, 秘宝ID: String) -> Dictionary:
	if 弟子 == null or 秘宝ID == "" or 弟子.家族ID == "":
		return {"成功": false, "因": "弟子无效或无家族"}
	if not _家族秘宝配置.has(秘宝ID):
		return {"成功": false, "因": "秘宝不存在"}
	var 家族: Dictionary = 获取家族(弟子.家族ID)
	if 家族.is_empty():
		return {"成功": false, "因": "家族不存在"}
	var 家族秘宝: Array = 家族.get("家族秘宝", [])
	if not 家族秘宝.has(秘宝ID):
		return {"成功": false, "因": "家族尚未拥有此秘宝"}
	# 特殊秘宝需要血脉觉醒
	var 秘宝: Dictionary = _家族秘宝配置[秘宝ID]
	if 秘宝ID == "zhenbao_005" and not 弟子.血脉觉醒:
		return {"成功": false, "因": "此秘宝需要血脉觉醒才能使用"}
	# 检查是否已装备其他秘宝（简化版：只能装备一件秘宝）
	if 弟子.家族秘宝 != "":
		return {"成功": false, "因": "已装备其他家族秘宝，请先卸下"}
	弟子.家族秘宝 = 秘宝ID
	Game.添加纪事("家族", "装备秘宝", "%s 装备家族秘宝「%s」" % [弟子.姓名, str(秘宝.get("名", 秘宝ID))], 1)
	return {"成功": true, "秘宝ID": 秘宝ID, "秘宝名": str(秘宝.get("名", 秘宝ID))}

## 卸下家族秘宝
