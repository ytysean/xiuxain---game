# tests/economy_simulator.gd —— 经济模拟器
# 功能：模拟长期的经济运行情况，用于经济数值平衡分析
# 运行：在游戏中调用 EconomySimulator.simulate_xxx() 模拟经济
class_name EconomySimulator
extends RefCounted

# ============ 经济模型配置 ============

# 基准玩家配置
const 基准玩家: Dictionary = {
	"弟子数量": 10,
	"平均境界": "筑基",
	"灵田等级": 3,
	"矿脉等级": 2,
	"殿阁等级": 2,
	"每日游戏时长": 60,  # 分钟
}

# 资源产出配置（每日）
const 每日产出: Dictionary = {
	"灵石": {"基础": 100, "灵田加成": 20, "矿脉加成": 30, "任务加成": 50},
	"灵气": {"基础": 50, "灵田加成": 30, "弟子修炼加成": 10},
	"灵草": {"基础": 10, "灵田加成": 15},
	"矿石": {"基础": 5, "矿脉加成": 10},
}

# 资源消耗配置（每日）
const 每日消耗: Dictionary = {
	"灵石": {"弟子俸禄": 50, "殿阁维护": 30, "阵法维护": 20},
	"灵气": {"弟子修炼": 40, "阵法激活": 10},
	"灵草": {"炼丹消耗": 8},
	"矿石": {"炼器消耗": 4},
}

# 模拟结果
var 模拟结果: Dictionary = {}

# ============ 单日经济模拟 ============

func 模拟单日经济(玩家配置: Dictionary) -> Dictionary:
	var 当日收支 = {}

	# 计算产出
	for 资源类型 in 每日产出.keys():
		var 产出配置 = 每日产出[资源类型]
		var 总产出 = 产出配置.get("基础", 0)
		# 灵田加成
		if 产出配置.has("灵田加成"):
			总产出 += 产出配置["灵田加成"] * 玩家配置.get("灵田等级", 1)
		# 矿脉加成
		if 产出配置.has("矿脉加成"):
			总产出 += 产出配置["矿脉加成"] * 玩家配置.get("矿脉等级", 1)
		# 弟子修炼加成
		if 产出配置.has("弟子修炼加成"):
			总产出 += 产出配置["弟子修炼加成"] * 玩家配置.get("弟子数量", 1)
		# 任务加成
		if 产出配置.has("任务加成"):
			总产出 += 产出配置["任务加成"] * (玩家配置.get("每日游戏时长", 30) / 60.0)
		当日收支[资源类型] = {"产出": int(总产出), "消耗": 0}

	# 计算消耗
	for 资源类型 in 每日消耗.keys():
		var 消耗配置 = 每日消耗[资源类型]
		var 总消耗 = 0
		# 弟子俸禄
		if 消耗配置.has("弟子俸禄"):
			总消耗 += 消耗配置["弟子俸禄"] * 玩家配置.get("弟子数量", 1)
		# 殿阁维护
		if 消耗配置.has("殿阁维护"):
			总消耗 += 消耗配置["殿阁维护"] * 玩家配置.get("殿阁等级", 1)
		# 阵法维护
		if 消耗配置.has("阵法维护"):
			总消耗 += 消耗配置["阵法维护"]
		# 弟子修炼
		if 消耗配置.has("弟子修炼"):
			总消耗 += 消耗配置["弟子修炼"] * 玩家配置.get("弟子数量", 1)
		# 阵法激活
		if 消耗配置.has("阵法激活"):
			总消耗 += 消耗配置["阵法激活"]
		# 炼丹消耗
		if 消耗配置.has("炼丹消耗"):
			总消耗 += 消耗配置["炼丹消耗"] * (玩家配置.get("每日游戏时长", 30) / 60.0)
		# 炼器消耗
		if 消耗配置.has("炼器消耗"):
			总消耗 += 消耗配置["炼器消耗"] * (玩家配置.get("每日游戏时长", 30) / 60.0)
		if 当日收支.has(资源类型):
			当日收支[资源类型]["消耗"] = int(总消耗)
		else:
			当日收支[资源类型] = {"产出": 0, "消耗": int(总消耗)}

	# 计算净收入
	for 资源类型 in 当日收支.keys():
		var 数据 = 当日收支[资源类型]
		数据["净收入"] = 数据["产出"] - 数据["消耗"]

	return 当日收支

# ============ 长期经济模拟 ============

func 模拟长期经济(玩家配置: Dictionary, 模拟天数: int = 365) -> Dictionary:
	var 累计收支 = {}
	var 每日记录 = []
	var 当前配置 = 玩家配置.duplicate()

	for 天 in range(模拟天数):
		var 当日收支 = 模拟单日经济(当前配置)
		每日记录.append(当日收支)
		# 累计
		for 资源类型 in 当日收支.keys():
			if not 累计收支.has(资源类型):
				累计收支[资源类型] = {"总产出": 0, "总消耗": 0, "总净收入": 0}
			累计收支[资源类型]["总产出"] += 当日收支[资源类型]["产出"]
			累计收支[资源类型]["总消耗"] += 当日收支[资源类型]["消耗"]
			累计收支[资源类型]["总净收入"] += 当日收支[资源类型]["净收入"]
		# 模拟成长（每30天提升一次）
		if (天 + 1) % 30 == 0:
			当前配置["灵田等级"] = min(当前配置.get("灵田等级", 1) + 1, 10)
			当前配置["矿脉等级"] = min(当前配置.get("矿脉等级", 1) + 1, 10)
			当前配置["殿阁等级"] = min(当前配置.get("殿阁等级", 1) + 1, 10)
			当前配置["弟子数量"] = min(当前配置.get("弟子数量", 1) + 2, 50)

	# 计算平均值
	for 资源类型 in 累计收支.keys():
		累计收支[资源类型]["日均产出"] = 累计收支[资源类型]["总产出"] / 模拟天数
		累计收支[资源类型]["日均消耗"] = 累计收支[资源类型]["总消耗"] / 模拟天数
		累计收支[资源类型]["日均净收入"] = 累计收支[资源类型]["总净收入"] / 模拟天数

	return {
		"模拟天数": 模拟天数,
		"累计收支": 累计收支,
		"每日记录": 每日记录,
		"最终配置": 当前配置,
	}

# ============ 通货膨胀模拟 ============

func 模拟通货膨胀(基础经济: Dictionary, 模拟月数: int = 12, 通胀率: float = 0.02) -> Dictionary:
	var 物价指数 = []
	var 当前指数 = 1.0

	for 月 in range(模拟月数):
		物价指数.append(当前指数)
		当前指数 *= (1 + 通胀率)

	return {
		"模拟月数": 模拟月数,
		"月通胀率": 通胀率,
		"年通胀率": pow(1 + 通胀率, 12) - 1,
		"物价指数": 物价指数,
		"最终物价": 当前指数,
	}

# ============ 不同玩家类型对比 ============

func 模拟不同玩家类型(模拟天数: int = 30) -> Dictionary:
	var 玩家类型 = {
		"休闲玩家": {"弟子数量": 5, "平均境界": "练气", "灵田等级": 1, "矿脉等级": 1, "殿阁等级": 1, "每日游戏时长": 15},
		"普通玩家": {"弟子数量": 10, "平均境界": "筑基", "灵田等级": 3, "矿脉等级": 2, "殿阁等级": 2, "每日游戏时长": 60},
		"硬核玩家": {"弟子数量": 20, "平均境界": "金丹", "灵田等级": 5, "矿脉等级": 4, "殿阁等级": 4, "每日游戏时长": 180},
		"氪金玩家": {"弟子数量": 30, "平均境界": "元婴", "灵田等级": 8, "矿脉等级": 7, "殿阁等级": 7, "每日游戏时长": 120},
	}

	var 结果 = {}
	for 类型名 in 玩家类型.keys():
		var 配置 = 玩家类型[类型名]
		var 模拟结果 = 模拟长期经济(配置, 模拟天数)
		结果[类型名] = {
			"配置": 配置,
			"累计收支": 模拟结果["累计收支"],
		}

	return 结果

# ============ 导出报告 ============

func 导出经济报告(模拟天数: int = 365) -> String:
	var 报告 = ""
	报告 += "=".repeat(60) + "\n"
	报告 += "经济模拟器 - 经济平衡报告\n"
	报告 += "=".repeat(60) + "\n\n"

	# 基准玩家单日经济
	报告 += "一、基准玩家单日经济\n"
	报告 += "-".repeat(40) + "\n"
	var 单日收支 = 模拟单日经济(基准玩家)
	报告 += "%-10s %-12s %-12s %-12s\n" % ["资源类型", "产出", "消耗", "净收入"]
	for 资源类型 in 单日收支.keys():
		var 数据 = 单日收支[资源类型]
		报告 += "%-10s %-12d %-12d %-12d\n" % [资源类型, 数据["产出"], 数据["消耗"], 数据["净收入"]]
	报告 += "\n"

	# 长期经济模拟
	报告 += "二、基准玩家长期经济（%d天）\n" % 模拟天数
	报告 += "-".repeat(40) + "\n"
	var 长期结果 = 模拟长期经济(基准玩家, 模拟天数)
	var 累计收支 = 长期结果["累计收支"]
	报告 += "%-10s %-12s %-12s %-12s %-12s\n" % ["资源类型", "总产出", "总消耗", "总净收入", "日均净收入"]
	for 资源类型 in 累计收支.keys():
		var 数据 = 累计收支[资源类型]
		报告 += "%-10s %-12d %-12d %-12d %-12.1f\n" % [资源类型, 数据["总产出"], 数据["总消耗"], 数据["总净收入"], 数据["日均净收入"]]
	报告 += "\n"

	# 不同玩家类型对比
	报告 += "三、不同玩家类型对比（30天）\n"
	报告 += "-".repeat(40) + "\n"
	var 玩家对比 = 模拟不同玩家类型(30)
	for 类型名 in 玩家对比.keys():
		var 数据 = 玩家对比[类型名]
		报告 += "\n【%s】\n" % 类型名
		报告 += "  弟子数量: %d, 灵田等级: %d, 每日时长: %d分钟\n" % [数据["配置"]["弟子数量"], 数据["配置"]["灵田等级"], 数据["配置"]["每日游戏时长"]]
		var 收支 = 数据["累计收支"]
		if 收支.has("灵石"):
			报告 += "  灵石净收入: %d (日均%.1f)\n" % [收支["灵石"]["总净收入"], 收支["灵石"]["日均净收入"]]
	报告 += "\n"

	# 通货膨胀模拟
	报告 += "四、通货膨胀模拟（12个月，月通胀率2%）\n"
	报告 += "-".repeat(40) + "\n"
	var 通胀结果 = 模拟通货膨胀({}, 12, 0.02)
	报告 += "月通胀率: %.1f%%\n" % (通胀结果["月通胀率"] * 100)
	报告 += "年通胀率: %.1f%%\n" % (通胀结果["年通胀率"] * 100)
	报告 += "最终物价指数: %.2f\n" % 通胀结果["最终物价"]
	报告 += "\n"

	报告 += "=".repeat(60) + "\n"
	报告 += "报告结束\n"
	报告 += "=".repeat(60) + "\n"

	return 报告

func 保存报告到文件(文件路径: String, 报告: String) -> bool:
	var f = FileAccess.open(文件路径, FileAccess.WRITE)
	if f == null:
		print("[EconomySimulator] 保存报告失败: %s" % 文件路径)
		return false
	f.store_string(报告)
	f.close()
	print("[EconomySimulator] 报告已保存: %s" % 文件路径)
	return true
