# ============ 调查任务系统（2026-08-31 P3 扩展：弟子失踪→宗门下发调查任务→高阶弟子接取）============
# 设计：历练失败时按难度概率标记低阶弟子「失踪」；宗门自动下发调查任务，接取者修为阶必须高于失踪者；
#       调查结算成功后再按难度掷骰判生还/陨落（高风险关卡常客死，贴近真实修真）。
const _境界序表: Array = Disciple.境界序   # 唯一真源（2026-09-02）：原为 7 阶硬编码，缺炼虚/合体/大乘/渡劫，导致关卡「解锁境界:合体/大乘」映射为 0
var 调查任务列表: Dictionary = {}   # 调查任务ID -> {任务ID, 失踪弟子ID, 失踪弟子名, 失踪弟子境界, 失踪关卡名, 要求修为阶, 难度, 发布日, 奖励灵石, 奖励贡献点}
var 调查进行中: Dictionary = {}     # 调查实例ID -> {实例ID, 任务ID, 失踪弟子ID, 接取弟子ID列表, 开始游戏日, 预计结束游戏日, 任务}
var 调查实例计数器: int = 0

func _修为阶(obj) -> int:
	# 修为阶 = 境界序*10 + 层数，越大越高阶（用于「接取者须高于失踪者」判定）
	if obj == null:
		return 0
	var 境: String = obj.境界 if (obj is Object) else str(obj.get("境界", "练气"))
	var 层: int = int(obj.层数) if (obj is Object) else int(obj.get("层数", 1))
	var i = _境界序表.find(境)
	if i < 0:
		i = 0
	return i * 10 + 层

func _关卡要求阶(关卡: Dictionary) -> int:
	# 关卡解锁境界 → 要求修为阶（用于「低阶做高级任务→阶差→失踪率升高」判定）
	var 解锁境: String = str(关卡.get("解锁境界", "练气"))
	var i = _境界序表.find(解锁境)
	if i < 0:
		i = 0
	return i * 10 + 1

# ============ 关卡查询 ============
func 获取关卡(关卡ID: String) -> Dictionary:
	return 关卡库.get(关卡ID, {})

func 获取可用关卡(弟子最高境界: String) -> Array:
	var 结果: Array = []
	for id in 关卡库.keys():
		var 关卡 = 关卡库[id]
		if _境界达标(弟子最高境界, 关卡["解锁境界"]):
			结果.append(id)
	return 结果

func 获取日常关卡() -> Array:
