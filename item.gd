	}

func 是材料名称(名: String) -> bool:
	if 基础库.has("ling_cai"):
		for 阶 in 基础库["ling_cai"].keys():
			for 条 in 基础库["ling_cai"][阶]:
				if 条.get("名", "") == 名:
					return true
	return false

# ===== S53 物品认主系统函数 =====
# 是否可交易（认主物品不可交易）
func 是否可交易() -> bool:
	match 认主类型:
		"无主":
			return true
		"滴血认主":
			return false  # 已认主不可交易，需先解除认主
		"有缘者得":
			return false  # 拾取绑定，不可交易
		"宗门印记":
			return false  # 宗门专属，不可交易
		"宗主本命":
			return false  # 宗主专属，不可交易
		_:
			return true

# 滴血认主（装备穿戴时自动调用）
func 滴血认主(认主者: String) -> void:
	if 认主类型 == "无主":
		认主类型 = "滴血认主"
		认主者ID = 认主者
		if Game != null:
			认主日期 = Game.累计游戏日

