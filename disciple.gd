## 性格相冲度：返回 0(不相冲) 或 强度(1-3)；顺序无关；甲/乙 为空返回 0
static func 性格相冲度(甲: String, 乙: String) -> int:
	if 甲 == "" or 乙 == "":
		return 0
	for 对 in 性格相冲表:
		if (对[0] == 甲 and 对[1] == 乙) or (对[0] == 乙 and 对[1] == 甲):
			return int(对[2])
	return 0

