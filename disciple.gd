## 随机觉醒特殊体质（入门测灵时调用）
## 天品灵根概率提升至15%，极品10%，上品7%，其他5%
func 随机觉醒体质(灵根品阶: String) -> String:
	var 基础概率: float = 0.05
	match 灵根品阶:
		"天品": 基础概率 = 0.15
		"极品": 基础概率 = 0.10
		"上品": 基础概率 = 0.07
		_: 基础概率 = 0.05
	if randf() >= 基础概率:
		return "凡体"
	# 觉醒特殊体质，按权重随机
	var 体质列表: Array = []
	var 权重列表: Array = []
	for 体质名 in 特殊体质表:
		if 体质名 == "凡体":
			continue
		体质列表.append(体质名)
		权重列表.append(float(特殊体质表[体质名]["觉醒概率"]))
	var 总权重: float = 0.0
	for w in 权重列表:
		总权重 += w
	var r: float = randf() * 总权重
	var 累计: float = 0.0
	for i in range(体质列表.size()):
		累计 += 权重列表[i]
		if r <= 累计:
			return str(体质列表[i])
	return "先天道体"   # 兜底

## 获取体质修炼加成
func 体质修炼加成() -> float:
	if not 体质觉醒 or 特殊体质 == "凡体":
		return 0.0
	return float(特殊体质表.get(特殊体质, {}).get("修炼加成", 0.0))

