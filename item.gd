func _init():
	构建基础库()
	随机生成()

func 构建基础库():
	基础库 = {}
	基础库["dan_yao"] = _丹药库()
	基础库["ling_cai"] = _灵材库()
	基础库["fabao"] = _按阶造(法宝名, 法宝功效, 法宝描述)
	基础库["fa_qi"] = {}
	for 槽 in 法器槽名.keys():
		基础库["fa_qi"][槽] = _按阶造(法器槽名[槽], 法器功效, 法器描述)
	基础库["shen_bing"] = {}
	for 职 in 道途名:
		var 名表: Array = 神兵名[职]
		var 功效表 := []
		for t in 神兵功效:
			功效表.append(t % 职)
		基础库["shen_bing"][职] = _按阶造(名表, 功效表, 神兵描述)

func _按阶造(名表: Array, 功效表: Array, 描述表: Array) -> Dictionary:
	var d := {}
	for i in 品阶序key.size():
		d[品阶序key[i]] = [{"名": 名表[i], "功效": 功效表[i], "描述": 描述表[i]}]
	return d

