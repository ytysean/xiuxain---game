extends RefCounted

# ===== S58 世界地图系统 =====
# 五大区域 + 无限坐标 + 宗门位置 + 距离计算
# 符合修真世界观：世界广袤，宗门各据一方，距离影响运输和战争

# ===== 五大区域定义 =====
const 区域_中州 = "中州"
const 区域_东域 = "东域"
const 区域_西域 = "西域"
const 区域_南疆 = "南疆"
const 区域_北域 = "北域"

const 所有区域: Array = [区域_中州, 区域_东域, 区域_西域, 区域_南疆, 区域_北域]

# 区域特性
