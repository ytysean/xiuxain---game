## 检查材料是否足够
static func 检查材料(丹方ID: String, 背包: Array) -> Dictionary:
	var 丹方 = 丹方库.get(丹方ID, {})
	if 丹方.is_empty():
		return {"足够": false, "原因": "丹方不存在"}
	for mat in 丹方["材料"]:
		var 需求名: String = str(mat["名"])
		var 需求数: int = int(mat["数量"])
		var 拥有数: int = 0
		for item in 背包:
			if item != null and typeof(item) == TYPE_OBJECT and "名称" in item and str(item.名称) == 需求名:
				拥有数 += 1
		if 拥有数 < 需求数:
			return {"足够": false, "原因": "材料不足：%s（%d/%d）" % [需求名, 拥有数, 需求数], "缺失": 需求名}
	return {"足够": true}

## 执行炼丹
## 返回：{成功, 产出丹药(Item/null), 消耗材料, 原因}
static func 炼丹(丹方ID: String, 背包: Array, 丹堂等级: int = 1) -> Dictionary:
	var 检查 = 检查材料(丹方ID, 背包)
	if not 检查["足够"]:
		return {"成功": false, "产出": null, "消耗": [], "原因": 检查.get("原因", "材料不足")}
	var 丹方 = 丹方库.get(丹方ID, {})
	# 计算成功率：基础 + 丹堂等级加成（每级+2%）
	var 成功率: float = float(丹方.get("基础成功率", 50)) + float(max(0, 丹堂等级 - 1)) * 2.0
	成功率 = clampf(成功率, 5.0, 95.0)
	# 消耗材料
	var 消耗列表: Array = []
	for mat in 丹方["材料"]:
		var 需求名: String = str(mat["名"])
		var 需求数: int = int(mat["数量"])
		var 已消耗: int = 0
		for i in range(背包.size() - 1, -1, -1):
			if 已消耗 >= 需求数:
				break
			var item = 背包[i]
			if item != null and typeof(item) == TYPE_OBJECT and "名称" in item and str(item.名称) == 需求名:
				消耗列表.append(item)
				背包.remove_at(i)
				已消耗 += 1
	# 成功率判定
	if randf() * 100.0 > 成功率:
		return {"成功": false, "产出": null, "消耗": 消耗列表, "原因": "炼丹失败，材料已消耗（成功率%.0f%%）" % 成功率}
	# 成功，产出丹药
	var 丹药名: String = str(丹方.get("产出", "未知丹药"))
	var 新品 = Item.new()
	新品.类别 = "dan_yao"
	新品.品阶 = str(丹方.get("品阶", "凡阶"))
	新品.名称 = 丹药名
	新品.功效 = str(丹药效果.get(丹药名, {}).get("描述", ""))
	新品.描述 = str(丹方.get("描述", ""))
	新品.战力加成 = 0
	新品.算战力()
	背包.append(新品)
	return {"成功": true, "产出": 新品, "消耗": 消耗列表, "原因": "炼丹成功！获得%s（成功率%.0f%%）" % [丹药名, 成功率]}

## 服用丹药
## 返回：{成功, 效果, 原因}
static func 服用丹药(弟子, 丹药: Item) -> Dictionary:
	if 弟子 == null or 丹药 == null:
		return {"成功": false, "原因": "无效参数"}
	var 效果 = 丹药效果.get(str(丹药.名称), {})
	if 效果.is_empty():
		return {"成功": false, "原因": "未知丹药效果"}
	match str(效果.get("类型", "")):
		"zhuyan":
			if 弟子.has_method("服用驻颜丹"):
				var ok: bool = 弟子.服用驻颜丹()
				if ok:
					return {"成功": true, "效果": "驻颜成功，外观已锁定", "原因": "服用%s成功！" % 丹药.名称}
				return {"成功": false, "原因": "已服用过驻颜丹，外观已锁定"}
		"permanent":
			var 属性: String = str(效果.get("属性", ""))
			var 数值: int = int(效果.get("数值", 0))
			if 属性 == "道心" and "道心" in 弟子:
				弟子.道心 += 数值
			elif 属性 == "寿元" and "寿元" in 弟子:
				弟子.寿元 += 数值
			return {"成功": true, "效果": "%s永久+%d" % [属性, 数值], "原因": "服用%s成功！" % 丹药.名称}
		"buff":
			# 临时增益存入弟子buff列表
			if "临时增益" not in 弟子:
				弟子["临时增益"] = []
			弟子["临时增益"].append({"丹药": 丹药.名称, "属性": 效果.get("属性", ""), "数值": 效果.get("数值", 0), "剩余天数": 效果.get("持续天数", 7)})
			return {"成功": true, "效果": "%s+%d%%，持续%d天" % [str(效果.get("属性","")), int(float(效果.get("数值",0))*100), int(效果.get("持续天数",7))], "原因": "服用%s成功！" % 丹药.名称}
		"breakthrough":
			if "突破增益" not in 弟子:
				弟子["突破增益"] = {}
			弟子["突破增益"][str(效果.get("境界",""))] = float(效果.get("数值", 0))
			return {"成功": true, "效果": "%s突破辅助+%d%%" % [str(效果.get("境界","")), int(float(效果.get("数值",0))*100)], "原因": "服用%s成功！" % 丹药.名称}
	return {"成功": false, "原因": "未知丹药类型"}
