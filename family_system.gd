## 升级家族学塾
func 升级家族学塾(家族ID: String, 操作者: Disciple) -> Dictionary:
	if 家族ID == "" or 操作者 == null:
		return {"成功": false, "因": "参数无效"}
	var 家族: Dictionary = 获取家族(家族ID)
	if 家族.is_empty():
		return {"成功": false, "因": "家族不存在"}
	# 检查操作者权限（老祖/长老可升级）
	var 职位权限: Dictionary = {"老祖": 10, "长老": 8, "核心": 6, "内门": 4, "外门": 2, "附庸": 1}
	if 职位权限.get(操作者.家族职位, 0) < 8:
		return {"成功": false, "因": "家族职位不足，只有老祖/长老才能升级学塾"}
	var 当前等级: int = int(家族.get("学塾等级", 1))
	if 当前等级 >= 4:
		return {"成功": false, "因": "学塾已达最高品级"}
	# 消耗家族贡献池
	var 升级消耗: int = 当前等级 * 500
	if int(家族.get("家族贡献池", 0)) < 升级消耗:
		return {"成功": false, "因": "家族贡献池不足，需要%d点贡献" % 升级消耗}
	家族["家族贡献池"] = int(家族.get("家族贡献池", 0)) - 升级消耗
	家族["学塾等级"] = 当前等级 + 1
	家族列表[家族ID] = 家族
	var 新学塾: Dictionary = _家族学塾配置.get("level_%d" % (当前等级 + 1), {})
	Game.添加纪事("家族", "升级学塾", "%s 将家族学塾升级为「%s」" % [操作者.姓名, str(新学塾.get("名", ""))], 1)
	return {"成功": true, "新等级": 当前等级 + 1, "学塾名": str(新学塾.get("名", ""))}

## 家族试炼（选拔核心弟子）
func 家族试炼(家族ID: String, 弟子: Disciple) -> Dictionary:
	if 家族ID == "" or 弟子 == null:
		return {"成功": false, "因": "参数无效"}
	var 家族: Dictionary = 获取家族(家族ID)
	if 家族.is_empty():
		return {"成功": false, "因": "家族不存在"}
	if 弟子.家族ID != 家族ID:
		return {"成功": false, "因": "不是本家族成员"}
	# 试炼条件：境界≥筑基，家族贡献≥100
	if 弟子.境界 == "练气" or 弟子.境界 == "":  # 境界不足，需要筑基以上
		return {"成功": false, "因": "境界不足，需要筑基以上才能参加家族试炼"}
	if 弟子.家族贡献 < 100:
		return {"成功": false, "因": "家族贡献不足，需要100点贡献才能参加试炼"}
	# 消耗贡献
	弟子.家族贡献 -= 100
	# 试炼结果（随机，受资质/境界影响）
	var 资质系数: float = float(弟子.资质) / 100.0
	var 成功概率: float = 0.3 + 资质系数 * 0.4
	if randf() < 成功概率:
		# 试炼成功：晋升核心弟子，获得奖励
		if 弟子.家族职位 == "内门" or 弟子.家族职位 == "外门":
			弟子.家族职位 = "核心"
		弟子.家族贡献 += 200
		# 获得临时修炼加成（30游戏日）
		Game.添加纪事("家族", "试炼成功", "%s 通过家族试炼，晋升核心弟子，获得200点家族贡献" % 弟子.姓名, 1)
		return {"成功": true, "结果": "试炼成功", "奖励": "晋升核心弟子+200贡献"}
	else:
		# 试炼失败：获得安慰奖
		弟子.家族贡献 += 50
		Game.添加纪事("家族", "试炼失败", "%s 未能通过家族试炼，获得50点安慰贡献" % 弟子.姓名, 1)
		return {"成功": true, "结果": "试炼失败", "安慰": "50点贡献"}

## 计算家族培养加成（学塾+资源倾斜）
func 计算家族培养加成(弟子: Disciple) -> Dictionary:
	if 弟子 == null or not (弟子 is Disciple) or 弟子.家族ID == "":
		return {"修炼加成": 0.0, "突破加成": 0.0}
	var 家族: Dictionary = 获取家族(弟子.家族ID)
	if 家族.is_empty():
		return {"修炼加成": 0.0, "突破加成": 0.0}
	var 学塾等级: int = int(家族.get("学塾等级", 1))
	var 学塾: Dictionary = _家族学塾配置.get("level_%d" % 学塾等级, _家族学塾配置.get("level_1", {}))
	var 修炼加成: float = float(学塾.get("修炼加成", 0.0))
	var 突破加成: float = float(学塾.get("突破加成", 0.0))
	# 核心弟子享受资源倾斜，额外+50%效果
	if 弟子.家族职位 == "核心" or 弟子.家族职位 == "长老" or 弟子.家族职位 == "老祖":
		修炼加成 *= 1.5
		突破加成 *= 1.5
	# 数值红线：家族培养单源子帽≤1%（全局等效）
	修炼加成 = min(修炼加成, 0.01)
	突破加成 = min(突破加成, 0.05)
	return {"修炼加成": 修炼加成, "突破加成": 突破加成}

# ============ §6.16 宗门功法不外传机制（P2实现）============
# 修真世界设定：宗门功法只有宗门弟子能学习，叛出宗门自动清除

## 学习宗门功法（需要宗门职位权限）
func 学习宗门功法(弟子: Disciple, 功法ID: String) -> Dictionary:
	if 弟子 == null or 功法ID == "":
		return {"成功": false, "因": "弟子或功法ID为空"}
	# 检查是否是宗门弟子（简化版：所有在宗弟子都是宗门弟子）
	if 弟子.状态 != "在宗":
		return {"成功": false, "因": "不在宗门，无法学习宗门功法"}
	# 检查功法是否存在（简化版：假设所有功法ID都存在）
	# 检查是否已学习
	if 功法ID in 弟子.已学功法:
		return {"成功": false, "因": "已学习此宗门功法"}
	# 宗门职位权限检查（简化版：核心弟子及以上可学习高级功法）
	# 这里简化处理，所有在宗弟子都能学习基础功法
	弟子.已学功法.append(功法ID)
	Game.添加纪事("宗门", "学习功法", "%s 学习宗门功法「%s」" % [弟子.姓名, 功法ID], 1)
	return {"成功": true, "功法ID": 功法ID}

## 清除宗门功法（叛出宗门/逐出宗门时调用）
func 清除宗门功法(弟子: Disciple) -> Dictionary:
	if 弟子 == null:
		return {"成功": false, "因": "弟子无效"}
	var 清除数量: int = 弟子.已学功法.size()
	弟子.已学功法.clear()
	Game.添加纪事("宗门", "清除功法", "%s 被清除所有宗门功法（共%d门）" % [弟子.姓名, 清除数量], 1)
	return {"成功": true, "清除数量": 清除数量}

# ============ §6.16 家族社交系统（P3实现）============
# 修真世界设定：家族联盟、家族联姻、家族仇杀、家族竞争

## 家族联盟
func 家族联盟(家族ID1: String, 家族ID2: String, 操作者: Disciple) -> Dictionary:
	if 家族ID1 == "" or 家族ID2 == "" or 家族ID1 == 家族ID2:
		return {"成功": false, "因": "家族ID无效"}
	if 操作者 == null:
		return {"成功": false, "因": "操作者无效"}
	var 家族1: Dictionary = 获取家族(家族ID1)
	var 家族2: Dictionary = 获取家族(家族ID2)
	if 家族1.is_empty() or 家族2.is_empty():
		return {"成功": false, "因": "家族不存在"}
	# 检查操作者权限（家族1的老祖/长老可发起联盟）
	var 职位权限: Dictionary = {"老祖": 10, "长老": 8, "核心": 6, "内门": 4, "外门": 2, "附庸": 1}
	if 操作者.家族ID != 家族ID1 or 职位权限.get(操作者.家族职位, 0) < 8:
		return {"成功": false, "因": "权限不足，只有家族1的老祖/长老才能发起联盟"}
	# 检查是否已联盟
	var 联盟列表1: Array = 家族1.get("联盟家族", [])
	if 联盟列表1.has(家族ID2):
		return {"成功": false, "因": "两家族已联盟"}
	# 检查是否是敌对家族
	var 敌对列表1: Array = 家族1.get("敌对家族", [])
	if 敌对列表1.has(家族ID2):
		return {"成功": false, "因": "两家族是敌对关系，无法联盟"}
	# 建立联盟
	联盟列表1.append(家族ID2)
	家族1["联盟家族"] = 联盟列表1
	var 联盟列表2: Array = 家族2.get("联盟家族", [])
	联盟列表2.append(家族ID1)
	家族2["联盟家族"] = 联盟列表2
	家族列表[家族ID1] = 家族1
	家族列表[家族ID2] = 家族2
	Game.添加纪事("家族", "家族联盟", "「%s」与「%s」结为联盟家族" % [str(家族1.get("名", "")), str(家族2.get("名", ""))], 1)
	return {"成功": true, "家族1": str(家族1.get("名", "")), "家族2": str(家族2.get("名", ""))}

## 解除家族联盟
func 解除家族联盟(家族ID1: String, 家族ID2: String, 操作者: Disciple) -> Dictionary:
	if 家族ID1 == "" or 家族ID2 == "":
		return {"成功": false, "因": "家族ID无效"}
	var 家族1: Dictionary = 获取家族(家族ID1)
	var 家族2: Dictionary = 获取家族(家族ID2)
	if 家族1.is_empty() or 家族2.is_empty():
		return {"成功": false, "因": "家族不存在"}
	var 职位权限: Dictionary = {"老祖": 10, "长老": 8, "核心": 6, "内门": 4, "外门": 2, "附庸": 1}
	if 操作者.家族ID != 家族ID1 or 职位权限.get(操作者.家族职位, 0) < 8:
		return {"成功": false, "因": "权限不足"}
	var 联盟列表1: Array = 家族1.get("联盟家族", [])
	if not 联盟列表1.has(家族ID2):
		return {"成功": false, "因": "两家族未联盟"}
	联盟列表1.erase(家族ID2)
	家族1["联盟家族"] = 联盟列表1
	var 联盟列表2: Array = 家族2.get("联盟家族", [])
	联盟列表2.erase(家族ID1)
	家族2["联盟家族"] = 联盟列表2
	家族列表[家族ID1] = 家族1
	家族列表[家族ID2] = 家族2
	Game.添加纪事("家族", "解除联盟", "「%s」与「%s」解除联盟" % [str(家族1.get("名", "")), str(家族2.get("名", ""))], 1)
	return {"成功": true}

## 家族联姻
func 家族联姻(家族ID1: String, 家族ID2: String, 弟子1: Disciple, 弟子2: Disciple, 操作者: Disciple) -> Dictionary:
	if 家族ID1 == "" or 家族ID2 == "" or 家族ID1 == 家族ID2:
		return {"成功": false, "因": "家族ID无效"}
	if 弟子1 == null or 弟子2 == null:
		return {"成功": false, "因": "联姻弟子无效"}
	var 家族1: Dictionary = 获取家族(家族ID1)
	var 家族2: Dictionary = 获取家族(家族ID2)
	if 家族1.is_empty() or 家族2.is_empty():
		return {"成功": false, "因": "家族不存在"}
	var 职位权限: Dictionary = {"老祖": 10, "长老": 8, "核心": 6, "内门": 4, "外门": 2, "附庸": 1}
	if 操作者.家族ID != 家族ID1 or 职位权限.get(操作者.家族职位, 0) < 8:
		return {"成功": false, "因": "权限不足，只有家族1的老祖/长老才能发起联姻"}
	# 检查联姻弟子是否属于对应家族
	if 弟子1.家族ID != 家族ID1 or 弟子2.家族ID != 家族ID2:
		return {"成功": false, "因": "联姻弟子不属于对应家族"}
	# 检查是否已联姻
	var 联姻列表1: Array = 家族1.get("联姻家族", [])
	if 联姻列表1.has(家族ID2):
		return {"成功": false, "因": "两家族已联姻"}
	# 建立联姻
	联姻列表1.append({"家族ID": 家族ID2, "弟子1": 弟子1.弟子ID, "弟子2": 弟子2.弟子ID, "联姻时间": Game.累计游戏日})
	家族1["联姻家族"] = 联姻列表1
	var 联姻列表2: Array = 家族2.get("联姻家族", [])
	联姻列表2.append({"家族ID": 家族ID1, "弟子1": 弟子2.弟子ID, "弟子2": 弟子1.弟子ID, "联姻时间": Game.累计游戏日})
	家族2["联姻家族"] = 联姻列表2
	# 联姻后自动建立联盟
	var 联盟列表1: Array = 家族1.get("联盟家族", [])
	if not 联盟列表1.has(家族ID2):
		联盟列表1.append(家族ID2)
		家族1["联盟家族"] = 联盟列表1
	var 联盟列表2: Array = 家族2.get("联盟家族", [])
	if not 联盟列表2.has(家族ID1):
		联盟列表2.append(家族ID1)
		家族2["联盟家族"] = 联盟列表2
	家族列表[家族ID1] = 家族1
	家族列表[家族ID2] = 家族2
	Game.添加纪事("家族", "家族联姻", "「%s」%s 与 「%s」%s 联姻，两家族结为秦晋之好" % [str(家族1.get("名", "")), 弟子1.姓名, str(家族2.get("名", "")), 弟子2.姓名], 1)
	return {"成功": true, "家族1": str(家族1.get("名", "")), "家族2": str(家族2.get("名", ""))}

## 家族结仇
func 家族结仇(家族ID1: String, 家族ID2: String, 原因: String, 操作者: Disciple) -> Dictionary:
	if 家族ID1 == "" or 家族ID2 == "" or 家族ID1 == 家族ID2:
		return {"成功": false, "因": "家族ID无效"}
	var 家族1: Dictionary = 获取家族(家族ID1)
	var 家族2: Dictionary = 获取家族(家族ID2)
	if 家族1.is_empty() or 家族2.is_empty():
		return {"成功": false, "因": "家族不存在"}
	var 职位权限: Dictionary = {"老祖": 10, "长老": 8, "核心": 6, "内门": 4, "外门": 2, "附庸": 1}
	if 操作者.家族ID != 家族ID1 or 职位权限.get(操作者.家族职位, 0) < 8:
		return {"成功": false, "因": "权限不足"}
	# 检查是否已结仇
	var 敌对列表1: Array = 家族1.get("敌对家族", [])
	if 敌对列表1.has(家族ID2):
		return {"成功": false, "因": "两家族已是敌对关系"}
	# 结仇后自动解除联盟
	var 联盟列表1: Array = 家族1.get("联盟家族", [])
	if 联盟列表1.has(家族ID2):
		联盟列表1.erase(家族ID2)
		家族1["联盟家族"] = 联盟列表1
	var 联盟列表2: Array = 家族2.get("联盟家族", [])
	if 联盟列表2.has(家族ID1):
		联盟列表2.erase(家族ID1)
		家族2["联盟家族"] = 联盟列表2
	# 建立敌对关系
	敌对列表1.append({"家族ID": 家族ID2, "仇恨值": 50, "原因": 原因, "结仇时间": Game.累计游戏日})
	家族1["敌对家族"] = 敌对列表1
	var 敌对列表2: Array = 家族2.get("敌对家族", [])
	敌对列表2.append({"家族ID": 家族ID1, "仇恨值": 50, "原因": 原因, "结仇时间": Game.累计游戏日})
	家族2["敌对家族"] = 敌对列表2
	家族列表[家族ID1] = 家族1
	家族列表[家族ID2] = 家族2
	Game.添加纪事("家族", "家族结仇", "「%s」与「%s」结仇，原因：%s" % [str(家族1.get("名", "")), str(家族2.get("名", "")), 原因], 2)
	return {"成功": true, "仇恨值": 50}

## P1联动：家族联姻 → 后代资质提升
# 计算联姻家族后代的资质加成（父母家族联姻，后代资质提升）
func 计算联姻后代资质加成(家族ID: String) -> float:
	var 家族: Dictionary = 获取家族(家族ID)
	if 家族.is_empty():
		return 0.0
	var 联姻列表: Array = 家族.get("联姻家族", [])
	if 联姻列表.is_empty():
		return 0.0
	# 每个联姻家族+5%资质上限，最多+20%
	return min(0.20, float(联姻列表.size()) * 0.05)

# 生成联姻后代（资质提升，有概率继承双方家族血脉天赋）
func 生成联姻后代(家族ID1: String, 家族ID2: String, 父: Disciple, 母: Disciple) -> Dictionary:
	var 家族1: Dictionary = 获取家族(家族ID1)
	var 家族2: Dictionary = 获取家族(家族ID2)
	if 家族1.is_empty() or 家族2.is_empty():
		return {"成功": false, "原因": "家族不存在"}
	# 计算资质加成
	var 资质加成: float = 计算联姻后代资质加成(家族ID1)
	# 基础资质（父母平均）
	# 注：资质在 Disciple 上为 String，直接相加会触发 "String" / "int" 类型错误，先转 int。
	var 基础资质: int = (int(父.资质) + int(母.资质)) / 2
	# 应用加成
	var 后代资质: int = min(100, int(float(基础资质) * (1.0 + 资质加成)))
	# 有30%概率继承父亲血脉天赋
	var 继承父天赋: bool = randf() < 0.3
	# 有30%概率继承母亲血脉天赋
	var 继承母天赋: bool = randf() < 0.3
	# 生成后代姓名
	var 姓氏: String = str(家族1.get("名", ""))
	# 注：随机生成弟子名() 在本类并不存在（原为臆造调用，导致编译期阻断）。
	#     改为复用 Disciple 的名库常量（const 可跨类访问），与弟子取名规则保持一致：70% 单名 / 30% 双名。
	var 名字: String = ""
	if randf() < 0.7:
		名字 = str(Disciple.名库单字.pick_random())
	else:
		名字 = str(Disciple.名库双字首.pick_random()) + str(Disciple.名库双字尾.pick_random())
	var 后代名: String = 姓氏 + 名字
	# 添加纪事
	Game.添加纪事("家族", "联姻后代", "「%s」与「%s」联姻，诞生后代「%s」，资质%d（联姻加成+%d%%）" % [str(家族1.get("名", "")), str(家族2.get("名", "")), 后代名, 后代资质, int(资质加成 * 100)], 0)
	Game._加推演条目("【家族】「%s」与「%s」联姻，诞生后代「%s」，资质出众" % [str(家族1.get("名", "")), str(家族2.get("名", "")), 后代名], "家族", "中")
	return {
		"成功": true,
		"姓名": 后代名,
		"资质": 后代资质,
		"资质加成": 资质加成,
		"继承父天赋": 继承父天赋,
		"继承母天赋": 继承母天赋,
	}

## 家族和解
func 家族和解(家族ID1: String, 家族ID2: String, 操作者: Disciple) -> Dictionary:
	if 家族ID1 == "" or 家族ID2 == "":
		return {"成功": false, "因": "家族ID无效"}
	var 家族1: Dictionary = 获取家族(家族ID1)
	var 家族2: Dictionary = 获取家族(家族ID2)
	if 家族1.is_empty() or 家族2.is_empty():
		return {"成功": false, "因": "家族不存在"}
	var 职位权限: Dictionary = {"老祖": 10, "长老": 8, "核心": 6, "内门": 4, "外门": 2, "附庸": 1}
	if 操作者.家族ID != 家族ID1 or 职位权限.get(操作者.家族职位, 0) < 8:
		return {"成功": false, "因": "权限不足"}
	# 检查是否是敌对关系
	var 敌对列表1: Array = 家族1.get("敌对家族", [])
	var 找到: bool = false
	for 敌对 in 敌对列表1:
		if str(敌对.get("家族ID", "")) == 家族ID2:
			找到 = true
			break
	if not 找到:
		return {"成功": false, "因": "两家族不是敌对关系"}
	# 和解需要消耗家族声望
	if int(家族1.get("家族声望", 0)) < 100:
		return {"成功": false, "因": "家族声望不足，需要100点声望才能和解"}
	家族1["家族声望"] = int(家族1.get("家族声望", 0)) - 100
	# 移除敌对关系
	var 新敌对列表1: Array = []
	for 敌对 in 敌对列表1:
		if str(敌对.get("家族ID", "")) != 家族ID2:
			新敌对列表1.append(敌对)
	家族1["敌对家族"] = 新敌对列表1
	var 敌对列表2: Array = 家族2.get("敌对家族", [])
	var 新敌对列表2: Array = []
	for 敌对 in 敌对列表2:
		if str(敌对.get("家族ID", "")) != 家族ID1:
			新敌对列表2.append(敌对)
	家族2["敌对家族"] = 新敌对列表2
	家族列表[家族ID1] = 家族1
	家族列表[家族ID2] = 家族2
	Game.添加纪事("家族", "家族和解", "「%s」与「%s」和解，消耗100点家族声望" % [str(家族1.get("名", "")), str(家族2.get("名", ""))], 1)
	return {"成功": true}

## 计算家族社交加成（联盟+联姻）
func 计算家族社交加成(弟子: Disciple) -> Dictionary:
	if 弟子 == null or not (弟子 is Disciple) or 弟子.家族ID == "":
		return {"修炼加成": 0.0, "战力加成": 0.0}
	var 家族: Dictionary = 获取家族(弟子.家族ID)
	if 家族.is_empty():
		return {"修炼加成": 0.0, "战力加成": 0.0}
	var 修炼加成: float = 0.0
	var 战力加成: float = 0.0
	# 联盟加成：每个联盟家族+0.2%修炼，最多+1%
	var 联盟数量: int = 家族.get("联盟家族", []).size()
	修炼加成 += min(联盟数量 * 0.002, 0.01)
	# 联姻加成：每个联姻家族+0.3%修炼+0.2%战力，最多+1.5%
	var 联姻数量: int = 家族.get("联姻家族", []).size()
	修炼加成 += min(联姻数量 * 0.003, 0.015)
	战力加成 += min(联姻数量 * 0.002, 0.01)
	# 数值红线：家族社交单源子帽≤1%（全局等效）
	修炼加成 = min(修炼加成, 0.01)
	战力加成 = min(战力加成, 0.01)
	return {"修炼加成": 修炼加成, "战力加成": 战力加成}

# ============ §6.16 功法泄露惩罚系统（P3实现）============
# 修真世界设定：泄露家族/宗门功法者，逐出家族/宗门，全江湖追杀

## 检测功法泄露
func 检测功法泄露(弟子: Disciple, 功法ID: String, 功法类型: String) -> Dictionary:
	if 弟子 == null or 功法ID == "":
		return {"成功": false, "因": "参数无效"}
	# 检查是否是家族功法
	if 功法类型 == "家族功法":
		if 弟子.家族ID == "":
			return {"成功": false, "因": "弟子无家族，不存在家族功法泄露"}
		var 家族: Dictionary = 获取家族(弟子.家族ID)
		var 家族功法: Array = 家族.get("家族功法", [])
		if not 家族功法.has(功法ID):
			return {"成功": false, "因": "该功法不是家族功法"}
		# 检测到泄露，执行惩罚
		return 执行功法泄露惩罚(弟子, 功法ID, "家族功法")
	# 检查是否是宗门功法
	elif 功法类型 == "宗门功法":
		if not 功法ID in 弟子.已学功法:
			return {"成功": false, "因": "弟子未学习此宗门功法"}
		return 执行功法泄露惩罚(弟子, 功法ID, "宗门功法")
	return {"成功": false, "因": "未知功法类型"}

## 执行功法泄露惩罚
func 执行功法泄露惩罚(弟子: Disciple, 功法ID: String, 功法类型: String) -> Dictionary:
	if 弟子 == null:
		return {"成功": false, "因": "弟子无效"}
	var 惩罚措施: Array = []
	# 惩罚1：清除所有该类型功法
	if 功法类型 == "家族功法":
		var 清除数量: int = 弟子.家族功法列表.size()
		弟子.家族功法列表.clear()
		惩罚措施.append("清除所有家族功法（共%d门）" % 清除数量)
		# 惩罚2：逐出家族
		if 弟子.家族ID != "":
			var 家族名: String = 弟子.家族名
			退出家族(弟子)
			惩罚措施.append("逐出家族「%s」" % 家族名)
	elif 功法类型 == "宗门功法":
		var 清除数量: int = 弟子.已学功法.size()
		弟子.已学功法.clear()
		惩罚措施.append("清除所有宗门功法（共%d门）" % 清除数量)
		# 惩罚2：逐出宗门（简化版：状态改为逐出）
		弟子.状态 = "逐出"
		惩罚措施.append("逐出宗门")
	# 惩罚3：声望大减
	弟子.家族贡献 = max(0, 弟子.家族贡献 - 500)
	惩罚措施.append("家族贡献-500")
	# 惩罚4：全江湖追杀标记（简化版：记录在履历中）
	弟子.履历.append({"时间": Game.累计游戏日, "事件": "泄露%s「%s」，被全江湖追杀" % [功法类型, 功法ID], "类型": "惩罚"})
	惩罚措施.append("全江湖追杀标记")
	Game.添加纪事("惩罚", "功法泄露", "%s 泄露%s「%s」，受到惩罚：%s" % [弟子.姓名, 功法类型, 功法ID, "；".join(惩罚措施)], 2)
	return {"成功": true, "惩罚措施": 惩罚措施}

