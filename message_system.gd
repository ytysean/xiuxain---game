# S56-P2：领取天机秘闻奖励
func 领取秘闻奖励(消息ID: String) -> Dictionary:
	var 消息: Dictionary = _找消息(消息ID)
	if 消息.is_empty():
		return {"成功": false, "原因": "秘闻不存在"}
	var 附加数据: Dictionary = 消息.get("附加数据", {})
	if bool(附加数据.get("已领取", false)):
		return {"成功": false, "原因": "奖励已领取"}
	# 检查有效期
	var 有效期: int = int(附加数据.get("有效期", 30))
	var 获取日: int = int(消息.get("日", 0))
	if Game.累计游戏日 - 获取日 > 有效期:
		return {"成功": false, "原因": "秘闻已过期"}
	# 领取奖励
	var 奖励: Dictionary = 附加数据.get("奖励", {})
	var 贡献奖励: int = int(奖励.get("贡献点", 0))
	var 声望奖励: int = int(奖励.get("声望", 0))
	Game.贡献点 += 贡献奖励
	Game.声望 += 声望奖励
	天机阁声望 += 5
	附加数据["已领取"] = true
	消息["附加数据"] = 附加数据
	return {"成功": true, "贡献点": 贡献奖励, "声望": 声望奖励}

# S56-P2：检查秘闻是否过期
func 秘闻是否过期(消息ID: String) -> bool:
	var 消息: Dictionary = _找消息(消息ID)
	if 消息.is_empty():
		return true
	var 附加数据: Dictionary = 消息.get("附加数据", {})
	var 有效期: int = int(附加数据.get("有效期", 30))
	var 获取日: int = int(消息.get("日", 0))
	return Game.累计游戏日 - 获取日 > 有效期

# ===== S56-P2：传音符消耗机制 =====
# 消耗传音符发送消息
func 消耗传音符发送(类型: String, 标题: String, 内容: String, 发送者: String = "宗主") -> Dictionary:
	if 传音符数量 <= 0:
		return {"成功": false, "原因": "传音符不足"}
	传音符数量 -= 1
	var 消息: Dictionary = 发送消息(类型, 标题, 内容, 发送者, {"消耗传音符": true})
	return {"成功": true, "消息": 消息}

# 增加传音符
func 增加传音符(数量: int) -> void:
	传音符数量 += max(0, 数量)

# ===== S56-P2：主动打探情报 =====
# 主动打探情报（花费灵石+贡献点）
func 主动打探情报() -> Dictionary:
	if 打探冷却 > 0:
		return {"成功": false, "原因": "打探冷却中，还需%d日" % 打探冷却}
	# 打探花费：500灵石 + 50贡献点
	var 花费灵石: int = 500
	var 花费贡献: int = 50
	if Game.灵石 < 花费灵石:
		return {"成功": false, "原因": "灵石不足，需%d灵石" % 花费灵石}
	if Game.贡献点 < 花费贡献:
		return {"成功": false, "原因": "贡献点不足，需%d贡献点" % 花费贡献}
	Game.灵石 -= 花费灵石
	Game.贡献点 -= 花费贡献
	打探冷却 = 7  # 7日冷却
	# 天机阁声望影响质量
	var 声望加成: float = float(天机阁声望) * 0.01
	var 随机值: float = randf() + 声望加成
	if 随机值 > 1.2:
		# 高概率获得天机秘闻
		var 秘闻: Dictionary = 随机生成天机秘闻()
		return {"成功": true, "结果": "天机秘闻", "消息": 秘闻}
	elif 随机值 > 0.6:
		# 获得坊市闲谈
		var 闲谈: Dictionary = 随机生成坊市闲谈()
		return {"成功": true, "结果": "坊市闲谈", "消息": 闲谈}
	else:
		# 打探失败
		return {"成功": true, "结果": "一无所获", "消息": null}

# ===== S56-P2：卧底情报系统 =====
# 派遣弟子卧底
func 派遣卧底(弟子ID: String) -> Dictionary:
	# 检查弟子是否存在
	var 弟子: Disciple = null
	for d in Game.弟子列表:
		if str(d.id) == 弟子ID:
			弟子 = d
			break
	if 弟子 == null:
		return {"成功": false, "原因": "弟子不存在"}
	# 检查是否已经在卧底
	for id in 卧底弟子:
		if str(id) == 弟子ID:
			return {"成功": false, "原因": "该弟子已在卧底中"}
	# 卧底要求：忠诚>=80，境界>=筑基
	if 弟子.忠诚 < 80:
		return {"成功": false, "原因": "弟子忠诚不足，需80以上"}
	# 派遣卧底，消耗100贡献点
	if Game.贡献点 < 100:
		return {"成功": false, "原因": "贡献点不足，需100贡献点"}
	Game.贡献点 -= 100
	卧底弟子.append(弟子ID)
	# 发送宗门传令
	发送宗门传令("弟子卧底", "弟子%s已潜入敌方，静待情报传回。" % 弟子.姓名)
	return {"成功": true, "弟子": 弟子.姓名}

# 卧底传回情报（月度概率触发）
func 卧底传回情报() -> void:
	if 卧底弟子.is_empty():
		return
	# 每个卧底弟子30%概率传回情报
	for 弟子ID in 卧底弟子:
		if randf() < 0.3:
			var 弟子: Disciple = null
			for d in Game.弟子列表:
				if str(d.id) == str(弟子ID):
					弟子 = d
					break
			if 弟子 != null:
				# 50%天机秘闻，50%坊市闲谈
				if randf() < 0.5:
					var 秘闻: Dictionary = 随机生成天机秘闻()
					发送宗门传令("卧底情报", "弟子%s传回机密情报：%s" % [弟子.姓名, 秘闻["标题"]])
				else:
					var 闲谈: Dictionary = 随机生成坊市闲谈()
					发送宗门传令("卧底情报", "弟子%s传回消息：%s" % [弟子.姓名, 闲谈["标题"]])

# 召回卧底弟子
func 召回卧底(弟子ID: String) -> Dictionary:
	var 索引: int = -1
	for i in range(卧底弟子.size()):
		if str(卧底弟子[i]) == 弟子ID:
			索引 = i
			break
	if 索引 == -1:
		return {"成功": false, "原因": "该弟子不在卧底中"}
	卧底弟子.remove_at(索引)
	发送宗门传令("卧底召回", "弟子已召回宗门。")
	return {"成功": true}

# ===== 宗门传令（内部通知）=====
# 发送宗门传令
func 发送宗门传令(标题: String, 内容: String) -> Dictionary:
	return 发送消息(类型_宗门传令, 标题, 内容, "宗主", {"宗门传令": true, "优先级": "普通"})

# S56-P1：发送紧急宗门传令
func 发送紧急传令(标题: String, 内容: String) -> Dictionary:
	return 发送消息(类型_宗门传令, 标题, 内容, "宗主", {"宗门传令": true, "优先级": "紧急", "全屏提示": true})

# ===== 辅助函数 =====
# 查找消息
func _找消息(消息ID: String) -> Dictionary:
	for msg in 消息列表:
		if str(msg.get("id", "")) == 消息ID:
			return msg
	return {}

# ===== S56-P1：宗门频道聊天系统 =====
# 发送宗门频道消息
func 发送宗门聊天(发送者: String, 内容: String, 是玩家: bool = false) -> Dictionary:
	var 聊天消息: Dictionary = {
		"id": "chat_%d_%d" % [Game.累计游戏日, randi() % 100000],
		"发送者": 发送者,
		"内容": 内容,
		"日": Game.累计游戏日,
		"是玩家": 是玩家,
	}
	宗门聊天记录.push_front(聊天消息)
	if 宗门聊天记录.size() > 最大聊天记录:
		宗门聊天记录.pop_back()
	return 聊天消息

# 获取宗门聊天记录
func 获取宗门聊天(数量: int = 50) -> Array:
	return 宗门聊天记录.slice(0, min(数量, 宗门聊天记录.size()))

# S56-P1：NPC随机聊天
func _生成npc聊天() -> void:
	if Game.弟子列表.is_empty():
		return
	# 随机选一个弟子
	var 弟子: Disciple = Game.弟子列表[randi() % Game.弟子列表.size()]
	var 聊天模板: Array = [
		"今日灵气充沛，正是修炼好时光。",
		"听说藏经阁又添了新功法，改日定要去看看。",
		"丹堂的师兄炼出一炉好丹，香气都飘到我这来了。",
		"器堂的法器越来越精良了，我也想换一件。",
		"近日修炼遇到瓶颈，不知何时才能突破。",
		"宗门灵田的灵草长势喜人，今年定有好收成。",
		"山下坊市来了批新货，有空去逛逛。",
		"师兄昨日历练归来，收获颇丰啊。",
		"宗主大人英明，我宗日益强盛。",
		"这几日心绪不宁，怕是心魔又要犯了。",
		"符堂的新符箓威力不小，我也想学学。",
		"御兽阁的灵兽又添了几只，甚是可爱。",
		"藏经阁的传功长老今日讲道，不可错过。",
		"宗门大阵又升级了，安全感倍增。",
		"山下凡人又来供奉了，我宗声望日隆。",
	]
	var 内容: String = 聊天模板[randi() % 聊天模板.size()]
	发送宗门聊天(弟子.姓名, 内容, false)

# S56-P1：触发NPC随机聊天（每日概率）
func 触发每日npc聊天() -> void:
	# 每日30%概率触发1-3条NPC聊天
	if randf() < 0.3:
		var 次数: int = randi_range(1, 3)
		for i in range(次数):
			_生成npc聊天()

# ===== 读取消息 =====
# 标记消息为已读
func 标记已读(消息ID: String) -> void:
	for msg in 消息列表:
		if str(msg.get("id", "")) == 消息ID:
			if not bool(msg.get("已读", false)):
				msg["已读"] = true
				var 类型: String = str(msg.get("类型", ""))
				if 类型 in 未读计数 and int(未读计数[类型]) > 0:
					未读计数[类型] = int(未读计数[类型]) - 1
				未读更新.emit()
			break

# 标记某类型全部已读
func 标记类型已读(类型: String) -> void:
	for msg in 消息列表:
		if str(msg.get("类型", "")) == 类型 and not bool(msg.get("已读", false)):
			msg["已读"] = true
	if 类型 in 未读计数:
		未读计数[类型] = 0
	未读更新.emit()

# 标记全部已读
func 标记全部已读() -> void:
	for msg in 消息列表:
		msg["已读"] = true
	for 类型 in 未读计数.keys():
		未读计数[类型] = 0
	未读更新.emit()

# ===== 获取消息 =====
# 获取某类型的消息列表
func 获取类型消息(类型: String, 数量: int = 50) -> Array:
	var 结果: Array = []
	for msg in 消息列表:
		if str(msg.get("类型", "")) == 类型:
			结果.append(msg)
			if 结果.size() >= 数量:
				break
	return 结果

# 获取最新消息（所有类型）
func 获取最新消息(数量: int = 10) -> Array:
	return 消息列表.slice(0, min(数量, 消息列表.size()))

# 获取最新一条消息（用于顶部栏显示）
func 获取最新一条() -> Dictionary:
	if 消息列表.is_empty():
		return {}
	return 消息列表[0]

# 获取总未读数
func 获取总未读数() -> int:
	var 总数: int = 0
	for 类型 in 未读计数.keys():
		总数 += int(未读计数[类型])
	return 总数

# 获取某类型未读数
func 获取类型未读数(类型: String) -> int:
	return int(未读计数.get(类型, 0))

# 获取消息类型颜色
func 获取类型颜色(类型: String) -> Color:
	match 类型:
		类型_天音法旨: return 颜色_天音法旨
		类型_仙盟邸报: return 颜色_仙盟邸报
		类型_坊市闲谈: return 颜色_坊市闲谈
		类型_密语传音: return 颜色_密语传音
		类型_天机秘闻: return 颜色_天机秘闻
		类型_宗门传令: return 颜色_宗门传令
		_: return Color(0.7, 0.7, 0.7)

# 获取消息类型图标
func 获取类型图标(类型: String) -> String:
	match 类型:
		类型_天音法旨: return "◇"
		类型_仙盟邸报: return "◇"
		类型_坊市闲谈: return "◇"
		类型_密语传音: return "◇"
		类型_天机秘闻: return "◇"
		类型_宗门传令: return "◆"
		_: return "◇"

# ===== 存档/读档 =====
func to_dict() -> Dictionary:
	return {
		"消息列表": 消息列表,
		"未读计数": 未读计数,
		"已验证消息": 已验证消息,
		"宗门聊天记录": 宗门聊天记录,
		"传音符数量": 传音符数量,
		"已获取秘闻": 已获取秘闻,
		"打探冷却": 打探冷却,
		"卧底弟子": 卧底弟子,
		"天机阁声望": 天机阁声望,
	}

func from_dict(data: Dictionary) -> void:
	消息列表 = data.get("消息列表", [])
	未读计数 = data.get("未读计数", {})
	已验证消息 = data.get("已验证消息", {})
	宗门聊天记录 = data.get("宗门聊天记录", [])
	传音符数量 = int(data.get("传音符数量", 10))
	已获取秘闻 = data.get("已获取秘闻", {})
	打探冷却 = int(data.get("打探冷却", 0))
	卧底弟子 = data.get("卧底弟子", [])
	天机阁声望 = int(data.get("天机阁声望", 0))
	# 确保所有类型都有计数
	for 类型 in [类型_天音法旨, 类型_仙盟邸报, 类型_坊市闲谈, 类型_密语传音, 类型_天机秘闻, 类型_宗门传令]:
		if 类型 not in 未读计数:
			未读计数[类型] = 0
