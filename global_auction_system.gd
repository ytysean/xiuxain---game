		if not 成就.has(名) and 累计成交数 >= int(a.get("条件", 0)):
			成就[名] = {"达成": true, "日": Game.累计游戏日, "描述": str(a.get("描述", ""))}
			Game.添加纪事("全服拍卖", "成就达成", "宗主达成拍卖成就「%s」！%s" % [名, str(a.get("描述", ""))], 2)
