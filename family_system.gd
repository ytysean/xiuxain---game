## 炼丹（含领悟丹方、丹纹、成功率、成丹量）
func 炼丹优化(弟子: Disciple, 丹方ID: String, 材料: Dictionary) -> Dictionary:
	if 弟子 == null or 丹方ID == "":
		return {"成功": false, "因": "参数无效"}
	var 炼丹等级: int = int(弟子.炼丹等级 if "炼丹等级" in 弟子 else 1)
	var 成功率: float = float(_炼丹配置["基础成功率"]) + 炼丹等级 * 0.02
	var 成丹量: int = int(_炼丹配置["基础成丹量"]) + int(炼丹等级 / 5)
	var 丹纹: bool = false
	var 领悟丹方: bool = false
	var 丹药品质: String = "普通"
	# 判定成功率
	if randf() > 成功率:
		return {"成功": false, "因": "炼丹失败", "成功率": 成功率}
	# 判定丹纹
	if randf() < float(_炼丹配置["丹纹概率"]):
		丹纹 = true
		丹药品质 = "稀有"
	# 判定领悟丹方
	if randf() < float(_炼丹配置["领悟丹方概率"]):
		领悟丹方 = true
		if not 弟子.已领悟丹方.has(丹方ID):
			弟子.已领悟丹方.append(丹方ID)
	# 品质加成
	var 品质倍率: float = float(_炼丹配置["品质加成"].get(丹药品质, 1.0))
	成丹量 = int(成丹量 * 品质倍率)
	Game.添加纪事("炼丹", "炼丹成功", "%s 炼制%s成功，成丹%d粒%s%s" % [弟子.姓名, 丹方ID, 成丹量, "，丹纹" if 丹纹 else "", "，领悟丹方" if 领悟丹方 else ""], 1)
	return {"成功": true, "丹方ID": 丹方ID, "成丹量": 成丹量, "品质": 丹药品质, "丹纹": 丹纹, "领悟丹方": 领悟丹方, "成功率": 成功率}

## 炼器（含领悟器方、器纹、成功率、成器量）
func 炼器优化(弟子: Disciple, 器方ID: String, 材料: Dictionary) -> Dictionary:
	if 弟子 == null or 器方ID == "":
		return {"成功": false, "因": "参数无效"}
	var 炼器等级: int = int(弟子.炼器等级 if "炼器等级" in 弟子 else 1)
	var 成功率: float = float(_炼器配置["基础成功率"]) + 炼器等级 * 0.02
	var 成器量: int = int(_炼器配置["基础成器量"])
	var 器纹: bool = false
	var 领悟器方: bool = false
	var 法器品质: String = "普通"
	if randf() > 成功率:
