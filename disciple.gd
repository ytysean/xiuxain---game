# 境界→序索引（非法/未知境界返回 -1）。a >= b 表示 a 境界不低于 b。
static func 境界索引(境: String) -> int:
	return 境界序.find(境)

# 下一境界名：境界序 的相邻下一阶（未知名/已至顶阶 → ""）
# 补：外部批次引用了不存在的 下一境界()，致 disciple.gd 编译失败、Game 单例起不来
static func 下一境界名(境: String) -> String:
	var i: int = 境界序.find(境)
	return 境界序[i + 1] if (i >= 0 and i + 1 < 境界序.size()) else ""

# 境界是否达到要求（未知境界一律判不达标，防 find=-1 被当 0 误判）
static func 境界达标(弟子境界: String, 要求境界: String) -> bool:
	var i1: int = 境界序.find(弟子境界)
	var i2: int = 境界序.find(要求境界)
	if i1 < 0 or i2 < 0:
		return false
	return i1 >= i2


