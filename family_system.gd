# ===== 家族系统增强：UI数据汇总 =====
## 获取家族系统UI汇总数据（一页展示所有家族信息）
func 获取家族UI汇总数据() -> Dictionary:
	var 家族详情列表: Array = []
	# 遍历所有家族（家族列表是Dictionary，key为家族ID）
	for 家族ID in 家族列表.keys():
		var 详情: Dictionary = 获取家族完整详情(家族ID)
		if not 详情.is_empty():
			家族详情列表.append(详情)
	# 按实力评分排序
	家族详情列表.sort_custom(func(a, b): return a.get("实力评分", {}).get("总分", 0) > b.get("实力评分", {}).get("总分", 0))
	return {
		"家族总数": 家族详情列表.size(),
		"家族排行榜": 家族详情列表,
		"资源点": Game._获取所有资源点状态(),
		"说明": "家族系统完整数据，UI可直接调用构建家族详情页/排行榜/资源点争夺"
	}

## 获取所有资源点状态

func AI外交自动执行(家族ID: String) -> Dictionary:
	if 家族ID == "" or not 家族列表.has(家族ID):
		return {"成功": false, "因": "家族不存在"}
	var 家族: Dictionary = 家族列表[家族ID]
	var 策略: Dictionary = 获取家族策略(家族ID)
	var 外交策略: String = str(策略.get("外交策略", "友好"))
	var 执行记录: Array = []
	if 外交策略 == "孤立":
		return {"成功": true, "执行记录": ["孤立策略，不执行外交"]}
	var 结盟权重: float = float(_家族策略配置["外交策略"][外交策略].get("结盟权重", 0.5))
	var 联姻权重: float = float(_家族策略配置["外交策略"][外交策略].get("联姻权重", 0.4))
	if randf() < 结盟权重:
		var 其他家族列表: Array = []
		for 其他ID in 家族列表.keys():
			if 其他ID != 家族ID and not 家族.get("联盟家族", []).has(其他ID) and not 家族.get("敌对家族", []).has(其他ID):
				其他家族列表.append(其他ID)
		if not 其他家族列表.is_empty():
			var 目标ID: String = 其他家族列表[randi() % 其他家族列表.size()]
			var 联盟列表1: Array = 家族.get("联盟家族", [])
			联盟列表1.append(目标ID)
			家族["联盟家族"] = 联盟列表1
			var 目标家族: Dictionary = 家族列表[目标ID]
			var 联盟列表2: Array = 目标家族.get("联盟家族", [])
			联盟列表2.append(家族ID)
			目标家族["联盟家族"] = 联盟列表2
			家族列表[目标ID] = 目标家族
			执行记录.append("AI自动与「%s」结盟" % str(目标家族.get("名", "")))
	if randf() < 联姻权重:
		var 联盟家族列表: Array = 家族.get("联盟家族", [])
		if not 联盟家族列表.is_empty():
			var 目标ID: String = 联盟家族列表[randi() % 联盟家族列表.size()]
			var 已联姻: bool = false
			for 联姻 in 家族.get("联姻家族", []):
				if str(联姻.get("家族ID", "")) == 目标ID:
					已联姻 = true
					break
			if not 已联姻:
				var 联姻列表1: Array = 家族.get("联姻家族", [])
				联姻列表1.append({"家族ID": 目标ID, "联姻时间": Game.累计游戏日})
				家族["联姻家族"] = 联姻列表1
				var 目标家族: Dictionary = 家族列表[目标ID]
				var 联姻列表2: Array = 目标家族.get("联姻家族", [])
				联姻列表2.append({"家族ID": 家族ID, "联姻时间": Game.累计游戏日})
				目标家族["联姻家族"] = 联姻列表2
				家族列表[目标ID] = 目标家族
				执行记录.append("AI自动与「%s」联姻" % str(目标家族.get("名", "")))
	家族列表[家族ID] = 家族
	return {"成功": true, "执行记录": 执行记录}

