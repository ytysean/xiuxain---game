class_name AuctionSystem extends RefCounted

# ===== 拍卖行系统状态变量 =====
var 拍卖会: Dictionary = {}                # 通用拍卖会状态（常驻拍品/大拍/交付默认/竞拍记录）
var _拍卖配置缓存: Dictionary = {}         # config/auction_config.csv -> {param: value}（懒加载，不入存档）
var _拍卖AI缓存: Array = []                # config/auction_ai_config.csv 行（懒加载，不入存档）

func _init() -> void:
	_拍卖会补缺()

# ============ ECON-03 P0-D 双币结算（数据侧 · 只加不改）============
# 拍品「底价仙玉」是**派生值**，每次读取按当日汇率现算，**绝不落盘**：
# 汇率逐日浮动，落盘会把「当日报价」写死进存档 ⇒ 跨日读档出现「显示价 ≠ 实扣价」。
func 拍品底价仙玉(lot: Dictionary) -> int:
	if lot.is_empty():
		return 0
	var 灵石价: int = int(lot.get("起拍价", lot.get("底价", 0)))
	return Game.灵石折仙玉(灵石价)

# 混场比价：统一折算为「灵石等价」后比较（灵石×1 / 仙玉×R）。
# ★ 此处用**原始汇率 R**、不加仙玉结算溢价 —— 溢价只作用于「实付额」；
#   若比价也乘溢价，等于把仙玉出价的竞争力重复打折，与「分池冻结」口径冲突。
func 出价灵石等价(出价: int, 货币: String) -> int:
	if 出价 <= 0:
		return 0
	if 货币 == "仙玉":
		return int(round(float(出价) * Game.当前汇率()))
	return 出价

func _读拍卖配置表() -> Dictionary:
	if not _拍卖配置缓存.is_empty():
		return _拍卖配置缓存
	var d: Dictionary = {}
	var rows: Array = Game._CSV去BOM("res://config/auction_config.csv")
	for r in rows:
		var p: String = str(r.get("param", "")).strip_edges()
		if p == "":
			continue
		d[p] = r.get("value", "")
	_拍卖配置缓存 = d
	return d

func _拍卖配置浮(param: String, 默认: float) -> float:
	var v = _读拍卖配置表().get(param, "")
	if v == "" or not (v is String):
		return 默认
	var f: float = float(v)
	if f == 0.0 and str(v) != "0":
		return 默认
	return f

func _读拍卖AI表() -> Array:
	if not _拍卖AI缓存.is_empty():
		return _拍卖AI缓存
	_拍卖AI缓存 = Game._CSV去BOM("res://config/auction_ai_config.csv")
	return _拍卖AI缓存

# ===================== S34-P0 拍卖行声望与等级系统 =====================
# 5级等级体系：普通客人(0)→熟客(500)→贵宾(2000)→黑金贵宾(8000)→至尊贵宾(30000)
# 权益：佣金递减(5%→3%)、上架数量递增、赊账额度、优先看货等

## 根据声望计算当前等级（1-5）
func _拍卖当前等级() -> int:
	var 声望: int = int(拍卖会.get("声望", 0))
	if 声望 >= 30000:
		return 5
	elif 声望 >= 8000:
		return 4
	elif 声望 >= 2000:
		return 3
	elif 声望 >= 500:
		return 2
	else:
		return 1

## 根据等级计算佣金率（Lv1=5%, Lv2=4.5%, Lv3=4%, Lv4=3.5%, Lv5=3%）
func _拍卖当前佣金率() -> float:
	var 等级: int = _拍卖当前等级()
	match 等级:
		1: return 0.05
		2: return 0.045
		3: return 0.04
		4: return 0.035
		5: return 0.03
	return 0.05

## 增加拍卖行声望并自动升级（大拍期间声望×2）
func _拍卖增加声望(金额: int) -> void:
	var 增加: int = max(1, int(float(金额) * 0.01))
	# 大拍期间声望获取×2
	if 拍卖会.get("大拍激活", false):
		增加 *= 2
	var 旧声望: int = int(拍卖会.get("声望", 0))
	var 新声望: int = 旧声望 + 增加
	拍卖会["声望"] = 新声望
	# 检查是否升级
	var 旧等级: int = int(拍卖会.get("等级", 1))
	var 新等级: int = _拍卖当前等级()
	if 新等级 > 旧等级:
		拍卖会["等级"] = 新等级
		Game.添加纪事("拍卖", "升级", "拍卖行声望日隆，贵宾品级荣升至「%s」，可享更多专属权益与优待！" % _拍卖等级名称(新等级), 2)

## 等级名称（用于UI展示和纪事）
func _拍卖等级名称(等级: int) -> String:
	match 等级:
		1: return "普通客人"
		2: return "熟客"
		3: return "贵宾"
		4: return "黑金贵宾"
		5: return "至尊贵宾"
	return "普通客人"

func _新拍卖会() -> Dictionary:
	return {
		"常驻拍品": [],
		"常驻上次刷新日": -999,
		"大拍激活": false,
		"大拍拍品": [],
		"大拍结束日": 0,
		"上次大拍日": -999,
		"当前拍卖类型": "",  # S53：月拍/季拍/年拍
		"上次提醒日": -999,  # S53：上次提醒日期，避免重复提醒
		"默认交付": {"类型": "库房"},
		"竞拍记录": [],
		# S34-P0 新增字段
		"声望": 0,
		"等级": 1,
		"委托列表": [],
		"结算通知": [],
		"连续未竞得天": 0,
	}

func _拍卖会补缺() -> void:
	if not (拍卖会 is Dictionary):
		拍卖会 = _新拍卖会()
		return
	var _默认: Dictionary = _新拍卖会()
	for k in _默认.keys():
		if not 拍卖会.has(k):
			拍卖会[k] = _默认[k]

func _拍卖品阶基准(品阶: String) -> int:
	return int(Game.拍卖品阶基准价.get(品阶, 60))

func _基准估值(it) -> int:
	var 品阶: String = ""
	var 战力: int = 0
	if it is Item:
		品阶 = it.品阶
		战力 = it.战力加成
	else:
		品阶 = str(it.get("品阶", "凡阶"))
		战力 = int(it.get("战力加成", 0))
	var 基: int = _拍卖品阶基准(品阶)
	var 估: int = int(float(基) * (1.0 + float(战力) / 2000.0))
	return max(估, 10)

func _造拍卖物品(目标品阶集: Array) -> Item:
	# 修真世界观：拍卖会有概率出现特殊炼器材料和高阶炼丹材料
	var 特殊材料池: Array = [
		{"名": "灵木", "类": "ling_cai", "阶": "灵阶", "价": 50},
		{"名": "灵蚕丝", "类": "ling_cai", "阶": "灵阶", "价": 80},
		{"名": "灵禽羽", "类": "ling_cai", "阶": "灵阶", "价": 60},
		{"名": "灵马尾", "类": "ling_cai", "阶": "灵阶", "价": 70},
		{"名": "玉石", "类": "ling_cai", "阶": "宝阶", "价": 100},
		{"名": "庚金", "类": "ling_cai", "阶": "宝阶", "价": 150},
		{"名": "紫晶", "类": "ling_cai", "阶": "宝阶", "价": 120},
		{"名": "星辰铁", "类": "ling_cai", "阶": "王阶", "价": 300},
		{"名": "太阳精金", "类": "ling_cai", "阶": "王阶", "价": 400},
		{"名": "太阴玄冰", "类": "ling_cai", "阶": "圣阶", "价": 800},
		{"名": "九天陨铁", "类": "ling_cai", "阶": "圣阶", "价": 1000},
		{"名": "混沌石", "类": "ling_cai", "阶": "仙阶", "价": 2000},
		{"名": "鸿蒙紫气", "类": "ling_cai", "阶": "仙阶", "价": 3000},
		{"名": "天道神金", "类": "ling_cai", "阶": "道阶", "价": 5000},
		{"名": "圣品灵草", "类": "ling_cai", "阶": "圣阶", "价": 1500},
		{"名": "仙品灵草", "类": "ling_cai", "阶": "仙阶", "价": 4000},
	]
	# 灵钓功法秘籍池（拍卖行有概率出现）
	var 灵钓功法池: Array = [
		{"id": "taigong_diaoyu", "名": "太公钓鱼诀", "阶": "凡阶", "价": 200},
		{"id": "shuijing_guanyu", "名": "水镜观鱼术", "阶": "灵阶", "价": 500},
		{"id": "chuidiao_xinjing", "名": "垂钓心经", "阶": "灵阶", "价": 600},
		{"id": "longli_yinling", "名": "龙鲤引灵诀", "阶": "宝阶", "价": 1200},
		{"id": "yuqiao_wenda", "名": "渔樵问答", "阶": "宝阶", "价": 1500},
		{"id": "beiming_kuntun", "名": "北冥鲲吞功", "阶": "王阶", "价": 3000},
		{"id": "jiaoren_qizhu", "名": "鲛人泣珠咒", "阶": "圣阶", "价": 6000},
		{"id": "dinghai_shenzhen", "名": "定海神针诀", "阶": "仙阶", "价": 12000},
	]
	var 是大拍: bool = 目标品阶集.has("圣阶") or 目标品阶集.has("仙阶")
	# 10%概率生成灵钓功法秘籍（大拍15%）
	var 功法概率: float = 0.15 if 是大拍 else 0.10
	if randf() < 功法概率:
		var 可用功法: Array = []
		for g in 灵钓功法池:
			if 目标品阶集.has(g["阶"]):
				可用功法.append(g)
		if 可用功法.size() > 0:
			var 选: Dictionary = 可用功法[randi() % 可用功法.size()]
			var it: Item = Item.new()
			it.名称 = 选["名"] + "（功法秘籍）"
			it.类别 = "gongfa_book"
			it.品阶 = 选["阶"]
			it.描述 = "前人遗著，修习后可习得《%s》，灵钓之道精进。" % 选["名"]
			it.功效 = "灵钓功法：" + 选["id"]
			it.算战力()
			return it
	# 20%概率生成特殊材料（大拍30%）
	var 特殊概率: float = 0.3 if 是大拍 else 0.2
	if randf() < 特殊概率:
		# 按目标品阶集筛选可用的特殊材料
		var 可用: Array = []
		for m in 特殊材料池:
			if 目标品阶集.has(m["阶"]):
				可用.append(m)
		if 可用.size() > 0:
			var 选: Dictionary = 可用[randi() % 可用.size()]
			var it: Item = Item.new()
			it.名称 = 选["名"]
			it.类别 = 选["类"]
			it.品阶 = 选["阶"]
			it.算战力()
			return it
	# 正常生成
	var it: Item = Item.new()
	var 尝试: int = 0
	while not 目标品阶集.has(it.品阶) and 尝试 < 12:
		it.随机生成()
		尝试 += 1
	if not 目标品阶集.has(it.品阶):
		it.品阶 = 目标品阶集[0]
		it.滚词缀()
		it.滚极品()
		it.祭炼上限 = {"凡阶":5,"灵阶":6,"宝阶":7,"王阶":8,"圣阶":9,"仙阶":10,"道阶":10}.get(it.品阶, 5)
		it.算战力()
	return it

func _生成单个拍品_S34(场次: String) -> Dictionary:
	var 配置 := _读拍卖配置表()
	var 大拍: bool = (场次 in ["大拍", "月拍", "季拍", "年拍"])
	var 目标集: Array = ["凡阶", "灵阶", "宝阶", "王阶"] if not 大拍 else ["宝阶", "王阶", "圣阶", "仙阶"]
	var it: Item = _造拍卖物品(目标集)
	var 基准: int = _基准估值(it)
	if 大拍:
		基准 = int(float(基准) * _拍卖配置浮("大拍基准倍率", 1.6))
	# S53：按拍卖类型区分起拍价和保留价
	var 起拍下限: float = 0.5
	var 起拍上限: float = 0.8
	var 流拍系数: float = 0.4
	match 场次:
		"常驻":
			起拍下限 = 0.5
			起拍上限 = 0.8
			流拍系数 = 0.4
		"月拍":
			起拍下限 = 0.6
			起拍上限 = 0.9
			流拍系数 = 0.5
		"季拍":
			起拍下限 = 0.7
			起拍上限 = 1.0
			流拍系数 = 0.6
		"年拍":
			起拍下限 = 0.8
			起拍上限 = 1.2
			流拍系数 = 0.7
		_:
			起拍下限 = 0.6
			起拍上限 = 1.0
			流拍系数 = 0.5
	var 起拍价: int = max(10, int(float(基准) * randf_range(起拍下限, 起拍上限)))
	var 保留价: int = max(10, int(float(基准) * 流拍系数))
	var ai表: Array = _读拍卖AI表()
	var ai数: int = int(_拍卖配置浮("AI数量", 3))
	var ai估值下限: float = _拍卖配置浮("AI估值系数下限", 0.8)
	var ai估值上限: float = _拍卖配置浮("AI估值系数上限", 2.0)
	var ai_list: Array = []
	for i in range(min(ai数, ai表.size())):
		var a: Dictionary = ai表[i]
		var vm: float = float(a.get("valuation_mod", 1.0))
		var bm: float = float(a.get("budget_mod", 1.0))
		var 估值: int = max(10, int(float(基准) * vm * randf_range(ai估值下限, ai估值上限)))
		var 预算: int = max(10, int(float(基准) * bm))
		var 台词池: Array = str(a.get("lines", "")).split("|")
		ai_list.append({"名": str(a.get("display_name", "神秘买家")), "类型": str(a.get("ai_type", "散修")), "估值": 估值, "预算": 预算, "已出": 0, "台词池": 台词池})
	var 时长: int = int(_拍卖配置浮("常驻时长日", 5)) if not 大拍 else int(_拍卖配置浮("大拍时长日", 7))
	# S34-P0：品类映射（Item类别→展示品类），为P1/P2扩展功法/符箓/灵兽/阵法/奇物做准备
	var 品类映射: Dictionary = {"dan_yao": "丹药", "ling_cai": "灵材", "fa_qi": "装备", "shen_bing": "装备", "fabao": "装备"}
	var 品类: String = 品类映射.get(it.类别, "装备")
	# S53：鉴宝玩法 - 10%概率生成未知宝物
	var 未知宝物: bool = false
	if randf() < 0.1 and 大拍:
		未知宝物 = true
	var lot: Dictionary = {
		"id": "lot_%d_%d" % [Game.累计游戏日, randi() % 100000],
		"物品": it.to_dict(),
		"类别": it.类别,
		"品阶": it.品阶,
		"名称": it.名称,
		"基准估值": 基准,
		"起拍价": 起拍价,
		"保留价": 保留价,
		"当前价": 起拍价,
		"最高出价者": "",
		"状态": "竞拍中",
		"场次": 场次,
		"结束日": Game.累计游戏日 + 时长,
		"AI列表": ai_list,
		"竞价台词": [],
		"交付目标": {"类型": "库房"},
		"溢价": 0.0,
		# S34-P0 新增字段
		"品类": 品类,
		"寄售者类型": "商会",
		"寄售者ID": "",
		"委托列表": [],
		"延时结束日": 0,
		# S53：鉴宝玩法
		"未知宝物": 未知宝物,
		"已鉴定": false,
		"鉴定结果": "",
		"真实倍率": 1.0,
		"流拍次数": 0,
	}
	return lot

func _生成常驻拍品_S34() -> void:
	var n: int = int(_拍卖配置浮("常驻拍品数", 6))
	var 新: Array = []
	for i in range(n):
		新.append(_生成单个拍品_S34("常驻"))
	拍卖会["常驻拍品"] = 新
	拍卖会["常驻上次刷新日"] = Game.累计游戏日

func _生成大拍拍品_S34(拍卖类型: String = "大拍") -> void:
	var n: int = int(_拍卖配置浮("大拍拍品数", 8))
	if 拍卖类型 == "年拍":
		n = 12  # 年拍拍品更多
	var 新: Array = []
	for i in range(n):
		新.append(_生成单个拍品_S34(拍卖类型))
	拍卖会["大拍拍品"] = 新
	拍卖会["大拍激活"] = true
	拍卖会["当前拍卖类型"] = 拍卖类型
	var 时长: int = 7  # 默认7游戏日
	if 拍卖类型 == "月拍":
		时长 = 7
	elif 拍卖类型 == "季拍":
		时长 = 14
	elif 拍卖类型 == "年拍":
		时长 = 21
	拍卖会["大拍结束日"] = Game.累计游戏日 + 时长
	拍卖会["上次大拍日"] = Game.累计游戏日
	var 类型名: String = {"月拍": "月度拍卖", "季拍": "季度大典", "年拍": "年度盛典"}.get(拍卖类型, "拍卖盛会")
	Game.添加纪事("拍卖", 类型名, "聚宝阁%s隆重开启！诸多稀世之宝现身坊间，霞光万道，瑞气千条，各方修士云集竞逐，盛况空前。" % 类型名, 2)
	# S53 P2：大典开幕仪式
	_大拍开幕仪式_S53(拍卖类型)

func _推进拍卖会_S34(天: int) -> void:
	if 拍卖会.is_empty():
		_拍卖会补缺()
	# S34-P0：常驻拍卖行改为持续开放模式——保持配置数量在拍，单件到期即补充，取消批量刷新
	var 目标数: int = int(_拍卖配置浮("常驻拍品数", 8))
	# S53：固定时间拍卖机制（月拍/季拍/年拍）
	if not 拍卖会.get("大拍激活", false):
		var 当前日: int = int(Game.累计游戏日)
		var 年内日: int = 当前日 % 360
		var 月内日: int = 当前日 % 30
		# 年拍：每年1月1日（游戏日0, 360, 720...）
		if 年内日 == 0 and 当前日 > 0:
			_生成大拍拍品_S34("年拍")
		# 季拍：每季首月1日（游戏日0, 90, 180, 270...）
		elif 年内日 in [0, 90, 180, 270] and 当前日 > 0:
			_生成大拍拍品_S34("季拍")
		# 月拍：每月1日（游戏日0, 30, 60, 90...）
		elif 月内日 == 0 and 当前日 > 0:
			_生成大拍拍品_S34("月拍")
	# 结算到期常驻拍品，并保留仍在竞拍的
	var 常驻2: Array = []
	for lot in (拍卖会.get("常驻拍品", []) as Array):
		if lot.get("状态", "") == "竞拍中" and int(lot.get("结束日", 0)) <= Game.累计游戏日:
			_结算单个拍品_S34(lot)
		if lot.get("状态", "") == "竞拍中":
			常驻2.append(lot)
	拍卖会["常驻拍品"] = 常驻2
	# S34-P0：单件到期即补充——不足目标数量时立即补充新拍品，持续开放不空窗
	while (拍卖会.get("常驻拍品", []) as Array).size() < 目标数:
		(拍卖会["常驻拍品"] as Array).append(_生成单个拍品_S34("常驻"))
	# S34-P0：连续未竞得天数累计（保底机制用）
	if 拍卖会.get("连续未竞得天", 0) >= 0:
		拍卖会["连续未竞得天"] = int(拍卖会.get("连续未竞得天", 0)) + 天
	# 大拍结算
	if 拍卖会.get("大拍激活", false):
		var 大2: Array = []
		for lot in (拍卖会.get("大拍拍品", []) as Array):
			if lot.get("状态", "") == "竞拍中" and int(lot.get("结束日", 0)) <= Game.累计游戏日:
				_结算单个拍品_S34(lot)
				_代拍结算_S53(lot)  # S53：代拍结算
			if lot.get("状态", "") == "竞拍中":
				大2.append(lot)
		拍卖会["大拍拍品"] = 大2
		# S53：副宗主代拍竞价（大拍期间每3游戏日竞价一次）
		if int(Game.累计游戏日) % 3 == 0:
			_副宗主代拍竞价_S53()
		if (拍卖会.get("大拍拍品", []) as Array).size() == 0:
			拍卖会["大拍激活"] = false
			拍卖会["当前拍卖类型"] = ""
	# S53：开拍提醒检查
	_检查拍卖提醒_S53()
	# S53 P2：消息散布系统（NPC传闻）
	_散布拍卖传闻_S53()

# ===== S53 开拍提醒系统 =====
func _检查拍卖提醒_S53() -> void:
	if 拍卖会.get("大拍激活", false):
		return  # 大拍进行中不提醒
	var 当前日: int = int(Game.累计游戏日)
	var 上次提醒: int = int(拍卖会.get("上次提醒日", -999))
	if 当前日 - 上次提醒 < 7:
		return  # 7游戏日内不重复提醒
	# 计算下一次拍卖时间
	var 年内日: int = 当前日 % 360
	var 下次拍卖日: int = 0
	var 下次拍卖类型: String = ""
	# 年拍：每年1月1日
	if 年内日 < 360:
		下次拍卖日 = 当前日 + (360 - 年内日)
		下次拍卖类型 = "年拍"
	# 季拍：每季首月1日
	var 季内日: int = 年内日 % 90
	if 季内日 < 90:
		var 季拍日: int = 当前日 + (90 - 季内日)
		if 季拍日 < 下次拍卖日:
			下次拍卖日 = 季拍日
			下次拍卖类型 = "季拍"
	# 月拍：每月1日
	var 月内日: int = 当前日 % 30
	if 月内日 < 30:
		var 月拍日: int = 当前日 + (30 - 月内日)
		if 月拍日 < 下次拍卖日:
			下次拍卖日 = 月拍日
			下次拍卖类型 = "月拍"
	# 距离下次拍卖7游戏日内提醒
	var 距离: int = 下次拍卖日 - 当前日
	if 距离 <= 7 and 距离 > 0:
		var 类型名: String = {"月拍": "月度拍卖", "季拍": "季度大典", "年拍": "年度盛典"}.get(下次拍卖类型, "拍卖")
		var 提醒文案: String = "聚宝阁%s将于%d日后开幕，本次将有稀世之宝现世，宗主可提前准备灵石或设置代拍方略。" % [类型名, 距离]
		Game.添加纪事("拍卖", "拍卖预告", 提醒文案, 1)
		拍卖会["上次提醒日"] = 当前日
		# UI红点提示（如果有UIHint）
		# 注：UIHint 并非 game_state 的固定属性，直接访问会触发 Invalid access。
		#     改为先判属性存在再取用，未挂载时静默跳过提示（不影响拍卖开幕逻辑）。
		if Game != null and "UIHint" in Game and Game.UIHint != null:
			Game.UIHint.show_hint("聚宝阁%s将于%d日后开幕！" % [类型名, 距离])

# 获取下一次拍卖信息（UI用）
func 获取下次拍卖信息_S53() -> Dictionary:
	var 当前日: int = int(Game.累计游戏日)
	var 年内日: int = 当前日 % 360
	var 下次拍卖日: int = 当前日 + 360
	var 下次拍卖类型: String = "年拍"
	# 季拍
	var 季内日: int = 年内日 % 90
	var 季拍日: int = 当前日 + (90 - 季内日)
	if 季拍日 < 下次拍卖日:
		下次拍卖日 = 季拍日
		下次拍卖类型 = "季拍"
	# 月拍
	var 月内日: int = 当前日 % 30
	var 月拍日: int = 当前日 + (30 - 月内日)
	if 月拍日 < 下次拍卖日:
		下次拍卖日 = 月拍日
		下次拍卖类型 = "月拍"
	var 类型名: String = {"月拍": "月度拍卖", "季拍": "季度大典", "年拍": "年度盛典"}.get(下次拍卖类型, "拍卖")
	return {
		"类型": 下次拍卖类型,
		"类型名": 类型名,
		"日期": 下次拍卖日,
		"距离": 下次拍卖日 - 当前日,
		"大拍进行中": 拍卖会.get("大拍激活", false),
		"当前拍卖类型": 拍卖会.get("当前拍卖类型", ""),
	}

# ===== S53 P2：消息散布系统（NPC传闻）=====
# 大拍前7日开始散布消息，吸引更多修士参与
var _传闻已散布: Dictionary = {}  # 已散布的传闻记录，避免重复

func _散布拍卖传闻_S53() -> void:
	var 信息: Dictionary = 获取下次拍卖信息_S53()
	if 信息.get("大拍进行中", false):
		return
	var 距离: int = int(信息.get("距离", 999))
	if 距离 > 7:
		return  # 7日内才散布
	var 类型: String = str(信息.get("类型", ""))
	var 关键: String = 类型 + "_" + str(信息.get("日期", 0))
	if _传闻已散布.has(关键):
		return  # 已散布过
	_传闻已散布[关键] = true
	# 根据拍卖类型生成不同传闻
	var 传闻列表: Array = []
	match 类型:
		"年拍":
			传闻列表 = [
				"听说了吗？聚宝阁年度盛典将至，据说有上古遗物现世！",
				"我表舅的侄子的道侣在聚宝阁当差，听说这次年拍有仙阶法宝！",
				"年度盛典啊，那可是修真界一大盛事，各方大佬都会到场。",
				"据说这次年拍的压轴之物，能助人突破化神瓶颈！",
			]
		"季拍":
			传闻列表 = [
				"聚宝阁季度大典快到了，这次有不少好东西。",
				"听说季度大典有王阶丹药，能省百年苦修。",
				"季度大典的拍品品质不错，手头宽裕的可以去看看。",
			]
		"月拍":
			传闻列表 = [
				"月度拍卖快开始了，有需要的可以去淘淘。",
				"这次月拍据说有几件灵阶法宝，性价比不错。",
			]
		_:
			传闻列表 = ["聚宝阁有拍卖，诸位道友可前往一观。"]
	# 随机选择一条传闻
	var 传闻: String = 传闻列表[randi() % 传闻列表.size()]
	Game.添加纪事("传闻", "坊市传闻", 传闻, 1)
	# 增加拍卖热度（影响NPC竞价活跃度）
	拍卖会["拍卖热度"] = int(拍卖会.get("拍卖热度", 0)) + 1

# ===== S53 P2：预热期竞价加成 =====
# 大拍前3日为预热期，NPC竞价活跃度+50%，成交价基准+20%
func _获取预热加成_S53() -> float:
	var 信息: Dictionary = 获取下次拍卖信息_S53()
	if 信息.get("大拍进行中", false):
		# 大拍进行中，根据拍卖类型给加成
		var 当前类型: String = str(信息.get("当前拍卖类型", ""))
		match 当前类型:
			"年拍": return 1.5  # 年拍NPC最活跃
			"季拍": return 1.3
			"月拍": return 1.1
			_: return 1.0
	var 距离: int = int(信息.get("距离", 999))
	if 距离 <= 3:
		return 1.2  # 预热期加成20%
	return 1.0

