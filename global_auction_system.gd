# 发起担保交易
func 发起担保交易(物品: Item, 价格: int, 买家: String) -> Dictionary:
	if 价格 <= 0:
		return {"成功": false, "原因": "价格必须大于0"}
	# 检查物品是否在库房
	var 找到: bool = false
	var 索引: int = -1
	for i in range(Game.宗门库房.size()):
		var it: Item = Game.宗门库房[i]
		if it == 物品:
			找到 = true
			索引 = i
			break
	if not 找到:
		return {"成功": false, "原因": "物品不在库房"}
	# 检查物品是否可交易
	if not 物品.是否可交易():
		return {"成功": false, "原因": "物品已认主，无法交易"}
	# 从库房移除
	Game.宗门库房.remove_at(索引)
	# 创建担保交易
	var 交易: Dictionary = {
		"id": "guar_%d_%d" % [Game.累计游戏日, randi() % 100000],
		"物品": 物品.to_dict(),
		"物品名": 物品.名称,
		"价格": 价格,
		"买家": 买家,
		"卖家": "玩家(宗主)",
		"状态": "担保中",
		"发起日": Game.累计游戏日,
		"担保费": int(float(价格) * 0.05),  # 5%担保费
	}
	(全服拍卖["担保交易列表"] as Array).append(交易)
	Game.添加纪事("全服拍卖", "发起担保交易", "宗主发起担保交易：「%s」价格%d灵石，买家%s。" % [物品.名称, 价格, 买家], 1)
	return {"成功": true, "原因": "担保交易发起成功", "交易ID": 交易.get("id", "")}

# 确认担保交易（买家确认）
func 确认担保交易(交易ID: String) -> Dictionary:
	for t in 全服拍卖.get("担保交易列表", []):
		if str(t.get("id", "")) == 交易ID and str(t.get("状态", "")) == "担保中":
			# 模拟买家确认（AI买家）
			t["状态"] = "已完成"
			var 价格: int = int(t.get("价格", 0))
			var 担保费: int = int(t.get("担保费", 0))
			var 实得: int = 价格 - 担保费
			Game.灵石 += 实得
			Game.添加纪事("全服拍卖", "担保交易完成", "担保交易完成：「%s」成交价%d灵石，扣除担保费%d，实得%d灵石。" % [str(t.get("物品名", "")), 价格, 担保费, 实得], 2)
			return {"成功": true, "原因": "交易完成", "实得": 实得}
	return {"成功": false, "原因": "交易不存在或已完成"}

# 取消担保交易
func 取消担保交易(交易ID: String) -> Dictionary:
	for i in range(全服拍卖.get("担保交易列表", []).size()):
		var t: Dictionary = 全服拍卖["担保交易列表"][i]
		if str(t.get("id", "")) == 交易ID and str(t.get("状态", "")) == "担保中":
			# 返还物品
			var it_dict: Dictionary = t.get("物品", {})
			var it: Item = Item.new()
			it.from_dict(it_dict)
			Game.宗门库房.append(it)
			t["状态"] = "已取消"
			Game.添加纪事("全服拍卖", "取消担保交易", "宗主取消担保交易：「%s」，物品已返还。" % str(t.get("物品名", "")), 1)
			return {"成功": true, "原因": "交易已取消，物品返还"}
	return {"成功": false, "原因": "交易不存在或已完成"}

