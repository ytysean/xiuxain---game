var 当前皮肤: String = ""        # 当前装备的皮肤ID（""=无皮肤，使用基础立绘）
var 已拥有皮肤: Array = []       # 已拥有的皮肤ID列表
const 皮肤路径前缀: String = "res://art/characters/disciples/skins/"  # 皮肤立绘目录前缀

# 千人千面：扫描depth目录，自动发现所有可用立绘类型（必须同时有男/女 stand图才算可用）
# 未来新增立绘类型只需往depth目录放图，代码零改动自动纳入随机池
static func 扫描可用立绘类型() -> Array:
	if _已扫描:
		return _扫描可用类型缓存
	_已扫描 = true
	var 可用: Array = []
	var dir := DirAccess.open("res://art/characters/disciples/弟子立绘/depth/")
	if dir == null:
		# fallback：用硬编码列表
		_扫描可用类型缓存 = 立绘类型列表.duplicate()
		return _扫描可用类型缓存
	dir.list_dir_begin()
	var 文件名: String = dir.get_next()
	var 发现类型: Dictionary = {}
	while 文件名 != "":
		if 文件名.begins_with("depth_") and 文件名.ends_with("_stand.png") and not 文件名.contains(".import"):
			# 解析：depth_{类型}_{性别}_stand.png
			var 部分: Array = 文件名.trim_prefix("depth_").trim_suffix("_stand.png").split("_")
			if 部分.size() >= 2:
				var 类型: String = 部分[0]
				var 性别: String = 部分[1]
				if not 发现类型.has(类型):
					发现类型[类型] = {"男": false, "女": false}
				if 性别 == "男" or 性别 == "女":
					发现类型[类型][性别] = true
		文件名 = dir.get_next()
	dir.list_dir_end()
	# 只保留同时有男/女 stand图的类型
	for 类型 in 发现类型.keys():
		if 发现类型[类型]["男"] and 发现类型[类型]["女"]:
			可用.append(类型)
	if 可用.is_empty():
		可用 = 立绘类型列表.duplicate()
	_扫描可用类型缓存 = 可用
	return _扫描可用类型缓存

func _init():
	随机生成()
	# WAVE-B #2：分配稳定唯一ID（_init 在 创建 与 from_dict 前均会执行；from_dict 会按需覆盖为存档ID）
	弟子ID = 下一弟子ID
	下一弟子ID += 1

# ============ §6.16 血脉共鸣系统（P0实现）============
# 血脉关系识别：判断两个弟子是否有血缘关系（父子/母子/兄弟/姐妹/祖孙）
# 遵守§6.16数值红线：血脉类单源子帽≤1.5%（全局等效）

## 判断是否与指定弟子有血缘关系
func 是否有血缘关系(其他弟子ID: int) -> bool:
	if 其他弟子ID < 0 or 其他弟子ID == 弟子ID:
		return false
	# 父子/母子关系：对方是我的父母，或我是对方的父母
	if 其他弟子ID in 父母ID:
		return true
	if 其他弟子ID in 子嗣列表:
		return true
	# 兄弟姐妹关系：有共同的父母
	if Game != null and Game.has_method("_取弟子"):
		var 其他: Object = Game._取弟子(其他弟子ID)
		if 其他 != null and 其他 is Disciple:
			# 检查是否有共同的父母
			for pid in 父母ID:
				if pid in 其他.父母ID and pid >= 0:
					return true
			# 祖孙关系：对方是我的祖父母，或我是对方的祖父母
			for pid in 父母ID:
				var 父: Object = Game._取弟子(pid)
				if 父 != null and 父 is Disciple:
					if 其他弟子ID in 父.父母ID:
						return true  # 对方是我的祖父母
					if 弟子ID in 父.子嗣列表 and 其他弟子ID in 父.子嗣列表:
						return true  # 对方是我的兄弟姐妹（通过父亲的子嗣列表）
	return false

## 获取血缘关系类型描述
func 获取血缘关系类型(其他弟子ID: int) -> String:
	if 其他弟子ID < 0 or 其他弟子ID == 弟子ID:
		return ""
	if 其他弟子ID in 父母ID:
		return "父母"
	if 其他弟子ID in 子嗣列表:
		return "子女"
	if Game != null and Game.has_method("_取弟子"):
		var 其他: Object = Game._取弟子(其他弟子ID)
		if 其他 != null and 其他 is Disciple:
			for pid in 父母ID:
				if pid in 其他.父母ID and pid >= 0:
					return "兄弟姐妹"
			for pid in 父母ID:
				var 父: Object = Game._取弟子(pid)
				if 父 != null and 父 is Disciple:
					if 其他弟子ID in 父.父母ID:
						return "祖孙"
	return "远亲"

## 获取所有有血缘关系的弟子ID列表
func 获取血脉关系列表() -> Array:
	var 列表: Array = []
	if Game == null or not Game.has_method("弟子列表"):
		return 列表
	for d in Game.弟子列表:
		if d != null and d is Disciple and d.弟子ID != 弟子ID:
			if 是否有血缘关系(d.弟子ID):
				列表.append({"id": d.弟子ID, "名": d.姓名, "关系": 获取血缘关系类型(d.弟子ID)})
	return 列表

## 获取在宗的有血缘关系弟子数量（用于计算血脉共鸣加成）
func 获取在宗血脉亲属数() -> int:
	var 数: int = 0
	if Game == null or not Game.has_method("弟子列表"):
		return 数
	for d in Game.弟子列表:
		if d != null and d is Disciple and d.弟子ID != 弟子ID:
			if d.状态 == "在宗" and 是否有血缘关系(d.弟子ID):
				数 += 1
	return 数

