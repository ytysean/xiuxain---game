## 记录违纪事件（带累计惩罚机制）
static func 记录违纪(弟子, 类型: String, 执法堂等级: int) -> Dictionary:
	if 弟子 == null:
		return {"成功": false, "原因": "弟子不存在"}
	var 违纪信息 = 违纪类型.get(类型, {})
	if 违纪信息.is_empty():
		return {"成功": false, "原因": "未知违纪类型"}
	# 执法堂等级影响惩罚力度
	var 等级系数: float = 1.0 + float(max(0, 执法堂等级 - 1)) * 0.1
	var 惩罚贡献 = int(float(违纪信息.get("惩罚贡献", 5)) * 等级系数)
	var 惩罚灵石 = int(float(违纪信息.get("惩罚灵石", 10)) * 等级系数)
	var 禁闭天数 = int(违纪信息.get("禁闭天数", 0))
	# 记录违纪次数
	if not "违纪记录" in 弟子:
		弟子["违纪记录"] = []
	if not "违纪次数" in 弟子:
		弟子["违纪次数"] = {}
	var 等级 = str(违纪信息.get("等级", "轻微"))
	弟子.违纪次数[等级] = int(弟子.违纪次数.get(等级, 0)) + 1
	# 累计惩罚机制
	var 累计次数 = int(弟子.违纪次数.get(等级, 0))
	var 等级上限 = int(违纪等级.get(等级, {}).get("累计上限", 5))
	var 惩罚升级 = ""
	if 累计次数 >= 等级上限:
		# 惩罚升级
		if 等级 == "轻微":
			惩罚升级 = "累计轻微违纪过多，升级为一般违纪处理"
			惩罚贡献 *= 2
			惩罚灵石 *= 2
		elif 等级 == "一般":
			惩罚升级 = "累计一般违纪过多，升级为严重违纪处理"
			惩罚贡献 *= 2
			惩罚灵石 *= 2
			禁闭天数 = max(禁闭天数, 5)
		elif 等级 == "严重":
			惩罚升级 = "累计严重违纪过多，升级为重大违纪处理"
			惩罚贡献 *= 2
			惩罚灵石 *= 2
			禁闭天数 = max(禁闭天数, 15)
		elif 等级 == "重大":
			惩罚升级 = "重大违纪，逐出师门"
	# 应用惩罚
	if Game != null:
		Game.贡献点 = max(0, Game.贡献点 - 惩罚贡献)
		Game.灵石 = max(0, Game.灵石 - 惩罚灵石)
		# 禁闭
		if 禁闭天数 > 0:
			弟子["禁闭到期日"] = Game.累计游戏日 + 禁闭天数
		# 记录到弟子履历
		if "履历" in 弟子 and 弟子.履历 != null:
			弟子.履历.append({"日": Game.累计游戏日, "事件": "违纪：%s" % 类型, "详情": "%s，扣除贡献%d、灵石%d、禁闭%d天" % [str(违纪信息.get("描述", "")), 惩罚贡献, 惩罚灵石, 禁闭天数]})
		# 记录到执法堂日志
		Game.执法日志.insert(0, {"日": Game.累计游戏日, "弟子": str(弟子.姓名), "类型": 类型, "等级": 等级, "惩罚贡献": 惩罚贡献, "惩罚灵石": 惩罚灵石, "禁闭天数": 禁闭天数})
		if Game.执法日志.size() > 100:
			Game.执法日志.resize(100)
	# 逐出师门
	if 违纪信息.get("逐出师门", false) or (等级 == "重大" and 累计次数 >= 等级上限):
		return {"成功": true, "原因": "%s因%s被执法堂记录，%s，建议逐出师门" % [str(弟子.姓名), 类型, 惩罚升级], "逐出师门": true}
	return {"成功": true, "原因": "%s因%s被执法堂记录，%s扣除贡献%d、灵石%d、禁闭%d天" % [str(弟子.姓名), 类型, 惩罚升级 + "，" if 惩罚升级 else "", 惩罚贡献, 惩罚灵石, 禁闭天数]}

## 弟子申诉
static func 申诉(弟子, 违纪索引: int, 申诉理由: String) -> Dictionary:
	if 弟子 == null:
		return {"成功": false, "原因": "弟子不存在"}
	if not "违纪记录" in 弟子 or 违纪索引 < 0 or 违纪索引 >= 弟子.违纪记录.size():
		return {"成功": false, "原因": "违纪记录不存在"}
	# 记录申诉
	if not "申诉记录" in 弟子:
		弟子["申诉记录"] = []
	弟子.申诉记录.append({"日": Game.累计游戏日 if Game != null else 0, "违纪索引": 违纪索引, "理由": 申诉理由, "状态": "待审核"})
	return {"成功": true, "原因": "申诉已提交，等待执法堂审核"}

## 审核申诉
static func 审核申诉(弟子, 申诉索引: int, 通过: bool) -> Dictionary:
	if 弟子 == null or not "申诉记录" in 弟子 or 申诉索引 < 0 or 申诉索引 >= 弟子.申诉记录.size():
		return {"成功": false, "原因": "申诉记录不存在"}
	var 申诉 = 弟子.申诉记录[申诉索引]
	if 通过:
		申诉["状态"] = "通过"
		# 撤销惩罚（简化：返还一半贡献和灵石）
		if Game != null:
			Game.贡献点 += int(申诉.get("惩罚贡献", 0) / 2)
			Game.灵石 += int(申诉.get("惩罚灵石", 0) / 2)
		return {"成功": true, "原因": "申诉通过，已撤销部分惩罚"}
	else:
		申诉["状态"] = "驳回"
		return {"成功": true, "原因": "申诉驳回，维持原惩罚"}

## 月度执法报告
static func 月度执法报告(执法堂等级: int) -> Dictionary:
	if Game == null or not "执法日志" in Game:
		return {"总违纪数": 0, "轻微": 0, "一般": 0, "严重": 0, "重大": 0, "报告": "本月无违纪记录"}
	var 日志 = Game.执法日志
	var 总违纪数 = 日志.size()
	var 轻微 = 0
	var 一般 = 0
	var 严重 = 0
	var 重大 = 0
	for 记录 in 日志:
		var 等级 = str(记录.get("等级", "轻微"))
		match 等级:
			"轻微": 轻微 += 1
			"一般": 一般 += 1
			"严重": 严重 += 1
			"重大": 重大 += 1
	# 执法堂等级影响贡献产出
	var 基础贡献 = 10 + max(0, 执法堂等级 - 1) * 5
	Game.贡献点 += 基础贡献
	var 报告 = "本月执法报告：共处理违纪%d起（轻微%d、一般%d、严重%d、重大%d），执法堂月度贡献+%d" % [总违纪数, 轻微, 一般, 严重, 重大, 基础贡献]
	return {"总违纪数": 总违纪数, "轻微": 轻微, "一般": 一般, "严重": 严重, "重大": 重大, "贡献": 基础贡献, "报告": 报告}

## 获取弟子违纪统计
static func 获取违纪统计(弟子) -> Dictionary:
	if 弟子 == null or not "违纪次数" in 弟子:
		return {"总次数": 0, "轻微": 0, "一般": 0, "严重": 0, "重大": 0}
	var 次数 = 弟子.违纪次数
	var 总次数 = 0
	for 等级 in 次数.keys():
		总次数 += int(次数[等级])
	return {"总次数": 总次数, "轻微": int(次数.get("轻微", 0)), "一般": int(次数.get("一般", 0)), "严重": int(次数.get("严重", 0)), "重大": int(次数.get("重大", 0))}

## 检查弟子是否在禁闭中
static func 检查禁闭(弟子) -> Dictionary:
	if 弟子 == null or not "禁闭到期日" in 弟子 or Game == null:
		return {"禁闭中": false, "剩余天数": 0}
	var 到期日 = int(弟子.get("禁闭到期日", 0))
	if Game.累计游戏日 < 到期日:
		return {"禁闭中": true, "剩余天数": 到期日 - Game.累计游戏日}
	return {"禁闭中": false, "剩余天数": 0}
