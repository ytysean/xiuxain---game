## 学习家族血脉功法（每个家族成员都能学习，家传绝学）
func 学习家族血脉功法(弟子: Disciple) -> Dictionary:
	if 弟子 == null or 弟子.家族ID == "":
		return {"成功": false, "因": "弟子无效或无家族"}
	var 家族: Dictionary = 获取家族(弟子.家族ID)
	if 家族.is_empty():
		return {"成功": false, "因": "家族不存在"}
	var 家族功法ID: String = "family_xuemai_%s" % 弟子.家族ID
	# 检查是否已学习
	if 家族功法ID in 弟子.血脉功法列表:
		return {"成功": false, "因": "已学习家族血脉功法"}
	# 检查家族是否有血脉功法（创建家族时自动生成）
	var 家族血脉功法: Dictionary = 家族.get("血脉功法", {})
	if 家族血脉功法.is_empty():
		return {"成功": false, "因": "家族尚未传承血脉功法"}
	弟子.血脉功法列表.append(家族功法ID)
	Game.添加纪事("家族", "学习家传功法", "%s 学习家族血脉功法「%s」" % [弟子.姓名, str(家族血脉功法.get("名", ""))], 1)
	return {"成功": true, "功法ID": 家族功法ID, "功法名": str(家族血脉功法.get("名", ""))}

## 学习神兽血脉功法（稀有，只有觉醒神兽血脉才能学习）
func 学习神兽血脉功法(弟子: Disciple, 功法ID: String) -> Dictionary:
	if 弟子 == null or 功法ID == "":
		return {"成功": false, "因": "弟子或功法ID为空"}
	if not _神兽血脉功法配置.has(功法ID):
		return {"成功": false, "因": "神兽血脉功法不存在"}
	var 功法: Dictionary = _神兽血脉功法配置[功法ID]
	var 血脉要求: String = str(功法.get("血脉要求", ""))
	# 检查血脉是否匹配
	if 弟子.血脉类型 != 血脉要求:
		return {"成功": false, "因": "血脉不匹配，此功法需要%s" % 血脉要求}
	# 检查是否已觉醒血脉
	if not 弟子.血脉觉醒:
		return {"成功": false, "因": "血脉未觉醒，无法学习神兽血脉功法"}
	# 检查是否已学习
	if 功法ID in 弟子.血脉功法列表:
		return {"成功": false, "因": "已学习此神兽血脉功法"}
	弟子.血脉功法列表.append(功法ID)
	Game.添加纪事("家族", "学习神兽功法", "%s 学习%s专属神兽血脉功法「%s」" % [弟子.姓名, 血脉要求, str(功法.get("名", 功法ID))], 1)
	return {"成功": true, "功法ID": 功法ID, "功法名": str(功法.get("名", 功法ID))}

## 计算血脉功法加成（家族血脉功法 + 神兽血脉功法）
func 计算血脉功法加成(弟子: Disciple) -> Dictionary:
	if 弟子 == null or not (弟子 is Disciple) or 弟子.血脉功法列表.is_empty():
		return {"修炼加成": 0.0, "战力加成": 0.0}
	var 修炼加成: float = 0.0
	var 战力加成: float = 0.0
	for 功法ID in 弟子.血脉功法列表:
		if str(功法ID).begins_with("family_xuemai_"):
			# 家族血脉功法：加成按家族等级计算
			var 家族ID: String = str(功法ID).replace("family_xuemai_", "")
			var 家族: Dictionary = 获取家族(家族ID)
			if not 家族.is_empty():
				var 家族等级: int = int(家族.get("等级", 1))
				# 家族等级1-10，加成0.5%-3%，但数值红线≤1.5%
				var 等级加成: float = min(0.005 + (家族等级 - 1) * 0.0025, 0.015)
				修炼加成 += 等级加成
				战力加成 += 等级加成
		elif _神兽血脉功法配置.has(功法ID):
			# 神兽血脉功法
			var 功法: Dictionary = _神兽血脉功法配置[功法ID]
			修炼加成 += float(功法.get("修炼加成", 0.0))
			战力加成 += float(功法.get("战力加成", 0.0))
	# 数值红线：血脉功法单源子帽≤1.5%（全局等效）
	修炼加成 = min(修炼加成, 0.015)
	战力加成 = min(战力加成, 0.015)
	return {"修炼加成": 修炼加成, "战力加成": 战力加成}

