class_name PuppetSystem extends RefCounted

# ===== 傀儡系统状态变量 =====
var 傀儡列表: Array = []                # 傀儡列表（{ID, 名称, 品阶, 类型, 等级, 效果, 替死, 装备}）
var 傀儡ID计数器: int = 0               # 傀儡ID计数器
var 累计制作傀儡数: int = 0             # 累计制作傀儡数量（成就用）

