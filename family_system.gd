## 触发家族事件
func 触发家族事件(家族ID: String, 事件类型: String, 附加信息: Dictionary = {}) -> Dictionary:
	if 家族ID == "" or 事件类型 == "":
		return {"成功": false, "因": "参数无效"}
	if not _家族事件配置.has(事件类型):
		return {"成功": false, "因": "事件类型不存在"}
	var 家族: Dictionary = 获取家族(家族ID)
	if 家族.is_empty():
		return {"成功": false, "因": "家族不存在"}
	var 事件: Dictionary = _家族事件配置[事件类型]
	# 处理声望变化
	if 事件.has("声望加成"):
		家族["家族声望"] = int(家族.get("家族声望", 0)) + int(事件.get("声望加成", 0))
	elif 事件.has("声望减少"):
		家族["家族声望"] = max(0, int(家族.get("家族声望", 0)) - int(事件.get("声望减少", 0)))
	# 记录事件
	var 事件记录: Dictionary = {
		"时间": Game.累计游戏日,
		"类型": 事件类型,
		"名": str(事件.get("名", "")),
		"描述": str(事件.get("描述", "")),
		"附加信息": 附加信息
	}
	if not 家族.has("事件记录"):
		家族["事件记录"] = []
	家族["事件记录"].append(事件记录)
	# 限制事件记录数量（最多100条）
	if 家族["事件记录"].size() > 100:
		家族["事件记录"].pop_front()
	家族列表[家族ID] = 家族
	# Game.添加纪事
	var 事件名: String = str(事件.get("名", ""))
	var 家族名: String = str(家族.get("名", ""))
	var 事件类型名: String = str(事件.get("类型", ""))
	var 重要性: int = 1 if 事件类型名 == "正面" else 2
	if 事件类型 == "family_destroy" or 事件类型 == "family_rise":
		重要性 = 2
	Game.添加纪事("家族事件", 事件名, "「%s」%s" % [家族名, str(事件.get("描述", ""))], 重要性)
	return {"成功": true, "事件名": 事件名, "家族声望": 家族.get("家族声望", 0)}

## 获取家族事件记录
func 获取家族事件记录(家族ID: String, 限制数量: int = 20) -> Array:
	if 家族ID == "" or not 家族列表.has(家族ID):
		return []
	var 家族: Dictionary = 家族列表[家族ID]
	var 事件记录: Array = 家族.get("事件记录", [])
	if 事件记录.is_empty():
		return []
	# 返回最近的事件
	var 结果: Array = []
	var 起始: int = max(0, 事件记录.size() - 限制数量)
	for i in range(起始, 事件记录.size()):
		结果.append(事件记录[i])
	return 结果

# ============ §6.16 家族排行榜系统（P4实现）============
# 修真世界设定：家族实力排行榜，激励玩家发展家族

## 计算家族实力评分
func 计算家族实力评分(家族ID: String) -> Dictionary:
	if 家族ID == "" or not 家族列表.has(家族ID):
		return {"评分": 0, "等级分": 0, "成员分": 0, "战力分": 0, "声望分": 0, "阵法分": 0, "秘宝分": 0}
	var 家族: Dictionary = 家族列表[家族ID]
	# 等级分（1-10级，每级10分）
	var 等级分: int = int(家族.get("等级", 1)) * 10
	# 成员分（每个成员1分，最多50分）
	var 成员分: int = min(家族.get("成员列表", []).size(), 50)
	# 战力分（所有在宗成员总战力/1000，最多100分）
	var 总战力: int = 0
	for 成员ID in 家族.get("成员列表", []):
		var d: Object = Game._取弟子(成员ID)
		if d != null and d is Disciple and d.状态 == "在宗":
			总战力 += d.计算战力()
	var 战力分: int = min(总战力 / 1000, 100)
	# 声望分（家族声望/10，最多50分）
	var 声望分: int = min(int(家族.get("家族声望", 0)) / 10, 50)
	# 阵法分（有阵法+20分，阵法等级+5分/级，最多40分）
	var 阵法分: int = 0
	if str(家族.get("家族阵法", "")) != "":
		阵法分 = 20 + int(家族.get("阵法等级", 1)) * 5
	阵法分 = min(阵法分, 40)
	# 秘宝分（每件秘宝+10分，最多30分）
	var 秘宝分: int = min(家族.get("家族秘宝", []).size() * 10, 30)
	# 总评分
	var 总评分: int = 等级分 + 成员分 + 战力分 + 声望分 + 阵法分 + 秘宝分
	return {
		"评分": 总评分,
		"等级分": 等级分,
		"成员分": 成员分,
		"战力分": 战力分,
		"声望分": 声望分,
		"阵法分": 阵法分,
		"秘宝分": 秘宝分,
		"总战力": 总战力
	}

## 获取家族排行榜
func 获取家族排行榜(限制数量: int = 10) -> Array:
	if 家族列表.is_empty():
		return []
	# 计算所有家族的评分
	var 家族评分列表: Array = []
	for 家族ID in 家族列表.keys():
		var 评分: Dictionary = 计算家族实力评分(家族ID)
		var 家族: Dictionary = 家族列表[家族ID]
		家族评分列表.append({
			"家族ID": 家族ID,
			"家族名": str(家族.get("名", "")),
			"等级": int(家族.get("等级", 1)),
			"成员数": 家族.get("成员列表", []).size(),
			"评分": 评分.get("评分", 0),
			"总战力": 评分.get("总战力", 0),
			"Game.声望": int(家族.get("家族声望", 0))
		})
	# 按评分排序（降序）
	家族评分列表.sort_custom(func(a, b): return a["评分"] > b["评分"])
	# 返回前N名
	var 结果: Array = []
	for i in range(min(限制数量, 家族评分列表.size())):
		var 排名信息: Dictionary = 家族评分列表[i]
		排名信息["排名"] = i + 1
		结果.append(排名信息)
	return 结果

## 获取家族排名
func 获取家族排名(家族ID: String) -> int:
	if 家族ID == "" or not 家族列表.has(家族ID):
		return -1
	var 排行榜: Array = 获取家族排行榜(家族列表.size())
	for i in range(排行榜.size()):
		if str(排行榜[i].get("家族ID", "")) == 家族ID:
			return i + 1
	return -1


