## 洞府修炼加成（洞府等级越高，修炼效率越高）
## 1级+5%，2级+10%，3级+15%，4级+20%，5级+25%，6级+30%，7级+40%
func 洞府修炼加成() -> float:
	if 洞府等级 <= 0:
		return 0.0
	var 加成: Array = [0.0, 0.05, 0.10, 0.15, 0.20, 0.25, 0.30, 0.40]
	return 加成[clamp(洞府等级, 0, 7)]

## 个人灵田月产出（灵田等级×2株灵草）
func 灵田月产出() -> int:
